"என்றால் மட்டுமே செயலில் உள்ளது."

#: docs/HingeJoint.xml docs/PhysicsServer.xml
msgid "The lower this value, the more the rotation gets slowed down."
msgstr "இந்த மதிப்பைக் குறைத்து, சுழற்சி குறைகிறது."

#: docs/HingeJoint.xml
msgid ""
"The maximum rotation. Only active if [member angular_limit/enable] is "
"[code]true[/code]."
msgstr ""
"அதிகபட்ச சுழற்சி. [உறுப்பினர் கோண_ லிமிட்/இயக்கு] [குறியீடு] உண்மை [/குறியீடு] என்றால் "
"மட்டுமே செயலில் உள்ளது."

#: docs/HingeJoint.xml
msgid "When activated, a motor turns the hinge."
msgstr "செயல்படுத்தும்போது, ஒரு மின்னோடி கீலை மாற்றுகிறது."

#: docs/HingeJoint.xml docs/PhysicsServer.xml
msgid "Maximum acceleration for the motor."
msgstr "மோட்டருக்கு அதிகபட்ச முடுக்கம்."

#: docs/HingeJoint.xml docs/PhysicsServer.xml
msgid "Target speed for the motor."
msgstr "மோட்டருக்கான இலக்கு விரைவு."

#: docs/HingeJoint.xml docs/PhysicsServer.xml
msgid ""
"The speed with which the two bodies get pulled together when they move in "
"different directions."
msgstr "இரண்டு உடல்களும் வெவ்வேறு திசைகளில் செல்லும்போது அவை ஒன்றாக இழுக்கப்படும் விரைவு."

#: docs/HMACContext.xml
msgid "Used to create an HMAC for a message using a key."
msgstr "ஒரு விசையைப் பயன்படுத்தி ஒரு செய்திக்கு HMAC ஐ உருவாக்க பயன்படுகிறது."

#: docs/HMACContext.xml
#, fuzzy
msgid ""
"The HMACContext class is useful for advanced HMAC use cases, such as "
"streaming the message as it supports creating the message over time rather "
"than providing it all at once.\n"
"[codeblock]\n"
"extends Node\n"
"var ctx = HMACContext.new()\n"
"\n"
"func _ready():\n"
"    var key = \"supersecret\".to_utf8()\n"
"    var err = ctx.start(HashingContext.HASH_SHA256, key)\n"
"    assert(err == OK)\n"
"    var msg1 = \"this is \".to_utf8()\n"
"    var msg2 = \"super duper secret\".to_utf8()\n"
"    err = ctx.update(msg1)\n"
"    assert(err == OK)\n"
"    err = ctx.update(msg2)\n"
"    assert(err == OK)\n"
"    var hmac = ctx.finish()\n"
"    print(hmac.hex_encode())\n"
"[/codeblock]\n"
"And in C# we can use the following.\n"
"[codeblock]\n"
"using Rebel;\n"
"using System;\n"
"using System.Diagnostics;\n"
"\n"
"public class CryptoNode : Node\n"
"{\n"
"    private HMACContext ctx = new HMACContext();\n"
"    public override void _Ready()\n"
"    {\n"
"        PoolByteArray key = String(\"supersecret\").to_utf8();\n"
"        Error err = ctx.Start(HashingContext.HASH_SHA256, key);\n"
"        GD.Assert(err == OK);\n"
"        PoolByteArray msg1 = String(\"this is \").to_utf8();\n"
"        PoolByteArray msg2 = String(\"super duper secret\").to_utf8();\n"
"        err = ctx.Update(msg1);\n"
"        GD.Assert(err == OK);\n"
"        err = ctx.Update(msg2);\n"
"        GD.Assert(err == OK);\n"
"        PoolByteArray hmac = ctx.Finish();\n"
"        GD.Print(hmac.HexEncode());\n"
"    }\n"
"}\n"
"[/codeblock]\n"
"[b]Note:[/b] Not available in web exports."
msgstr ""
"மேம்பட்ட HMAC பயன்பாட்டு நிகழ்வுகளுக்கு HMACContext வகுப்பு பயனுள்ளதாக இருக்கும், "
"அதாவது செய்தியை ச்ட்ரீமிங் செய்வது போன்றவை செய்தியை ஒரே நேரத்தில் வழங்குவதை விட "
"காலப்போக்கில் உருவாக்குவதை ஆதரிக்கின்றன.\n"
" [கோட் பிளாக்]\n"
" முனை நீட்டிக்கிறது\n"
" var ctx = hmaccontext.new ()\n"
"\n"
" func _ready ():\n"
" var key = \"supersecret\" .to_utf8 ()\n"
" var err = ctx.start (hashingcontext.hash_sha256, key)\n"
" உறுதிப்படுத்தவும் (பிழை == சரி)\n"
" var msg1 = \"இது\" .to_utf8 ()\n"
" var msg2 = \"சூப்பர் டூப்பர் மறைபொருள்\" .to_utf8 ()\n"
" பிழை = ctx.update (msg1)\n"
" உறுதிப்படுத்தவும் (பிழை == சரி)\n"
" பிழை = ctx.update (msg2)\n"
" உறுதிப்படுத்தவும் (பிழை == சரி)\n"
" var hmac = ctx.finish ()\n"
" அச்சு (hmac.hex_encode ())\n"
" [/codeBlock]\n"
" சி# இல் நாம் பின்வருவனவற்றைப் பயன்படுத்தலாம்.\n"
" [கோட் பிளாக்]\n"
" கோடோட்டைப் பயன்படுத்துதல்;\n"
" கணினியைப் பயன்படுத்துதல்;\n"
" System.diagnostics ஐப் பயன்படுத்துதல்;\n"
"\n"
" பொது வகுப்பு கிரிப்டோனோட்: முனை\n"
" {\n"
" தனியார் HmacContext CTX = புதிய HMACContext ();\n"
" பொது மேலெழுத வெற்றிடம் _ ஆயத்தம் ()\n"
" {\n"
" Boolbytearray key = சரம் (\"supersecret\"). To_utf8 ();\n"
" பிழை பிழை = ctx.start (hashingcontext.hash_sha256, key);\n"
" Gd.assert (பிழை == சரி);\n"
" Bolbytearray msg1 = சரம் (\"இது\") .to_utf8 ();\n"
" Boolbytearray msg2 = சரம் (\"சூப்பர் டூப்பர் ரகசியம்\"). To_utf8 ();\n"
" பிழை = ctx.update (msg1);\n"
" Gd.assert (பிழை == சரி);\n"
" பிழை = ctx.update (msg2);\n"
" Gd.assert (பிழை == சரி);\n"
" Bolbytearray hmac = ctx.finish ();\n"
" Gd.print (hmac.hexencode ());\n"
" }\n"
" }\n"
" [/codeBlock]\n"
" [b] குறிப்பு: [/b] வலை ஏற்றுமதியில் கிடைக்கவில்லை."

#: docs/HMACContext.xml
msgid ""
"Returns the resulting HMAC. If the HMAC failed, an empty [PoolByteArray] is "
"returned."
msgstr ""
"இதன் விளைவாக வரும் HMAC ஐ வழங்குகிறது. HMAC தோல்வியுற்றால், ஒரு வெற்று "
"[பூல்பிடியர்ரே] திருப்பித் தரப்படுகிறது."

#: docs/HMACContext.xml
msgid ""
"Initializes the HMACContext. This method cannot be called again on the same "
"HMACContext until [method finish] has been called."
msgstr ""
"HmacContext ஐத் தொடங்குகிறது. [முறை பூச்சு] அழைக்கப்படும் வரை இந்த முறையை அதே "
"HMACContext இல் மீண்டும் அழைக்க முடியாது."

#: docs/HMACContext.xml
msgid ""
"Updates the message to be HMACed. This can be called multiple times before "
"[method finish] is called to append [code]data[/code] to the message, but "
"cannot be called until [method start] has been called."
msgstr ""
"Hmaced செய்ய வேண்டிய செய்தியைப் புதுப்பிக்கிறது. [முறை பூச்சு] [குறியீடு] தரவை [/"
"குறியீட்டை] செய்தியுடன் சேர்க்கப்படுவதற்கு முன்பு இதை பல முறை அழைக்கலாம், ஆனால் [முறை "
"தொடக்க] அழைக்கப்படும் வரை அழைக்க முடியாது."

#: docs/HScrollBar.xml
msgid "Horizontal scroll bar."
msgstr "கிடைமட்ட உருள் பட்டி."

#: docs/HScrollBar.xml
msgid ""
"Horizontal version of [ScrollBar], which goes from left (min) to right (max)."
msgstr ""
"[ச்க்ரோல்பார்] இன் கிடைமட்ட பதிப்பு, இது இடது (நிமிடம்) இலிருந்து வலதுபுறம் (அதிகபட்சம்) "
"செல்கிறது."

#: docs/HScrollBar.xml
msgid ""
"Icon used as a button to scroll the [ScrollBar] left. Supports custom step "
"using the [member ScrollBar.custom_step] property."
msgstr ""
"[சுருள்] இடதுபுறத்தை உருட்ட ஒரு பொத்தானாக பயன்படுத்தப்படும் படவுரு. [உறுப்பினர் "
"storlbar.custom_step] சொத்தைப் பயன்படுத்தி தனிப்பயன் படிநிலையை ஆதரிக்கிறது."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Displayed when the mouse cursor hovers over the decrement button."
msgstr "குறைப்பு பொத்தானைக் காட்டிலும் மவுச் கர்சர் வட்டமிடும்போது காண்பிக்கப்படும்."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Displayed when the decrement button is being pressed."
msgstr "குறைவு பொத்தானை அழுத்தும் போது காண்பிக்கப்படும்."

#: docs/HScrollBar.xml
msgid ""
"Icon used as a button to scroll the [ScrollBar] right. Supports custom step "
"using the [member ScrollBar.custom_step] property."
msgstr ""
"[சுருள்] வலதுபுறத்தை உருட்ட ஒரு பொத்தானாக பயன்படுத்தப்படும் படவுரு. [உறுப்பினர் "
"storlbar.custom_step] சொத்தைப் பயன்படுத்தி தனிப்பயன் படிநிலையை ஆதரிக்கிறது."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Displayed when the mouse cursor hovers over the increment button."
msgstr "மவுச் கர்சர் அதிகரிப்பு பொத்தானைக் கடந்து செல்லும்போது காட்டப்படும்."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Displayed when the increment button is being pressed."
msgstr "அதிகரிப்பு பொத்தானை அழுத்தும் போது காண்பிக்கப்படும்."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid ""
"Used as texture for the grabber, the draggable element representing current "
"scroll."
msgstr ""
"கிராப்பருக்கு அமைப்பாகப் பயன்படுத்தப்படுகிறது, தற்போதைய சுருளைக் குறிக்கும் இழுக்கக்கூடிய "
"உறுப்பு."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Used when the mouse hovers over the grabber."
msgstr "மவுச் கிராப்பர் மீது வட்டமிடும்போது பயன்படுத்தப்படுகிறது."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Used when the grabber is being dragged."
msgstr "கிராப்பர் இழுக்கப்படும்போது பயன்படுத்தப்படுகிறது."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Used as background of this [ScrollBar]."
msgstr "இந்த [சுருள்] பின்னணியாகப் பயன்படுத்தப்படுகிறது."

#: docs/HScrollBar.xml docs/VScrollBar.xml
msgid "Used as background when the [ScrollBar] has the GUI focus."
msgstr "[சுருள்] GUI கவனம் இருக்கும்போது பின்னணியாகப் பயன்படுத்தப்படுகிறது."

#: docs/HSeparator.xml
msgid "Horizontal separator."
msgstr "கிடைமட்ட பிரிப்பான்."

#: docs/HSeparator.xml
msgid ""
"Horizontal separator. See [Separator]. Even though it looks horizontal, it "
"is used to separate objects vertically."
msgstr ""
"கிடைமட்ட பிரிப்பான். [பிரிப்பான்] ஐக் காண்க. இது கிடைமட்டமாகத் தெரிந்தாலும், பொருட்களை "
"செங்குத்தாக பிரிக்க இது பயன்படுகிறது."

#: docs/HSeparator.xml
msgid ""
"The height of the area covered by the separator. Effectively works like a "
"minimum height."
msgstr ""
"பிரிப்பானால் மூடப்பட்ட பகுதியின் உயரம். குறைந்தபட்ச உயரம் போல திறம்பட செயல்படுகிறது."

#: docs/HSeparator.xml
msgid "The style for the separator line. Works best with [StyleBoxLine]."
msgstr "பிரிப்பான் வரிக்கான நடை. [ச்டைல் பாக்்லைன்] உடன் சிறப்பாக செயல்படுகிறது."

#: docs/HSlider.xml
msgid "Horizontal slider."
msgstr "கிடைமட்ட ச்லைடர்."

#: docs/HSlider.xml
msgid ""
"Horizontal slider. See [Slider]. This one goes from left (min) to right "
"(max).\n"
"[b]Note:[/b] The [signal Range.changed] and [signal Range.value_changed] "
"signals are part of the [Range] class which this class inherits from."
msgstr ""
"கிடைமட்ட ச்லைடர். [ச்லைடர்] ஐக் காண்க. இது இடமிருந்து (நிமிடம்) வலதுபுறம் (அதிகபட்சம்) "
"செல்கிறது.\n"
" ."

#: docs/HSlider.xml docs/VSlider.xml
msgid "The texture for the grabber (the draggable element)."
msgstr "கிராப்பருக்கான அமைப்பு (இழுக்கக்கூடிய உறுப்பு)."

#: docs/HSlider.xml docs/VSlider.xml
msgid "The texture for the grabber when it's disabled."
msgstr "கிராப்பர் முடக்கப்பட்டிருக்கும் போது அது அமைப்பு."

#: docs/HSlider.xml docs/VSlider.xml
msgid "The texture for the grabber when it's focused."
msgstr "கிராப்பர் கவனம் செலுத்தும்போது அது அமைப்பு."

#: docs/HSlider.xml docs/VSlider.xml
msgid ""
"The texture for the ticks, visible when [member Slider.tick_count] is "
"greater than 0."
msgstr ""
"[உறுப்பினர் slider.tick_count] 0 ஐ விட அதிகமாக இருக்கும்போது, உண்ணிக்கான அமைப்பு "
"தெரியும்."

#: docs/HSlider.xml
msgid "The background of the area to the left of the grabber."
msgstr "கிராப்பரின் இடதுபுறத்தில் உள்ள பகுதியின் பின்னணி."

#: docs/HSlider.xml
msgid ""
"The background for the whole slider. Determines the height of the "
"[code]grabber_area[/code]."
msgstr ""
"முழு ச்லைடின் பின்னணி. [குறியீடு] கிராப்பர் பகுதியின் உயரத்தை தீர்மானிக்கிறது [/"
"குறியீடு]."

#: docs/HSplitContainer.xml
msgid "Horizontal split container."
msgstr "கிடைமட்ட பிளவு கொள்கலன்."

#: docs/HSplitContainer.xml
msgid ""
"Horizontal split container. See [SplitContainer]. This goes from left to "
"right."
msgstr ""
"கிடைமட்ட பிளவு கொள்கலன். [SplitContainer] ஐப் பார்க்கவும். இது இடமிருந்து வலமாக "
"செல்கிறது."

#: docs/HSplitContainer.xml docs/VSplitContainer.xml
msgid ""
"Boolean value. If 1 ([code]true[/code]), the grabber will hide automatically "
"when it isn't under the cursor. If 0 ([code]false[/code]), it's always "
"visible."
msgstr ""
"பூலியன் மதிப்பு. 1 ([குறியீடு] உண்மை [/குறியீடு]) என்றால், கிராப்பர் கர்சரின் கீழ் "
"இல்லாதபோது தானாகவே மறைக்கும். 0 ([குறியீடு] பொய் [/குறியீடு]) என்றால், அது எப்போதும் "
"தெரியும்."

#: docs/HSplitContainer.xml docs/VSplitContainer.xml
msgid "The space between sides of the container."
msgstr "கொள்கலனின் பக்கங்களுக்கு இடையிலான இடைவெளி."

#: docs/HSplitContainer.xml docs/VSplitContainer.xml
msgid "The icon used for the grabber drawn in the middle area."
msgstr "நடுத்தர பகுதியில் வரையப்பட்ட கிராப்பருக்கு பயன்படுத்தப்படும் படவுரு."

#: docs/HTTPClient.xml
msgid "Low-level hyper-text transfer protocol client."
msgstr "குறைந்த-நிலை ஐப்பர்-உரை பரிமாற்ற நெறிமுறை கிளையன்ட்."

#: docs/HTTPClient.xml
msgid ""
"Hyper-text transfer protocol client (sometimes called \"User Agent\"). Used "
"to make HTTP requests to download web content, upload files and other data "
"or to communicate with various services, among other use cases. [b]See the "
"[HTTPRequest] node for a higher-level alternative.[/b]\n"
"[b]Note:[/b] This client only needs to connect to a host once (see [method "
"connect_to_host]) to send multiple requests. Because of this, methods that "
"take URLs usually take just the part after the host instead of the full URL, "
"as the client is already connected to a host. See [method request] for a "
"full example and to get started.\n"
"A [HTTPClient] should be reused between multiple requests or to connect to "
"different hosts instead of creating one client per request. Supports SSL and "
"SSL server certificate verification. HTTP status codes in the 2xx range "
"indicate success, 3xx redirection (i.e. \"try again, but over here\"), 4xx "
"something was wrong with the request, and 5xx something went wrong on the "
"server's side.\n"
"For more information on HTTP, see https://developer.mozilla.org/en-US/docs/"
"Web/HTTP (or read RFC 2616 to get it straight from the source: https://"
"datatracker.ietf.org/doc/html/rfc2616).\n"
"[b]Note:[/b] When performing HTTP requests from a project exported for the "
"web, keep in mind the remote server may not allow requests from foreign "
"origins due to [url=https://developer.mozilla.org/en-US/docs/Web/HTTP/"
"CORS]CORS[/url]. If you host the server in question, you should modify its "
"backend to allow requests from foreign origins by adding the [code]Access-"
"Control-Allow-Origin: *[/code] HTTP header.\n"
"[b]Note:[/b] SSL/TLS support is currently limited to TLS 1.0, TLS 1.1, and "
"TLS 1.2. Attempting to connect to a TLS 1.3-only server will return an "
"error.\n"
"[b]Warning:[/b] SSL/TLS certificate revocation and certificate pinning are "
"currently not supported. Revoked certificates are accepted as long as they "
"are otherwise valid. If this is a concern, you may want to use automatically "
"managed certificates with a short validity period."
msgstr ""
"ஐப்பர்-உரை பரிமாற்ற நெறிமுறை வாங்கி (சில நேரங்களில் \"பயனர் முகவர்\" என்று "
"அழைக்கப்படுகிறது). வலை உள்ளடக்கம், கோப்புகள் மற்றும் பிற தரவைப் பதிவேற்ற அல்லது பல்வேறு "
"சேவைகளுடன் தொடர்பு கொள்ள HTTP கோரிக்கைகளைச் செய்யப் பயன்படுகிறது. [b] உயர் மட்ட "
"மாற்றுக்கான [httprequest] முனையைப் பார்க்கவும். [/b]\n"
" . இதன் காரணமாக, முகவரி களை எடுக்கும் முறைகள் வழக்கமாக முழு முகவரி க்கு பதிலாக "
"ஓச்டுக்குப் பிறகு மட்டுமே பங்குகளை எடுக்கும், ஏனெனில் வாடிக்கையாளர் ஏற்கனவே ஒரு ஓச்டுடன் "
"இணைக்கப்பட்டுள்ளார். ஒரு முழு எடுத்துக்காட்டுக்கு [முறை கோரிக்கை] ஐப் பார்க்கவும்.\n"
" ஒரு [HTTPClient] பல கோரிக்கைகளுக்கு இடையில் அல்லது ஒரு கோரிக்கைக்கு ஒரு கிளையண்டை "
"உருவாக்குவதற்கு பதிலாக வெவ்வேறு ஓச்ட்களுடன் இணைக்க மீண்டும் பயன்படுத்தப்பட வேண்டும். SSL "
"மற்றும் SSL சேவையக சான்றிதழ் சரிபார்ப்பை ஆதரிக்கிறது. 2xx வரம்பில் உள்ள HTTP நிலை "
"குறியீடுகள் வெற்றி, 3xx திருப்பிவிடுதல் (அதாவது \"மீண்டும் முயற்சிக்கவும், ஆனால் "
"இங்கே\"), 4xx கோரிக்கையில் ஏதோ தவறு இருந்தது, 5xx சேவையகத்தின் பக்கத்தில் ஏதோ தவறு "
"ஏற்பட்டது.\n"
" HTTP பற்றிய கூடுதல் தகவலுக்கு, https://developer.mozilla.org/en-us/docs/web/"
"http ஐப் பார்க்கவும் (அல்லது மூலத்திலிருந்து நேராகப் பெற RFC 2616 ஐப் படிக்கவும்: "
"https://datatatracker.org/doc/html/rfc2616).\n"
" . நீங்கள் கேள்விக்குரிய சேவையகத்தை புரவலன் செய்தால், [குறியீடு] அணுகல்-கட்டுப்பாடு-அலோ-"
"ஆரிசின்: *[/குறியீடு] HTTP தலைப்பைச் சேர்ப்பதன் மூலம் வெளிநாட்டு தோற்றத்திலிருந்து "
"கோரிக்கைகளை அனுமதிக்க அதன் பின்தளத்தில் மாற்ற வேண்டும்.\n"
" [b] குறிப்பு: [/b] SSL/TLS உதவி தற்போது TLS 1.0, TLS 1.1 மற்றும் TLS 1.2 க்கு "
"மட்டுப்படுத்தப்பட்டுள்ளது. டி.எல்.எச் 1.3-மட்டும் சேவையகத்துடன் இணைக்க முயற்சிப்பது பிழையைத் "
"தரும்.\n"
" [b] எச்சரிக்கை: [/b] SSL/TLS சான்றிதழ் திரும்பப்பெறுதல் மற்றும் சான்றிதழ் பின்னிங் "
"தற்போது ஆதரிக்கப்படவில்லை. ரத்து செய்யப்பட்ட சான்றிதழ்கள் அவை செல்லுபடியாகும் வரை "
"ஏற்றுக்கொள்ளப்படுகின்றன. இது ஒரு கவலையாக இருந்தால், குறுகிய செல்லுபடியாகும் காலத்துடன் "
"தானாக நிர்வகிக்கப்படும் சான்றிதழ்களைப் பயன்படுத்த விரும்பலாம்."

