msgid ""
"Appends an element at the end of the array (alias of [method push_back])."
msgstr "வரிசையின் முடிவில் ஒரு உறுப்பைச் சேர்க்கிறது ([முறை புச்_பேக்] மாற்றுப்பெயர்)."

#: docs/Array.xml
msgid ""
"Appends another array at the end of this array.\n"
"[codeblock]\n"
"var array1 = [1, 2, 3]\n"
"var array2 = [4, 5, 6]\n"
"array1.append_array(array2)\n"
"print(array1) # Prints [1, 2, 3, 4, 5, 6].\n"
"[/codeblock]"
msgstr ""
"இந்த வரிசையின் முடிவில் மற்றொரு வரிசையைச் சேர்க்கிறது.\n"
" [கோட் பிளாக்]\n"
" var array1 = [1, 2, 3]\n"
" var array2 = [4, 5, 6]\n"
" array1.append_array (array2)\n"
" அச்சு (வரிசை 1) # அச்சிட்டுகள் [1, 2, 3, 4, 5, 6].\n"
" [/codeBlock]"

#: docs/Array.xml
msgid ""
"Returns the last element of the array. Prints an error and returns "
"[code]null[/code] if the array is empty.\n"
"[b]Note:[/b] Calling this function is not the same as writing [code]array[-1]"
"[/code]. If the array is empty, accessing by index will pause project "
"execution when running from the editor."
msgstr ""
"வரிசையின் கடைசி உறுப்பை வழங்குகிறது. ஒரு பிழையை அச்சிட்டு, வரிசை காலியாக இருந்தால் "
"[குறியீடு] சுழிய [/குறியீடு] ஐ வழங்குகிறது.\n"
" [b] குறிப்பு: [/b] இந்த செயல்பாட்டை அழைப்பது [குறியீடு] வரிசை [-1] [/குறியீடு] "
"எழுதுவதற்கு சமமானதல்ல. வரிசை காலியாக இருந்தால், குறியீட்டின் மூலம் அணுகுவது "
"எடிட்டரிலிருந்து இயங்கும் போது திட்ட செயலாக்கத்தை இடைநிறுத்தும்."

#: docs/Array.xml
msgid ""
"Finds the index of an existing value (or the insertion index that maintains "
"sorting order, if the value is not yet present in the array) using binary "
"search. Optionally, a [code]before[/code] specifier can be passed. If "
"[code]false[/code], the returned index comes after all existing entries of "
"the value in the array.\n"
"[b]Note:[/b] Calling [method bsearch] on an unsorted array results in "
"unexpected behavior."
msgstr ""
"பைனரி தேடலைப் பயன்படுத்தி ஏற்கனவே உள்ள மதிப்பின் குறியீட்டைக் கண்டறிந்து (அல்லது "
"வரிசையாக்க வரிசையை பராமரிக்கும் செருகும் குறியீட்டை வரிசைப்படுத்தும் குறியீடு). "
"விருப்பமாக, [/குறியீடு] விவரக்குறிப்புக்கு முன் ஒரு [குறியீடு] அனுப்பப்படலாம். "
"[குறியீடு] தவறான [/குறியீடு] என்றால், வரிசையில் மதிப்பின் தற்போதுள்ள அனைத்து "
"உள்ளீடுகளுக்குப் பிறகு திரும்பிய குறியீடு வருகிறது.\n"
" ."

#: docs/Array.xml
msgid ""
"Finds the index of an existing value (or the insertion index that maintains "
"sorting order, if the value is not yet present in the array) using binary "
"search and a custom comparison method declared in the [code]obj[/code]. "
"Optionally, a [code]before[/code] specifier can be passed. If [code]false[/"
"code], the returned index comes after all existing entries of the value in "
"the array. The custom method receives two arguments (an element from the "
"array and the value searched for) and must return [code]true[/code] if the "
"first argument is less than the second, and return [code]false[/code] "
"otherwise.\n"
"[codeblock]\n"
"func cardinal_to_algebraic(a):\n"
"    match a:\n"
"        \"one\":\n"
"            return 1\n"
"        \"two\":\n"
"            return 2\n"
"        \"three\":\n"
"            return 3\n"
"        \"four\":\n"
"            return 4\n"
"        _:\n"
"            return 0\n"
"\n"
"func compare(a, b):\n"
"    return cardinal_to_algebraic(a) < cardinal_to_algebraic(b)\n"
"\n"
"func _ready():\n"
"    var a = [\"one\", \"two\", \"three\", \"four\"]\n"
"    # `compare` is defined in this object, so we use `self` as the `obj` "
"parameter.\n"
"    print(a.bsearch_custom(\"three\", self, \"compare\", true)) # Expected "
"value is 2.\n"
"[/codeblock]\n"
"[b]Note:[/b] Calling [method bsearch_custom] on an unsorted array results in "
"unexpected behavior."
msgstr ""
"பைனரி தேடலைப் பயன்படுத்தி ஏற்கனவே உள்ள மதிப்பின் குறியீட்டை (அல்லது வரிசையாக்க வரிசையை "
"பராமரிக்கும் செருகும் குறியீட்டை பராமரிக்கும் குறியீடு) காண்கிறது மற்றும் [குறியீடு] OBJ "
"[/code] இல் அறிவிக்கப்பட்ட தனிப்பயன் ஒப்பீட்டு முறை. விருப்பமாக, [/குறியீடு] "
"விவரக்குறிப்புக்கு முன் ஒரு [குறியீடு] அனுப்பப்படலாம். [குறியீடு] தவறான [/குறியீடு] "
"என்றால், வரிசையில் மதிப்பின் தற்போதுள்ள அனைத்து உள்ளீடுகளுக்குப் பிறகு திரும்பிய குறியீடு "
"வருகிறது. தனிப்பயன் முறை இரண்டு வாதங்களைப் பெறுகிறது (வரிசையிலிருந்து ஒரு உறுப்பு "
"மற்றும் தேடப்பட்ட மதிப்பு) மற்றும் முதல் உரையாடல் இரண்டாவதாக இருந்தால் [குறியீடு] உண்மை [/"
"குறியீடு] திரும்ப வேண்டும், மேலும் [குறியீடு] தவறான [/குறியீடு] இல்லையெனில் திரும்ப "
"வேண்டும்.\n"
" [கோட் பிளாக்]\n"
" func கார்டினல்_டோ_அல்செப்ராயிக் (அ):\n"
" போட்டி A:\n"
" \"ஒன்று\":\n"
" திரும்ப 1\n"
" \"இரண்டு\":\n"
" திரும்ப 2\n"
" \"மூன்று\":\n"
" திரும்ப 3\n"
" \"நான்கு\":\n"
" திரும்ப 4\n"
" _:\n"
" திரும்ப 0\n"
"\n"
" func ஒப்பிடுக (அ, பி):\n"
" கார்டினல்_டோ_அல்செப்ராயிக் (அ) <கார்டினல்_டோ_அல்செப்ராயிக் (பி) திரும்பவும்\n"
"\n"
" func _ready ():\n"
" var a = [\"ஒரு\", \"இரண்டு\", \"மூன்று\", \"நான்கு\"]\n"
" # `ஒப்பிட்டுப் பாருங்கள்` இந்த பொருளில் வரையறுக்கப்பட்டுள்ளது, எனவே` சுயத்தை` `OBJ` "
"அளவுருவாகப் பயன்படுத்துகிறோம்.\n"
" அச்சு (a.bsearch_custom (\"மூன்று\", தன்வய, \"ஒப்பிடுக\", உண்மை)) # "
"எதிர்பார்க்கப்படும் மதிப்பு 2.\n"
" [/codeBlock]\n"
" ."

#: docs/Array.xml
msgid ""
"Clears the array. This is equivalent to using [method resize] with a size of "
"[code]0[/code]."
msgstr ""
"வரிசையை அழிக்கிறது. இது [குறியீடு] 0 [/குறியீடு] அளவுடன் [முறை மறுஅளவிடுதல்] "
"பயன்படுத்துவதற்கு சமம்."

#: docs/Array.xml
msgid "Returns the number of times an element is in the array."
msgstr "ஒரு உறுப்பு வரிசையில் இருக்கும் எண்ணிக்கையை எத்தனை முறை வழங்குகிறது."

#: docs/Array.xml
msgid ""
"Returns a copy of the array.\n"
"If [code]deep[/code] is [code]true[/code], a deep copy is performed: all "
"nested arrays and dictionaries are duplicated and will not be shared with "
"the original array. If [code]false[/code], a shallow copy is made and "
"references to the original nested arrays and dictionaries are kept, so that "
"modifying a sub-array or dictionary in the copy will also impact those "
"referenced in the source array."
msgstr ""
"வரிசையின் நகலை வழங்குகிறது.\n"
" . ."

#: docs/Array.xml docs/PoolByteArray.xml docs/PoolColorArray.xml
#: docs/PoolIntArray.xml docs/PoolRealArray.xml docs/PoolStringArray.xml
#: docs/PoolVector2Array.xml docs/PoolVector3Array.xml
msgid "Returns [code]true[/code] if the array is empty."
msgstr "வரிசை காலியாக இருந்தால் [குறியீடு] உண்மை [/குறியீடு] ஐ வழங்குகிறது."

#: docs/Array.xml
msgid ""
"Removes the first occurrence of a value from the array. If the value does "
"not exist in the array, nothing happens. To remove an element by index, use "
"[method remove] instead.\n"
"[b]Note:[/b] This method acts in-place and doesn't return a value.\n"
"[b]Note:[/b] On large arrays, this method will be slower if the removed "
"element is close to the beginning of the array (index 0). This is because "
"all elements placed after the removed element have to be reindexed."
msgstr ""
"வரிசையிலிருந்து ஒரு மதிப்பின் முதல் நிகழ்வை நீக்குகிறது. வரிசையில் மதிப்பு இல்லை "
"என்றால், எதுவும் நடக்காது. குறியீட்டால் ஒரு உறுப்பை அகற்ற, அதற்கு பதிலாக [முறை அகற்று] "
"பயன்படுத்தவும்.\n"
" [b] குறிப்பு: [/b] இந்த முறை இடத்தில் செயல்படுகிறது மற்றும் ஒரு மதிப்பைத் தராது.\n"
" [b] குறிப்பு: [/b] பெரிய வரிசைகளில், அகற்றப்பட்ட உறுப்பு வரிசையின் தொடக்கத்திற்கு "
"(குறியீட்டு 0) நெருக்கமாக இருந்தால் இந்த முறை மெதுவாக இருக்கும். ஏனென்றால், அகற்றப்பட்ட "
"உறுப்புக்குப் பிறகு வைக்கப்படும் அனைத்து கூறுகளும் மறுசீரமைக்கப்பட வேண்டும்."

#: docs/Array.xml
msgid ""
"Searches the array for a value and returns its index or [code]-1[/code] if "
"not found. Optionally, the initial search index can be passed."
msgstr ""
"ஒரு மதிப்புக்கான வரிசையைத் தேடுகிறது மற்றும் அதன் குறியீட்டு அல்லது [குறியீடு] -1 [/"
"குறியீடு] கிடைக்கவில்லை என்றால் தருகிறது. விருப்பமாக, ஆரம்ப தேடல் குறியீட்டை அனுப்பலாம்."

#: docs/Array.xml
msgid ""
"Searches the array in reverse order for a value and returns its index or "
"[code]-1[/code] if not found."
msgstr ""
"ஒரு மதிப்புக்கு தலைகீழ் வரிசையில் வரிசையைத் தேடி, அதன் குறியீட்டு அல்லது [குறியீடு] -1 "
"[/குறியீடு] கிடைக்கவில்லை என்றால் திருப்பித் தரவும்."

#: docs/Array.xml
msgid ""
"Returns the first element of the array. Prints an error and returns "
"[code]null[/code] if the array is empty.\n"
"[b]Note:[/b] Calling this function is not the same as writing [code]array[0]"
"[/code]. If the array is empty, accessing by index will pause project "
"execution when running from the editor."
msgstr ""
"வரிசையின் முதல் உறுப்பை வழங்குகிறது. ஒரு பிழையை அச்சிட்டு, வரிசை காலியாக இருந்தால் "
"[குறியீடு] சுழிய [/குறியீடு] ஐ வழங்குகிறது.\n"
" [b] குறிப்பு: [/b] இந்த செயல்பாட்டை அழைப்பது [குறியீடு] வரிசை [0] [/குறியீடு] "
"எழுதுவதற்கு சமமானதல்ல. வரிசை காலியாக இருந்தால், குறியீட்டின் மூலம் அணுகுவது "
"எடிட்டரிலிருந்து இயங்கும் போது திட்ட செயலாக்கத்தை இடைநிறுத்தும்."

#: docs/Array.xml
msgid ""
"Returns [code]true[/code] if the array contains the given value.\n"
"[codeblock]\n"
"[\"inside\", 7].has(\"inside\") # True\n"
"[\"inside\", 7].has(\"outside\") # False\n"
"[\"inside\", 7].has(7) # True\n"
"[\"inside\", 7].has(\"7\") # False\n"
"[/codeblock]\n"
"[b]Note:[/b] This is equivalent to using the [code]in[/code] operator as "
"follows:\n"
"[codeblock]\n"
"# Will evaluate to `true`.\n"
"if 2 in [2, 4, 6, 8]:\n"
"    pass\n"
"[/codeblock]"
msgstr ""
"வரிசையில் கொடுக்கப்பட்ட மதிப்பைக் கொண்டிருந்தால் [குறியீடு] உண்மை [/குறியீடு].\n"
" [கோட் பிளாக்]\n"
" [\"உள்ளே\", 7] .has (\"உள்ளே\") # உண்மை\n"
" [\"உள்ளே\", 7] .has (\"வெளியே\") # பொய்\n"
" [\"உள்ளே\", 7] .has (7) # உண்மை\n"
" [\"உள்ளே\", 7] .has (\"7\") # தவறு\n"
" [/codeBlock]\n"
" [b] குறிப்பு: [/b] இது [/குறியீடு] ஆபரேட்டரில் [குறியீடு] ஐப் பயன்படுத்துவதற்கு "
"சமம்:\n"
" [கோட் பிளாக்]\n"
" # `உண்மை` என மதிப்பீடு செய்யும்.\n"
" [2, 4, 6, 8] இல் 2 என்றால்:\n"
" பாச்\n"
" [/codeBlock]"

#: docs/Array.xml
msgid ""
"Returns a hashed 32-bit integer value representing the array and its "
"contents.\n"
"[b]Note:[/b] [Array]s with equal content will always produce identical hash "
"values. However, the reverse is not true. Returning identical hash values "
"does [i]not[/i] imply the arrays are equal, because different arrays can "
"have identical hash values due to hash collisions."
msgstr ""
"வரிசை மற்றும் அதன் உள்ளடக்கங்களைக் குறிக்கும் 32-பிட் முழு எண் மதிப்பை வழங்குகிறது.\n"
" [b] குறிப்பு: [/b] [வரிசை] சமமான உள்ளடக்கத்துடன் கள் எப்போதும் ஒரே மாதிரியான ஆச் "
"மதிப்புகளை உருவாக்கும். இருப்பினும், தலைகீழ் உண்மை இல்லை. ஒரே மாதிரியான ஆச் மதிப்புகளைத் "
"திருப்பித் தருவது [i] [/i] வரிசைகள் சமமானவை என்பதைக் குறிக்காது, ஏனென்றால் வெவ்வேறு "
"வரிசைகள் ஆச் மோதல்கள் காரணமாக ஒரே மாதிரியான ஆச் மதிப்புகளைக் கொண்டிருக்கலாம்."

#: docs/Array.xml
msgid ""
"Inserts a new element at a given position in the array. The position must be "
"valid, or at the end of the array ([code]pos == size()[/code]).\n"
"[b]Note:[/b] This method acts in-place and doesn't return a value.\n"
"[b]Note:[/b] On large arrays, this method will be slower if the inserted "
"element is close to the beginning of the array (index 0). This is because "
"all elements placed after the newly inserted element have to be reindexed."
msgstr ""
"வரிசையில் ஒரு குறிப்பிட்ட நிலையில் ஒரு புதிய உறுப்பைச் செருகுகிறது. நிலை "
"செல்லுபடியாகும், அல்லது வரிசையின் முடிவில் ([குறியீடு] POS == அளவு () [/"
"குறியீடு]).\n"
" [b] குறிப்பு: [/b] இந்த முறை இடத்தில் செயல்படுகிறது மற்றும் ஒரு மதிப்பைத் தராது.\n"
" [b] குறிப்பு: [/b] பெரிய வரிசைகளில், செருகப்பட்ட உறுப்பு வரிசையின் தொடக்கத்திற்கு "
"அருகில் இருந்தால் (குறியீட்டு 0) இந்த முறை மெதுவாக இருக்கும். ஏனென்றால், புதிதாக "
"செருகப்பட்ட உறுப்புக்குப் பிறகு வைக்கப்பட்டுள்ள அனைத்து கூறுகளும் மறுசீரமைக்கப்பட வேண்டும்."

#: docs/Array.xml docs/PoolByteArray.xml docs/PoolColorArray.xml
#: docs/PoolIntArray.xml docs/PoolRealArray.xml docs/PoolStringArray.xml
#: docs/PoolVector2Array.xml docs/PoolVector3Array.xml
msgid "Reverses the order of the elements in the array."
msgstr "வரிசையில் உள்ள உறுப்புகளின் வரிசையை மாற்றியமைக்கிறது."

#: docs/Array.xml
msgid ""
"Returns the maximum value contained in the array if all elements are of "
"comparable types. If the elements can't be compared, [code]null[/code] is "
"returned."
msgstr ""
"அனைத்து கூறுகளும் ஒப்பிடக்கூடிய வகைகளாக இருந்தால் வரிசையில் உள்ள அதிகபட்ச மதிப்பை "
"வழங்குகிறது. உறுப்புகளை ஒப்பிட முடியாவிட்டால், [குறியீடு] சுழிய [/குறியீடு] திரும்பப் "
"பெறப்படும்."

#: docs/Array.xml
msgid ""
"Returns the minimum value contained in the array if all elements are of "
"comparable types. If the elements can't be compared, [code]null[/code] is "
"returned."
msgstr ""
"அனைத்து கூறுகளும் ஒப்பிடக்கூடிய வகைகளாக இருந்தால் வரிசையில் உள்ள குறைந்தபட்ச மதிப்பை "
"வழங்குகிறது. உறுப்புகளை ஒப்பிட முடியாவிட்டால், [குறியீடு] சுழிய [/குறியீடு] திரும்பப் "
"பெறப்படும்."

#: docs/Array.xml
msgid ""
"Removes and returns the element of the array at index [code]position[/code]. "
"If negative, [code]position[/code] is considered relative to the end of the "
"array. Leaves the array untouched and returns [code]null[/code] if the array "
"is empty or if it's accessed out of bounds. An error message is printed when "
"the array is accessed out of bounds, but not when the array is empty.\n"
"[b]Note:[/b] On large arrays, this method can be slower than [method "
"pop_back] as it will reindex the array's elements that are located after the "
"removed element. The larger the array and the lower the index of the removed "
"element, the slower [method pop_at] will be."
msgstr ""
"குறியீட்டு [குறியீடு] நிலையில் [/குறியீடு] வரிசையின் உறுப்பை அகற்றி வழங்குகிறது. "
"எதிர்மறையாக இருந்தால், [குறியீடு] நிலை [/குறியீடு] வரிசையின் முடிவோடு "
"தொடர்புடையதாகக் கருதப்படுகிறது. வரிசையை தீண்டாமல் விட்டுவிட்டு, வரிசை காலியாக "
"இருந்தால் அல்லது அது எல்லைக்கு வெளியே அணுகப்பட்டால் [குறியீடு] சுழிய [/குறியீடு] ஐ "
"வழங்குகிறது. வரிசை எல்லைக்கு வெளியே அணுகும்போது பிழை செய்தி அச்சிடப்படுகிறது, ஆனால் "
"வரிசை காலியாக இருக்கும்போது அல்ல.\n"
" . பெரிய வரிசை மற்றும் அகற்றப்பட்ட உறுப்பின் குறியீட்டைக் குறைத்து, மெதுவான [முறை "
"POP_AT] இருக்கும்."

#: docs/Array.xml
msgid ""
"Removes and returns the last element of the array. Returns [code]null[/code] "
"if the array is empty, without printing an error message. See also [method "
"pop_front]."
msgstr ""
"வரிசையின் கடைசி உறுப்பை அகற்றி வழங்குகிறது. பிழை செய்தியை அச்சிடாமல், வரிசை காலியாக "
"இருந்தால் [குறியீடு] NULL [/code] ஐ வழங்குகிறது. [முறை POP_FRONT] ஐயும் காண்க."

#: docs/Array.xml
msgid ""
"Removes and returns the first element of the array. Returns [code]null[/"
"code] if the array is empty, without printing an error message. See also "
"[method pop_back].\n"
"[b]Note:[/b] On large arrays, this method is much slower than [method "
"pop_back] as it will reindex all the array's elements every time it's "
"called. The larger the array, the slower [method pop_front] will be."
msgstr ""
"வரிசையின் முதல் உறுப்பை அகற்றி வழங்குகிறது. பிழை செய்தியை அச்சிடாமல், வரிசை காலியாக "
"இருந்தால் [குறியீடு] NULL [/code] ஐ வழங்குகிறது. [முறை POP_BACK] ஐயும் காண்க.\n"
" . பெரிய வரிசை, மெதுவான [முறை பாப்_பிரண்ட்] இருக்கும்."

#: docs/Array.xml
msgid ""
"Appends an element at the end of the array. See also [method push_front]."
msgstr "வரிசையின் முடிவில் ஒரு உறுப்பைச் சேர்க்கிறது. [முறை புச்_பிரண்ட்] ஐயும் காண்க."

#: docs/Array.xml
msgid ""
"Adds an element at the beginning of the array. See also [method push_back].\n"
"[b]Note:[/b] On large arrays, this method is much slower than [method "
"push_back] as it will reindex all the array's elements every time it's "
"called. The larger the array, the slower [method push_front] will be."
msgstr ""
"வரிசையின் தொடக்கத்தில் ஒரு உறுப்பைச் சேர்க்கிறது. [முறை புச்_பேக்] ஐயும் காண்க.\n"
" . பெரிய வரிசை, மெதுவான [முறை புச்_பிரண்ட்] இருக்கும்."

#: docs/Array.xml
msgid ""
"Removes an element from the array by index. If the index does not exist in "
"the array, nothing happens. To remove an element by searching for its value, "
"use [method erase] instead.\n"
"[b]Note:[/b] This method acts in-place and doesn't return a value.\n"
"[b]Note:[/b] On large arrays, this method will be slower if the removed "
"element is close to the beginning of the array (index 0). This is because "
"all elements placed after the removed element have to be reindexed."
msgstr ""
"குறியீட்டால் வரிசையிலிருந்து ஒரு உறுப்பை நீக்குகிறது. வரிசையில் குறியீடு இல்லை என்றால், "
"எதுவும் நடக்காது. ஒரு உறுப்பை அதன் மதிப்பைத் தேடுவதன் மூலம் அகற்ற, அதற்கு பதிலாக [முறை "
"அழிக்க] பயன்படுத்தவும்.\n"
" [b] குறிப்பு: [/b] இந்த முறை இடத்தில் செயல்படுகிறது மற்றும் ஒரு மதிப்பைத் தராது.\n"
" [b] குறிப்பு: [/b] பெரிய வரிசைகளில், அகற்றப்பட்ட உறுப்பு வரிசையின் தொடக்கத்திற்கு "
"(குறியீட்டு 0) நெருக்கமாக இருந்தால் இந்த முறை மெதுவாக இருக்கும். ஏனென்றால், அகற்றப்பட்ட "
"உறுப்புக்குப் பிறகு வைக்கப்படும் அனைத்து கூறுகளும் மறுசீரமைக்கப்பட வேண்டும்."

#: docs/Array.xml
msgid ""
"Resizes the array to contain a different number of elements. If the array "
"size is smaller, elements are cleared, if bigger, new elements are "
"[code]null[/code]."
msgstr ""
"வேறுபட்ட எண்ணிக்கையிலான உறுப்புகளைக் கொண்டிருக்க வரிசையை மறுஅளவிடுங்கள். வரிசை அளவு "
"சிறியதாக இருந்தால், கூறுகள் அழிக்கப்படும், பெரியதாக இருந்தால், புதிய கூறுகள் "
"[குறியீடு] NULL [/குறியீடு]."

#: docs/Array.xml
msgid ""
"Searches the array in reverse order. Optionally, a start search index can be "
"passed. If negative, the start index is considered relative to the end of "
"the array."
msgstr ""
"தலைகீழ் வரிசையில் வரிசையைத் தேடுகிறது. விருப்பமாக, தொடக்க தேடல் குறியீட்டை அனுப்ப "
"முடியும். எதிர்மறையாக இருந்தால், தொடக்கக் குறியீடு வரிசையின் முடிவோடு தொடர்புடையதாகக் "
"கருதப்படுகிறது."

#: docs/Array.xml
msgid ""
"Shuffles the array such that the items will have a random order. This method "
"uses the global random number generator common to methods such as [method "
"@GDScript.randi]. Call [method @GDScript.randomize] to ensure that a new "
"seed will be used each time if you want non-reproducible shuffling."
msgstr ""
"உருப்படிகளுக்கு ஒரு சீரற்ற ஆர்டர் இருக்கும் என்ற வரிசையை மாற்றுகிறது. இந்த முறை [முறை "
"@gdscript.randi] போன்ற முறைகளுக்கு பொதுவான உலகளாவிய சீரற்ற எண் செனரேட்டரைப் "
"பயன்படுத்துகிறது. மாற்றப்படாத மாற்றத்தை நீங்கள் விரும்பினால் ஒவ்வொரு முறையும் ஒரு புதிய "
"விதை பயன்படுத்தப்படும் என்பதை உறுதிப்படுத்த [முறை @gdscript.randomize] ஐ அழைக்கவும்."

#: docs/Array.xml
msgid "Returns the number of elements in the array."
msgstr "வரிசையில் உள்ள உறுப்புகளின் எண்ணிக்கையை வழங்குகிறது."

#: docs/Array.xml
msgid ""
"Duplicates the subset described in the function and returns it in an array, "
"deeply copying the array if [code]deep[/code] is [code]true[/code]. Lower "
"and upper index are inclusive, with the [code]step[/code] describing the "
"change between indices while slicing."
msgstr ""
"செயல்பாட்டில் விவரிக்கப்பட்டுள்ள துணைக்குழுவை நகலெடுத்து அதை ஒரு வரிசையில் திருப்பி, "
"[குறியீடு] ஆழமான [/குறியீடு] [குறியீடு] உண்மை [/குறியீடு] என்றால் வரிசையை ஆழமாக "
"நகலெடுக்கிறது. [குறியீடு] படி [/குறியீடு] வெட்டும் போது குறியீடுகளுக்கு இடையிலான "
"மாற்றத்தை விவரிக்கும் குறைந்த மற்றும் மேல் குறியீடு உள்ளடக்கியது."

#: docs/Array.xml
msgid ""
"Sorts the array.\n"
"[b]Note:[/b] Strings are sorted in alphabetical order (as opposed to natural "
"order). This may lead to unexpected behavior when sorting an array of "
"strings ending with a sequence of numbers. Consider the following example:\n"
"[codeblock]\n"
"var strings = [\"string1\", \"string2\", \"string10\", \"string11\"]\n"
"strings.sort()\n"
"print(strings) # Prints [string1, string10, string11, string2]\n"
"[/codeblock]"
msgstr ""
"வரிசையை வரிசைப்படுத்துகிறது.\n"
" [b] குறிப்பு: [/b] சரங்கள் அகர வரிசைப்படி வரிசைப்படுத்தப்படுகின்றன (இயற்கை ஒழுங்குக்கு "
"மாறாக). எண்களின் வரிசையுடன் முடிவடையும் சரங்களின் வரிசையை வரிசைப்படுத்தும்போது இது "
"எதிர்பாராத நடத்தைக்கு வழிவகுக்கும். பின்வரும் உதாரணத்தைக் கவனியுங்கள்:\n"
" [கோட் பிளாக்]\n"
" var சரங்கள் = [\"string1\", \"string2\", \"string10\", \"string11\"]\n"
" strings.sort ()\n"
" அச்சு (சரங்கள்) # அச்சிடுகிறது [சரம் 1, சரம் 10, சரம் 11, சரம் 2]\n"
" [/codeBlock]"

#: docs/Array.xml
msgid ""
"Sorts the array using a custom method. The arguments are an object that "
"holds the method and the name of such method. The custom method receives two "
"arguments (a pair of elements from the array) and must return either "
"[code]true[/code] or [code]false[/code].\n"
"For two elements [code]a[/code] and [code]b[/code], if the given method "
"returns [code]true[/code], element [code]b[/code] will be after element "
"[code]a[/code] in the array.\n"
"[b]Note:[/b] You cannot randomize the return value as the heapsort algorithm "
"expects a deterministic result. Doing so will result in unexpected "
"behavior.\n"
"[codeblock]\n"
"class MyCustomSorter:\n"
"    static func sort_ascending(a, b):\n"
"        if a[0] < b[0]:\n"
"            return true\n"
"        return false\n"
"\n"
"var my_items = [[5, \"Potato\"], [9, \"Rice\"], [4, \"Tomato\"]]\n"
"my_items.sort_custom(MyCustomSorter, \"sort_ascending\")\n"
"print(my_items) # Prints [[4, Tomato], [5, Potato], [9, Rice]].\n"
"[/codeblock]"
msgstr ""
"தனிப்பயன் முறையைப் பயன்படுத்தி வரிசையை வரிசைப்படுத்துகிறது. வாதங்கள் முறையையும் அத்தகைய "
"முறையின் பெயரையும் வைத்திருக்கும் ஒரு பொருள். தனிப்பயன் முறை இரண்டு வாதங்களைப் "
"பெறுகிறது (வரிசையிலிருந்து ஒரு இணை உறுப்புகள்) மற்றும் [குறியீடு] உண்மை [/குறியீடு] "
"அல்லது [குறியீடு] தவறான [/குறியீடு] ஐ வழங்க வேண்டும்.\n"
" இரண்டு கூறுகளுக்கு [குறியீடு] ஒரு [/குறியீடு] மற்றும் [குறியீடு] பி [/குறியீடு], "
"கொடுக்கப்பட்ட முறை [குறியீடு] உண்மை [/குறியீடு] ஐ வழங்கினால், உறுப்பு [குறியீடு] பி [/"
"குறியீடு] வரிசையில் உறுப்பு [குறியீடு] ஒரு [/குறியீடு] க்குப் பிறகு இருக்கும்.\n"
" . அவ்வாறு செய்வது எதிர்பாராத நடத்தைக்கு வழிவகுக்கும்.\n"
" [கோட் பிளாக்]\n"
" வகுப்பு MyCustomSorter:\n"
" நிலையான FUNC Sort_ascend (A, B):\n"
" A [0] <b [0] என்றால்:\n"
" உண்மை திரும்பவும்\n"
" தவறு திரும்பவும்\n"
"\n"
" var my_items = [[5, \"உருளைக்கிழங்கு\"], [9, \"அரிசி\"], [4, \"தக்காளி\"]]]\n"
" my_items.sort_custom (MyCustomSorter, \"sort_ascending\")\n"
" அச்சிடுக (my_items) # அச்சிடுகிறது [[4, தக்காளி], [5, உருளைக்கிழங்கு], [9, "
"அரிசி]].\n"
" [/codeBlock]"

#: docs/ArrayMesh.xml
msgid ""
"[Mesh] type that provides utility for constructing a surface from arrays."
msgstr ""
"[கண்ணி] வரிசைகளிலிருந்து ஒரு மேற்பரப்பை உருவாக்குவதற்கான பயன்பாட்டை வழங்கும் வகை."

#: docs/ArrayMesh.xml
msgid ""
"The [ArrayMesh] is used to construct a [Mesh] by specifying the attributes "
"as arrays.\n"
"The most basic example is the creation of a single triangle:\n"
"[codeblock]\n"
"var vertices = PoolVector3Array()\n"
"vertices.push_back(Vector3(0, 1, 0))\n"
"vertices.push_back(Vector3(1, 0, 0))\n"
"vertices.push_back(Vector3(0, 0, 1))\n"
"# Initialize the ArrayMesh.\n"
"var arr_mesh = ArrayMesh.new()\n"
"var arrays = []\n"
"arrays.resize(ArrayMesh.ARRAY_MAX)\n"
"arrays[ArrayMesh.ARRAY_VERTEX] = vertices\n"
"# Create the Mesh.\n"
"arr_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)\n"
"var m = MeshInstance.new()\n"
"m.mesh = arr_mesh\n"
"[/codeblock]\n"
"The [MeshInstance] is ready to be added to the [SceneTree] to be shown.\n"
"See also [ImmediateGeometry], [MeshDataTool] and [SurfaceTool] for "
"procedural geometry generation.\n"
"[b]Note:[/b] Rebel Engine uses clockwise [url=https://learnopengl.com/"
"Advanced-OpenGL/Face-culling]winding order[/url] for front faces of triangle "
"primitive modes."
msgstr ""
"பண்புகளை வரிசைகளாகக் குறிப்பிடுவதன் மூலம் [மெச்] ஐ உருவாக்க [அரேமேச்] "
"பயன்படுத்தப்படுகிறது.\n"
" ஒற்றை முக்கோணத்தை உருவாக்குவது மிக அடிப்படையான எடுத்துக்காட்டு:\n"
" [கோட் பிளாக்]\n"
" var செங்குத்துகள் = boolvector3array ()\n"
" vertices.push_back (வெக்டர் 3 (0, 1, 0))\n"
" vertices.push_back (வெக்டர் 3 (1, 0, 0))\n"
" vertices.push_back (வெக்டர் 3 (0, 0, 1))\n"
" # அரேமேசைத் தொடங்கவும்.\n"
" var arr_mesh = arraymesh.new ()\n"
" var வரிசைகள் = []\n"
" வரிசைகள். Resize (arraymesh.array_max)\n"
" வரிசைகள் [arraymesh.array_vertex] = செங்குத்துகள்\n"
" # கண்ணி உருவாக்கவும்.\n"
" arr_mesh.add_surface_from_arrays (mesh.primitive_triangles, வரிசைகள்)\n"
" var m = meshinstance.new ()\n"
" m.mesh = arr_mesh\n"
" [/codeBlock]\n"
" [மெசின்ச்டன்ச்] காட்டப்பட வேண்டிய [காட்சி] இல் சேர்க்க தயாராக உள்ளது.\n"
" நடைமுறை வடிவியல் தலைமுறைக்கு [உடனடி சியோமெட்ரி], [மெச்தடாடூல்] மற்றும் "
"[சர்ஃபாசெட்டூல்] ஐயும் காண்க.\n"
" ."

#: docs/ArrayMesh.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/procedural_geometry/"
"arraymesh.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/procedural_geometry/"
"arraymesh.html"

#: docs/ArrayMesh.xml
msgid ""
"Adds name for a blend shape that will be added with [method "
"add_surface_from_arrays]. Must be called before surface is added."
msgstr ""
"[முறை Add_surface_from_arrays] உடன் சேர்க்கப்படும் கலப்பு வடிவத்திற்கான பெயரைச் "
"சேர்க்கிறது. மேற்பரப்பு சேர்க்கப்படுவதற்கு முன்பு அழைக்கப்பட வேண்டும்."

#: docs/ArrayMesh.xml
msgid ""
"Creates a new surface.\n"
"Surfaces are created to be rendered using a [code]primitive[/code], which "
"may be any of the types defined in [enum Mesh.PrimitiveType]. (As a note, "
"when using indices, it is recommended to only use points, lines, or "
"triangles.) [method Mesh.get_surface_count] will become the [code]surf_idx[/"
"code] for this new surface.\n"
"The [code]arrays[/code] argument is an array of arrays. See [enum ArrayType] "
"for the values used in this array. For example, [code]arrays[0][/code] is "
"the array of vertices. That first vertex sub-array is always required; the "
"others are optional. Adding an index array puts this function into \"index "
"mode\" where the vertex and other arrays become the sources of data and the "
"index array defines the vertex order. All sub-arrays must have the same "
"length as the vertex array or be empty, except for [constant ARRAY_INDEX] if "
"it is used."
msgstr ""
"புதிய மேற்பரப்பை உருவாக்குகிறது.\n"
" [குறியீடு] பழமையான [/குறியீடு] ஐப் பயன்படுத்தி மேற்பரப்புகள் உருவாக்கப்படுகின்றன, இது "
"[enum mesh.primitivetype] இல் வரையறுக்கப்பட்ட வகைகளாக இருக்கலாம். .\n"
" [குறியீடு] வரிசைகள் [/குறியீடு] உரையாடல் வரிசைகளின் வரிசை. இந்த வரிசையில் "
"பயன்படுத்தப்படும் மதிப்புகளுக்கு [enum arrayType] ஐப் பார்க்கவும். எடுத்துக்காட்டாக, "
"[குறியீடு] வரிசைகள் [0] [/குறியீடு] என்பது செங்குத்துகளின் வரிசை. அந்த முதல் வெர்டெக்ச் "
"துணை வரிசை எப்போதும் தேவைப்படுகிறது; மற்றவர்கள் விருப்பமானவர்கள். ஒரு குறியீட்டு "
"வரிசையைச் சேர்ப்பது இந்த செயல்பாட்டை \"குறியீட்டு பயன்முறையில்\" வைக்கிறது, அங்கு "
"வெர்டெக்ச் மற்றும் பிற வரிசைகள் தரவுகளின் ஆதாரங்களாக மாறும் மற்றும் குறியீட்டு வரிசை "
"வெர்டெக்ச் வரிசையை வரையறுக்கிறது. எல்லா துணை வரிசைகளும் வெர்டெக்ச் வரிசையின் அதே "
"நீளத்தைக் கொண்டிருக்க வேண்டும் அல்லது காலியாக இருக்க வேண்டும், அது பயன்படுத்தப்பட்டால் "
"[நிலையான வரிசை_இண்டெக்ச்] தவிர."

#: docs/ArrayMesh.xml
msgid "Removes all blend shapes from this [ArrayMesh]."
msgstr "இந்த [அரேமேச்] இலிருந்து அனைத்து கலப்பு வடிவங்களையும் நீக்குகிறது."

#: docs/ArrayMesh.xml
msgid "Removes all surfaces from this [ArrayMesh]."
msgstr "இந்த [அரேமேச்] இலிருந்து அனைத்து மேற்பரப்புகளையும் நீக்குகிறது."

#: docs/ArrayMesh.xml
msgid "Returns the number of blend shapes that the [ArrayMesh] holds."
msgstr "[அரேமேச்] வைத்திருக்கும் கலப்பு வடிவங்களின் எண்ணிக்கையை வழங்குகிறது."

#: docs/ArrayMesh.xml
msgid "Returns the name of the blend shape at this index."
msgstr "இந்த குறியீட்டில் கலவை வடிவத்தின் பெயரை வழங்குகிறது."

#: docs/ArrayMesh.xml
msgid ""
"Will perform a UV unwrap on the [ArrayMesh] to prepare the mesh for "
"lightmapping."
msgstr "லைட்மாப்பிங்கிற்கான கண்ணி தயாரிக்க [அரேமேச்] இல் யு.வி."

#: docs/ArrayMesh.xml
msgid "Will regenerate normal maps for the [ArrayMesh]."
msgstr "[அரேமேச்] க்கான சாதாரண வரைபடங்களை மீண்டும் உருவாக்கும்."

#: docs/ArrayMesh.xml
msgid ""
"Returns the index of the first surface with this name held within this "
"[ArrayMesh]. If none are found, -1 is returned."
msgstr ""
"இந்த [அரேமேச்] க்குள் இந்த பெயருடன் முதல் மேற்பரப்பின் குறியீட்டை வழங்குகிறது. எதுவும் "
"கிடைக்கவில்லை என்றால், -1 திரும்பப் பெறப்படுகிறது."

#: docs/ArrayMesh.xml
msgid ""
"Returns the length in indices of the index array in the requested surface "
"(see [method add_surface_from_arrays])."
msgstr ""
"கோரப்பட்ட மேற்பரப்பில் குறியீட்டு வரிசையின் குறியீடுகளில் நீளத்தை வழங்குகிறது ([முறை "
"ADD_SURFACE_FROM_ARRAYS] ஐப் பார்க்கவும்)."

#: docs/ArrayMesh.xml
msgid ""
"Returns the length in vertices of the vertex array in the requested surface "
"(see [method add_surface_from_arrays])."
msgstr ""
"கோரப்பட்ட மேற்பரப்பில் வெர்டெக்ச் வரிசையின் செங்குத்துகளில் நீளத்தை வழங்குகிறது ([முறை "
"ADD_SURFACE_FROM_ARRAYS] ஐப் பார்க்கவும்)."

#: docs/ArrayMesh.xml
msgid ""
"Returns the format mask of the requested surface (see [method "
"add_surface_from_arrays])."
msgstr ""
"கோரப்பட்ட மேற்பரப்பின் வடிவமைப்பு முகமூடியை வழங்குகிறது ([முறை "
"ADD_SURFACE_FROM_ARRAYS] ஐப் பார்க்கவும்)."

#: docs/ArrayMesh.xml
msgid "Gets the name assigned to this surface."
msgstr "இந்த மேற்பரப்பில் ஒதுக்கப்பட்ட பெயரைப் பெறுகிறது."

#: docs/ArrayMesh.xml
msgid ""
"Returns the primitive type of the requested surface (see [method "
"add_surface_from_arrays])."
msgstr ""
"கோரப்பட்ட மேற்பரப்பின் பழமையான வகையை வழங்குகிறது ([முறை ADD_SURFACE_FROM_ARRAYS] "
"ஐப் பார்க்கவும்)."

#: docs/ArrayMesh.xml
msgid ""
"Removes a surface at position [code]surf_idx[/code], shifting greater "
"surfaces one [code]surf_idx[/code] slot down."
msgstr ""
"ஒரு மேற்பரப்பை [குறியீடு] Surf_idx [/code] இல் நீக்குகிறது, அதிக மேற்பரப்புகளை ஒரு "
"[குறியீடு] surf_idx [/code] ச்லாட்டைக் கீழே மாற்றுகிறது."

#: docs/ArrayMesh.xml
msgid "Sets a name for a given surface."
msgstr "கொடுக்கப்பட்ட மேற்பரப்புக்கு ஒரு பெயரை அமைக்கிறது."

#: docs/ArrayMesh.xml
msgid ""
"Updates a specified region of mesh arrays on the GPU.\n"
"[b]Warning:[/b] Only use if you know what you are doing. You can easily "
"cause crashes by calling this function with improper arguments."
msgstr ""
"GPU இல் கண்ணி வரிசைகளின் குறிப்பிட்ட பகுதியைப் புதுப்பிக்கிறது.\n"
" [b] எச்சரிக்கை: [/b] நீங்கள் என்ன செய்கிறீர்கள் என்று உங்களுக்குத் தெரிந்தால் மட்டுமே "
"பயன்படுத்தவும். இந்த செயல்பாட்டை முறையற்ற வாதங்களுடன் அழைப்பதன் மூலம் நீங்கள் எளிதில் "
"செயலிழப்பை ஏற்படுத்தலாம்."

#: docs/ArrayMesh.xml
msgid "Sets the blend shape mode to one of [enum Mesh.BlendShapeMode]."
msgstr "கலப்பு வடிவ பயன்முறையை [enum mesh.blendshapemode] க்கு அமைக்கிறது."

#: docs/ArrayMesh.xml docs/PrimitiveMesh.xml
msgid ""
"Overrides the [AABB] with one defined by user for use with frustum culling. "
"Especially useful to avoid unexpected culling when using a shader to offset "
"vertices."
msgstr ""
"[AABB] ஐ மீறுகிறது, பயனரால் வரையறுக்கப்பட்டுள்ளது. செங்குத்துகளை ஈடுசெய்ய ஒரு சேடரைப் "
"பயன்படுத்தும் போது எதிர்பாராத குவிப்பைத் தவிர்ப்பதற்கு குறிப்பாக பயனுள்ளதாக இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Default value used for index_array_len when no indices are present."
msgstr ""
"குறியீடுகள் இல்லாதபோது Index_array_len க்கு பயன்படுத்தப்படும் இயல்புநிலை மதிப்பு."

#: docs/ArrayMesh.xml
msgid "Amount of weights/bone indices per vertex (always 4)."
msgstr "ஒரு வெர்டெக்சுக்கு எடைகள்/எலும்பு குறியீடுகளின் அளவு (எப்போதும் 4)."

#: docs/ArrayMesh.xml
msgid "[PoolVector3Array], [PoolVector2Array], or [Array] of vertex positions."
msgstr "[PoolVector3Array], [PoolVector2Array], அல்லது [Array] உச்சி நிலைகள்."

#: docs/ArrayMesh.xml
msgid "[PoolVector3Array] of vertex normals."
msgstr "வெர்டெக்ச் நார்மல்களின் [bolvecter3array]."

#: docs/ArrayMesh.xml
msgid ""
"[PoolRealArray] of vertex tangents. Each element in groups of 4 floats, "
"first 3 floats determine the tangent, and the last the binormal direction as "
"-1 or 1."
msgstr ""
"வெர்டெக்ச் தொடுகோடுகளின் [பூல்ரியல்அரே]. 4 மிதவைகளின் குழுக்களில் உள்ள ஒவ்வொரு உறுப்பு, "
"முதல் 3 மிதவைகள் தொடுகோடு தீர்மானிக்கின்றன, கடைசியாக பைனார்மல் திசையை -1 அல்லது 1 என."

#: docs/ArrayMesh.xml
msgid "[PoolColorArray] of vertex colors."
msgstr "[பூலலோரரே] வெர்டெக்ச் வண்ணங்களின்."

#: docs/ArrayMesh.xml
msgid "[PoolVector2Array] for UV coordinates."
msgstr "[Bolvecter2Array] புற ஊதா ஆயத்தொலைவுகளுக்கு."

#: docs/ArrayMesh.xml
msgid "[PoolVector2Array] for second UV coordinates."
msgstr "[Boolvecter2Array] இரண்டாவது புற ஊதா ஆயத்தொலைவுகளுக்கு."

#: docs/ArrayMesh.xml
msgid ""
"[PoolRealArray] or [PoolIntArray] of bone indices. Each element in groups of "
"4 floats."
msgstr ""
"[பூல்ரியல்அரே] அல்லது [பூலிண்டார்] எலும்பு குறியீடுகளின். 4 மிதவைகளின் குழுக்களில் "
"ஒவ்வொரு உறுப்பு."

#: docs/ArrayMesh.xml
msgid "[PoolRealArray] of bone weights. Each element in groups of 4 floats."
msgstr "எலும்பு எடையின் [பூல்ரீலார்ர்]. 4 மிதவைகளின் குழுக்களில் ஒவ்வொரு உறுப்பு."

#: docs/ArrayMesh.xml
msgid ""
"[PoolIntArray] of integers used as indices referencing vertices, colors, "
"normals, tangents, and textures. All of those arrays must have the same "
"number of elements as the vertex array. No index can be beyond the vertex "
"array size. When this index array is present, it puts the function into "
"\"index mode,\" where the index selects the *i*'th vertex, normal, tangent, "
"color, UV, etc. This means if you want to have different normals or colors "
"along an edge, you have to duplicate the vertices.\n"
"For triangles, the index array is interpreted as triples, referring to the "
"vertices of each triangle. For lines, the index array is in pairs indicating "
"the start and end of each line."
msgstr ""
"செங்குத்துகள், வண்ணங்கள், இயல்பான, தொடுகோடுகள் மற்றும் அமைப்புகளைக் குறிக்கும் "
"குறியீடுகளாகப் பயன்படுத்தப்படும் முழு எண்களின் [POLLINTARRAY]. அந்த வரிசைகள் அனைத்தும் "
"வெர்டெக்ச் வரிசை போன்ற அதே எண்ணிக்கையிலான கூறுகளைக் கொண்டிருக்க வேண்டும். எந்த குறியீடும் "
"வெர்டெக்ச் வரிசை அளவிற்கு அப்பால் இருக்க முடியாது. இந்த குறியீட்டு வரிசை இருக்கும்போது, "
"அது செயல்பாட்டை \"குறியீட்டு பயன்முறையில்\" வைக்கிறது, அங்கு குறியீடு *i *'வது "
"வெர்டெக்ச், இயல்பான, தொடுகோடு, வண்ணம், புற ஊதா போன்றவற்றைத் தேர்ந்தெடுக்கும். இதன் பொருள் "
"நீங்கள் ஒரு விளிம்பில் வெவ்வேறு இயல்புகள் அல்லது வண்ணங்களை வைத்திருக்க விரும்பினால், நீங்கள் "
"செங்குத்துகளை நகலெடுக்க வேண்டும்.\n"
" முக்கோணங்களைப் பொறுத்தவரை, குறியீட்டு வரிசை ஒவ்வொரு முக்கோணத்தின் செங்குத்துகளையும் "
"குறிக்கிறது. வரிகளைப் பொறுத்தவரை, குறியீட்டு வரிசை ஒவ்வொரு வரியின் தொடக்கத்தையும் "
"முடிவையும் குறிக்கும் சோடிகளாக உள்ளது."

#: docs/ArrayMesh.xml docs/Mesh.xml docs/VisualServer.xml
msgid "Represents the size of the [enum ArrayType] enum."
msgstr "[Enum arrayType] enum இன் அளவைக் குறிக்கிறது."

#: docs/ArrayMesh.xml
msgid "Array format will include vertices (mandatory)."
msgstr "வரிசை வடிவத்தில் செங்குத்துகள் (கட்டாய) அடங்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include normals."
msgstr "வரிசை வடிவத்தில் இயல்பானவை இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include tangents."
msgstr "வரிசை வடிவத்தில் தொடுகோடுகள் இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include a color array."
msgstr "வரிசை வடிவத்தில் வண்ண வரிசை இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include UVs."
msgstr "வரிசை வடிவத்தில் UV கள் இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include another set of UVs."
msgstr "வரிசை வடிவத்தில் யு.வி.க்களின் மற்றொரு தொகுப்பு இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include bone indices."
msgstr "வரிசை வடிவத்தில் எலும்பு குறியீடுகள் இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Array format will include bone weights."
msgstr "வரிசை வடிவத்தில் எலும்பு எடைகள் இருக்கும்."

#: docs/ArrayMesh.xml
msgid "Index array will be used."
msgstr "குறியீட்டு வரிசை பயன்படுத்தப்படும்."

#: docs/ARVRAnchor.xml
msgid "An anchor point in AR space."
msgstr "AR இடத்தில் ஒரு நங்கூர புள்ளி."

#: docs/ARVRAnchor.xml
msgid ""
"The [ARVRAnchor] point is a spatial node that maps a real world location "
"identified by the AR platform to a position within the game world. For "
"example, as long as plane detection in ARKit is on, ARKit will identify and "
"update the position of planes (tables, floors, etc) and create anchors for "
"them.\n"
"This node is mapped to one of the anchors through its unique ID. When you "
"receive a signal that a new anchor is available, you should add this node to "
"your scene for that anchor. You can predefine nodes and set the ID; the "
"nodes will simply remain on 0,0,0 until a plane is recognized.\n"
"Keep in mind that, as long as plane detection is enabled, the size, placing "
"and orientation of an anchor will be updated as the detection logic learns "
"more about the real world out there especially if only part of the surface "
"is in view."
msgstr ""
"[Arvranchor] புள்ளி என்பது ஒரு இடஞ்சார்ந்த முனை ஆகும், இது AR தளத்தால் அடையாளம் "
"காணப்பட்ட ஒரு உண்மையான உலக இருப்பிடத்தை விளையாட்டு உலகிற்குள் ஒரு நிலைக்கு "
"வரைபடமாக்குகிறது. எடுத்துக்காட்டாக, ஆர்கிட்டில் வானூர்தி கண்டறிதல் இயங்கும் வரை, ஆர்கிட் "
"விமானங்களின் நிலையை (அட்டவணைகள், தளங்கள் போன்றவை) அடையாளம் கண்டு புதுப்பித்து அவற்றுக்கான "
"நங்கூரங்களை உருவாக்கும்.\n"
" இந்த முனை அதன் தனித்துவமான ஐடி மூலம் நங்கூரங்களில் ஒன்றில் பொருத்தப்பட்டுள்ளது. ஒரு "
"புதிய நங்கூரம் கிடைக்கக்கூடிய சமிக்ஞையை நீங்கள் பெறும்போது, அந்த நங்கூரத்திற்காக இந்த "
"முனையை உங்கள் காட்சியில் சேர்க்க வேண்டும். நீங்கள் முனைகளை முன்னிலைப்படுத்தி ஐடியை "
"அமைக்கலாம்; ஒரு வானூர்தி அங்கீகரிக்கப்படும் வரை முனைகள் 0,0,0 இல் இருக்கும்.\n"
" வானூர்தி கண்டறிதல் இயக்கப்பட்டிருக்கும் வரை, கண்டறிதல் வழக்கு உண்மையான உலகத்தைப் பற்றி "
"மேலும் அறியும்போது, குறிப்பாக மேற்பரப்பின் ஒரு பகுதி மட்டுமே பார்வையில் இருந்தால், ஒரு "
"நங்கூரத்தின் அளவு, வைப்பது மற்றும் நோக்குநிலை புதுப்பிக்கப்படும் என்பதை நினைவில் கொள்ளுங்கள்."

#: docs/ARVRAnchor.xml
msgid "Returns the name given to this anchor."
msgstr "இந்த நங்கூரத்திற்கு கொடுக்கப்பட்ட பெயரை வழங்குகிறது."

#: docs/ARVRAnchor.xml
msgid ""
"Returns [code]true[/code] if the anchor is being tracked and [code]false[/"
"code] if no anchor with this ID is currently known."
msgstr ""
"இந்த ஐடியுடன் எந்த நங்கூரமும் தற்போது அறியப்பட்டால், நங்கூரம் கண்காணிக்கப்பட்டு [/குறியீடு] "
"பொய் [/குறியீடு] இருந்தால் [குறியீடு] உண்மை [/குறியீடு] திரும்பும்."

#: docs/ARVRAnchor.xml
msgid ""
"If provided by the [ARVRInterface], this returns a mesh object for the "
"anchor. For an anchor, this can be a shape related to the object being "
"tracked or it can be a mesh that provides topology related to the anchor and "
"can be used to create shadows/reflections on surfaces or for generating "
"collision shapes."
msgstr ""
"[Arvrinterface] ஆல் வழங்கப்பட்டால், இது நங்கூரத்திற்கு ஒரு கண்ணி பொருளை வழங்குகிறது. "
"ஒரு நங்கூரத்தைப் பொறுத்தவரை, இது கண்காணிக்கப்படும் பொருளுடன் தொடர்புடைய வடிவமாக "
"இருக்கலாம் அல்லது இது நங்கூரத்துடன் தொடர்புடைய இடவியலை வழங்கும் ஒரு கண்ணி ஆக இருக்கலாம் "
"மற்றும் மேற்பரப்புகளில் நிழல்கள்/பிரதிபலிப்புகளை உருவாக்க அல்லது மோதல் வடிவங்களை உருவாக்க "
"பயன்படுத்தலாம்."

#: docs/ARVRAnchor.xml
msgid ""
"Returns a plane aligned with our anchor; handy for intersection testing."
msgstr ""
"எங்கள் நங்கூரத்துடன் சீரமைக்கப்பட்ட ஒரு விமானத்தை வழங்குகிறது; குறுக்குவெட்டு சோதனைக்கு "
"எளிது."

#: docs/ARVRAnchor.xml
msgid ""
"Returns the estimated size of the plane that was detected. Say when the "
"anchor relates to a table in the real world, this is the estimated size of "
"the surface of that table."
msgstr ""
"கண்டறியப்பட்ட விமானத்தின் மதிப்பிடப்பட்ட அளவை வழங்குகிறது. நங்கூரம் உண்மையான உலகில் ஒரு "
"அட்டவணையுடன் தொடர்புடையதாக இருக்கும்போது, இது அந்த அட்டவணையின் மேற்பரப்பின் மதிப்பிடப்பட்ட "
"அளவு."

#: docs/ARVRAnchor.xml
msgid ""
"The anchor's ID. You can set this before the anchor itself exists. The first "
"anchor gets an ID of [code]1[/code], the second an ID of [code]2[/code], "
"etc. When anchors get removed, the engine can then assign the corresponding "
"ID to new anchors. The most common situation where anchors \"disappear\" is "
"when the AR server identifies that two anchors represent different parts of "
"the same plane and merges them."
msgstr ""
"நங்கூரத்தின் ஐடி. நங்கூரம் இருப்பதற்கு முன்பு இதை நீங்கள் அமைக்கலாம். முதல் நங்கூரம் "
"[குறியீடு] 1 [/குறியீடு] இன் ஐடியைப் பெறுகிறது, [குறியீடு] 2 [/குறியீடு] இன் "
"இரண்டாவது ஐடி. நங்கூரர்கள் அகற்றப்படும்போது, இயந்திரம் தொடர்புடைய ஐடியை புதிய "
"நங்கூரங்களுக்கு ஒதுக்க முடியும். இரண்டு நங்கூரர்கள் ஒரே விமானத்தின் வெவ்வேறு பகுதிகளைக் "
"குறிக்கின்றன என்பதை AR சேவையகம் அடையாளம் கண்டு அவற்றை ஒன்றிணைக்கும் போது நங்கூரங்கள் "
"\"மறைந்துவிடும்\" என்ற பொதுவான சூழ்நிலை."

#: docs/ARVRAnchor.xml
msgid ""
"Emitted when the mesh associated with the anchor changes or when one becomes "
"available. This is especially important for topology that is constantly "
"being [code]mesh_updated[/code]."
msgstr ""
"நங்கூரத்துடன் தொடர்புடைய கண்ணி மாறும்போது அல்லது ஒன்று கிடைக்கும்போது வெளிப்படும். "
"தொடர்ந்து [குறியீடு] Mesh_updated [/code] ஆக இருக்கும் இடவியல் இது மிகவும் "
"முக்கியமானது."

#: docs/ARVRCamera.xml
msgid ""
"A camera node with a few overrules for AR/VR applied, such as location "
"tracking."
msgstr "இருப்பிட கண்காணிப்பு போன்ற AR/VR க்கான சில மேலோட்டங்களைக் கொண்ட கேமரா முனை."

#: docs/ARVRCamera.xml
msgid ""
"This is a helper spatial node for our camera; note that, if stereoscopic "
"rendering is applicable (VR-HMD), most of the camera properties are ignored, "
"as the HMD information overrides them. The only properties that can be "
"trusted are the near and far planes.\n"
"The position and orientation of this node is automatically updated by the "
"ARVR Server to represent the location of the HMD if such tracking is "
"available and can thus be used by game logic. Note that, in contrast to the "
"ARVR Controller, the render thread has access to the most up-to-date "
"tracking data of the HMD and the location of the ARVRCamera can lag a few "
"milliseconds behind what is used for rendering as a result."
msgstr ""
"இது எங்கள் கேமராவிற்கான உதவி இடஞ்சார்ந்த முனை; ச்டீரியோச்கோபிக் வழங்குதல் பொருந்தினால் "
"(வி.ஆர்-எச்எம்டி), எச்எம்டி தகவல்கள் அவற்றை மீறுவதால், கேமரா பண்புகள் பெரும்பாலானவை "
"புறக்கணிக்கப்படுகின்றன என்பதை நினைவில் கொள்க. நம்பக்கூடிய ஒரே பண்புகள் அருகிலுள்ள மற்றும் "
"தொலைதூர விமானங்கள்.\n"
" இந்த முனையின் நிலை மற்றும் நோக்குநிலை தானாகவே ARVR சேவையகத்தால் புதுப்பிக்கப்படும், "
"இதுபோன்ற கண்காணிப்பு கிடைத்தால் HMD இன் இருப்பிடத்தைக் குறிக்க, இதனால் விளையாட்டு "
"தர்க்கத்தால் பயன்படுத்தப்படலாம். ARVR கட்டுப்படுத்திக்கு மாறாக, வழங்குதல் நூல் HMD இன் "
"மிகவும் புதுப்பித்த கண்காணிப்பு தரவுகளுக்கான அணுகலைக் கொண்டுள்ளது மற்றும் அர்வ்ர்கமேராவின் "
"இருப்பிடம் இதன் விளைவாக வழங்குதல் செய்யப் பயன்படுத்தப்படுவதற்கு சில மில்லி விநாடிகளுக்கு "
"பின்னால் பின்தங்கியிருக்கலாம்."

#: docs/ARVRCamera.xml docs/ARVRController.xml docs/ARVRInterface.xml
#: docs/ARVROrigin.xml docs/ARVRPositionalTracker.xml docs/ARVRServer.xml
msgid "https://docs.rebeltoolbox.com/en/latest/tutorials/vr/index.html"
msgstr "https://docs.rebeltoolbox.com/en/latest/tutorials/vr/index.html"

#: docs/ARVRController.xml
msgid "A spatial node representing a spatially-tracked controller."
msgstr "இடஞ்சார்ந்த தடமறியும் கட்டுப்படுத்தியைக் குறிக்கும் இடஞ்சார்ந்த முனை."

#: docs/ARVRController.xml
msgid ""
"This is a helper spatial node that is linked to the tracking of controllers. "
"It also offers several handy passthroughs to the state of buttons and such "
"on the controllers.\n"
"Controllers are linked by their ID. You can create controller nodes before "
"the controllers are available. If your game always uses two controllers (one "
"for each hand), you can predefine the controllers with ID 1 and 2; they will "
"become active as soon as the controllers are identified. If you expect "
"additional controllers to be used, you should react to the signals and add "
"ARVRController nodes to your scene.\n"
"The position of the controller node is automatically updated by the "
"[ARVRServer]. This makes this node ideal to add child nodes to visualize the "
"controller."
msgstr ""
"இது ஒரு உதவி இடஞ்சார்ந்த முனை, இது கட்டுப்படுத்திகளின் கண்காணிப்புடன் இணைக்கப்பட்டுள்ளது. "
"இது பொத்தான்களின் நிலைக்கு பல எளிமையான பாச்ட்ரூக்களையும் கட்டுப்படுத்திகளிலும் "
"வழங்குகிறது.\n"
" கட்டுப்படுத்திகள் அவற்றின் ஐடியால் இணைக்கப்பட்டுள்ளன. கட்டுப்படுத்திகள் கிடைப்பதற்கு முன்பு "
"நீங்கள் கட்டுப்பாட்டு முனைகளை உருவாக்கலாம். உங்கள் விளையாட்டு எப்போதும் இரண்டு "
"கட்டுப்படுத்திகளைப் பயன்படுத்தினால் (ஒவ்வொரு கைக்கும் ஒன்று), நீங்கள் ஐடி 1 மற்றும் 2 உடன் "
"கட்டுப்படுத்திகளை முன்னரே வைக்கலாம்; கட்டுப்படுத்திகள் அடையாளம் காணப்பட்டவுடன் அவை செயலில் "
"இருக்கும். கூடுதல் கட்டுப்படுத்திகள் பயன்படுத்தப்படும் என்று நீங்கள் எதிர்பார்த்தால், நீங்கள் "
"சமிக்ஞைகளுக்கு எதிர்வினையாற்ற வேண்டும் மற்றும் உங்கள் காட்சியில் Arvrontroller முனைகளைச் "
"சேர்க்க வேண்டும்.\n"
" கட்டுப்படுத்தி முனையின் நிலை தானாகவே [arvrserver] புதுப்பிக்கப்படுகிறது. "
"கட்டுப்படுத்தியைக் காட்சிப்படுத்த குழந்தை முனைகளைச் சேர்க்க இது இந்த முனையை ஏற்றது."

#: docs/ARVRController.xml
msgid ""
"If active, returns the name of the associated controller if provided by the "
"AR/VR SDK used."
msgstr ""
"செயலில் இருந்தால், பயன்படுத்தப்பட்ட AR/VR SDK ஆல் வழங்கப்பட்டால் தொடர்புடைய "
"கட்டுப்படுத்தியின் பெயரை வழங்குகிறது."

#: docs/ARVRController.xml
msgid ""
"Returns the hand holding this controller, if known. See [enum "
"ARVRPositionalTracker.TrackerHand]."
msgstr ""
"தெரிந்தால், இந்த கட்டுப்படுத்தியை வைத்திருக்கும் கையை வழங்குகிறது. [Enum "
"arvrpospositionaltracker.trackerhand] ஐப் பார்க்கவும்."

#: docs/ARVRController.xml
msgid ""
"Returns [code]true[/code] if the bound controller is active. ARVR systems "
"attempt to track active controllers."
msgstr ""
"பிணைக்கப்பட்ட கட்டுப்படுத்தி செயலில் இருந்தால் [குறியீடு] உண்மை [/குறியீடு] ஐ "
"வழங்குகிறது. ARVR அமைப்புகள் செயலில் உள்ள கட்டுப்பாட்டாளர்களைக் கண்காணிக்க முயற்சிக்கின்றன."

#: docs/ARVRController.xml
msgid ""
"Returns the value of the given axis for things like triggers, touchpads, "
"etc. that are embedded into the controller."
msgstr ""
"கட்டுப்படுத்தியில் உட்பொதிக்கப்பட்ட தூண்டுதல்கள், டச்பேடுகள் போன்றவற்றுக்கு கொடுக்கப்பட்ட அச்சின் "
"மதிப்பை வழங்குகிறது."

#: docs/ARVRController.xml
msgid ""
"Returns the ID of the joystick object bound to this. Every controller "
"tracked by the [ARVRServer] that has buttons and axis will also be "
"registered as a joystick within Rebel Engine. This means that all the normal "
"joystick tracking and input mapping will work for buttons and axis found on "
"the AR/VR controllers. This ID is purely offered as information so you can "
"link up the controller with its joystick entry."
msgstr ""
"இதனுடன் பிணைக்கப்பட்ட சாய்ச்டிக் பொருளின் ஐடியை வழங்குகிறது. பொத்தான்கள் மற்றும் அச்சைக் "
"கொண்ட [Arvrserver] ஆல் கண்காணிக்கப்படும் ஒவ்வொரு கட்டுப்படுத்தியும் கிளர்ச்சி "
"இயந்திரத்திற்குள் ஒரு சாய்ச்டிக் ஆக பதிவு செய்யப்படும். இதன் பொருள் அனைத்து சாதாரண "
"சாய்ச்டிக் கண்காணிப்பு மற்றும் உள்ளீட்டு மேப்பிங் AR/VR கட்டுப்படுத்திகளில் காணப்படும் "
"பொத்தான்கள் மற்றும் அச்சுகளுக்கு வேலை செய்யும். இந்த ஐடி முற்றிலும் தகவலாக "
"வழங்கப்படுகிறது, எனவே நீங்கள் கட்டுப்படுத்தியை அதன் சாய்ச்டிக் நுழைவுடன் இணைக்க முடியும்."

#: docs/ARVRController.xml
msgid ""
"If provided by the [ARVRInterface], this returns a mesh associated with the "
"controller. This can be used to visualize the controller."
msgstr ""
"[Arvrinterface] ஆல் வழங்கப்பட்டால், இது கட்டுப்படுத்தியுடன் தொடர்புடைய ஒரு கண்ணி "
"தருகிறது. கட்டுப்படுத்தியைக் காட்சிப்படுத்த இதைப் பயன்படுத்தலாம்."

#: docs/ARVRController.xml
msgid ""
"Returns [code]true[/code] if the button at index [code]button[/code] is "
"pressed. See [enum JoystickList], in particular the [code]JOY_VR_*[/code] "
"constants."
msgstr ""
"குறியீட்டு [குறியீடு] பொத்தான் [/குறியீடு] இல் உள்ள பொத்தானை அழுத்தினால் [குறியீடு] உண்மை "
"[/code] ஐ வழங்குகிறது. [எனம் சாய்ச்டிக்லிச்ட்டை] காண்க, குறிப்பாக [குறியீடு] சாய்_விஆர் "
"_*[/குறியீடு] மாறிலிகள்."

#: docs/ARVRController.xml
msgid ""
"The controller's ID.\n"
"A controller ID of 0 is unbound and will always result in an inactive node. "
"Controller ID 1 is reserved for the first controller that identifies itself "
"as the left-hand controller and ID 2 is reserved for the first controller "
"that identifies itself as the right-hand controller.\n"
"For any other controller that the [ARVRServer] detects, we continue with "
"controller ID 3.\n"
"When a controller is turned off, its slot is freed. This ensures controllers "
"will keep the same ID even when controllers with lower IDs are turned off."
msgstr ""
"கட்டுப்படுத்தியின் ஐடி.\n"
" 0 இன் கட்டுப்படுத்தி ஐடி வரம்பற்றது மற்றும் எப்போதும் செயலற்ற முனைக்கு வழிவகுக்கும். "
"கட்டுப்பாட்டு ஐடி 1 முதல் கட்டுப்படுத்திக்கு ஒதுக்கப்பட்டுள்ளது, இது தன்னை இடது கை "
"கட்டுப்படுத்தியாக அடையாளம் காட்டுகிறது மற்றும் ஐடி 2 முதல் கட்டுப்படுத்திக்கு "
"ஒதுக்கப்பட்டுள்ளது, அது தன்னை வலது கை கட்டுப்படுத்தியாக அடையாளம் காட்டுகிறது.\n"
" [Arvrserver] கண்டறிந்த வேறு எந்த கட்டுப்படுத்திக்கும், நாங்கள் கட்டுப்பாட்டு ஐடி 3 உடன் "
"தொடர்கிறோம்.\n"
" ஒரு கட்டுப்படுத்தி அணைக்கப்படும் போது, அதன் ச்லாட் விடுவிக்கப்படுகிறது. குறைந்த ஐடிகளைக் "
"கொண்ட கட்டுப்படுத்திகள் அணைக்கப்படும்போது கூட கட்டுப்பாட்டாளர்கள் அதே ஐடியை வைத்திருப்பதை "
"இது உறுதி செய்கிறது."

#: docs/ARVRController.xml
msgid ""
"The degree to which the controller vibrates. Ranges from [code]0.0[/code] to "
"[code]1.0[/code] with precision [code].01[/code]. If changed, updates "
"[member ARVRPositionalTracker.rumble] accordingly.\n"
"This is a useful property to animate if you want the controller to vibrate "
"for a limited duration."
msgstr ""
"கட்டுப்படுத்தி எந்த அளவிற்கு அதிர்வுறும். [குறியீடு] 0.0 [/குறியீடு] முதல் [குறியீடு] "
"1.0 [/குறியீடு] வரை துல்லியமான [குறியீடு] .01 [/குறியீடு] வரை வரம்புகள். "
"மாற்றப்பட்டால், புதுப்பிப்புகள் [உறுப்பினர் arvrpositionaltracker.rumble] அதற்கேற்ப.\n"
" கட்டுப்படுத்தி ஒரு வரையறுக்கப்பட்ட காலத்திற்கு அதிர்வுற வேண்டும் என்று நீங்கள் விரும்பினால் "
"உயிரூட்ட இது ஒரு பயனுள்ள சொத்து."

#: docs/ARVRController.xml
msgid "Emitted when a button on this controller is pressed."
msgstr "இந்த கட்டுப்படுத்தியில் ஒரு பொத்தானை அழுத்தும்போது உமிழப்படும்."

#: docs/ARVRController.xml
msgid "Emitted when a button on this controller is released."
msgstr "இந்த கட்டுப்படுத்தியில் ஒரு பொத்தான் வெளியிடப்படும் போது உமிழப்படும்."

#: docs/ARVRController.xml
msgid ""
"Emitted when the mesh associated with the controller changes or when one "
"becomes available. Generally speaking this will be a static mesh after "
"becoming available."
msgstr ""
"கட்டுப்படுத்தியுடன் தொடர்புடைய கண்ணி மாறும்போது அல்லது ஒன்று கிடைக்கும்போது உமிழும். "
"பொதுவாக இது கிடைத்த பிறகு நிலையான கண்ணி இருக்கும்."

#: docs/ARVRInterface.xml
msgid "Base class for an AR/VR interface implementation."
msgstr "AR/VR இடைமுக செயலாக்கத்திற்கான அடிப்படை வகுப்பு."

#: docs/ARVRInterface.xml
msgid ""
"This class needs to be implemented to make an AR or VR platform available to "
"Rebel Engine and these should be implemented as C++ modules or GDNative "
"modules (note that for GDNative the subclass ARVRScriptInterface should be "
"used). Part of the interface is exposed to GDScript so you can detect, "
"enable and configure an AR or VR platform.\n"
"Interfaces should be written in such a way that simply enabling them will "
"give us a working setup. You can query the available interfaces through "
"[ARVRServer]."
msgstr ""
"கிளர்ச்சி இயந்திரத்திற்கு AR அல்லது VR இயங்குதளத்தை கிடைக்கச் செய்ய இந்த வகுப்பு "
"செயல்படுத்தப்பட வேண்டும், இவை C ++ தொகுதிகள் அல்லது Gdnative தொகுதிகள் என "
"செயல்படுத்தப்பட வேண்டும் (Gdnative க்கு ArvrscriptInterface ஐப் பயன்படுத்த வேண்டும் "
"என்பதை நினைவில் கொள்க). இடைமுகத்தின் ஒரு பகுதி GDSCRIPT க்கு வெளிப்படும், எனவே நீங்கள் "
"AR அல்லது VR இயங்குதளத்தைக் கண்டறிந்து இயக்கலாம் மற்றும் உள்ளமைக்கலாம்.\n"
" இடைமுகங்கள் எழுதப்பட வேண்டும், அவற்றை வெறுமனே செயல்படுத்துவது எங்களுக்கு ஒரு வேலை "
"அமைப்பைக் கொடுக்கும். [Arvrserver] மூலம் கிடைக்கக்கூடிய இடைமுகங்களை நீங்கள் வினவலாம்."

#: docs/ARVRInterface.xml
msgid ""
"If this is an AR interface that requires displaying a camera feed as the "
"background, this method returns the feed ID in the [CameraServer] for this "
"interface."
msgstr ""
"இது ஒரு AR இடைமுகமாக இருந்தால், இது கேமரா ஊட்டத்தை பின்னணியாகக் காண்பிக்க வேண்டும், "
"இந்த முறை இந்த இடைமுகத்திற்கான [கேமரேசர்] இல் ஊட்ட ஐடியை வழங்குகிறது."

#: docs/ARVRInterface.xml
msgid ""
"Returns a combination of [enum Capabilities] flags providing information "
"about the capabilities of this interface."
msgstr ""
"இந்த இடைமுகத்தின் திறன்களைப் பற்றிய தகவல்களை வழங்கும் [ENUM திறன்கள்] கொடிகளின் கலவையை "
"வழங்குகிறது."

#: docs/ARVRInterface.xml
msgid "Returns the name of this interface (OpenVR, OpenHMD, ARKit, etc)."
msgstr "இந்த இடைமுகத்தின் பெயரை (OpenVR, OpenHMD, ARKIT போன்றவை) வழங்குகிறது."

#: docs/ARVRInterface.xml
msgid ""
"Returns the resolution at which we should render our intermediate results "
"before things like lens distortion are applied by the VR platform."
msgstr ""
"லென்ச் விலகல் போன்ற விசயங்கள் வி.ஆர் இயங்குதளத்தால் பயன்படுத்தப்படுவதற்கு முன்பு எங்கள் "
"இடைநிலை முடிவுகளை வழங்க வேண்டிய தீர்மானத்தை வழங்குகிறது."

#: docs/ARVRInterface.xml
msgid ""
"If supported, returns the status of our tracking. This will allow you to "
"provide feedback to the user whether there are issues with positional "
"tracking."
msgstr ""
"ஆதரிக்கப்பட்டால், எங்கள் கண்காணிப்பின் நிலையை வழங்குகிறது. நிலை கண்காணிப்பில் சிக்கல்கள் "
"உள்ளதா என்பது பயனருக்கு கருத்துக்களை வழங்க இது உங்களை அனுமதிக்கும்."

#: docs/ARVRInterface.xml
msgid ""
"Call this to initialize this interface. The first interface that is "
"initialized is identified as the primary interface and it will be used for "
"rendering output.\n"
"After initializing the interface you want to use you then need to enable the "
"AR/VR mode of a viewport and rendering should commence.\n"
"[b]Note:[/b] You must enable the AR/VR mode on the main viewport for any "
"device that uses the main output of Rebel Engine, such as for mobile VR.\n"
"If you do this for a platform that handles its own output (such as OpenVR) "
"Rebel Engine will show just one eye without distortion on screen. "
"Alternatively, you can add a separate viewport node to your scene and enable "
"AR/VR on that viewport. It will be used to output to the HMD, leaving you "
"free to do anything you like in the main window, such as using a separate "
"camera as a spectator camera or rendering something completely different.\n"
"While currently not used, you can activate additional interfaces. You may "
"wish to do this if you want to track controllers from other platforms. "
"However, at this point in time only one interface can render to an HMD."
msgstr ""
"இந்த இடைமுகத்தைத் தொடங்க இதை அழைக்கவும். துவக்கப்பட்ட முதல் இடைமுகம் முதன்மை இடைமுகமாக "
"அடையாளம் காணப்படுகிறது, மேலும் இது வெளியீட்டை வழங்குதல் செய்ய பயன்படுத்தப்படும்.\n"
" நீங்கள் பயன்படுத்த விரும்பும் இடைமுகத்தைத் தொடங்கிய பிறகு, நீங்கள் ஒரு காட்சியகத்தின் AR/VR "
"பயன்முறையை இயக்க வேண்டும் மற்றும் வழங்குதல் தொடங்க வேண்டும்.\n"
" .\n"
" அதன் சொந்த வெளியீட்டைக் கையாளும் ஒரு தளத்திற்காக நீங்கள் இதைச் செய்தால் (ஓபன்.வி.ஆர் "
"போன்றவை) கிளர்ச்சி இயந்திரம் திரையில் விலகல் இல்லாமல் ஒரு கண்ணைக் காண்பிக்கும். மாற்றாக, "
"நீங்கள் உங்கள் காட்சியில் ஒரு தனி காட்சியகம் முனையைச் சேர்த்து, அந்தக் காட்சியில் AR/VR ஐ "
"இயக்கலாம். இது எச்எம்டிக்கு வெளியிட பயன்படுகிறது, முதன்மையான சாளரத்தில் நீங்கள் விரும்பும் "
"எதையும் செய்ய உங்களை விடுவிக்கிறது, அதாவது ஒரு தனி கேமராவை பார்வையாளர் கேமராவாகப் "
"பயன்படுத்துவது அல்லது முற்றிலும் வேறுபட்ட ஒன்றை வழங்குவது.\n"
" தற்போது பயன்படுத்தப்படவில்லை என்றாலும், நீங்கள் கூடுதல் இடைமுகங்களை செயல்படுத்தலாம். மற்ற "
"தளங்களிலிருந்து கட்டுப்படுத்திகளைக் கண்காணிக்க விரும்பினால் இதைச் செய்ய நீங்கள் விரும்பலாம். "
"இருப்பினும், இந்த நேரத்தில் ஒரு இடைமுகம் மட்டுமே ஒரு HMD க்கு வழங்க முடியும்."

#: docs/ARVRInterface.xml
msgid ""
"Returns [code]true[/code] if the current output of this interface is in "
"stereo."
msgstr ""
"இந்த இடைமுகத்தின் தற்போதைய வெளியீடு ச்டீரியோவில் இருந்தால் [குறியீடு] உண்மை [/code] ஐ "
"வழங்குகிறது."

#: docs/ARVRInterface.xml
msgid "Turns the interface off."
msgstr "இடைமுகத்தை அணைக்கிறது."

#: docs/ARVRInterface.xml
msgid "On an AR interface, [code]true[/code] if anchor detection is enabled."
msgstr ""
"AR இடைமுகத்தில், நங்கூரம் கண்டறிதல் இயக்கப்பட்டிருந்தால் [குறியீடு] உண்மை [/குறியீடு]."

#: docs/ARVRInterface.xml
msgid "[code]true[/code] if this interface been initialized."
msgstr "[குறியீடு] உண்மை [/குறியீடு] இந்த இடைமுகம் துவக்கப்பட்டால்."

#: docs/ARVRInterface.xml
msgid "[code]true[/code] if this is the primary interface."
msgstr "[குறியீடு] உண்மை [/குறியீடு] இது முதன்மை இடைமுகமாக இருந்தால்."

#: docs/ARVRInterface.xml
msgid "No ARVR capabilities."
msgstr "ARVR திறன்கள் இல்லை."

#: docs/ARVRInterface.xml
msgid ""
"This interface can work with normal rendering output (non-HMD based AR)."
msgstr ""
"இந்த இடைமுகம் சாதாரண வழங்குதல் வெளியீட்டில் வேலை செய்யலாம் (HMD அல்லாத அடிப்படையிலான "
"AR)."

#: docs/ARVRInterface.xml
msgid "This interface supports stereoscopic rendering."
msgstr "இந்த இடைமுகம் ச்டீரியோச்கோபிக் ரெண்டரிங்கை ஆதரிக்கிறது."

#: docs/ARVRInterface.xml
msgid "This interface supports AR (video background and real world tracking)."
msgstr ""
"இந்த இடைமுகம் AR ஐ ஆதரிக்கிறது (வீடியோ பின்னணி மற்றும் உண்மையான உலக கண்காணிப்பு)."

#: docs/ARVRInterface.xml
msgid ""
"This interface outputs to an external device. If the main viewport is used, "
"the on screen output is an unmodified buffer of either the left or right eye "
"(stretched if the viewport size is not changed to the same aspect ratio of "
"[method get_render_targetsize]). Using a separate viewport node frees up the "
"main viewport for other purposes."
msgstr ""
"இந்த இடைமுகம் வெளிப்புற சாதனத்திற்கு வெளியிடுகிறது. முதன்மையான காட்சியகம் "
"பயன்படுத்தப்பட்டால், ஆன் திரை வெளியீடு இடது அல்லது வலது கண்ணின் மாற்றப்படாத இடையகமாகும் "
"(வியூபோர்ட் அளவு [முறை Get_Render_targetSize] இன் அதே விகிதத்திற்கு "
"மாற்றப்படாவிட்டால் நீட்டப்படுகிறது). ஒரு தனி காட்சியகம் முனையைப் பயன்படுத்துவது பிற "
"நோக்கங்களுக்காக முக்கிய காட்சியை விடுவிக்கிறது."

#: docs/ARVRInterface.xml
msgid ""
"Mono output, this is mostly used internally when retrieving positioning "
"information for our camera node or when stereo scopic rendering is not "
"supported."
msgstr ""
"மோனோ வெளியீடு, எங்கள் கேமரா முனைக்கான பொருத்துதல் தகவல்களை மீட்டெடுக்கும்போது அல்லது "
"ச்டீரியோ ச்கோபிக் வழங்குதல் ஆதரிக்கப்படாதபோது இது பெரும்பாலும் உள்நாட்டில் "
"பயன்படுத்தப்படுகிறது."

#: docs/ARVRInterface.xml
msgid ""
"Left eye output, this is mostly used internally when rendering the image for "
"the left eye and obtaining positioning and projection information."
msgstr ""
"இடது கண் வெளியீடு, இடது கண்ணுக்கு படத்தை வழங்கும்போது மற்றும் பொருத்துதல் மற்றும் திட்ட "
"தகவல்களைப் பெறும்போது இது பெரும்பாலும் உள்நாட்டில் பயன்படுத்தப்படுகிறது."

#: docs/ARVRInterface.xml
msgid ""
"Right eye output, this is mostly used internally when rendering the image "
"for the right eye and obtaining positioning and projection information."
msgstr ""
"வலது கண் வெளியீடு, வலது கண்ணுக்கு படத்தை வழங்கும்போது மற்றும் பொருத்துதல் மற்றும் திட்ட "
"தகவல்களைப் பெறும்போது இது பெரும்பாலும் உள்நாட்டில் பயன்படுத்தப்படுகிறது."

#: docs/ARVRInterface.xml
msgid "Tracking is behaving as expected."
msgstr "கண்காணிப்பு எதிர்பார்த்தபடி நடந்துகொள்கிறது."

#: docs/ARVRInterface.xml
msgid ""
"Tracking is hindered by excessive motion (the player is moving faster than "
"tracking can keep up)."
msgstr ""
"அதிகப்படியான இயக்கத்தால் கண்காணிப்பு தடைபடுகிறது (கண்காணிப்பதை விட வீரர் வேகமாக "
"நகர்கிறார்)."

#: docs/ARVRInterface.xml
msgid ""
"Tracking is hindered by insufficient features, it's too dark (for camera-"
"based tracking), player is blocked, etc."
msgstr ""
"போதிய அம்சங்களால் கண்காணிப்பு தடைபடுகிறது, இது மிகவும் இருண்டது (கேமரா அடிப்படையிலான "
"கண்காணிப்புக்கு), பிளேயர் தடுக்கப்பட்டுள்ளது, முதலியன."

#: docs/ARVRInterface.xml
msgid ""
"We don't know the status of the tracking or this interface does not provide "
"feedback."
msgstr ""
"கண்காணிப்பின் நிலை எங்களுக்குத் தெரியாது அல்லது இந்த இடைமுகம் கருத்துக்களை வழங்காது."

#: docs/ARVRInterface.xml
msgid ""
"Tracking is not functional (camera not plugged in or obscured, lighthouses "
"turned off, etc.)."
msgstr ""
"கண்காணிப்பு செயல்படாது (கேமரா செருகப்படவில்லை அல்லது மறைக்கப்படவில்லை, கலங்கரை "
"விளக்கங்கள் அணைக்கப்பட்டன, முதலியன)."

#: modules/gdnative/docs/ARVRInterfaceGDNative.xml
msgid "GDNative wrapper for an ARVR interface."
msgstr "ARVR இடைமுகத்திற்கான gdnative ரேப்பர்."

#: modules/gdnative/docs/ARVRInterfaceGDNative.xml
msgid ""
"This is a wrapper class for GDNative implementations of the ARVR interface. "
"To use a GDNative ARVR interface, simply instantiate this object and set "
"your GDNative library containing the ARVR interface implementation."
msgstr ""
"ARVR இடைமுகத்தின் Gdnative செயலாக்கங்களுக்கான ரேப்பர் வகுப்பு இது. ஒரு GDNATIVE ARVR "
"இடைமுகத்தைப் பயன்படுத்த, இந்த பொருளை உடனடிப்படுத்தவும், ARVR இடைமுக செயல்படுத்தலைக் "
"கொண்ட உங்கள் Gdnative நூலகத்தை அமைக்கவும்."

#: docs/ARVROrigin.xml
msgid "The origin point in AR/VR."
msgstr "AR/Vr இல் தோற்றம் புள்ளி."

#: docs/ARVROrigin.xml
msgid ""
"This is a special node within the AR/VR system that maps the physical "
"location of the center of our tracking space to the virtual location within "
"our game world.\n"
"There should be only one of these nodes in your scene and you must have one. "
"All the ARVRCamera, ARVRController and ARVRAnchor nodes should be direct "
"children of this node for spatial tracking to work correctly.\n"
"It is the position of this node that you update when your character needs to "
"move through your game world while we're not moving in the real world. "
"Movement in the real world is always in relation to this origin point.\n"
"For example, if your character is driving a car, the ARVROrigin node should "
"be a child node of this car. Or, if you're implementing a teleport system to "
"move your character, you should change the position of this node."
msgstr ""
"இது AR/VR அமைப்பினுள் ஒரு சிறப்பு முனை, இது எங்கள் கண்காணிப்பு இடத்தின் மையத்தின் "
"இயற்பியல் இருப்பிடத்தை எங்கள் விளையாட்டு உலகில் உள்ள மெய்நிகர் இருப்பிடத்திற்கு "
"வரைபடமாக்குகிறது.\n"
" உங்கள் காட்சியில் இந்த முனைகளில் ஒன்று மட்டுமே இருக்க வேண்டும், உங்களிடம் ஒன்று இருக்க "
"வேண்டும். அனைத்து ARVRCAMERA, ARVRController மற்றும் Arvranchor Nodes இந்த முனையின் "
"நேரடி குழந்தைகளாக இருக்க வேண்டும்.\n"
" இந்த முனையின் நிலைதான், உங்கள் கதாபாத்திரம் உங்கள் விளையாட்டு உலகில் செல்ல "
"வேண்டியிருக்கும் போது நீங்கள் நிச உலகில் நகரவில்லை. உண்மையான உலகில் இயக்கம் எப்போதும் இந்த "
"தோற்ற புள்ளியுடன் தொடர்புடையது.\n"
" எடுத்துக்காட்டாக, உங்கள் கதாபாத்திரம் ஒரு காரை ஓட்டினால், அர்வ்ரோரிசின் முனை இந்த காரின் "
"குழந்தை முனையாக இருக்க வேண்டும். அல்லது, உங்கள் பாத்திரத்தை நகர்த்துவதற்கு நீங்கள் ஒரு "
"டெலிபோர்ட் அமைப்பை செயல்படுத்துகிறீர்கள் என்றால், இந்த முனையின் நிலையை மாற்ற வேண்டும்."

#: docs/ARVROrigin.xml
msgid ""
"Allows you to adjust the scale to your game's units. Most AR/VR platforms "
"assume a scale of 1 game world unit = 1 real world meter.\n"
"[b]Note:[/b] This method is a passthrough to the [ARVRServer] itself."
msgstr ""
"உங்கள் விளையாட்டின் அலகுகளுக்கு அளவை சரிசெய்ய உங்களை அனுமதிக்கிறது. பெரும்பாலான AR/VR "
"தளங்கள் 1 விளையாட்டு உலக அலகு = 1 உண்மையான உலக மீட்டரின் அளவைக் கருதுகின்றன.\n"
" [b] குறிப்பு: [/b] இந்த முறை [arvrserver] க்கு ஒரு பாச்ட்ரூ."

#: docs/ARVRPositionalTracker.xml
msgid "A tracked object."
msgstr "கண்காணிக்கப்பட்ட பொருள்."

#: docs/ARVRPositionalTracker.xml
msgid ""
"An instance of this object represents a device that is tracked, such as a "
"controller or anchor point. HMDs aren't represented here as they are handled "
"internally.\n"
"As controllers are turned on and the AR/VR interface detects them, instances "
"of this object are automatically added to this list of active tracking "
"objects accessible through the [ARVRServer].\n"
"The [ARVRController] and [ARVRAnchor] both consume objects of this type and "
"should be used in your project. The positional trackers are just under-the-"
"hood objects that make this all work. These are mostly exposed so that "
"GDNative-based interfaces can interact with them."
msgstr ""
"இந்த பொருளின் ஒரு எடுத்துக்காட்டு கட்டுப்படுத்தி அல்லது நங்கூர புள்ளி போன்ற கண்காணிக்கப்பட்ட "
"சாதனத்தைக் குறிக்கிறது. உள்நாட்டில் கையாளப்படுவதால் HMD கள் இங்கு குறிப்பிடப்படவில்லை.\n"
" கட்டுப்படுத்திகள் இயக்கப்பட்டிருப்பதால், AR/VR இடைமுகம் அவற்றைக் கண்டறிந்தால், இந்த பொருளின் "
"நிகழ்வுகள் தானாகவே [Arvrserver] மூலம் அணுகக்கூடிய செயலில் கண்காணிப்பு பொருள்களின் "
"பட்டியலில் சேர்க்கப்படுகின்றன.\n"
" [Arvrcontroller] மற்றும் [arvranchor] இரண்டும் இந்த வகை பொருள்களைப் "
"பயன்படுத்துகின்றன, மேலும் அவை உங்கள் திட்டத்தில் பயன்படுத்தப்பட வேண்டும். நிலை "
"கண்காணிப்பாளர்கள் இதையெல்லாம் வேலை செய்யும் கீழ்-ஊட் பொருள்கள். இவை பெரும்பாலும் "
"அம்பலப்படுத்தப்படுகின்றன, இதனால் சி.டி.நேடிவ் அடிப்படையிலான இடைமுகங்கள் அவற்றுடன் தொடர்பு "
"கொள்ள முடியும்."

#: docs/ARVRPositionalTracker.xml
msgid ""
"Returns the hand holding this tracker, if known. See [enum TrackerHand] "
"constants."
msgstr ""
"தெரிந்தால், இந்த டிராக்கரை வைத்திருக்கும் கையை வழங்குகிறது. [Enum trackerhand] "
"மாறிலிகளைக் காண்க."

#: docs/ARVRPositionalTracker.xml
msgid ""
"If this is a controller that is being tracked, the controller will also be "
"represented by a joystick entry with this ID."
msgstr ""
"இது கண்காணிக்கப்படும் ஒரு கட்டுப்படுத்தியாக இருந்தால், இந்த ஐடியுடன் சாய்ச்டிக் நுழைவு "
"மூலம் கட்டுப்படுத்தி குறிப்பிடப்படும்."

#: docs/ARVRPositionalTracker.xml
msgid ""
"Returns the mesh related to a controller or anchor point if one is available."
msgstr "ஒன்று கிடைத்தால் கட்டுப்படுத்தி அல்லது நங்கூர புள்ளி தொடர்பான கண்ணி வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns the controller or anchor point's name if available."
msgstr "கிடைத்தால் கட்டுப்படுத்தி அல்லது நங்கூரம் புள்ளியின் பெயரை வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns the controller's orientation matrix."
msgstr "கட்டுப்படுத்தியின் நோக்குநிலை மேட்ரிக்சை வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns the world-space controller position."
msgstr "உலக-விண்வெளி கட்டுப்படுத்தி நிலையை வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid ""
"Returns the internal tracker ID. This uniquely identifies the tracker per "
"tracker type and matches the ID you need to specify for nodes such as the "
"[ARVRController] and [ARVRAnchor] nodes."
msgstr ""
"உள் டிராக்கர் ஐடியை வழங்குகிறது. இது டிராக்கர் வகைக்கு டிராக்கரை தனித்துவமாக அடையாளம் "
"காட்டுகிறது மற்றும் [ArvrController] மற்றும் [Arvranchor] முனைகள் போன்ற முனைகளுக்கு "
"நீங்கள் குறிப்பிட வேண்டிய ஐடியுடன் பொருந்துகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns [code]true[/code] if this device tracks orientation."
msgstr ""
"இந்த சாதனம் நோக்குநிலையைக் கண்காணித்தால் [குறியீடு] உண்மை [/குறியீடு] ஐ வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns [code]true[/code] if this device tracks position."
msgstr "இந்த சாதனம் நிலையை கண்காணித்தால் [குறியீடு] உண்மை [/குறியீடு] ஐ வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns the transform combining this device's orientation and position."
msgstr "இந்த சாதனத்தின் நோக்குநிலை மற்றும் நிலையை இணைக்கும் உருமாற்றத்தை வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid "Returns the tracker's type."
msgstr "டிராக்கரின் வகையை வழங்குகிறது."

#: docs/ARVRPositionalTracker.xml
msgid ""
"The degree to which the tracker rumbles. Ranges from [code]0.0[/code] to "
"[code]1.0[/code] with precision [code].01[/code]."
msgstr ""
"டிராக்கர் எந்த அளவிற்கு ஒலிக்கிறது. [குறியீடு] 0.0 [/குறியீடு] முதல் [குறியீடு] 1.0 [/"
"குறியீடு] வரை துல்லியமான [குறியீடு] .01 [/குறியீடு] வரை வரம்புகள்."

#: docs/ARVRPositionalTracker.xml
msgid "The hand this tracker is held in is unknown or not applicable."
msgstr "இந்த டிராக்கர் வைத்திருக்கும் கை தெரியவில்லை அல்லது பொருந்தாது."

#: docs/ARVRPositionalTracker.xml
msgid "This tracker is the left hand controller."
msgstr "இந்த டிராக்கர் இடது கை கட்டுப்படுத்தி."

#: docs/ARVRPositionalTracker.xml
msgid "This tracker is the right hand controller."
msgstr "இந்த டிராக்கர் வலது கை கட்டுப்படுத்தி."

#: docs/ARVRServer.xml
msgid "Server for AR and VR features."
msgstr "AR மற்றும் VR அம்சங்களுக்கான சேவையகம்."

#: docs/ARVRServer.xml
msgid ""
"The AR/VR server is the heart of our Advanced and Virtual Reality solution "
"and handles all the processing."
msgstr ""
"AR/VR சேவையகம் எங்கள் மேம்பட்ட மற்றும் மெய்நிகர் ரியாலிட்டி தீர்வின் இதயம் மற்றும் அனைத்து "
"செயலாக்கங்களையும் கையாளுகிறது."

#: docs/ARVRServer.xml
msgid "Registers an [ARVRInterface] object."
msgstr "[Arvrinterface] பொருளைப் பதிவுசெய்கிறது."

#: docs/ARVRServer.xml
msgid ""
"Registers a new [ARVRPositionalTracker] that tracks a spatial location in "
"real space."
msgstr ""
"உண்மையான இடத்தில் இடஞ்சார்ந்த இடத்தைக் கண்காணிக்கும் புதிய [ARV நிலை டிராக்கரை] பதிவு "
"செய்யுங்கள்."

#: docs/ARVRServer.xml
msgid ""
"This is an important function to understand correctly. AR and VR platforms "
"all handle positioning slightly differently.\n"
"For platforms that do not offer spatial tracking, our origin point (0,0,0) "
"is the location of our HMD, but you have little control over the direction "
"the player is facing in the real world.\n"
"For platforms that do offer spatial tracking, our origin point depends very "
"much on the system. For OpenVR, our origin point is usually the center of "
"the tracking space, on the ground. For other platforms, it's often the "
"location of the tracking camera.\n"
"This method allows you to center your tracker on the location of the HMD. It "
"will take the current location of the HMD and use that to adjust all your "
"tracking data; in essence, realigning the real world to your player's "
"current position in the game world.\n"
"For this method to produce usable results, tracking information must be "
"available. This often takes a few frames after starting your game.\n"
"You should call this method after a few seconds have passed. For instance, "
"when the user requests a realignment of the display holding a designated "
"button on a controller for a short period of time, or when implementing a "
"teleport mechanism."
msgstr ""
"சரியாக புரிந்து கொள்ள இது ஒரு முக்கியமான செயல்பாடு. AR மற்றும் VR இயங்குதளங்கள் "
"அனைத்தும் சற்று வித்தியாசமாக நிலைநிறுத்துவதை கையாளுகின்றன.\n"
" இடஞ்சார்ந்த கண்காணிப்பை வழங்காத தளங்களுக்கு, எங்கள் ஆரிசின் பாயிண்ட் (0,0,0) எங்கள் "
"எச்எம்டியின் இருப்பிடமாகும், ஆனால் உண்மையான உலகில் வீரர் எதிர்கொள்ளும் திசையில் உங்களுக்கு "
"சிறிய கட்டுப்பாடு இல்லை.\n"
" இடஞ்சார்ந்த கண்காணிப்பை வழங்கும் தளங்களுக்கு, எங்கள் தோற்றம் புள்ளி கணினியைப் பொறுத்தது. "
"OpenVr ஐப் பொறுத்தவரை, எங்கள் தோற்றம் புள்ளி பொதுவாக தரையில் கண்காணிப்பு இடத்தின் மையமாக "
"இருக்கும். மற்ற தளங்களுக்கு, இது பெரும்பாலும் கண்காணிப்பு கேமராவின் இருப்பிடமாகும்.\n"
" இந்த முறை உங்கள் டிராக்கரை HMD இன் இருப்பிடத்தில் மையப்படுத்த உங்களை அனுமதிக்கிறது. இது "
"HMD இன் தற்போதைய இருப்பிடத்தை எடுத்து, உங்கள் கண்காணிப்பு தரவு அனைத்தையும் சரிசெய்ய அதைப் "
"பயன்படுத்தும்; சாராம்சத்தில், விளையாட்டு உலகில் உங்கள் வீரரின் தற்போதைய நிலைக்கு உண்மையான "
"உலகத்தை மாற்றியமைத்தல்.\n"
" பயன்படுத்தக்கூடிய முடிவுகளை உருவாக்க இந்த முறை, கண்காணிப்பு செய்தி கிடைக்க வேண்டும். "
"இது உங்கள் விளையாட்டைத் தொடங்கிய பிறகு பெரும்பாலும் சில பிரேம்களை எடுக்கும்.\n"
" சில நொடிகள் கடந்துவிட்ட பிறகு இந்த முறையை நீங்கள் அழைக்க வேண்டும். உதாரணமாக, ஒரு "
"கட்டுப்படுத்தி மீது ஒரு குறுகிய காலத்திற்கு நியமிக்கப்பட்ட பொத்தானை வைத்திருக்கும் "
"காட்சியின் மறுசீரமைப்பை பயனர் கோரும்போது அல்லது டெலிபோர்ட் பொறிமுறையை செயல்படுத்தும்போது."

#: docs/ARVRServer.xml
msgid ""
"Clears our current primary interface if it is set to the provided interface."
msgstr ""
"வழங்கப்பட்ட இடைமுகத்திற்கு அமைக்கப்பட்டால் எங்கள் தற்போதைய முதன்மை இடைமுகத்தை அழிக்கிறது."

#: docs/ARVRServer.xml
msgid ""
"Finds an interface by its name. For instance, if your project uses "
"capabilities of an AR/VR platform, you can find the interface for that "
"platform by name and initialize it."
msgstr ""
"அதன் பெயரில் ஒரு இடைமுகத்தைக் காண்கிறது. உதாரணமாக, உங்கள் திட்டம் AR/VR தளத்தின் "
"திறன்களைப் பயன்படுத்தினால், அந்த தளத்திற்கான இடைமுகத்தை பெயரால் கண்டுபிடித்து அதைத் "
"தொடங்கலாம்."

#: docs/ARVRServer.xml
msgid "Returns the primary interface's transformation."
msgstr "முதன்மை இடைமுகத்தின் மாற்றத்தை வழங்குகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the interface registered at a given index in our list of interfaces."
msgstr ""
"எங்கள் இடைமுகங்களின் பட்டியலில் கொடுக்கப்பட்ட குறியீட்டில் பதிவுசெய்யப்பட்ட இடைமுகத்தை "
"வழங்குகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the number of interfaces currently registered with the AR/VR server. "
"If your project supports multiple AR/VR platforms, you can look through the "
"available interface, and either present the user with a selection or simply "
"try to initialize each interface and use the first one that returns "
"[code]true[/code]."
msgstr ""
"தற்போது AR/VR சேவையகத்தில் பதிவு செய்யப்பட்டுள்ள இடைமுகங்களின் எண்ணிக்கையை வழங்குகிறது. "
"உங்கள் திட்டம் பல AR/VR இயங்குதளங்களை ஆதரித்தால், நீங்கள் கிடைக்கக்கூடிய இடைமுகத்தைப் "
"பார்க்கலாம், மேலும் பயனரை ஒரு தேர்வோடு வழங்கலாம் அல்லது ஒவ்வொரு இடைமுகத்தையும் துவக்க "
"முயற்சிக்கவும், [குறியீடு] உண்மை [/குறியீடு] ஐத் தரும் முதல் ஒன்றைப் பயன்படுத்தவும்."

#: docs/ARVRServer.xml
msgid ""
"Returns a list of available interfaces the ID and name of each interface."
msgstr ""
"கிடைக்கக்கூடிய இடைமுகங்களின் பட்டியலை ஒவ்வொரு இடைமுகத்தின் ஐடி மற்றும் பெயரின் பட்டியலை "
"வழங்குகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the absolute timestamp (in μs) of the last [ARVRServer] commit of "
"the AR/VR eyes to [VisualServer]. The value comes from an internal call to "
"[method OS.get_ticks_usec]."
msgstr ""
"AR/Vr கண்களின் கடைசி [Arvrserver] இன் முழுமையான நேர முத்திரையை [VisionServer] "
"க்கு வழங்குகிறது. மதிப்பு [முறை OS.GET_TICKS_USEC] க்கு உள் அழைப்பிலிருந்து "
"வருகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the duration (in μs) of the last frame. This is computed as the "
"difference between [method get_last_commit_usec] and [method "
"get_last_process_usec] when committing."
msgstr ""
"கடைசி சட்டகத்தின் காலத்தை (μS இல்) வழங்குகிறது. இது [முறை get_last_commit_usec] "
"மற்றும் [முறை get_last_process_usec] ஆகியவற்றுக்கு இடையிலான வித்தியாசமாக "
"கணக்கிடப்படுகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the absolute timestamp (in μs) of the last [ARVRServer] process "
"callback. The value comes from an internal call to [method "
"OS.get_ticks_usec]."
msgstr ""
"கடைசி [Arvrserver] செயல்முறை கால்பேக்கின் முழுமையான நேர முத்திரையை (μS இல்) "
"வழங்குகிறது. மதிப்பு [முறை OS.GET_TICKS_USEC] க்கு உள் அழைப்பிலிருந்து வருகிறது."

#: docs/ARVRServer.xml
msgid ""
"Returns the reference frame transform. Mostly used internally and exposed "
"for GDNative build interfaces."
msgstr ""
"குறிப்பு பிரேம் உருமாற்றத்தை வழங்குகிறது. பெரும்பாலும் உள்நாட்டில் பயன்படுத்தப்படுகிறது "
"மற்றும் சி.டி.நேடிவ் உருவாக்க இடைமுகங்களுக்கு அம்பலப்படுத்தப்படுகிறது."

#: docs/ARVRServer.xml
msgid "Returns the positional tracker at the given ID."
msgstr "கொடுக்கப்பட்ட ஐடியில் நிலை டிராக்கரை வழங்குகிறது."

#: docs/ARVRServer.xml
msgid "Returns the number of trackers currently registered."
msgstr "தற்போது பதிவுசெய்யப்பட்ட டிராக்கர்களின் எண்ணிக்கையை வழங்குகிறது."

#: docs/ARVRServer.xml
msgid "Removes this interface."
msgstr "இந்த இடைமுகத்தை நீக்குகிறது."

#: docs/ARVRServer.xml
msgid "Removes this positional tracker."
msgstr "இந்த நிலை டிராக்கரை அகற்று."

#: docs/ARVRServer.xml
msgid "The primary [ARVRInterface] currently bound to the [ARVRServer]."
msgstr "முதன்மை [ARVRINTERFACE] தற்போது [arvrserver] உடன் பிணைக்கப்பட்டுள்ளது."

#: docs/ARVRServer.xml
msgid ""
"Allows you to adjust the scale to your game's units. Most AR/VR platforms "
"assume a scale of 1 game world unit = 1 real world meter."
msgstr ""
"உங்கள் விளையாட்டின் அலகுகளுக்கு அளவை சரிசெய்ய உங்களை அனுமதிக்கிறது. பெரும்பாலான AR/VR "
"தளங்கள் 1 விளையாட்டு உலக அலகு = 1 உண்மையான உலக மீட்டரின் அளவைக் கருதுகின்றன."

#: docs/ARVRServer.xml
msgid "Emitted when a new interface has been added."
msgstr "ஒரு புதிய இடைமுகம் சேர்க்கப்படும்போது உமிழப்படும்."

#: docs/ARVRServer.xml
msgid "Emitted when an interface is removed."
msgstr "ஒரு இடைமுகம் அகற்றப்படும் போது உமிழப்படும்."

#: docs/ARVRServer.xml
msgid ""
"Emitted when a new tracker has been added. If you don't use a fixed number "
"of controllers or if you're using [ARVRAnchor]s for an AR solution, it is "
"important to react to this signal to add the appropriate [ARVRController] or "
"[ARVRAnchor] nodes related to this new tracker."
msgstr ""
"ஒரு புதிய டிராக்கர் சேர்க்கப்பட்டால் உமிழப்படும். நீங்கள் ஒரு நிலையான எண்ணிக்கையிலான "
"கட்டுப்படுத்திகளைப் பயன்படுத்தவில்லை என்றால் அல்லது நீங்கள் AR தீர்வுக்காக [Arvranchor] ஐப் "
"பயன்படுத்துகிறீர்கள் என்றால், இந்த புதிய டிராக்கருடன் தொடர்புடைய பொருத்தமான "
"[ARVRController] அல்லது [Arvranchor] முனைகளைச் சேர்க்க இந்த சமிக்ஞைக்கு "
"எதிர்வினையாற்றுவது முதன்மை."

#: docs/ARVRServer.xml
msgid ""
"Emitted when a tracker is removed. You should remove any [ARVRController] or "
"[ARVRAnchor] points if applicable. This is not mandatory, the nodes simply "
"become inactive and will be made active again when a new tracker becomes "
"available (i.e. a new controller is switched on that takes the place of the "
"previous one)."
msgstr ""
"ஒரு டிராக்கர் அகற்றப்படும் போது உமிழப்படும். பொருந்தினால் நீங்கள் [ARVRController] அல்லது "
"[Arvranchor] புள்ளிகளை அகற்ற வேண்டும். இது கட்டாயமில்லை, முனைகள் வெறுமனே செயலற்றதாக "
"மாறும், மேலும் ஒரு புதிய டிராக்கர் கிடைக்கும்போது மீண்டும் செயலில் இருக்கும் (அதாவது ஒரு "
"புதிய கட்டுப்படுத்தி மாற்றப்படுகிறது, அது முந்தைய இடத்தைப் பிடிக்கும்)."

#: docs/ARVRServer.xml
msgid "The tracker tracks the location of a controller."
msgstr "டிராக்கர் ஒரு கட்டுப்படுத்தியின் இருப்பிடத்தைக் கண்காணிக்கிறது."

#: docs/ARVRServer.xml
msgid "The tracker tracks the location of a base station."
msgstr "டிராக்கர் ஒரு அடிப்படை நிலையத்தின் இருப்பிடத்தைக் கண்காணிக்கிறது."

#: docs/ARVRServer.xml
msgid "The tracker tracks the location and size of an AR anchor."
msgstr "டிராக்கர் ஒரு AR நங்கூரத்தின் இருப்பிடம் மற்றும் அளவைக் கண்காணிக்கிறது."

#: docs/ARVRServer.xml
msgid "Used internally to filter trackers of any known type."
msgstr ""
"அறியப்பட்ட எந்தவொரு வகையிலும் டிராக்கர்களை வடிகட்ட உள்நாட்டில் பயன்படுத்தப்படுகிறது."

#: docs/ARVRServer.xml
msgid "Used internally if we haven't set the tracker type yet."
msgstr "நாங்கள் இன்னும் டிராக்கர் வகையை அமைக்கவில்லை என்றால் உள்நாட்டில் பயன்படுத்தப்படுகிறது."

#: docs/ARVRServer.xml
msgid "Used internally to select all trackers."
msgstr "அனைத்து டிராக்கர்களையும் தேர்ந்தெடுக்க உள்நாட்டில் பயன்படுத்தப்பட்டது."

#: docs/ARVRServer.xml
msgid ""
"Fully reset the orientation of the HMD. Regardless of what direction the "
"user is looking to in the real world. The user will look dead ahead in the "
"virtual world."
msgstr ""
"HMD இன் நோக்குநிலையை முழுமையாக மீட்டமைக்கவும். உண்மையான உலகில் பயனர் எந்த திசையை "
"எதிர்பார்க்கிறார் என்பதைப் பொருட்படுத்தாமல். மெய்நிகர் உலகில் பயனர் இறந்து போவார்."

#: docs/ARVRServer.xml
msgid ""
"Resets the orientation but keeps the tilt of the device. So if we're looking "
"down, we keep looking down but heading will be reset."
msgstr ""
"நோக்குநிலையை மீட்டமைக்கிறது, ஆனால் சாதனத்தின் சாய்வை வைத்திருக்கிறது. எனவே நாங்கள் கீழே "
"பார்க்கிறோம் என்றால், நாங்கள் கீழே பார்த்துக் கொண்டிருக்கிறோம், ஆனால் தலைப்பு மீட்டமைக்கப்படும்."

#: docs/ARVRServer.xml
msgid ""
"Does not reset the orientation of the HMD, only the position of the player "
"gets centered."
msgstr "HMD இன் நோக்குநிலையை மீட்டமைக்காது, வீரரின் நிலை மட்டுமே மையமாகிறது."

#: docs/AspectRatioContainer.xml
msgid "Container that preserves its child controls' aspect ratio."
msgstr "அதன் குழந்தை கட்டுப்பாட்டு விகித விகிதத்தை பாதுகாக்கும் கொள்கலன்."

#: docs/AspectRatioContainer.xml
msgid ""
"Arranges child controls in a way to preserve their aspect ratio "
"automatically whenever the container is resized. Solves the problem where "
"the container size is dynamic and the contents' size needs to adjust "
"accordingly without losing proportions."
msgstr ""
"கொள்கலன் மறுஅளவாக்கப்படும்போதெல்லாம் குழந்தை கட்டுப்பாடுகளை அவற்றின் விகித விகிதத்தை "
"தானாகவே பாதுகாக்க ஒரு வழியில் ஏற்பாடு செய்கிறது. கொள்கலன் அளவு மாறும் மற்றும் "
"உள்ளடக்கங்களின் அளவு விகிதாச்சாரத்தை இழக்காமல் அதற்கேற்ப சரிசெய்ய வேண்டும்."

#: docs/AspectRatioContainer.xml
msgid "Specifies the horizontal relative position of child controls."
msgstr "குழந்தை கட்டுப்பாடுகளின் கிடைமட்ட உறவினர் நிலையை குறிப்பிடுகிறது."

#: docs/AspectRatioContainer.xml
msgid "Specifies the vertical relative position of child controls."
msgstr "குழந்தை கட்டுப்பாடுகளின் செங்குத்து உறவினர் நிலையைக் குறிப்பிடுகிறது."

#: docs/AspectRatioContainer.xml
msgid ""
"The aspect ratio to enforce on child controls. This is the width divided by "
"the height. The ratio depends on the [member stretch_mode]."
msgstr ""
"குழந்தை கட்டுப்பாடுகளை செயல்படுத்துவதற்கான விகித விகிதம். இது உயரத்தால் வகுக்கப்பட்ட "
"அகலம். விகிதம் [உறுப்பினர் நீட்டிப்பு_மோட்] ஐப் பொறுத்தது."

#: docs/AspectRatioContainer.xml
msgid "The stretch mode used to align child controls."
msgstr "குழந்தை கட்டுப்பாடுகளை சீரமைக்க பயன்படுத்தப்படும் நீட்சி பயன்முறை."

#: docs/AspectRatioContainer.xml
msgid ""
"The height of child controls is automatically adjusted based on the width of "
"the container."
msgstr ""
"கொள்கலனின் அகலத்தின் அடிப்படையில் குழந்தை கட்டுப்பாடுகளின் உயரம் தானாகவே "
"சரிசெய்யப்படுகிறது."

#: docs/AspectRatioContainer.xml
msgid ""
"The width of child controls is automatically adjusted based on the height of "
"the container."
msgstr ""
"கொள்கலனின் உயரத்தின் அடிப்படையில் குழந்தை கட்டுப்பாடுகளின் அகலம் தானாகவே "
"சரிசெய்யப்படுகிறது."

#: docs/AspectRatioContainer.xml
msgid ""
"The bounding rectangle of child controls is automatically adjusted to fit "
"inside the container while keeping the aspect ratio."
msgstr ""
"குழந்தைக் கட்டுப்பாடுகளின் எல்லை செவ்வகம் தானாகவே கொள்கலனுக்குள் பொருந்தும் வகையில் "
"சரிசெய்யப்படுகிறது, அதே நேரத்தில் விகித விகிதத்தை வைத்திருக்கும்."

#: docs/AspectRatioContainer.xml
msgid ""
"The width and height of child controls is automatically adjusted to make "
"their bounding rectangle cover the entire area of the container while "
"keeping the aspect ratio.\n"
"When the bounding rectangle of child controls exceed the container's size "
"and [member Control.rect_clip_content] is enabled, this allows to show only "
"the container's area restricted by its own bounding rectangle."
msgstr ""
"குழந்தைக் கட்டுப்பாடுகளின் அகலம் மற்றும் உயரம் தானாகவே சரிசெய்யப்பட்டு, அவற்றின் எல்லை "
"செவ்வகத்தை கொள்கலனின் முழுப் பகுதியையும் மறைக்கும்போது விகித விகிதத்தை வைத்திருக்கும்.\n"
" குழந்தைக் கட்டுப்பாடுகளின் கட்டுப்பாட்டு செவ்வகம் கொள்கலனின் அளவு மற்றும் [உறுப்பினர் "
"கட்டுப்பாடு. Rect_clip_content] இயக்கப்பட்டிருக்கும்போது, இது கொள்கலனின் பகுதியை அதன் "
"சொந்த எல்லை செவ்வகத்தால் கட்டுப்படுத்தப்பட்டுள்ளதைக் காட்ட அனுமதிக்கிறது."

#: docs/AspectRatioContainer.xml
msgid ""
"Aligns child controls with the beginning (left or top) of the container."
msgstr "கொள்கலனின் தொடக்க (இடது அல்லது மேல்) உடன் குழந்தை கட்டுப்பாடுகளை சீரமைக்கிறது."

#: docs/AspectRatioContainer.xml
msgid "Aligns child controls with the center of the container."
msgstr "குழந்தை கட்டுப்பாடுகளை கொள்கலனின் மையத்துடன் சீரமைக்கிறது."

#: docs/AspectRatioContainer.xml
msgid "Aligns child controls with the end (right or bottom) of the container."
msgstr "கொள்கலனின் இறுதி (வலது அல்லது கீழ்) உடன் குழந்தை கட்டுப்பாடுகளை சீரமைக்கிறது."

#: docs/AStar.xml
msgid ""
"An implementation of A* to find the shortest paths among connected points in "
"space."
msgstr ""
"விண்வெளியில் இணைக்கப்பட்ட புள்ளிகளில் குறுகிய பாதைகளைக் கண்டறிய A* இன் செயல்படுத்தல்."

#: docs/AStar.xml
msgid ""
"A* (A star) is a computer algorithm that is widely used in pathfinding and "
"graph traversal, the process of plotting short paths among vertices "
"(points), passing through a given set of edges (segments). It enjoys "
"widespread use due to its performance and accuracy. Rebel Engine's A* "
"implementation uses points in three-dimensional space and Euclidean "
"distances by default.\n"
"You must add points manually with [method add_point] and create segments "
"manually with [method connect_points]. Then you can test if there is a path "
"between two points with the [method are_points_connected] function, get a "
"path containing indices by [method get_id_path], or one containing actual "
"coordinates with [method get_point_path].\n"
"It is also possible to use non-Euclidean distances. To do so, create a class "
"that extends [code]AStar[/code] and override methods [method _compute_cost] "
"and [method _estimate_cost]. Both take two indices and return a length, as "
"is shown in the following example.\n"
"[codeblock]\n"
"class MyAStar:\n"
"    extends AStar\n"
"\n"
"    func _compute_cost(u, v):\n"
"        return abs(u - v)\n"
"\n"
"    func _estimate_cost(u, v):\n"
"        return min(0, abs(u - v) - 1)\n"
"[/codeblock]\n"
"[method _estimate_cost] should return a lower bound of the distance, i.e. "
"[code]_estimate_cost(u, v) <= _compute_cost(u, v)[/code]. This serves as a "
"hint to the algorithm because the custom [code]_compute_cost[/code] might be "
"computation-heavy. If this is not the case, make [method _estimate_cost] "
"return the same value as [method _compute_cost] to provide the algorithm "
"with the most accurate information.\n"
"If the default [method _estimate_cost] and [method _compute_cost] methods "
"are used, or if the supplied [method _estimate_cost] method returns a lower "
"bound of the cost, then the paths returned by A* will be the lowest-cost "
"paths. Here, the cost of a path equals the sum of the [method _compute_cost] "
"results of all segments in the path multiplied by the [code]weight_scale[/"
"code]s of the endpoints of the respective segments. If the default methods "
"are used and the [code]weight_scale[/code]s of all points are set to "
"[code]1.0[/code], then this equals the sum of Euclidean distances of all "
"segments in the path."
msgstr ""
"A* (ஒரு நட்சத்திரம்) என்பது ஒரு கணினி வழிமுறையாகும், இது பாத்ஃபைண்டிங் மற்றும் வரைபட "
"பயணத்தில் பரவலாகப் பயன்படுத்தப்படுகிறது, இது செங்குத்துகள் (புள்ளிகள்) மத்தியில் குறுகிய "
"பாதைகளைத் திட்டமிடும் செயல்முறையாகும், இது ஒரு குறிப்பிட்ட விளிம்புகள் (பிரிவுகள்) "
"வழியாக செல்கிறது. அதன் செயல்திறன் மற்றும் துல்லியம் காரணமாக இது பரவலான பயன்பாட்டை "
"அனுபவிக்கிறது. கிளர்ச்சி இயந்திரத்தின் A* செயல்படுத்தல் முன்னிருப்பாக முப்பரிமாண "
"இடத்திலும் யூக்ளிடியன் தூரங்களிலும் புள்ளிகளைப் பயன்படுத்துகிறது.\n"
" நீங்கள் [முறை ADD_POINT] உடன் கைமுறையாக புள்ளிகளைச் சேர்க்க வேண்டும் மற்றும் [முறை "
"இணைப்பு_ புள்ளிகள்] உடன் பிரிவுகளை கைமுறையாக உருவாக்க வேண்டும். [முறை "
"you_points_connected] செயல்பாட்டுடன் இரண்டு புள்ளிகளுக்கு இடையில் ஒரு பாதை இருந்தால் "
"நீங்கள் சோதிக்கலாம், [முறை Get_id_path] ஆல் குறியீடுகளைக் கொண்ட பாதையைப் பெறுங்கள், "
"அல்லது [முறை get_point_path] உடன் உண்மையான ஆயத்தொகுப்புகளைக் கொண்ட ஒன்றைப் பெறுங்கள்.\n"
" யூக்ளிடியன் அல்லாத தூரங்களைப் பயன்படுத்தவும் முடியும். அவ்வாறு செய்ய, [குறியீடு] ASTAR "
"[/code] மற்றும் முறைகளை மீறும் ஒரு வகுப்பை உருவாக்கவும் [முறை _compute_cost] மற்றும் "
"[முறை _estimate_cost]. இருவரும் இரண்டு குறியீடுகளை எடுத்து ஒரு நீளத்தைத் திருப்பித் "
"தருகிறார்கள், பின்வரும் எடுத்துக்காட்டில் காட்டப்பட்டுள்ளபடி.\n"
" [கோட் பிளாக்]\n"
" வகுப்பு மச்டார்:\n"
" அச்டார் நீட்டிக்கிறது\n"
"\n"
" func _compute_cost (u, v):\n"
" ABS (U - V) திரும்பவும்\n"
"\n"
" func _estimate_cost (u, v):\n"
" திரும்பும் மணித்துளி (0, ஏபிஎச் (யு - வி) - 1)\n"
" [/codeBlock]\n"
" . இது வழிமுறையின் குறிப்பாக செயல்படுகிறது, ஏனெனில் தனிப்பயன் [குறியீடு] "
"_COMPUTE_COST [/குறியீடு] கணக்கீடு-கனமானதாக இருக்கலாம். இது அவ்வாறு இல்லையென்றால், "
"[முறை _estimate_cost] [முறை _compute_cost] இன் அதே மதிப்பைத் திருப்பி விடுங்கள்.\n"
" இயல்புநிலை [முறை _estimate_cost] மற்றும் [முறை _compute_cost] முறைகள் "
"பயன்படுத்தப்பட்டால், அல்லது வழங்கப்பட்ட [முறை _estimate_cost] முறை செலவின் குறைந்த "
"வரம்பைத் தரும் என்றால், A* திரும்பிய பாதைகள் மிகக் குறைந்த விலை பாதைகளாக இருக்கும். "
"இங்கே, ஒரு பாதையின் விலை அந்தந்த பிரிவுகளின் இறுதிப் புள்ளிகளின் [குறியீடு] எடை_ "
"அளவிலான [/குறியீடு] கள் மூலம் பெருக்கப்படும் பாதையில் உள்ள அனைத்து பிரிவுகளின் [முறை "
"_compute_cost] முடிவுகளின் கூட்டுத்தொகைக்கு சமம். இயல்புநிலை முறைகள் பயன்படுத்தப்பட்டு, "
"[குறியீடு] அனைத்து புள்ளிகளிலும் [குறியீடு] 1.0 [/குறியீடு] என அமைக்கப்பட்டால், இது "
"பாதையில் உள்ள அனைத்து பிரிவுகளின் யூக்ளிடியன் தூரங்களின் தொகையை சமப்படுத்துகிறது."

#: docs/AStar.xml
msgid ""
"Called when computing the cost between two connected points.\n"
"Note that this function is hidden in the default [code]AStar[/code] class."
msgstr ""
"இணைக்கப்பட்ட இரண்டு புள்ளிகளுக்கு இடையில் செலவைக் கணக்கிடும்போது அழைக்கப்படுகிறது.\n"
" இந்த செயல்பாடு இயல்புநிலை [குறியீடு] ASTAR [/code] வகுப்பில் மறைக்கப்பட்டுள்ளது என்பதை "
"நினைவில் கொள்க."

#: docs/AStar.xml
msgid ""
"Called when estimating the cost between a point and the path's ending "
"point.\n"
"Note that this function is hidden in the default [code]AStar[/code] class."
msgstr ""
"ஒரு புள்ளிக்கும் பாதையின் முடிவுக்கும் இடையிலான செலவை மதிப்பிடும்போது "
"அழைக்கப்படுகிறது.\n"
" இந்த செயல்பாடு இயல்புநிலை [குறியீடு] ASTAR [/code] வகுப்பில் மறைக்கப்பட்டுள்ளது என்பதை "
"நினைவில் கொள்க."

#: docs/AStar.xml
msgid ""
"Adds a new point at the given position with the given identifier. The "
"[code]id[/code] must be 0 or larger, and the [code]weight_scale[/code] must "
"be 1 or larger.\n"
"The [code]weight_scale[/code] is multiplied by the result of [method "
"_compute_cost] when determining the overall cost of traveling across a "
"segment from a neighboring point to this point. Thus, all else being equal, "
"the algorithm prefers points with lower [code]weight_scale[/code]s to form a "
"path.\n"
"[codeblock]\n"
"var astar = AStar.new()\n"
"astar.add_point(1, Vector3(1, 0, 0), 4) # Adds the point (1, 0, 0) with "
"weight_scale 4 and id 1\n"
"[/codeblock]\n"
"If there already exists a point for the given [code]id[/code], its position "
"and weight scale are updated to the given values."
msgstr ""
"கொடுக்கப்பட்ட அடையாளங்காட்டியுடன் கொடுக்கப்பட்ட நிலையில் ஒரு புதிய புள்ளியைச் சேர்க்கிறது. "
"[குறியீடு] ஐடி [/குறியீடு] 0 அல்லது பெரியதாக இருக்க வேண்டும், மேலும் [குறியீடு] எடை_ "
"அளவிலான [/குறியீடு] 1 அல்லது பெரியதாக இருக்க வேண்டும்.\n"
" [குறியீடு] எடை_ச்கேல் [/குறியீடு] [முறை _COMPUTE_COST] இன் விளைவாக "
"பெருக்கப்படுகிறது, இது ஒரு பகுதியிலிருந்து ஒரு பகுதியிலிருந்து பயணத்தின் ஒட்டுமொத்த "
"செலவை இந்த கட்டம் வரை தீர்மானிக்கும்போது. எனவே, மற்ற அனைத்தும் சமமாக இருப்பதால், வழிமுறை "
"ஒரு பாதையை உருவாக்க குறைந்த [குறியீடு] எடை_ அளவிலான [/குறியீடு] எச் உடன் புள்ளிகளை "
"விரும்புகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar.new ()\n"
" astar.add_point (1, வெக்டர் 3 (1, 0, 0), 4) # எடை_ அளவிலான 4 மற்றும் ஐடி 1 உடன் "
"புள்ளியை (1, 0, 0) சேர்க்கிறது\n"
" [/codeBlock]\n"
" கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] க்கு ஏற்கனவே ஒரு புள்ளி இருந்தால், அதன் நிலை "
"மற்றும் எடை அளவு கொடுக்கப்பட்ட மதிப்புகளுக்கு புதுப்பிக்கப்படும்."

#: docs/AStar.xml
msgid ""
"Returns whether the two given points are directly connected by a segment. If "
"[code]bidirectional[/code] is [code]false[/code], returns whether movement "
"from [code]id[/code] to [code]to_id[/code] is possible through this segment."
msgstr ""
"கொடுக்கப்பட்ட இரண்டு புள்ளிகள் ஒரு பகுதியால் நேரடியாக இணைக்கப்பட்டுள்ளதா என்பதைத் "
"தருகிறது. [குறியீடு] இருதரப்பு]"

#: docs/AStar.xml docs/AStar2D.xml
msgid "Clears all the points and segments."
msgstr "எல்லா புள்ளிகளையும் பிரிவுகளையும் அழிக்கிறது."

#: docs/AStar.xml
msgid ""
"Creates a segment between the given points. If [code]bidirectional[/code] is "
"[code]false[/code], only movement from [code]id[/code] to [code]to_id[/code] "
"is allowed, not the reverse direction.\n"
"[codeblock]\n"
"var astar = AStar.new()\n"
"astar.add_point(1, Vector3(1, 1, 0))\n"
"astar.add_point(2, Vector3(0, 5, 0))\n"
"astar.connect_points(1, 2, false)\n"
"[/codeblock]"
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் ஒரு பகுதியை உருவாக்குகிறது. [குறியீடு] "
"இருதரப்பு]\n"
" [கோட் பிளாக்]\n"
" var astar = astar.new ()\n"
" astar.add_point (1, வெக்டர் 3 (1, 1, 0))\n"
" astar.add_point (2, வெக்டர் 3 (0, 5, 0))\n"
" astar.connect_points (1, 2, பொய்)\n"
" [/codeBlock]"

#: docs/AStar.xml
msgid ""
"Deletes the segment between the given points. If [code]bidirectional[/code] "
"is [code]false[/code], only movement from [code]id[/code] to [code]to_id[/"
"code] is prevented, and a unidirectional segment possibly remains."
msgstr "கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையிலான பகுதியை நீக்குகிறது. ."

#: docs/AStar.xml docs/AStar2D.xml
msgid "Returns the next available point ID with no point associated to it."
msgstr "அடுத்த கிடைக்கக்கூடிய புள்ளி ஐடியை எந்தப் புள்ளியும் இல்லாமல் வழங்குகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns the ID of the closest point to [code]to_position[/code], optionally "
"taking disabled points into account. Returns [code]-1[/code] if there are no "
"points in the points pool.\n"
"[b]Note:[/b] If several points are the closest to [code]to_position[/code], "
"the one with the smallest ID will be returned, ensuring a deterministic "
"result."
msgstr ""
"[குறியீடு] to_position [/code] க்கு மிக நெருக்கமான புள்ளியின் ஐடியை வழங்குகிறது, "
"விருப்பமாக முடக்கப்பட்ட புள்ளிகளை கணக்கில் எடுத்துக்கொள்கிறது. புள்ளிகள் குளத்தில் புள்ளிகள் "
"இல்லை என்றால் [குறியீடு] -1 [/குறியீடு] திரும்பும்.\n"
" ."

#: docs/AStar.xml
msgid ""
"Returns the closest position to [code]to_position[/code] that resides inside "
"a segment between two connected points.\n"
"[codeblock]\n"
"var astar = AStar.new()\n"
"astar.add_point(1, Vector3(0, 0, 0))\n"
"astar.add_point(2, Vector3(0, 5, 0))\n"
"astar.connect_points(1, 2)\n"
"var res = astar.get_closest_position_in_segment(Vector3(3, 3, 0)) # Returns "
"(0, 3, 0)\n"
"[/codeblock]\n"
"The result is in the segment that goes from [code]y = 0[/code] to [code]y = "
"5[/code]. It's the closest position in the segment to the given point."
msgstr ""
"இணைக்கப்பட்ட இரண்டு புள்ளிகளுக்கு இடையில் ஒரு பிரிவுக்குள் வசிக்கும் [குறியீடு] "
"To_Position [/code] க்கு மிக நெருக்கமான நிலையை வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar.new ()\n"
" astar.add_point (1, வெக்டர் 3 (0, 0, 0))\n"
" astar.add_point (2, வெக்டர் 3 (0, 5, 0))\n"
" astar.connect_points (1, 2)\n"
" var res = astar.get_closest_position_in_segment (vecter3 (3, 3, 0)) # "
"வருமானம் (0, 3, 0)\n"
" [/codeBlock]\n"
" இதன் விளைவாக [குறியீடு] ஒய் = 0 [/code] இலிருந்து [குறியீடு] ஒய் = 5 [/code] வரை "
"செல்லும் பிரிவில் உள்ளது. கொடுக்கப்பட்ட புள்ளியின் பிரிவில் இது மிக நெருக்கமான நிலை."

#: docs/AStar.xml
msgid ""
"Returns an array with the IDs of the points that form the path found by "
"AStar between the given points. The array is ordered from the starting point "
"to the ending point of the path.\n"
"[codeblock]\n"
"var astar = AStar.new()\n"
"astar.add_point(1, Vector3(0, 0, 0))\n"
"astar.add_point(2, Vector3(0, 1, 0), 1) # Default weight is 1\n"
"astar.add_point(3, Vector3(1, 1, 0))\n"
"astar.add_point(4, Vector3(2, 0, 0))\n"
"\n"
"astar.connect_points(1, 2, false)\n"
"astar.connect_points(2, 3, false)\n"
"astar.connect_points(4, 3, false)\n"
"astar.connect_points(1, 4, false)\n"
"\n"
"var res = astar.get_id_path(1, 3) # Returns [1, 2, 3]\n"
"[/codeblock]\n"
"If you change the 2nd point's weight to 3, then the result will be [code][1, "
"4, 3][/code] instead, because now even though the distance is longer, it's "
"\"easier\" to get through point 4 than through point 2."
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் அச்டார் கண்டுபிடிக்கும் பாதையை உருவாக்கும் புள்ளிகளின் "
"ஐடிகளுடன் ஒரு வரிசையை வழங்குகிறது. வரிசை தொடக்க புள்ளியிலிருந்து பாதையின் இறுதி "
"புள்ளி வரை ஆர்டர் செய்யப்படுகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar.new ()\n"
" astar.add_point (1, வெக்டர் 3 (0, 0, 0))\n"
" astar.add_point (2, வெக்டர் 3 (0, 1, 0), 1) # இயல்புநிலை எடை 1\n"
" astar.add_point (3, வெக்டர் 3 (1, 1, 0))\n"
" astar.add_point (4, வெக்டர் 3 (2, 0, 0))\n"
"\n"
" astar.connect_points (1, 2, பொய்)\n"
" astar.connect_points (2, 3, பொய்)\n"
" astar.connect_points (4, 3, பொய்)\n"
" astar.connect_points (1, 4, பொய்)\n"
"\n"
" var res = astar.get_id_path (1, 3) # வருமானம் [1, 2, 3]\n"
" [/codeBlock]\n"
" நீங்கள் 2 வது புள்ளியின் எடையை 3 ஆக மாற்றினால், இதன் விளைவாக [குறியீடு] [1, 4, 3] [/"
"குறியீடு] அதற்கு பதிலாக இருக்கும், ஏனென்றால் இப்போது தூரம் நீளமாக இருந்தாலும், புள்ளி 2 "
"ஐ விட புள்ளி 4 வழியாக செல்வது \"எளிதானது\"."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns the capacity of the structure backing the points, useful in "
"conjunction with [code]reserve_space[/code]."
msgstr ""
"[குறியீடு] ரிசர்வ்_ச்பேச் [/குறியீடு] உடன் இணைந்து பயனுள்ள புள்ளிகளை ஆதரிக்கும் "
"கட்டமைப்பின் திறனை வழங்குகிறது."

#: docs/AStar.xml
msgid ""
"Returns an array with the IDs of the points that form the connection with "
"the given point.\n"
"[codeblock]\n"
"var astar = AStar.new()\n"
"astar.add_point(1, Vector3(0, 0, 0))\n"
"astar.add_point(2, Vector3(0, 1, 0))\n"
"astar.add_point(3, Vector3(1, 1, 0))\n"
"astar.add_point(4, Vector3(2, 0, 0))\n"
"\n"
"astar.connect_points(1, 2, true)\n"
"astar.connect_points(1, 3, true)\n"
"\n"
"var neighbors = astar.get_point_connections(1) # Returns [2, 3]\n"
"[/codeblock]"
msgstr ""
"கொடுக்கப்பட்ட புள்ளியுடன் இணைப்பை உருவாக்கும் புள்ளிகளின் ஐடிகளுடன் ஒரு வரிசையை "
"வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar.new ()\n"
" astar.add_point (1, வெக்டர் 3 (0, 0, 0))\n"
" astar.add_point (2, வெக்டர் 3 (0, 1, 0))\n"
" astar.add_point (3, வெக்டர் 3 (1, 1, 0))\n"
" astar.add_point (4, வெக்டர் 3 (2, 0, 0))\n"
"\n"
" astar.connect_points (1, 2, உண்மை)\n"
" astar.connect_points (1, 3, உண்மை)\n"
"\n"
" var நெய்பர்ச் = astar.get_point_connections (1) # வருமானம் [2, 3]\n"
" [/codeBlock]"

#: docs/AStar.xml docs/AStar2D.xml
msgid "Returns the number of points currently in the points pool."
msgstr "புள்ளிகள் குளத்தில் தற்போது புள்ளிகளின் எண்ணிக்கையை வழங்குகிறது."

#: docs/AStar.xml
msgid ""
"Returns an array with the points that are in the path found by AStar between "
"the given points. The array is ordered from the starting point to the ending "
"point of the path.\n"
"[b]Note:[/b] This method is not thread-safe. If called from a [Thread], it "
"will return an empty [PoolVector3Array] and will print an error message."
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் அச்டார் கண்டுபிடிக்கும் பாதையில் உள்ள புள்ளிகளுடன் ஒரு "
"வரிசையை வழங்குகிறது. வரிசை தொடக்க புள்ளியிலிருந்து பாதையின் இறுதி புள்ளி வரை ஆர்டர் "
"செய்யப்படுகிறது.\n"
" [b] குறிப்பு: [/b] இந்த முறை நூல்-பாதுகாப்பானது அல்ல. ஒரு [நூல்] இலிருந்து "
"அழைக்கப்பட்டால், அது ஒரு வெற்று [பூல்பெக்டர் 3அரே] ஐத் தரும் மற்றும் பிழை செய்தியை "
"அச்சிடும்."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns the position of the point associated with the given [code]id[/code]."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் தொடர்புடைய புள்ளியின் நிலையை வழங்குகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns the weight scale of the point associated with the given [code]id[/"
"code]."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் தொடர்புடைய புள்ளியின் எடை அளவை "
"வழங்குகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid "Returns an array of all points."
msgstr "எல்லா புள்ளிகளின் வரிசையையும் தருகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns whether a point associated with the given [code]id[/code] exists."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் தொடர்புடைய ஒரு புள்ளி இருக்கிறதா என்பதை "
"வழங்குகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Returns whether a point is disabled or not for pathfinding. By default, all "
"points are enabled."
msgstr ""
"ஒரு புள்ளி முடக்கப்பட்டதா இல்லையா என்பது பாத்ஃபைண்டிங். இயல்பாக, எல்லா புள்ளிகளும் "
"இயக்கப்பட்டுள்ளன."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Removes the point associated with the given [code]id[/code] from the points "
"pool."
msgstr ""
"புள்ளிகள் குளத்திலிருந்து கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் தொடர்புடைய "
"புள்ளியை நீக்குகிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Reserves space internally for [code]num_nodes[/code] points, useful if "
"you're adding a known large number of points at once, for a grid for "
"instance. New capacity must be greater or equals to old capacity."
msgstr ""
"[குறியீடு] Num_Nodes [/code] புள்ளிகளுக்கு உள்நாட்டில் இடத்தை வைத்திருக்கிறது, நீங்கள் "
"ஒரே நேரத்தில் அறியப்பட்ட பெரிய எண்ணிக்கையிலான புள்ளிகளைச் சேர்த்தால், உதாரணமாக ஒரு "
"கட்டத்திற்கு பயனுள்ளதாக இருக்கும். புதிய திறன் அதிகமாக இருக்க வேண்டும் அல்லது பழைய "
"திறனுக்கு சமமாக இருக்க வேண்டும்."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Disables or enables the specified point for pathfinding. Useful for making a "
"temporary obstacle."
msgstr ""
"பாத்ஃபைண்டிற்கு குறிப்பிட்ட புள்ளியை முடக்குகிறது அல்லது செயல்படுத்துகிறது. தற்காலிக "
"தடையாக இருக்க பயனுள்ளதாக இருக்கும்."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Sets the [code]position[/code] for the point with the given [code]id[/code]."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் புள்ளிக்கு [குறியீடு] நிலையை [/குறியீடு] "
"அமைக்கிறது."

#: docs/AStar.xml docs/AStar2D.xml
msgid ""
"Sets the [code]weight_scale[/code] for the point with the given [code]id[/"
"code]. The [code]weight_scale[/code] is multiplied by the result of [method "
"_compute_cost] when determining the overall cost of traveling across a "
"segment from a neighboring point to this point."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] உடன் புள்ளிக்கு [குறியீடு] எடை_ச்கேல் [/"
"குறியீடு] ஐ அமைக்கிறது. [குறியீடு] எடை_ச்கேல் [/குறியீடு] [முறை _COMPUTE_COST] இன் "
"விளைவாக பெருக்கப்படுகிறது, இது ஒரு பகுதியிலிருந்து ஒரு பகுதியிலிருந்து பயணத்தின் "
"ஒட்டுமொத்த செலவை இந்த கட்டம் வரை தீர்மானிக்கும்போது."

#: docs/AStar2D.xml
msgid "AStar class representation that uses 2D vectors as edges."
msgstr "2 டி திசையன்களை விளிம்புகளாகப் பயன்படுத்தும் அச்டார் வகுப்பு பிரதிநிதித்துவம்."

#: docs/AStar2D.xml
msgid ""
"This is a wrapper for the [AStar] class which uses 2D vectors instead of 3D "
"vectors."
msgstr ""
"இது [ASTAR] வகுப்பிற்கான ஒரு ரேப்பர் ஆகும், இது 3D திசையன்களுக்கு பதிலாக 2D "
"திசையன்களைப் பயன்படுத்துகிறது."

#: docs/AStar2D.xml
msgid ""
"Called when computing the cost between two connected points.\n"
"Note that this function is hidden in the default [code]AStar2D[/code] class."
msgstr ""
"இணைக்கப்பட்ட இரண்டு புள்ளிகளுக்கு இடையில் செலவைக் கணக்கிடும்போது அழைக்கப்படுகிறது.\n"
" இந்த செயல்பாடு இயல்புநிலை [குறியீடு] ASTAR2D [/code] வகுப்பில் மறைக்கப்பட்டுள்ளது "
"என்பதை நினைவில் கொள்க."

#: docs/AStar2D.xml
msgid ""
"Called when estimating the cost between a point and the path's ending "
"point.\n"
"Note that this function is hidden in the default [code]AStar2D[/code] class."
msgstr ""
"ஒரு புள்ளிக்கும் பாதையின் முடிவுக்கும் இடையிலான செலவை மதிப்பிடும்போது "
"அழைக்கப்படுகிறது.\n"
" இந்த செயல்பாடு இயல்புநிலை [குறியீடு] ASTAR2D [/code] வகுப்பில் மறைக்கப்பட்டுள்ளது "
"என்பதை நினைவில் கொள்க."

#: docs/AStar2D.xml
msgid ""
"Adds a new point at the given position with the given identifier. The "
"[code]id[/code] must be 0 or larger, and the [code]weight_scale[/code] must "
"be 1 or larger.\n"
"The [code]weight_scale[/code] is multiplied by the result of [method "
"_compute_cost] when determining the overall cost of traveling across a "
"segment from a neighboring point to this point. Thus, all else being equal, "
"the algorithm prefers points with lower [code]weight_scale[/code]s to form a "
"path.\n"
"[codeblock]\n"
"var astar = AStar2D.new()\n"
"astar.add_point(1, Vector2(1, 0), 4) # Adds the point (1, 0) with "
"weight_scale 4 and id 1\n"
"[/codeblock]\n"
"If there already exists a point for the given [code]id[/code], its position "
"and weight scale are updated to the given values."
msgstr ""
"கொடுக்கப்பட்ட அடையாளங்காட்டியுடன் கொடுக்கப்பட்ட நிலையில் ஒரு புதிய புள்ளியைச் சேர்க்கிறது. "
"[குறியீடு] ஐடி [/குறியீடு] 0 அல்லது பெரியதாக இருக்க வேண்டும், மேலும் [குறியீடு] எடை_ "
"அளவிலான [/குறியீடு] 1 அல்லது பெரியதாக இருக்க வேண்டும்.\n"
" [குறியீடு] எடை_ச்கேல் [/குறியீடு] [முறை _COMPUTE_COST] இன் விளைவாக "
"பெருக்கப்படுகிறது, இது ஒரு பகுதியிலிருந்து ஒரு பகுதியிலிருந்து பயணத்தின் ஒட்டுமொத்த "
"செலவை இந்த கட்டம் வரை தீர்மானிக்கும்போது. எனவே, மற்ற அனைத்தும் சமமாக இருப்பதால், வழிமுறை "
"ஒரு பாதையை உருவாக்க குறைந்த [குறியீடு] எடை_ அளவிலான [/குறியீடு] எச் உடன் புள்ளிகளை "
"விரும்புகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar2d.new ()\n"
" astar.add_point (1, திசையன் 2 (1, 0), 4) # எடை_ அளவிலான 4 மற்றும் ஐடி 1 உடன் "
"புள்ளியை (1, 0) சேர்க்கிறது\n"
" [/codeBlock]\n"
" கொடுக்கப்பட்ட [குறியீடு] ஐடி [/குறியீடு] க்கு ஏற்கனவே ஒரு புள்ளி இருந்தால், அதன் நிலை "
"மற்றும் எடை அளவு கொடுக்கப்பட்ட மதிப்புகளுக்கு புதுப்பிக்கப்படும்."

#: docs/AStar2D.xml
msgid "Returns whether there is a connection/segment between the given points."
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் ஒரு இணைப்பு/பிரிவு இருக்கிறதா என்பதைத் தருகிறது."

#: docs/AStar2D.xml
msgid ""
"Creates a segment between the given points. If [code]bidirectional[/code] is "
"[code]false[/code], only movement from [code]id[/code] to [code]to_id[/code] "
"is allowed, not the reverse direction.\n"
"[codeblock]\n"
"var astar = AStar2D.new()\n"
"astar.add_point(1, Vector2(1, 1))\n"
"astar.add_point(2, Vector2(0, 5))\n"
"astar.connect_points(1, 2, false)\n"
"[/codeblock]"
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் ஒரு பகுதியை உருவாக்குகிறது. [குறியீடு] "
"இருதரப்பு]\n"
" [கோட் பிளாக்]\n"
" var astar = astar2d.new ()\n"
" astar.add_point (1, வெக்டர் 2 (1, 1))\n"
" astar.add_point (2, வெக்டர் 2 (0, 5))\n"
" astar.connect_points (1, 2, பொய்)\n"
" [/codeBlock]"

#: docs/AStar2D.xml
msgid "Deletes the segment between the given points."
msgstr "கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையிலான பகுதியை நீக்குகிறது."

#: docs/AStar2D.xml
msgid ""
"Returns the closest position to [code]to_position[/code] that resides inside "
"a segment between two connected points.\n"
"[codeblock]\n"
"var astar = AStar2D.new()\n"
"astar.add_point(1, Vector2(0, 0))\n"
"astar.add_point(2, Vector2(0, 5))\n"
"astar.connect_points(1, 2)\n"
"var res = astar.get_closest_position_in_segment(Vector2(3, 3)) # Returns (0, "
"3)\n"
"[/codeblock]\n"
"The result is in the segment that goes from [code]y = 0[/code] to [code]y = "
"5[/code]. It's the closest position in the segment to the given point."
msgstr ""
"இணைக்கப்பட்ட இரண்டு புள்ளிகளுக்கு இடையில் ஒரு பிரிவுக்குள் வசிக்கும் [குறியீடு] "
"To_Position [/code] க்கு மிக நெருக்கமான நிலையை வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar2d.new ()\n"
" astar.add_point (1, வெக்டர் 2 (0, 0))\n"
" astar.add_point (2, வெக்டர் 2 (0, 5))\n"
" astar.connect_points (1, 2)\n"
" var res = astar.get_closest_position_in_segment (திசையன் 2 (3, 3)) # வருமானம் "
"(0, 3)\n"
" [/codeBlock]\n"
" இதன் விளைவாக [குறியீடு] ஒய் = 0 [/code] இலிருந்து [குறியீடு] ஒய் = 5 [/code] வரை "
"செல்லும் பிரிவில் உள்ளது. கொடுக்கப்பட்ட புள்ளியின் பிரிவில் இது மிக நெருக்கமான நிலை."

#: docs/AStar2D.xml
msgid ""
"Returns an array with the IDs of the points that form the path found by "
"AStar2D between the given points. The array is ordered from the starting "
"point to the ending point of the path.\n"
"[codeblock]\n"
"var astar = AStar2D.new()\n"
"astar.add_point(1, Vector2(0, 0))\n"
"astar.add_point(2, Vector2(0, 1), 1) # Default weight is 1\n"
"astar.add_point(3, Vector2(1, 1))\n"
"astar.add_point(4, Vector2(2, 0))\n"
"\n"
"astar.connect_points(1, 2, false)\n"
"astar.connect_points(2, 3, false)\n"
"astar.connect_points(4, 3, false)\n"
"astar.connect_points(1, 4, false)\n"
"\n"
"var res = astar.get_id_path(1, 3) # Returns [1, 2, 3]\n"
"[/codeblock]\n"
"If you change the 2nd point's weight to 3, then the result will be [code][1, "
"4, 3][/code] instead, because now even though the distance is longer, it's "
"\"easier\" to get through point 4 than through point 2."
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் ASTAR2D ஆல் கண்டுபிடிக்கப்பட்ட பாதையை உருவாக்கும் "
"புள்ளிகளின் ஐடிகளுடன் ஒரு வரிசையை வழங்குகிறது. வரிசை தொடக்க புள்ளியிலிருந்து "
"பாதையின் இறுதி புள்ளி வரை ஆர்டர் செய்யப்படுகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar2d.new ()\n"
" astar.add_point (1, வெக்டர் 2 (0, 0))\n"
" astar.add_point (2, திசையன் 2 (0, 1), 1) # இயல்புநிலை எடை 1\n"
" astar.add_point (3, வெக்டர் 2 (1, 1))\n"
" astar.add_point (4, வெக்டர் 2 (2, 0))\n"
"\n"
" astar.connect_points (1, 2, பொய்)\n"
" astar.connect_points (2, 3, பொய்)\n"
" astar.connect_points (4, 3, பொய்)\n"
" astar.connect_points (1, 4, பொய்)\n"
"\n"
" var res = astar.get_id_path (1, 3) # வருமானம் [1, 2, 3]\n"
" [/codeBlock]\n"
" நீங்கள் 2 வது புள்ளியின் எடையை 3 ஆக மாற்றினால், இதன் விளைவாக [குறியீடு] [1, 4, 3] [/"
"குறியீடு] அதற்கு பதிலாக இருக்கும், ஏனென்றால் இப்போது தூரம் நீளமாக இருந்தாலும், புள்ளி 2 "
"ஐ விட புள்ளி 4 வழியாக செல்வது \"எளிதானது\"."

#: docs/AStar2D.xml
msgid ""
"Returns an array with the IDs of the points that form the connection with "
"the given point.\n"
"[codeblock]\n"
"var astar = AStar2D.new()\n"
"astar.add_point(1, Vector2(0, 0))\n"
"astar.add_point(2, Vector2(0, 1))\n"
"astar.add_point(3, Vector2(1, 1))\n"
"astar.add_point(4, Vector2(2, 0))\n"
"\n"
"astar.connect_points(1, 2, true)\n"
"astar.connect_points(1, 3, true)\n"
"\n"
"var neighbors = astar.get_point_connections(1) # Returns [2, 3]\n"
"[/codeblock]"
msgstr ""
"கொடுக்கப்பட்ட புள்ளியுடன் இணைப்பை உருவாக்கும் புள்ளிகளின் ஐடிகளுடன் ஒரு வரிசையை "
"வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var astar = astar2d.new ()\n"
" astar.add_point (1, வெக்டர் 2 (0, 0))\n"
" astar.add_point (2, திசையன் 2 (0, 1))\n"
" astar.add_point (3, வெக்டர் 2 (1, 1))\n"
" astar.add_point (4, வெக்டர் 2 (2, 0))\n"
"\n"
" astar.connect_points (1, 2, உண்மை)\n"
" astar.connect_points (1, 3, உண்மை)\n"
"\n"
" var நெய்பர்ச் = astar.get_point_connections (1) # வருமானம் [2, 3]\n"
" [/codeBlock]"

#: docs/AStar2D.xml
msgid ""
"Returns an array with the points that are in the path found by AStar2D "
"between the given points. The array is ordered from the starting point to "
"the ending point of the path.\n"
"[b]Note:[/b] This method is not thread-safe. If called from a [Thread], it "
"will return an empty [PoolVector2Array] and will print an error message."
msgstr ""
"கொடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் Astar2d ஆல் கண்டுபிடிக்கப்பட்ட பாதையில் உள்ள "
"புள்ளிகளுடன் ஒரு வரிசையை வழங்குகிறது. வரிசை தொடக்க புள்ளியிலிருந்து பாதையின் இறுதி "
"புள்ளி வரை ஆர்டர் செய்யப்படுகிறது.\n"
" [b] குறிப்பு: [/b] இந்த முறை நூல்-பாதுகாப்பானது அல்ல. ஒரு [நூல்] இலிருந்து "
"அழைக்கப்பட்டால், அது ஒரு வெற்று [boolvecter2Array] ஐத் தரும் மற்றும் பிழை செய்தியை "
"அச்சிடும்."

#: docs/AtlasTexture.xml
msgid ""
"Crops out one part of a texture, such as a texture from a texture atlas."
msgstr ""
"ஒரு அமைப்பு அட்லசிலிருந்து ஒரு அமைப்பு போன்ற ஒரு அமைப்பின் ஒரு பகுதியை பயிர்கள் "
"வெளியேற்றுகின்றன."

#: docs/AtlasTexture.xml
msgid ""
"[Texture] resource that crops out one part of the [member atlas] texture, "
"defined by [member region]. The main use case is cropping out textures from "
"a texture atlas, which is a big texture file that packs multiple smaller "
"textures. Consists of a [Texture] for the [member atlas], a [member region] "
"that defines the area of [member atlas] to use, and a [member margin] that "
"defines the border width.\n"
"[AtlasTexture] cannot be used in an [AnimatedTexture], cannot be tiled in "
"nodes such as [TextureRect], and does not work properly if used inside of "
"other [AtlasTexture] resources. Multiple [AtlasTexture] resources can be "
"used to crop multiple textures from the atlas. Using a texture atlas helps "
"to optimize video memory costs and render calls compared to using multiple "
"small files.\n"
"[b]Note:[/b] AtlasTextures don't support repetition. The [constant "
"Texture.FLAG_REPEAT] and [constant Texture.FLAG_MIRRORED_REPEAT] flags are "
"ignored when using an AtlasTexture."
msgstr ""
"[அமைப்பு] [உறுப்பினர் அட்லச்] அமைப்பின் ஒரு பகுதியை பயிர் செய்யும் வளம், [உறுப்பினர் "
"பிராந்தியத்தால்] வரையறுக்கப்படுகிறது. முக்கிய பயன்பாட்டு வழக்கு ஒரு அமைப்பு "
"அட்லசிலிருந்து அமைப்புகளை பயிர் செய்வதாகும், இது பல சிறிய அமைப்புகளைக் கட்டும் ஒரு "
"பெரிய அமைப்பு கோப்பு. [உறுப்பினர் அட்லச்], [உறுப்பினர் அட்லச்] பயன்படுத்த வேண்டிய பகுதியை "
"வரையறுக்கும் [உறுப்பினர் பகுதி] மற்றும் எல்லை அகலத்தை வரையறுக்கும் [உறுப்பினர் விளிம்பு] "
"ஆகியவற்றிற்கான [அமைப்பு].\n"
" [அட்லாச்ட் டெக்ச்டெர்] [அனிமேசன் டெக்ச்டெர்] இல் பயன்படுத்த முடியாது, [டெக்ச்டரரெக்டரி] "
"போன்ற முனைகளில் ஓட முடியாது, மற்ற [அட்லாச்ட் டெக்ச்டெர்] வளங்களுக்குள் பயன்படுத்தினால் "
"சரியாக வேலை செய்யாது. அட்லசிலிருந்து பல அமைப்புகளை பயிர் செய்ய பல [அட்லாச்ட் டெக்ச்டெர்] "
"வளங்கள் பயன்படுத்தப்படலாம். ஒரு அமைப்பைப் பயன்படுத்துவது அட்லசைப் பயன்படுத்துவது பல சிறிய "
"கோப்புகளைப் பயன்படுத்துவதை ஒப்பிடும்போது வீடியோ நினைவக செலவுகளை மேம்படுத்தவும் "
"அழைப்புகளை வழங்கவும் உதவுகிறது.\n"
" [b] குறிப்பு: [/b] அட்லாச்டெக்ச்டர்கள் மீண்டும் மீண்டும் ஆதரிக்காது. அட்லாச்ட் டெக்ச்டெர் "
"பயன்படுத்தும் போது [நிலையான stecture.flag_repeat] மற்றும் [நிலையான அமைப்பு."

#: docs/AtlasTexture.xml
msgid "The texture that contains the atlas. Can be any [Texture] subtype."
msgstr "அட்லசைக் கொண்ட அமைப்பு. எந்தவொரு [அமைப்பு] துணை வகையாக இருக்கலாம்."

#: docs/AtlasTexture.xml
msgid ""
"If [code]true[/code], clips the area outside of the region to avoid bleeding "
"of the surrounding texture pixels."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், சுற்றியுள்ள அமைப்பு படப்புள்ளிகள் இரத்தப்போக்கு "
"ஏற்படுவதைத் தவிர்க்க பிராந்தியத்திற்கு வெளியே உள்ள பகுதியை கிளிப் செய்கிறது."

#: docs/AtlasTexture.xml
msgid ""
"The margin around the region. The [Rect2]'s [member Rect2.size] parameter "
"(\"w\" and \"h\" in the editor) resizes the texture so it fits within the "
"margin."
msgstr "பிராந்தியத்தைச் சுற்றியுள்ள விளிம்பு. ."

#: docs/AtlasTexture.xml
msgid "The AtlasTexture's used region."
msgstr "அட்லாச்டெக்ச்டரின் பயன்படுத்தப்பட்ட பகுதி."

#: docs/AudioBusLayout.xml
msgid "Stores information about the audio buses."
msgstr "ஆடியோ பேருந்துகள் பற்றிய தகவல்களை சேமிக்கிறது."

#: docs/AudioBusLayout.xml
msgid ""
"Stores position, muting, solo, bypass, effects, effect position, volume, and "
"the connections between buses. See [AudioServer] for usage."
msgstr ""
"நிலை, முடக்குதல், சோலோ, பைபாச், விளைவுகள், விளைவு நிலை, தொகுதி மற்றும் "
"பேருந்துகளுக்கு இடையிலான இணைப்புகளை சேமிக்கிறது. பயன்பாட்டிற்கு [ஆடியோசர்வர்] "
"பார்க்கவும்."

#: docs/AudioEffect.xml
msgid "Audio effect for audio."
msgstr "ஆடியோவுக்கான ஆடியோ விளைவு."

#: docs/AudioEffect.xml
msgid ""
"Base resource for audio bus. Applies an audio effect on the bus that the "
"resource is applied on."
msgstr ""
"ஆடியோ பச்சிற்கான அடிப்படை சான்று. சான்று பயன்படுத்தப்படும் பச்சில் ஆடியோ விளைவைப் "
"பயன்படுத்துகிறது."

#: docs/AudioEffectAmplify.xml
msgid ""
"Adds an amplifying audio effect to an audio bus.\n"
"Increases or decreases the volume of the selected audio bus."
msgstr ""
"ஆடியோ பச்சில் பெருக்கும் ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" தேர்ந்தெடுக்கப்பட்ட ஆடியோ பச் அளவை அதிகரிக்கிறது அல்லது குறைக்கிறது."

#: docs/AudioEffectAmplify.xml
msgid "Increases or decreases the volume being routed through the audio bus."
msgstr "ஆடியோ பச் மூலம் திசைதிருப்பப்படும் அளவை அதிகரிக்கிறது அல்லது குறைக்கிறது."

#: docs/AudioEffectAmplify.xml
msgid ""
"Amount of amplification in decibels. Positive values make the sound louder, "
"negative values make it quieter. Value can range from -80 to 24."
msgstr ""
"டெசிபல்களில் பெருக்கத்தின் அளவு. நேர்மறை மதிப்புகள் ஒலியை சத்தமாக ஆக்குகின்றன, எதிர்மறை "
"மதிப்புகள் அதை அமைதியாக ஆக்குகின்றன. மதிப்பு -80 முதல் 24 வரை இருக்கலாம்."

#: docs/AudioEffectBandLimitFilter.xml
msgid "Adds a band limit filter to the audio bus."
msgstr "ஆடியோ பச்சில் பேண்ட் லிமிட் வடிகட்டியைச் சேர்க்கிறது."

#: docs/AudioEffectBandLimitFilter.xml
msgid ""
"Limits the frequencies in a range around the [member "
"AudioEffectFilter.cutoff_hz] and allows frequencies outside of this range to "
"pass."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.சட்டோஃப்_எர்ட்ச்] ஐச் சுற்றியுள்ள வரம்பில் அதிர்வெண்களைக் "
"கட்டுப்படுத்துகிறது மற்றும் இந்த வரம்பிற்கு வெளியே உள்ள அதிர்வெண்களை கடக்க அனுமதிக்கிறது."

#: docs/AudioEffectBandPassFilter.xml
msgid "Adds a band pass filter to the audio bus."
msgstr "ஆடியோ பச்சில் பேண்ட் பாச் வடிப்பானைச் சேர்க்கிறது."

#: docs/AudioEffectBandPassFilter.xml
msgid ""
"Attenuates the frequencies inside of a range around the [member "
"AudioEffectFilter.cutoff_hz] and cuts frequencies outside of this band."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.குடோஃப்_.எச்.இசட்] ஐச் சுற்றியுள்ள ஒரு வரம்பிற்குள் உள்ள "
"அதிர்வெண்களைக் கவனித்து, இந்த இசைக்குழுவுக்கு வெளியே அதிர்வெண்களை வெட்டுகிறது."

#: docs/AudioEffectCapture.xml
msgid "Captures audio from an audio bus in real-time."
msgstr "நிகழ்நேரத்தில் ஆடியோ பச்சிலிருந்து ஆடியோவைப் பிடிக்கிறது."

#: docs/AudioEffectCapture.xml
msgid ""
"AudioEffectCapture is an AudioEffect which copies all audio frames from the "
"attached audio effect bus into its internal ring buffer.\n"
"Application code should consume these audio frames from this ring buffer "
"using [method get_buffer] and process it as needed, for example to capture "
"data from a microphone, implement application defined effects, or to "
"transmit audio over the network. When capturing audio data from a "
"microphone, the format of the samples will be stereo 32-bit floating point "
"PCM."
msgstr ""
"ஆடியோ எஃபெக்ட்காப்சர் என்பது ஆடியோஃபெக்ட் ஆகும், இது இணைக்கப்பட்ட ஆடியோ விளைவு "
"பச்சிலிருந்து அனைத்து ஆடியோ பிரேம்களையும் அதன் உள் வளைய இடையகத்தில் நகலெடுக்கிறது.\n"
" பயன்பாட்டுக் குறியீடு [முறை Get_Buffer] ஐப் பயன்படுத்தி இந்த ரிங் பஃப்பரிலிருந்து இந்த "
"ஆடியோ பிரேம்களை உட்கொள்ள வேண்டும் மற்றும் தேவைக்கேற்ப அதை செயலாக்க வேண்டும், "
"எடுத்துக்காட்டாக மைக்ரோஃபோனிலிருந்து தரவைப் பிடிக்க, பயன்பாட்டு வரையறுக்கப்பட்ட "
"விளைவுகளை செயல்படுத்த அல்லது பிணையத்தில் ஆடியோவை அனுப்ப வேண்டும். மைக்ரோஃபோனிலிருந்து "
"ஆடியோ தரவைப் பிடிக்கும்போது, மாதிரிகளின் வடிவம் ச்டீரியோ 32-பிட் மிதக்கும் புள்ளி "
"பிசிஎம் ஆகும்."

#: docs/AudioEffectCapture.xml
msgid ""
"Returns [code]true[/code] if at least [code]frames[/code] audio frames are "
"available to read in the internal ring buffer."
msgstr ""
"உள் வளைய இடையகத்தில் படிக்க குறைந்தபட்சம் [குறியீடு] பிரேம்கள் [/குறியீடு] ஆடியோ "
"பிரேம்கள் கிடைத்தால் [குறியீடு] உண்மை [/குறியீடு] திரும்பும்."

#: docs/AudioEffectCapture.xml
msgid "Clears the internal ring buffer."
msgstr "உள் வளைய இடையகத்தை அழிக்கிறது."

#: docs/AudioEffectCapture.xml
msgid ""
"Gets the next [code]frames[/code] audio samples from the internal ring "
"buffer.\n"
"Returns a [PoolVector2Array] containing exactly [code]frames[/code] audio "
"samples if available, or an empty [PoolVector2Array] if insufficient data "
"was available."
msgstr ""
"உள் வளைய இடையகத்திலிருந்து அடுத்த [குறியீடு] பிரேம்கள் [/குறியீடு] ஆடியோ மாதிரிகளைப் "
"பெறுகின்றன.\n"
" போதுமான தரவு கிடைக்கவில்லை என்றால், சரியாக [குறியீடு] பிரேம்கள் [/குறியீடு] ஆடியோ "
"மாதிரிகள் அல்லது வெற்று [பூல்வெக்டர் 2அரே] ஆகியவற்றைக் கொண்ட [பூல்வெக்டர் 2ரே] ஐ "
"வழங்குகிறது."

#: docs/AudioEffectCapture.xml
msgid "Returns the total size of the internal ring buffer in frames."
msgstr "உள் வளைய இடையகத்தின் மொத்த அளவை பிரேம்களில் வழங்குகிறது."

#: docs/AudioEffectCapture.xml
msgid ""
"Returns the number of audio frames discarded from the audio bus due to full "
"buffer."
msgstr ""
"முழு இடையகத்தின் காரணமாக ஆடியோ பச்சிலிருந்து நிராகரிக்கப்பட்ட ஆடியோ பிரேம்களின் "
"எண்ணிக்கையை வழங்குகிறது."

#: docs/AudioEffectCapture.xml
msgid ""
"Returns the number of frames available to read using [method get_buffer]."
msgstr ""
"[முறை get_buffer] ஐப் பயன்படுத்தி படிக்க கிடைக்கக்கூடிய பிரேம்களின் எண்ணிக்கையை "
"வழங்குகிறது."

#: docs/AudioEffectCapture.xml
msgid "Returns the number of audio frames inserted from the audio bus."
msgstr "ஆடியோ பச்சிலிருந்து செருகப்பட்ட ஆடியோ பிரேம்களின் எண்ணிக்கையை வழங்குகிறது."

#: docs/AudioEffectCapture.xml
msgid ""
"Length of the internal ring buffer, in seconds. Setting the buffer length "
"will have no effect if already initialized."
msgstr ""
"உள் வளைய இடையகத்தின் நீளம், நொடிகளில். ஏற்கனவே துவக்கப்பட்டால் இடையக நீளத்தை அமைப்பது எந்த "
"விளைவையும் ஏற்படுத்தாது."

#: docs/AudioEffectChorus.xml
msgid "Adds a chorus audio effect."
msgstr "கோரச் ஆடியோ விளைவைச் சேர்க்கிறது."

#: docs/AudioEffectChorus.xml
msgid ""
"Adds a chorus audio effect. The effect applies a filter with voices to "
"duplicate the audio source and manipulate it through the filter."
msgstr ""
"கோரச் ஆடியோ விளைவைச் சேர்க்கிறது. விளைவு ஆடியோ மூலத்தை நகலெடுக்கவும், வடிகட்டி மூலம் "
"கையாளவும் குரல்களுடன் ஒரு வடிப்பானைப் பயன்படுத்துகிறது."

#: docs/AudioEffectChorus.xml
msgid "The effect's raw signal."
msgstr "விளைவின் மூல சமிக்ஞை."

#: docs/AudioEffectChorus.xml
msgid "The voice's cutoff frequency."
msgstr "குரலின் வெட்டு அதிர்வெண்."

#: docs/AudioEffectChorus.xml
msgid "The voice's signal delay."
msgstr "குரலின் சமிக்ஞை நேரந்தவறுகை."

#: docs/AudioEffectChorus.xml
msgid "The voice filter's depth."
msgstr "குரல் வடிகட்டியின் ஆழம்."

#: docs/AudioEffectChorus.xml
msgid "The voice's volume."
msgstr "குரலின் தொகுதி."

#: docs/AudioEffectChorus.xml
msgid "The voice's pan level."
msgstr "குரலின் பான் நிலை."

#: docs/AudioEffectChorus.xml
msgid "The voice's filter rate."
msgstr "குரலின் வடிகட்டி வீதம்."

#: docs/AudioEffectChorus.xml
msgid "The amount of voices in the effect."
msgstr "விளைவில் உள்ள குரல்களின் அளவு."

#: docs/AudioEffectChorus.xml
msgid "The effect's processed signal."
msgstr "விளைவு பதப்படுத்தப்பட்ட சமிக்ஞை."

#: docs/AudioEffectCompressor.xml
msgid ""
"Adds a compressor audio effect to an audio bus.\n"
"Reduces sounds that exceed a certain threshold level, smooths out the "
"dynamics and increases the overall volume."
msgstr ""
"ஆடியோ பச்சில் அமுக்கி ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" ஒரு குறிப்பிட்ட வாசல் மட்டத்தை மீறும் ஒலிகளைக் குறைக்கிறது, இயக்கவியலை "
"மென்மையாக்குகிறது மற்றும் ஒட்டுமொத்த அளவை அதிகரிக்கிறது."

#: docs/AudioEffectCompressor.xml
msgid ""
"Dynamic range compressor reduces the level of the sound when the amplitude "
"goes over a certain threshold in Decibels. One of the main uses of a "
"compressor is to increase the dynamic range by clipping as little as "
"possible (when sound goes over 0dB).\n"
"Compressor has many uses in the mix:\n"
"- In the Master bus to compress the whole output (although an "
"[AudioEffectLimiter] is probably better).\n"
"- In voice channels to ensure they sound as balanced as possible.\n"
"- Sidechained. This can reduce the sound level sidechained with another "
"audio bus for threshold detection. This technique is common in video game "
"mixing to the level of music and SFX while voices are being heard.\n"
"- Accentuates transients by using a wider attack, making effects sound more "
"punchy."
msgstr ""
"டெசிபல்களில் ஒரு குறிப்பிட்ட வாசலுக்கு மேல் வீச்சு செல்லும்போது மாறும் ரேஞ்ச் அமுக்கி "
"ஒலியின் அளவைக் குறைக்கிறது. ஒரு அமுக்கியின் முக்கிய பயன்பாடுகளில் ஒன்று, முடிந்தவரை "
"மிகக் குறைவான கிளிப்பிங் மூலம் மாறும் வரம்பை அதிகரிப்பதாகும் (ஒலி 0dB க்கு மேல் செல்லும் "
"போது).\n"
" கம்ப்ரசர் கலவையில் பல பயன்பாடுகளைக் கொண்டுள்ளது:\n"
" - முழு வெளியீட்டையும் சுருக்க மாச்டர் பச்சில் (ஒரு [ஆடியோஃபெக்டிமிட்டர்] சிறந்தது "
"என்றாலும்).\n"
" - குரல் சேனல்களில் அவை முடிந்தவரை சீரானவை என்பதை உறுதிப்படுத்த.\n"
" - ஓரங்கட்டப்பட்ட. இது வாசல் கண்டறிதலுக்காக மற்றொரு ஆடியோ பச் மூலம் பக்கவாட்டு பக்கத்தை "
"குறைக்கும். வீடியோ கேம் இசையின் நிலைக்கு கலவையில் இந்த நுட்பம் பொதுவானது மற்றும் குரல்கள் "
"கேட்கப்படும் போது.\n"
" - பரந்த தாக்குதலைப் பயன்படுத்துவதன் மூலம் டிரான்சியண்டுகளை வெளிப்படுத்துகிறது, "
"விளைவுகளை மிகவும் பஞ்ச் செய்கிறது."

#: docs/AudioEffectCompressor.xml
msgid ""
"Compressor's reaction time when the signal exceeds the threshold, in "
"microseconds. Value can range from 20 to 2000."
msgstr ""
"மைக்ரோ விநாடிகளில் சமிக்ஞை வாசலை மீறும் போது அமுக்கியின் எதிர்வினை நேரம். மதிப்பு 20 "
"முதல் 2000 வரை இருக்கலாம்."

#: docs/AudioEffectCompressor.xml
msgid "Gain applied to the output signal."
msgstr "வெளியீட்டு சமிக்ஞைக்கு பயன்படுத்தப்படும் ஆதாயம்."

#: docs/AudioEffectCompressor.xml
msgid ""
"Balance between original signal and effect signal. Value can range from 0 "
"(totally dry) to 1 (totally wet)."
msgstr ""
"அசல் சமிக்ஞை மற்றும் விளைவு சமிக்ஞைக்கு இடையில் சமநிலை. மதிப்பு 0 (முற்றிலும் உலர்ந்த) "
"முதல் 1 வரை (முற்றிலும் ஈரமாக) இருக்கலாம்."

#: docs/AudioEffectCompressor.xml
msgid ""
"Amount of compression applied to the audio once it passes the threshold "
"level. The higher the ratio, the more the loud parts of the audio will be "
"compressed. Value can range from 1 to 48."
msgstr ""
"ஆடியோ வாசல் அளவைக் கடந்து சென்றவுடன் சுருக்கத்தின் அளவு. அதிக விகிதம், ஆடியோவின் உரத்த "
"பகுதிகள் சுருக்கப்படும். மதிப்பு 1 முதல் 48 வரை இருக்கலாம்."

#: docs/AudioEffectCompressor.xml
msgid ""
"Compressor's delay time to stop reducing the signal after the signal level "
"falls below the threshold, in milliseconds. Value can range from 20 to 2000."
msgstr ""
"சமிக்ஞை அளவைக் குறைப்பதை நிறுத்த அமுக்கியின் தாமத நேரம் மில்லி விநாடிகளில், வாசலுக்குக் "
"கீழே விழுந்த பிறகு. மதிப்பு 20 முதல் 2000 வரை இருக்கலாம்."

#: docs/AudioEffectCompressor.xml
msgid "Reduce the sound level using another audio bus for threshold detection."
msgstr "வாசல் கண்டறிதலுக்கு மற்றொரு ஆடியோ பச்சைப் பயன்படுத்தி ஒலி அளவைக் குறைக்கவும்."

#: docs/AudioEffectCompressor.xml
msgid ""
"The level above which compression is applied to the audio. Value can range "
"from -60 to 0."
msgstr ""
"ஆடியோவுக்கு எந்த சுருக்கம் பயன்படுத்தப்படுகிறது. மதிப்பு -60 முதல் 0 வரை இருக்கலாம்."

#: docs/AudioEffectDelay.xml
msgid ""
"Adds a delay audio effect to an audio bus. Plays input signal back after a "
"period of time.\n"
"Two tap delay and feedback options."
msgstr ""
"ஆடியோ பச்சில் தாமத ஆடியோ விளைவைச் சேர்க்கிறது. ஒரு குறிப்பிட்ட காலத்திற்குப் பிறகு "
"உள்ளீட்டு சமிக்ஞையை மீண்டும் இயக்குகிறது.\n"
" இரண்டு குழாய் நேரந்தவறுகை மற்றும் பின்னூட்ட விருப்பங்கள்."

#: docs/AudioEffectDelay.xml
msgid ""
"Plays input signal back after a period of time. The delayed signal may be "
"played back multiple times to create the sound of a repeating, decaying "
"echo. Delay effects range from a subtle echo effect to a pronounced blending "
"of previous sounds with new sounds."
msgstr ""
"ஒரு குறிப்பிட்ட காலத்திற்குப் பிறகு உள்ளீட்டு சமிக்ஞையை மீண்டும் இயக்குகிறது. மீண்டும் "
"மீண்டும், அழுகும் எதிரொலியின் ஒலியை உருவாக்க தாமதமான சமிக்ஞை பல முறை மீண்டும் "
"இயக்கப்படலாம். தாமத விளைவுகள் ஒரு நுட்பமான எதிரொலி விளைவிலிருந்து புதிய ஒலிகளுடன் "
"முந்தைய ஒலிகளின் உச்சரிக்கப்படும் கலவையாக இருக்கும்."

#: docs/AudioEffectDelay.xml
msgid ""
"Output percent of original sound. At 0, only delayed sounds are output. "
"Value can range from 0 to 1."
msgstr ""
"அசல் ஒலியின் வெளியீட்டு விழுக்காடு. 0 இல், தாமதமான ஒலிகள் மட்டுமே வெளியீடு. மதிப்பு 0 "
"முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectDelay.xml
msgid "If [code]true[/code], feedback is enabled."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், கருத்து இயக்கப்பட்டது."

#: docs/AudioEffectDelay.xml
msgid "Feedback delay time in milliseconds."
msgstr "மில்லி விநாடிகளில் கருத்து தாமத நேரம்."

#: docs/AudioEffectDelay.xml
msgid "Sound level for [code]tap1[/code]."
msgstr "[குறியீடு] TAP1 [/code] க்கான ஒலி நிலை."

#: docs/AudioEffectDelay.xml
msgid ""
"Low-pass filter for feedback, in Hz. Frequencies below this value are "
"filtered out of the source signal."
msgstr ""
"பின்னூட்டத்திற்கான குறைந்த-பாச் வடிகட்டி, HZ இல். இந்த மதிப்புக்குக் கீழே உள்ள அதிர்வெண்கள் "
"மூல சமிக்ஞையிலிருந்து வடிகட்டப்படுகின்றன."

#: docs/AudioEffectDelay.xml
msgid "If [code]true[/code], [code]tap1[/code] will be enabled."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், [குறியீடு] TAP1 [/குறியீடு] இயக்கப்படும்."

#: docs/AudioEffectDelay.xml
msgid "[code]tap1[/code] delay time in milliseconds."
msgstr "[குறியீடு] TAP1 [/code] மில்லி விநாடிகளில் தாமத நேரம்."

#: docs/AudioEffectDelay.xml
msgid ""
"Pan position for [code]tap1[/code]. Value can range from -1 (fully left) to "
"1 (fully right)."
msgstr ""
"[குறியீடு] TAP1 [/code] க்கான பான் நிலை. மதிப்பு -1 (முழுமையாக இடது) முதல் 1 வரை "
"(முழுமையாக வலது) இருக்கும்."

#: docs/AudioEffectDelay.xml
msgid "If [code]true[/code], [code]tap2[/code] will be enabled."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், [குறியீடு] TAP2 [/குறியீடு] இயக்கப்படும்."

#: docs/AudioEffectDelay.xml
msgid "[b]Tap2[/b] delay time in milliseconds."
msgstr "[b] TAP2 [/b] மில்லி விநாடிகளில் தாமத நேரம்."

#: docs/AudioEffectDelay.xml
msgid "Sound level for [code]tap2[/code]."
msgstr "[குறியீடு] TAP2 [/code] க்கான ஒலி நிலை."

#: docs/AudioEffectDelay.xml
msgid ""
"Pan position for [code]tap2[/code]. Value can range from -1 (fully left) to "
"1 (fully right)."
msgstr ""
"[குறியீடு] TAP2 [/code] க்கான பான் நிலை. மதிப்பு -1 (முழுமையாக இடது) முதல் 1 வரை "
"(முழுமையாக வலது) இருக்கும்."

#: docs/AudioEffectDistortion.xml
msgid ""
"Adds a distortion audio effect to an Audio bus.\n"
"Modify the sound to make it distorted."
msgstr ""
"ஆடியோ பச்சில் விலகல் ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" ஒலியை சிதைக்க மாற்றவும்."

#: docs/AudioEffectDistortion.xml
msgid ""
"Different types are available: clip, tan, lo-fi (bit crushing), overdrive, "
"or waveshape.\n"
"By distorting the waveform the frequency content change, which will often "
"make the sound \"crunchy\" or \"abrasive\". For games, it can simulate sound "
"coming from some saturated device or speaker very efficiently."
msgstr ""
"வெவ்வேறு வகைகள் கிடைக்கின்றன: கிளிப், டான், லோ-ஃபை (பிட் நொறுக்குதல்), ஓவர் இயக்கி "
"அல்லது வேவ்சேப்.\n"
" அலைவடிவத்தை சிதைப்பதன் மூலம் அதிர்வெண் உள்ளடக்க மாற்றத்தை மாற்றுவதன் மூலம், இது "
"பெரும்பாலும் ஒலியை \"நொறுங்கிய\" அல்லது \"சிராய்ப்பு\" செய்யும். விளையாட்டுகளுக்கு, "
"இது சில நிறைவுற்ற சாதனம் அல்லது ச்பீக்கரிலிருந்து வரும் ஒலியை மிகவும் திறமையாக "
"உருவகப்படுத்தலாம்."

#: docs/AudioEffectDistortion.xml docs/AudioEffectFilter.xml
#: docs/AudioEffectHighShelfFilter.xml docs/AudioEffectLowShelfFilter.xml
#: docs/AudioServer.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/audio_buses.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/audio_buses.html"

#: docs/AudioEffectDistortion.xml
msgid "Distortion power. Value can range from 0 to 1."
msgstr "சிதைவு ஆற்றல். மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectDistortion.xml
msgid ""
"High-pass filter, in Hz. Frequencies higher than this value will not be "
"affected by the distortion. Value can range from 1 to 20000."
msgstr ""
"உயர்-பாச் வடிகட்டி, Hz இல். இந்த மதிப்பை விட அதிகமான அதிர்வெண்கள் விலகலால் "
"பாதிக்கப்படாது. மதிப்பு 1 முதல் 20000 வரை இருக்கலாம்."

#: docs/AudioEffectDistortion.xml
msgid "Distortion type."
msgstr "சிதைவு வகை."

#: docs/AudioEffectDistortion.xml
msgid ""
"Increases or decreases the volume after the effect. Value can range from -80 "
"to 24."
msgstr ""
"விளைவுக்குப் பிறகு அளவை அதிகரிக்கிறது அல்லது குறைக்கிறது. மதிப்பு -80 முதல் 24 வரை "
"இருக்கலாம்."

#: docs/AudioEffectDistortion.xml
msgid ""
"Increases or decreases the volume before the effect. Value can range from "
"-60 to 60."
msgstr ""
"விளைவுக்கு முன் அளவை அதிகரிக்கிறது அல்லது குறைக்கிறது. மதிப்பு -60 முதல் 60 வரை "
"இருக்கலாம்."

#: docs/AudioEffectDistortion.xml
msgid ""
"Digital distortion effect which cuts off peaks at the top and bottom of the "
"waveform."
msgstr "அலைவடிவத்தின் மேல் மற்றும் கீழ் சிகரங்களை துண்டிக்கும் டிசிட்டல் விலகல் விளைவு."

#: docs/AudioEffectDistortion.xml
msgid ""
"Low-resolution digital distortion effect. You can use it to emulate the "
"sound of early digital audio devices."
msgstr ""
"குறைந்த தெளிவுத்திறன் கொண்ட டிசிட்டல் விலகல் விளைவு. ஆரம்பகால டிசிட்டல் ஆடியோ "
"சாதனங்களின் ஒலியைப் பின்பற்ற இதைப் பயன்படுத்தலாம்."

#: docs/AudioEffectDistortion.xml
msgid ""
"Emulates the warm distortion produced by a field effect transistor, which is "
"commonly used in solid-state musical instrument amplifiers."
msgstr ""
"ஒரு புலம் விளைவு டிரான்சிச்டரால் விளைவாக்கம் செய்யப்படும் சூடான விலகலைப் பின்பற்றுகிறது, "
"இது பொதுவாக திட-நிலை இசைக்கருவிகள் கருவி பெருக்கிகளில் பயன்படுத்தப்படுகிறது."

#: docs/AudioEffectDistortion.xml
msgid ""
"Waveshaper distortions are used mainly by electronic musicians to achieve an "
"extra-abrasive sound."
msgstr "வேவ்சேப்பர் சிதைவுகள் முக்கியமாக மின்னணு இசைக்கலைஞர்களால் பயன்படுத்தப்படுகின்றன."

#: docs/AudioEffectEQ.xml
msgid ""
"Base class for audio equalizers. Gives you control over frequencies.\n"
"Use it to create a custom equalizer if [AudioEffectEQ6], [AudioEffectEQ10] "
"or [AudioEffectEQ21] don't fit your needs."
msgstr ""
"ஆடியோ சமநிலைகளுக்கான அடிப்படை வகுப்பு. அதிர்வெண்களின் மீது உங்களுக்கு கட்டுப்பாட்டை "
"வழங்குகிறது.\n"
" [ஆடியோ எஃபெக்டெக் 6], [ஆடியோஃபெக்டெக் 10] அல்லது [ஆடியோஎஃபெக்டெக் 21] உங்கள் "
"தேவைகளுக்கு பொருந்தவில்லை என்றால் தனிப்பயன் சமநிலையை உருவாக்க இதைப் பயன்படுத்தவும்."

#: docs/AudioEffectEQ.xml
msgid ""
"AudioEffectEQ gives you control over frequencies. Use it to compensate for "
"existing deficiencies in audio. AudioEffectEQs are useful on the Master bus "
"to completely master a mix and give it more character. They are also useful "
"when a game is run on a mobile device, to adjust the mix to that kind of "
"speakers (it can be added but disabled when headphones are plugged)."
msgstr ""
"ஆடியோ எஃபெக்டெக் அதிர்வெண்களின் மீது கட்டுப்பாட்டை வழங்குகிறது. ஆடியோவில் இருக்கும் "
"குறைபாடுகளை ஈடுசெய்ய இதைப் பயன்படுத்தவும். ஆடியோ எஃபெக்டெக்ச் மாச்டர் பச்சில் ஒரு கலவையை "
"முழுமையாக மாச்டர் செய்ய பயனுள்ளதாக இருக்கும். மொபைல் சாதனத்தில் ஒரு விளையாட்டு "
"இயங்கும்போது அவை பயனுள்ளதாக இருக்கும், அந்த வகையான ச்பீக்கர்களுடன் கலவையை சரிசெய்யவும் "
"(எட்ஃபோன்கள் செருகப்படும்போது இதைச் சேர்க்கலாம் ஆனால் முடக்கலாம்)."

#: docs/AudioEffectEQ.xml
msgid "Returns the number of bands of the equalizer."
msgstr "சமநிலையின் பட்டையின் எண்ணிக்கையை வழங்குகிறது."

#: docs/AudioEffectEQ.xml
msgid "Returns the band's gain at the specified index, in dB."
msgstr "டி.பியில் குறிப்பிட்ட குறியீட்டில் இசைக்குழுவின் ஆதாயத்தை வழங்குகிறது."

#: docs/AudioEffectEQ.xml
msgid "Sets band's gain at the specified index, in dB."
msgstr "டி.பியில் குறிப்பிட்ட குறியீட்டில் இசைக்குழுவின் ஆதாயத்தை அமைக்கிறது."

#: docs/AudioEffectEQ10.xml
msgid ""
"Adds a 10-band equalizer audio effect to an Audio bus. Gives you control "
"over frequencies from 31 Hz to 16000 Hz.\n"
"Each frequency can be modulated between -60/+24 dB."
msgstr ""
"ஆடியோ பச்சில் 10-பேண்ட் சமநிலை ஆடியோ விளைவைச் சேர்க்கிறது. 31 எர்ட்ச் முதல் 16000 எர்ட்ச் "
"வரையிலான அதிர்வெண்களின் மீது உங்களுக்கு கட்டுப்பாட்டை வழங்குகிறது.\n"
" ஒவ்வொரு அதிர்வெண்ணையும் -60/+24 dB க்கு இடையில் மாற்றியமைக்கலாம்."

#: docs/AudioEffectEQ10.xml
msgid ""
"Frequency bands:\n"
"Band 1: 31 Hz\n"
"Band 2: 62 Hz\n"
"Band 3: 125 Hz\n"
"Band 4: 250 Hz\n"
"Band 5: 500 Hz\n"
"Band 6: 1000 Hz\n"
"Band 7: 2000 Hz\n"
"Band 8: 4000 Hz\n"
"Band 9: 8000 Hz\n"
"Band 10: 16000 Hz\n"
"See also [AudioEffectEQ], [AudioEffectEQ6], [AudioEffectEQ21]."
msgstr ""
"அதிர்வெண் பட்டைகள்:\n"
" பேண்ட் 1: 31 எர்ட்ச்\n"
" பேண்ட் 2: 62 எர்ட்ச்\n"
" பேண்ட் 3: 125 எர்ட்ச்\n"
" பேண்ட் 4: 250 எர்ட்ச்\n"
" பேண்ட் 5: 500 எர்ட்ச்\n"
" பேண்ட் 6: 1000 எர்ட்ச்\n"
" பேண்ட் 7: 2000 எர்ட்ச்\n"
" பேண்ட் 8: 4000 எர்ட்ச்\n"
" பேண்ட் 9: 8000 எர்ட்ச்\n"
" பேண்ட் 10: 16000 எர்ட்ச்\n"
" [ஆடியோ எஃபெக்டெக்], [ஆடியோஃபெக்டெக் 6], [ஆடியோஃபெக்டெக் 21] ஐயும் காண்க."

#: docs/AudioEffectEQ21.xml
msgid ""
"Adds a 21-band equalizer audio effect to an Audio bus. Gives you control "
"over frequencies from 22 Hz to 22000 Hz.\n"
"Each frequency can be modulated between -60/+24 dB."
msgstr ""
"ஆடியோ பச்சில் 21-பேண்ட் சமநிலை ஆடியோ விளைவைச் சேர்க்கிறது. 22 எர்ட்ச் முதல் 22000 எர்ட்ச் "
"வரையிலான அதிர்வெண்களின் மீது உங்களுக்கு கட்டுப்பாட்டை வழங்குகிறது.\n"
" ஒவ்வொரு அதிர்வெண்ணையும் -60/+24 dB க்கு இடையில் மாற்றியமைக்கலாம்."

#: docs/AudioEffectEQ21.xml
msgid ""
"Frequency bands:\n"
"Band 1: 22 Hz\n"
"Band 2: 32 Hz\n"
"Band 3: 44 Hz\n"
"Band 4: 63 Hz\n"
"Band 5: 90 Hz\n"
"Band 6: 125 Hz\n"
"Band 7: 175 Hz\n"
"Band 8: 250 Hz\n"
"Band 9: 350 Hz\n"
"Band 10: 500 Hz\n"
"Band 11: 700 Hz\n"
"Band 12: 1000 Hz\n"
"Band 13: 1400 Hz\n"
"Band 14: 2000 Hz\n"
"Band 15: 2800 Hz\n"
"Band 16: 4000 Hz\n"
"Band 17: 5600 Hz\n"
"Band 18: 8000 Hz\n"
"Band 19: 11000 Hz\n"
"Band 20: 16000 Hz\n"
"Band 21: 22000 Hz\n"
"See also [AudioEffectEQ], [AudioEffectEQ6], [AudioEffectEQ10]."
msgstr ""
"அதிர்வெண் பட்டைகள்:\n"
" பேண்ட் 1: 22 எர்ட்ச்\n"
" பேண்ட் 2: 32 எர்ட்ச்\n"
" பேண்ட் 3: 44 எர்ட்ச்\n"
" பேண்ட் 4: 63 எர்ட்ச்\n"
" பேண்ட் 5: 90 எர்ட்ச்\n"
" பேண்ட் 6: 125 எர்ட்ச்\n"
" பேண்ட் 7: 175 எர்ட்ச்\n"
" பேண்ட் 8: 250 எர்ட்ச்\n"
" பேண்ட் 9: 350 எர்ட்ச்\n"
" பேண்ட் 10: 500 எர்ட்ச்\n"
" பேண்ட் 11: 700 எர்ட்ச்\n"
" பேண்ட் 12: 1000 எர்ட்ச்\n"
" பேண்ட் 13: 1400 எர்ட்ச்\n"
" இசைக்குழு 14: 2000 எர்ட்ச்\n"
" பேண்ட் 15: 2800 எர்ட்ச்\n"
" பேண்ட் 16: 4000 எர்ட்ச்\n"
" இசைக்குழு 17: 5600 எர்ட்ச்\n"
" பேண்ட் 18: 8000 எர்ட்ச்\n"
" பேண்ட் 19: 11000 எர்ட்ச்\n"
" பேண்ட் 20: 16000 எர்ட்ச்\n"
" பேண்ட் 21: 22000 எர்ட்ச்\n"
" [ஆடியோ எஃபெக்டெக்], [ஆடியோ எஃபெக்டெக் 6], [ஆடியோ எஃபெக்டெக் 10] ஐயும் காண்க."

#: docs/AudioEffectEQ6.xml
msgid ""
"Adds a 6-band equalizer audio effect to an Audio bus. Gives you control over "
"frequencies from 32 Hz to 10000 Hz.\n"
"Each frequency can be modulated between -60/+24 dB."
msgstr ""
"ஆடியோ பச்சில் 6-பேண்ட் சமநிலை ஆடியோ விளைவைச் சேர்க்கிறது. 32 எர்ட்ச் முதல் 10000 எர்ட்ச் "
"வரை அதிர்வெண்களின் மீது கட்டுப்பாட்டை வழங்குகிறது.\n"
" ஒவ்வொரு அதிர்வெண்ணையும் -60/+24 dB க்கு இடையில் மாற்றியமைக்கலாம்."

#: docs/AudioEffectEQ6.xml
msgid ""
"Frequency bands:\n"
"Band 1: 32 Hz\n"
"Band 2: 100 Hz\n"
"Band 3: 320 Hz\n"
"Band 4: 1000 Hz\n"
"Band 5: 3200 Hz\n"
"Band 6: 10000 Hz\n"
"See also [AudioEffectEQ], [AudioEffectEQ10], [AudioEffectEQ21]."
msgstr ""
"அதிர்வெண் பட்டைகள்:\n"
" பேண்ட் 1: 32 எர்ட்ச்\n"
" பேண்ட் 2: 100 எர்ட்ச்\n"
" பேண்ட் 3: 320 எர்ட்ச்\n"
" பேண்ட் 4: 1000 எர்ட்ச்\n"
" பேண்ட் 5: 3200 எர்ட்ச்\n"
" பேண்ட் 6: 10000 எர்ட்ச்\n"
" [ஆடியோஃபெக்டெக்], [ஆடியோ எஃபெக்டெக் 10], [ஆடியோஃபெக்டெக் 21] ஐயும் காண்க."

#: docs/AudioEffectFilter.xml
msgid "Adds a filter to the audio bus."
msgstr "ஆடியோ பச்சில் வடிகட்டியைச் சேர்க்கிறது."

#: docs/AudioEffectFilter.xml
msgid "Allows frequencies other than the [member cutoff_hz] to pass."
msgstr "[உறுப்பினர் கட்ஆஃப்_எர்ட்ச்] தவிர வேறு அதிர்வெண்களை கடக்க அனுமதிக்கிறது."

#: docs/AudioEffectFilter.xml
msgid "Threshold frequency for the filter, in Hz."
msgstr "Hz இல், வடிகட்டிக்கான வாசல் அதிர்வெண்."

#: docs/AudioEffectFilter.xml
msgid "Gain amount of the frequencies after the filter."
msgstr "வடிகட்டிக்குப் பிறகு அதிர்வெண்களின் அளவு."

#: docs/AudioEffectFilter.xml
msgid "Amount of boost in the frequency range near the cutoff frequency."
msgstr "வெட்டு அதிர்வெண்ணுக்கு அருகிலுள்ள அதிர்வெண் வரம்பில் ஊக்கத்தின் அளவு."

#: docs/AudioEffectHighPassFilter.xml
msgid "Adds a high-pass filter to the Audio Bus."
msgstr "ஆடியோ பச்சில் உயர்-பாச் வடிப்பானைச் சேர்க்கிறது."

#: docs/AudioEffectHighPassFilter.xml
msgid ""
"Cuts frequencies lower than the [member AudioEffectFilter.cutoff_hz] and "
"allows higher frequencies to pass."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.குடோஃப்_எர்ட்ச்] ஐ விடக் குறைவான அதிர்வெண்களை வெட்டுகிறது "
"மற்றும் அதிக அதிர்வெண்களைக் கடக்க அனுமதிக்கிறது."

#: docs/AudioEffectHighShelfFilter.xml
msgid "Reduces all frequencies above the [member AudioEffectFilter.cutoff_hz]."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.சுட்டாஃப்_எர்ட்ச்] க்கு மேலே உள்ள அனைத்து அதிர்வெண்களையும் "
"குறைக்கிறது."

#: docs/AudioEffectLimiter.xml
msgid "Adds a soft-clip limiter audio effect to an Audio bus."
msgstr "ஆடியோ பச்சில் மென்மையான-கிளிப் லிமிட்டர் ஆடியோ விளைவைச் சேர்க்கிறது."

#: docs/AudioEffectLimiter.xml
msgid ""
"A limiter is similar to a compressor, but it's less flexible and designed to "
"disallow sound going over a given dB threshold. Adding one in the Master bus "
"is always recommended to reduce the effects of clipping.\n"
"Soft clipping starts to reduce the peaks a little below the threshold level "
"and progressively increases its effect as the input level increases such "
"that the threshold is never exceeded."
msgstr ""
"ஒரு வரம்பு ஒரு அமுக்கிக்கு ஒத்ததாக இருக்கிறது, ஆனால் இது குறைவான நெகிழ்வானது மற்றும் "
"கொடுக்கப்பட்ட டிபி வாசலுக்கு மேல் ஒலியை அனுமதிக்க வடிவமைக்கப்பட்டுள்ளது. கிளிப்பிங்கின் "
"விளைவுகளை குறைக்க மாச்டர் பச்சில் ஒன்றைச் சேர்ப்பது எப்போதும் பரிந்துரைக்கப்படுகிறது.\n"
" மென்மையான கிளிப்பிங் உச்சங்களை வாசல் மட்டத்திற்கு சற்று கீழே குறைக்கத் தொடங்குகிறது மற்றும் "
"உள்ளீட்டு நிலை அதிகரிக்கும்போது படிப்படியாக அதன் விளைவை அதிகரிக்கிறது, அதாவது வாசல் "
"ஒருபோதும் மீறாது."

#: docs/AudioEffectLimiter.xml
msgid ""
"The waveform's maximum allowed value, in decibels. Value can range from -20 "
"to -0.1."
msgstr ""
"அலைவடிவத்தின் அதிகபட்ச அனுமதிக்கப்பட்ட மதிப்பு, டெசிபல்களில். மதிப்பு -20 முதல் -0.1 "
"வரை இருக்கலாம்."

#: docs/AudioEffectLimiter.xml
msgid ""
"Applies a gain to the limited waves, in decibels. Value can range from 0 to "
"6."
msgstr ""
"வரையறுக்கப்பட்ட அலைகளுக்கு, டெசிபல்களில் ஒரு ஆதாயத்தைப் பயன்படுத்துகிறது. மதிப்பு 0 "
"முதல் 6 வரை இருக்கலாம்."

#: docs/AudioEffectLimiter.xml
msgid ""
"Threshold from which the limiter begins to be active, in decibels. Value can "
"range from -30 to 0."
msgstr ""
"டெசிபல்களில், வரம்பு செயலில் இருக்கத் தொடங்கும் வாசல். மதிப்பு -30 முதல் 0 வரை இருக்கலாம்."

#: docs/AudioEffectLowPassFilter.xml
msgid "Adds a low-pass filter to the Audio bus."
msgstr "ஆடியோ பச்சில் குறைந்த பாச் வடிப்பானைச் சேர்க்கிறது."

#: docs/AudioEffectLowPassFilter.xml
msgid ""
"Cuts frequencies higher than the [member AudioEffectFilter.cutoff_hz] and "
"allows lower frequencies to pass."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.குடோஃப்_எர்ட்ச்] ஐ விட அதிகமாக அதிர்வெண்களைக் குறைக்கிறது "
"மற்றும் குறைந்த அதிர்வெண்களைக் கடக்க அனுமதிக்கிறது."

#: docs/AudioEffectLowShelfFilter.xml
msgid "Reduces all frequencies below the [member AudioEffectFilter.cutoff_hz]."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.சுட்டாஃப்_எர்ட்ச்] க்குக் கீழே உள்ள அனைத்து அதிர்வெண்களையும் "
"குறைக்கிறது."

#: docs/AudioEffectNotchFilter.xml
msgid "Adds a notch filter to the Audio bus."
msgstr "ஆடியோ பச்சில் ஒரு உச்சநிலை வடிப்பானைச் சேர்க்கிறது."

#: docs/AudioEffectNotchFilter.xml
msgid ""
"Attenuates frequencies in a narrow band around the [member "
"AudioEffectFilter.cutoff_hz] and cuts frequencies outside of this range."
msgstr ""
"[உறுப்பினர் ஆடியோஃபெக்ட்ஃபில்டர்.குடோஃப்_.எச்.இசட்] ஐச் சுற்றியுள்ள ஒரு குறுகிய "
"இசைக்குழுவில் அதிர்வெண்களைக் கவனித்து, இந்த வரம்பிற்கு வெளியே அதிர்வெண்களை வெட்டுகிறது."

#: docs/AudioEffectPanner.xml
msgid "Adds a panner audio effect to an Audio bus. Pans sound left or right."
msgstr ""
"ஆடியோ பச்சில் பன்னர் ஆடியோ விளைவைச் சேர்க்கிறது. பான்கள் இடது அல்லது வலதுபுறம் "
"ஒலிக்கின்றன."

#: docs/AudioEffectPanner.xml
msgid ""
"Determines how much of an audio signal is sent to the left and right buses."
msgstr ""
"இடது மற்றும் வலது பேருந்துகளுக்கு ஆடியோ சமிக்ஞை எவ்வளவு அனுப்பப்படுகிறது என்பதை "
"தீர்மானிக்கிறது."

#: docs/AudioEffectPanner.xml
msgid "Pan position. Value can range from -1 (fully left) to 1 (fully right)."
msgstr ""
"பான் நிலை. மதிப்பு -1 (முழுமையாக இடது) முதல் 1 வரை (முழுமையாக வலது) இருக்கும்."

#: docs/AudioEffectPhaser.xml
msgid ""
"Adds a phaser audio effect to an Audio bus.\n"
"Combines the original signal with a copy that is slightly out of phase with "
"the original."
msgstr ""
"ஆடியோ பச்சில் பேசர் ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" அசல் சமிக்ஞையை அசல் மூலம் சற்று வெளியே இருக்கும் நகலுடன் ஒருங்கிணைக்கிறது."

#: docs/AudioEffectPhaser.xml
msgid ""
"Combines phase-shifted signals with the original signal. The movement of the "
"phase-shifted signals is controlled using a low-frequency oscillator."
msgstr ""
"கட்ட-மாற்றப்பட்ட சமிக்ஞைகளை அசல் சமிக்ஞையுடன் ஒருங்கிணைக்கிறது. கட்ட-மாற்றப்பட்ட "
"சமிக்ஞைகளின் இயக்கம் குறைந்த அதிர்வெண் ஆசிலேட்டரைப் பயன்படுத்தி கட்டுப்படுத்தப்படுகிறது."

#: docs/AudioEffectPhaser.xml
msgid ""
"Governs how high the filter frequencies sweep. Low value will primarily "
"affect bass frequencies. High value can sweep high into the treble. Value "
"can range from 0.1 to 4."
msgstr ""
"வடிகட்டி அதிர்வெண்கள் எவ்வளவு அதிகமாக துடைக்கின்றன என்பதை நிர்வகிக்கிறது. குறைந்த "
"மதிப்பு முதன்மையாக பாச் அதிர்வெண்களை பாதிக்கும். அதிக மதிப்பு மும்மடங்காக உயரக்கூடும். "
"மதிப்பு 0.1 முதல் 4 வரை இருக்கலாம்."

#: docs/AudioEffectPhaser.xml
msgid "Output percent of modified sound. Value can range from 0.1 to 0.9."
msgstr ""
"மாற்றியமைக்கப்பட்ட ஒலியின் வெளியீட்டு விழுக்காடு. மதிப்பு 0.1 முதல் 0.9 வரை இருக்கலாம்."

#: docs/AudioEffectPhaser.xml
msgid ""
"Determines the maximum frequency affected by the LFO modulations, in Hz. "
"Value can range from 10 to 10000."
msgstr ""
"HZ இல், LFO மாடுலேட்டல்களால் பாதிக்கப்பட்ட அதிகபட்ச அதிர்வெண்ணை தீர்மானிக்கிறது. மதிப்பு "
"10 முதல் 10000 வரை இருக்கலாம்."

#: docs/AudioEffectPhaser.xml
msgid ""
"Determines the minimum frequency affected by the LFO modulations, in Hz. "
"Value can range from 10 to 10000."
msgstr ""
"HZ இல், LFO மாடுலேசன்களால் பாதிக்கப்பட்ட குறைந்தபட்ச அதிர்வெண்ணை தீர்மானிக்கிறது. மதிப்பு "
"10 முதல் 10000 வரை இருக்கலாம்."

#: docs/AudioEffectPhaser.xml
msgid ""
"Adjusts the rate in Hz at which the effect sweeps up and down across the "
"frequency range."
msgstr ""
"HZ இல் உள்ள விகிதத்தை சரிசெய்கிறது, இதன் மூலம் விளைவு அதிர்வெண் வரம்பில் மேலேயும் "
"கீழேயும் துடைக்கிறது."

#: docs/AudioEffectPitchShift.xml
msgid ""
"Adds a pitch-shifting audio effect to an Audio bus.\n"
"Raises or lowers the pitch of original sound."
msgstr ""
"ஆடியோ பச்சில் சுருதி மாற்றும் ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" அசல் ஒலியின் சுருதியை உயர்த்துகிறது அல்லது குறைக்கிறது."

#: docs/AudioEffectPitchShift.xml
msgid ""
"Allows modulation of pitch independently of tempo. All frequencies can be "
"increased/decreased with minimal effect on transients."
msgstr ""
"டெம்போவிலிருந்து சுயாதீனமாக சுருதியை மாற்றியமைக்க அனுமதிக்கிறது. அனைத்து "
"அதிர்வெண்களும் டிரான்சியண்டுகளில் குறைந்தபட்ச விளைவைக் கொண்டு அதிகரிக்கலாம்/குறைக்கப்படலாம்."

#: docs/AudioEffectPitchShift.xml
msgid ""
"The size of the [url=https://en.wikipedia.org/wiki/"
"Fast_Fourier_transform]Fast Fourier transform[/url] buffer. Higher values "
"smooth out the effect over time, but have greater latency. The effects of "
"this higher latency are especially noticeable on sounds that have sudden "
"amplitude changes."
msgstr ""
". அதிக மதிப்புகள் காலப்போக்கில் விளைவை மென்மையாக்குகின்றன, ஆனால் அதிக தாமதத்தைக் "
"கொண்டுள்ளன. இந்த உயர் தாமதத்தின் விளைவுகள் திடீர் வீச்சு மாற்றங்களைக் கொண்ட ஒலிகளில் "
"குறிப்பாக கவனிக்கப்படுகின்றன."

#: docs/AudioEffectPitchShift.xml
msgid ""
"The oversampling factor to use. Higher values result in better quality, but "
"are more demanding on the CPU and may cause audio cracking if the CPU can't "
"keep up."
msgstr ""
"பயன்படுத்த அதிகப்படியான காரணி. அதிக மதிப்புகள் சிறந்த தரத்தை விளைவிக்கின்றன, ஆனால் "
"சிபியு இல் அதிக தேவைப்படுகின்றன, மேலும் சிபியு ஐத் தொடர முடியாவிட்டால் ஆடியோ "
"விரிசலை ஏற்படுத்தக்கூடும்."

#: docs/AudioEffectPitchShift.xml
msgid ""
"The pitch scale to use. [code]1.0[/code] is the default pitch and plays "
"sounds unaltered. [member pitch_scale] can range from [code]0.0[/code] "
"(infinitely low pitch, inaudible) to [code]16[/code] (16 times higher than "
"the initial pitch)."
msgstr ""
"பயன்படுத்த சுருதி அளவு. [குறியீடு] 1.0 [/குறியீடு] என்பது இயல்புநிலை சுருதி மற்றும் "
"நாடகங்கள் மாற்றப்படாதவை. ."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"Use a buffer of 256 samples for the Fast Fourier transform. Lowest latency, "
"but least stable over time."
msgstr ""
"வேகமான ஃபோரியர் உருமாற்றத்திற்கு 256 மாதிரிகளின் இடையகத்தைப் பயன்படுத்தவும். குறைந்த "
"நேரந்தவறுகை, ஆனால் காலப்போக்கில் குறைந்தது."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"Use a buffer of 512 samples for the Fast Fourier transform. Low latency, but "
"less stable over time."
msgstr ""
"வேகமான ஃபோரியர் உருமாற்றத்திற்கு 512 மாதிரிகளின் இடையகத்தைப் பயன்படுத்தவும். குறைந்த "
"நேரந்தவறுகை, ஆனால் காலப்போக்கில் குறைந்த நிலையானது."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"Use a buffer of 1024 samples for the Fast Fourier transform. This is a "
"compromise between latency and stability over time."
msgstr ""
"வேகமான ஃபோரியர் உருமாற்றத்திற்கு 1024 மாதிரிகளின் இடையகத்தைப் பயன்படுத்தவும். இது "
"காலப்போக்கில் தாமதத்திற்கும் ச்திரத்தன்மைக்கும் இடையிலான சமரசமாகும்."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"Use a buffer of 2048 samples for the Fast Fourier transform. High latency, "
"but stable over time."
msgstr ""
"வேகமான ஃபோரியர் உருமாற்றத்திற்கு 2048 மாதிரிகளின் இடையகத்தைப் பயன்படுத்தவும். அதிக "
"நேரந்தவறுகை, ஆனால் காலப்போக்கில் நிலையானது."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"Use a buffer of 4096 samples for the Fast Fourier transform. Highest "
"latency, but most stable over time."
msgstr ""
"வேகமான ஃபோரியர் உருமாற்றத்திற்கு 4096 மாதிரிகளின் இடையகத்தைப் பயன்படுத்தவும். மிக "
"உயர்ந்த நேரந்தவறுகை, ஆனால் காலப்போக்கில் மிகவும் நிலையானது."

#: docs/AudioEffectPitchShift.xml docs/AudioEffectSpectrumAnalyzer.xml
msgid "Represents the size of the [enum FFT_Size] enum."
msgstr "[Enum fft_size] enum இன் அளவைக் குறிக்கிறது."

#: docs/AudioEffectRecord.xml
msgid "Audio effect used for recording the sound from an audio bus."
msgstr "ஆடியோ பச்சிலிருந்து ஒலியைப் பதிவு செய்ய ஆடியோ விளைவு பயன்படுத்தப்படுகிறது."

#: docs/AudioEffectRecord.xml
msgid ""
"Allows the user to record the sound from an audio bus. This can include all "
"audio output by Rebel Engine when used on the \"Master\" audio bus.\n"
"Can be used (with an [AudioStreamMicrophone]) to record from a microphone.\n"
"It sets and gets the format in which the audio file will be recorded (8-bit, "
"16-bit, or compressed). It checks whether or not the recording is active, "
"and if it is, records the sound. It then returns the recorded sample."
msgstr ""
"ஆடியோ பச்சிலிருந்து ஒலியை பதிவு செய்ய பயனரை அனுமதிக்கிறது. \"மாச்டர்\" ஆடியோ பச்சில் "
"பயன்படுத்தும்போது கிளர்ச்சி இயந்திரத்தின் அனைத்து ஆடியோ வெளியீடும் இதில் அடங்கும்.\n"
" மைக்ரோஃபோனிலிருந்து பதிவு செய்ய ([ஆடியோச்ட்ரீம்மிக்ரோபோன்] உடன்) பயன்படுத்தலாம்.\n"
" இது ஆடியோ கோப்பு பதிவு செய்யப்படும் (8-பிட், 16-பிட் அல்லது சுருக்கப்பட்ட) வடிவமைப்பை "
"அமைத்து பெறுகிறது. பதிவு செயலில் உள்ளதா இல்லையா என்பதை இது சரிபார்க்கிறது, அது "
"இருந்தால், ஒலியை பதிவு செய்கிறது. அது பதிவு செய்யப்பட்ட மாதிரியை வழங்குகிறது."

#: docs/AudioEffectRecord.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/"
"recording_with_microphone.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/"
"recording_with_microphone.html"

#: docs/AudioEffectRecord.xml
msgid "Returns the recorded sample."
msgstr "பதிவுசெய்யப்பட்ட மாதிரியை வழங்குகிறது."

#: docs/AudioEffectRecord.xml
msgid "Returns whether the recording is active or not."
msgstr "பதிவு செயலில் உள்ளதா இல்லையா என்பதைத் தருகிறது."

#: docs/AudioEffectRecord.xml
msgid ""
"If [code]true[/code], the sound will be recorded. Note that restarting the "
"recording will remove the previously recorded sample."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், ஒலி பதிவு செய்யப்படும். பதிவை மறுதொடக்கம் செய்வது "
"முன்னர் பதிவுசெய்யப்பட்ட மாதிரியை அகற்றும் என்பதை நினைவில் கொள்க."

#: docs/AudioEffectRecord.xml
msgid ""
"Specifies the format in which the sample will be recorded. See [enum "
"AudioStreamSample.Format] for available formats."
msgstr ""
"மாதிரி பதிவு செய்யப்படும் வடிவமைப்பைக் குறிப்பிடுகிறது. கிடைக்கக்கூடிய வடிவங்களுக்கு "
"[enum audiostreamsample.format] ஐப் பார்க்கவும்."

#: docs/AudioEffectReverb.xml
msgid ""
"Adds a reverberation audio effect to an Audio bus.\n"
"Simulates the sound of acoustic environments such as rooms, concert halls, "
"caverns, or an open spaces."
msgstr ""
"ஆடியோ பச்சில் எதிரொலிக்கும் ஆடியோ விளைவைச் சேர்க்கிறது.\n"
" அறைகள், அரங்கிசை அரங்குகள், குகைகள் அல்லது திறந்தவெளிகள் போன்ற ஒலி சூழல்களின் ஒலியை "
"உருவகப்படுத்துகிறது."

#: docs/AudioEffectReverb.xml
msgid ""
"Simulates rooms of different sizes. Its parameters can be adjusted to "
"simulate the sound of a specific room."
msgstr ""
"வெவ்வேறு அளவிலான அறைகளை உருவகப்படுத்துகிறது. ஒரு குறிப்பிட்ட அறையின் ஒலியை "
"உருவகப்படுத்த அதன் அளவுருக்களை சரிசெய்யலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"Defines how reflective the imaginary room's walls are. Value can range from "
"0 to 1."
msgstr ""
"கற்பனை அறையின் சுவர்கள் எவ்வளவு பிரதிபலிப்பு என்பதை வரையறுக்கிறது. மதிப்பு 0 முதல் 1 "
"வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"Output percent of original sound. At 0, only modified sound is outputted. "
"Value can range from 0 to 1."
msgstr ""
"அசல் ஒலியின் வெளியீட்டு விழுக்காடு. 0 இல், மாற்றியமைக்கப்பட்ட ஒலி மட்டுமே "
"வெளியிடப்படுகிறது. மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"High-pass filter passes signals with a frequency higher than a certain "
"cutoff frequency and attenuates signals with frequencies lower than the "
"cutoff frequency. Value can range from 0 to 1."
msgstr ""
"உயர்-பாச் வடிகட்டி ஒரு குறிப்பிட்ட வெட்டு அதிர்வெண்ணை விட அதிக அதிர்வெண் கொண்ட "
"சமிக்ஞைகளை கடந்து செல்கிறது மற்றும் வெட்டு அதிர்வெண்ணைக் காட்டிலும் குறைவான அதிர்வெண்களைக் "
"கொண்ட சமிக்ஞைகளை கவனிக்கிறது. மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid "Output percent of predelay. Value can range from 0 to 1."
msgstr "ப்ரிகிலேயின் வெளியீட்டு விழுக்காடு. மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"Time between the original signal and the early reflections of the reverb "
"signal, in milliseconds."
msgstr ""
"அசல் சமிக்ஞைக்கும் ரெவெர்ப் சிக்னலின் ஆரம்ப பிரதிபலிப்புகளுக்கும் இடையிலான நேரம், மில்லி "
"விநாடிகளில்."

#: docs/AudioEffectReverb.xml
msgid ""
"Dimensions of simulated room. Bigger means more echoes. Value can range from "
"0 to 1."
msgstr ""
"உருவகப்படுத்தப்பட்ட அறையின் பரிமாணங்கள். பெரியது என்றால் அதிக எதிரொலிகள். மதிப்பு 0 "
"முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"Widens or narrows the stereo image of the reverb tail. 1 means fully widens. "
"Value can range from 0 to 1."
msgstr ""
"ரெவெர்ப் வால் ச்டீரியோ படத்தை விரிவுபடுத்துகிறது அல்லது குறைக்கிறது. 1 என்றால் "
"முழுமையாக விரிவடைகிறது. மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectReverb.xml
msgid ""
"Output percent of modified sound. At 0, only original sound is outputted. "
"Value can range from 0 to 1."
msgstr ""
"மாற்றியமைக்கப்பட்ட ஒலியின் வெளியீட்டு விழுக்காடு. 0 இல், அசல் ஒலி மட்டுமே "
"வெளியிடப்படுகிறது. மதிப்பு 0 முதல் 1 வரை இருக்கலாம்."

#: docs/AudioEffectSpectrumAnalyzer.xml
msgid "Audio effect that can be used for real-time audio visualizations."
msgstr "நிகழ்நேர ஆடியோ காட்சிப்படுத்தல்களுக்கு பயன்படுத்தக்கூடிய ஆடியோ விளைவு."

#: docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"This audio effect does not affect sound output, but can be used for real-"
"time audio visualizations.\n"
"See also [AudioStreamGenerator] for procedurally generating sounds."
msgstr ""
"இந்த ஆடியோ விளைவு ஒலி வெளியீட்டை பாதிக்காது, ஆனால் நிகழ்நேர ஆடியோ "
"காட்சிப்படுத்தல்களுக்கு பயன்படுத்தலாம்.\n"
" நடைமுறையில் ஒலிகளை உருவாக்கும் [ஆடியோச்ட்ரீம்செனரேட்டர்] ஐயும் காண்க."

#: docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"The length of the buffer to keep (in seconds). Higher values keep data "
"around for longer, but require more memory."
msgstr ""
"வைத்திருக்க இடையகத்தின் நீளம் (நொடிகளில்). அதிக மதிப்புகள் தரவை நீண்ட நேரம் "
"வைத்திருக்கின்றன, ஆனால் அதிக நினைவகம் தேவை."

#: docs/AudioEffectSpectrumAnalyzer.xml
msgid ""
"The size of the [url=https://en.wikipedia.org/wiki/"
"Fast_Fourier_transform]Fast Fourier transform[/url] buffer. Higher values "
"smooth out the spectrum analysis over time, but have greater latency. The "
"effects of this higher latency are especially noticeable with sudden "
"amplitude changes."
msgstr ""
". அதிக மதிப்புகள் காலப்போக்கில் ச்பெக்ட்ரம் பகுப்பாய்வை மென்மையாக்குகின்றன, ஆனால் அதிக "
"தாமதத்தைக் கொண்டுள்ளன. இந்த உயர் தாமதத்தின் விளைவுகள் திடீர் வீச்சு மாற்றங்களுடன் குறிப்பாக "
"கவனிக்கப்படுகின்றன."

#: docs/AudioEffectSpectrumAnalyzerInstance.xml
msgid "Use the average value as magnitude."
msgstr "சராசரி மதிப்பை அளவாக பயன்படுத்தவும்."

#: docs/AudioEffectSpectrumAnalyzerInstance.xml
msgid "Use the maximum value as magnitude."
msgstr "அதிகபட்ச மதிப்பை அளவாக பயன்படுத்தவும்."

#: docs/AudioServer.xml
msgid "Server interface for low-level audio access."
msgstr "குறைந்த-நிலை ஆடியோ அணுகலுக்கான சேவையக இடைமுகம்."

#: docs/AudioServer.xml
msgid ""
"[AudioServer] is a low-level server interface for audio access. It is in "
"charge of creating sample data (playable audio) as well as its playback via "
"a voice interface."
msgstr ""
"[ஆடியோசர்வர்] என்பது ஆடியோ அணுகலுக்கான குறைந்த அளவிலான சேவையக இடைமுகமாகும். இது "
"மாதிரி தரவு (விளையாடக்கூடிய ஆடியோ) மற்றும் குரல் இடைமுகம் வழியாக அதன் பின்னணி "
"ஆகியவற்றை உருவாக்கும் பொறுப்பாகும்."

#: docs/AudioServer.xml
msgid "Adds a bus at [code]at_position[/code]."
msgstr "[குறியீடு] at_position [/code] இல் ஒரு பச் சேர்க்கிறது."

#: docs/AudioServer.xml
msgid ""
"Adds an [AudioEffect] effect to the bus [code]bus_idx[/code] at "
"[code]at_position[/code]."
msgstr ""
"[குறியீடு] AT_POSITION [/code] இல் பச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] க்கு "
"[ஆடியோஃபெக்ட்] விளைவைச் சேர்க்கிறது."

#: docs/AudioServer.xml
msgid ""
"Name of the current device for audio input (see [method "
"capture_get_device_list]). The value [code]\"Default\"[/code] means that the "
"system-wide default audio input is currently used."
msgstr ""
"ஆடியோ உள்ளீட்டிற்கான தற்போதைய சாதனத்தின் பெயர் ([முறை capeture_get_device_list] ஐப் "
"பார்க்கவும்). மதிப்பு [குறியீடு] \"இயல்புநிலை\" [/குறியீடு] என்பது கணினி அளவிலான "
"இயல்புநிலை ஆடியோ உள்ளீடு தற்போது பயன்படுத்தப்படுகிறது."

#: docs/AudioServer.xml
msgid "Returns the names of all audio input devices detected on the system."
msgstr ""
"கணினியில் கண்டறியப்பட்ட அனைத்து ஆடியோ உள்ளீட்டு சாதனங்களின் பெயர்களையும் வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Sets which audio input device is used for audio capture. On systems with "
"multiple audio inputs (such as analog and USB), this can be used to select "
"the audio input device. Setting the value [code]\"Default\"[/code] will "
"record audio from the system-wide default audio input. If an invalid device "
"name is set, the value will be reverted back to [code]\"Default\"[/code]."
msgstr ""
"ஆடியோ பிடிப்புக்கு எந்த ஆடியோ உள்ளீட்டு சாதனம் பயன்படுத்தப்படுகிறது என்பதை அமைக்கிறது. "
"பல ஆடியோ உள்ளீடுகளைக் கொண்ட கணினிகளில் (அனலாக் மற்றும் யூ.எச்.பி போன்றவை), ஆடியோ "
"உள்ளீட்டு சாதனத்தைத் தேர்ந்தெடுக்க இதைப் பயன்படுத்தலாம். மதிப்பை அமைப்பது [குறியீடு] "
"\"இயல்புநிலை\" [/குறியீடு] கணினி அளவிலான இயல்புநிலை ஆடியோ உள்ளீட்டிலிருந்து "
"ஆடியோவைப் பதிவு செய்யும். தவறான சாதன பெயர் அமைக்கப்பட்டால், மதிப்பு [குறியீடு] "
"\"இயல்புநிலை\" [/குறியீடு] க்கு மாற்றப்படும்."

#: docs/AudioServer.xml
msgid "Generates an [AudioBusLayout] using the available buses and effects."
msgstr ""
"கிடைக்கக்கூடிய பேருந்துகள் மற்றும் விளைவுகளைப் பயன்படுத்தி [ஆடியோபுச்லேஅவுட்] "
"உருவாக்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the amount of channels of the bus at index [code]bus_idx[/code]."
msgstr ""
"குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் பச்சின் சேனல்களின் அளவை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the [AudioEffect] at position [code]effect_idx[/code] in bus "
"[code]bus_idx[/code]."
msgstr ""
"பச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் [குறியீடு] எஃபெக்ட்_ஐடிஎக்ச் [/குறியீடு] "
"நிலையில் உள்ள [ஆடியோஃபெக்ட்] ஐ வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the number of effects on the bus at [code]bus_idx[/code]."
msgstr ""
"[குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் பச்சில் விளைவுகளின் எண்ணிக்கையை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the [AudioEffectInstance] assigned to the given bus and effect "
"indices (and optionally channel)."
msgstr ""
"கொடுக்கப்பட்ட பச் மற்றும் விளைவு குறியீடுகளுக்கு (மற்றும் விருப்பமாக சேனல்) ஒதுக்கப்பட்ட "
"[ஆடியோஃபெக்டின்ச்டன்ச்] ஐ வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the index of the bus with the name [code]bus_name[/code]."
msgstr "[குறியீடு] பச்_பேம் [/குறியீடு] என்ற பெயருடன் பச்சின் குறியீட்டை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the name of the bus with the index [code]bus_idx[/code]."
msgstr "குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] உடன் பச்சின் பெயரை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the peak volume of the left speaker at bus index [code]bus_idx[/"
"code] and channel index [code]channel[/code]."
msgstr ""
"பச் இன்டெக்ச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] மற்றும் சேனல் இன்டெக்ச் [குறியீடு] சேனல் [/"
"குறியீடு] ஆகியவற்றில் இடது ச்பீக்கரின் உச்ச அளவை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the peak volume of the right speaker at bus index [code]bus_idx[/"
"code] and channel index [code]channel[/code]."
msgstr ""
"பச் இன்டெக்ச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] மற்றும் சேனல் இன்டெக்ச் [குறியீடு] சேனல் [/"
"குறியீடு] ஆகியவற்றில் வலது ச்பீக்கரின் உச்ச அளவை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Returns the name of the bus that the bus at index [code]bus_idx[/code] sends "
"to."
msgstr ""
"குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] அனுப்பும் பச் பச் பெயரை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the volume of the bus at index [code]bus_idx[/code] in dB."
msgstr "டி.பியில் பச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் பச்சின் அளவை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the names of all audio devices detected on the system."
msgstr "கணினியில் கண்டறியப்பட்ட அனைத்து ஆடியோ சாதனங்களின் பெயர்களையும் வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the sample rate at the output of the [AudioServer]."
msgstr "[ஆடியோசர்வர்] வெளியீட்டில் மாதிரி வீதத்தை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the audio driver's output latency."
msgstr "ஆடியோ டிரைவரின் வெளியீட்டு தாமதத்தை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the speaker configuration."
msgstr "ச்பீக்கர் உள்ளமைவை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the relative time since the last mix occurred."
msgstr "கடைசி கலவை நிகழ்ந்ததிலிருந்து உறவினர் நேரத்தை வழங்குகிறது."

#: docs/AudioServer.xml
msgid "Returns the relative time until the next mix occurs."
msgstr "அடுத்த கலவை ஏற்படும் வரை உறவினர் நேரத்தை வழங்குகிறது."

#: docs/AudioServer.xml
msgid ""
"If [code]true[/code], the bus at index [code]bus_idx[/code] is bypassing "
"effects."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் "
"உள்ள பச் விளைவுகளைத் தவிர்த்து விடுகிறது."

#: docs/AudioServer.xml
msgid ""
"If [code]true[/code], the effect at index [code]effect_idx[/code] on the bus "
"at index [code]bus_idx[/code] is enabled."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், குறியீட்டு [குறியீடு] குறியெண் [குறியீடு] "
"பச்_ஐடிஎக்ச் [/குறியீடு] இல் உள்ள குறியீட்டில் [குறியீடு] Effect_idx [/code] இன் விளைவு "
"இயக்கப்பட்டது."

#: docs/AudioServer.xml
msgid "If [code]true[/code], the bus at index [code]bus_idx[/code] is muted."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் "
"உள்ள பச் முடக்கப்பட்டுள்ளது."

#: docs/AudioServer.xml
msgid ""
"If [code]true[/code], the bus at index [code]bus_idx[/code] is in solo mode."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் "
"உள்ள பச் தனி பயன்முறையில் உள்ளது."

#: docs/AudioServer.xml
msgid ""
"Locks the audio driver's main loop.\n"
"[b]Note:[/b] Remember to unlock it afterwards."
msgstr ""
"ஆடியோ டிரைவரின் முதன்மையான வளையத்தை பூட்டுகிறது.\n"
" [b] குறிப்பு: [/b] பின்னர் அதைத் திறக்க நினைவில் கொள்ளுங்கள்."

#: docs/AudioServer.xml
msgid ""
"Moves the bus from index [code]index[/code] to index [code]to_index[/code]."
msgstr ""
"குறியீட்டு [குறியீடு] குறியீட்டிலிருந்து [/குறியீடு] குறியெண் [குறியீடு] to_index [/"
"code] க்கு பச்சை நகர்த்துகிறது."

#: docs/AudioServer.xml
msgid "Removes the bus at index [code]index[/code]."
msgstr "குறியீட்டு [குறியீடு] குறியீட்டில் [/குறியீடு] பச்சை நீக்குகிறது."

#: docs/AudioServer.xml
msgid ""
"Removes the effect at index [code]effect_idx[/code] from the bus at index "
"[code]bus_idx[/code]."
msgstr ""
"குறியீட்டு [குறியீடு] feult_idx [/code] இல் உள்ள விளைவை குறியீட்டு [குறியீடு] "
"பச்_ஐடிஎக்ச் [/குறியீடு] இல் இருந்து நீக்குகிறது."

#: docs/AudioServer.xml
msgid "Overwrites the currently used [AudioBusLayout]."
msgstr "தற்போது பயன்படுத்தப்படும் [ஆடியோ தளவமைப்பு] ஐ மேலெழுதவும்."

#: docs/AudioServer.xml
msgid ""
"Sets the name of the bus at index [code]bus_idx[/code] to [code]name[/code]."
msgstr ""
"பச்சின் பெயரை குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் [குறியீடு] பெயர் [/"
"குறியீடு] என அமைக்கிறது."

#: docs/AudioServer.xml
msgid ""
"Connects the output of the bus at [code]bus_idx[/code] to the bus named "
"[code]send[/code]."
msgstr ""
"[குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் பச்சின் வெளியீட்டை [குறியீடு] அனுப்பு [/குறியீடு] "
"என்ற பெயரில் இணைக்கிறது."

#: docs/AudioServer.xml
msgid ""
"Sets the volume of the bus at index [code]bus_idx[/code] to [code]volume_db[/"
"code]."
msgstr ""
"பச்சின் அளவை குறியீட்டு [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் [குறியீடு] தொகுதி_டிபி "
"[/குறியீடு] என அமைக்கிறது."

#: docs/AudioServer.xml
msgid "Swaps the position of two effects in bus [code]bus_idx[/code]."
msgstr ""
"பச் [குறியீடு] பச்_ஐடிஎக்ச் [/குறியீடு] இல் இரண்டு விளைவுகளின் நிலையை மாற்றுகிறது."

#: docs/AudioServer.xml
msgid ""
"Unlocks the audio driver's main loop. (After locking it, you should always "
"unlock it.)"
msgstr ""
"ஆடியோ டிரைவரின் முதன்மையான வளையத்தைத் திறக்கும். (அதைப் பூட்டிய பிறகு, நீங்கள் எப்போதும் "
"அதைத் திறக்க வேண்டும்.)"

#: docs/AudioServer.xml
msgid "Number of available audio buses."
msgstr "கிடைக்கக்கூடிய ஆடியோ பேருந்துகளின் எண்ணிக்கை."

#: docs/AudioServer.xml
msgid ""
"Name of the current device for audio output (see [method get_device_list]). "
"On systems with multiple audio outputs (such as analog, USB and HDMI audio), "
"this can be used to select the audio output device. The value [code]"
"\"Default\"[/code] will play audio on the system-wide default audio output. "
"If an invalid device name is set, the value will be reverted back to [code]"
"\"Default\"[/code]."
msgstr ""
"ஆடியோ வெளியீட்டிற்கான தற்போதைய சாதனத்தின் பெயர் ([முறை get_device_list] ஐப் "
"பார்க்கவும்). பல ஆடியோ வெளியீடுகளைக் கொண்ட கணினிகளில் (அனலாக், யூ.எச்.பி மற்றும் "
"எச்.டி.எம்.ஐ ஆடியோ போன்றவை), ஆடியோ வெளியீட்டு சாதனத்தைத் தேர்ந்தெடுக்க இதைப் "
"பயன்படுத்தலாம். மதிப்பு [குறியீடு] \"இயல்புநிலை\" [/குறியீடு] கணினி அளவிலான "
"இயல்புநிலை ஆடியோ வெளியீட்டில் ஆடியோவை இயக்கும். தவறான சாதன பெயர் அமைக்கப்பட்டால், "
"மதிப்பு [குறியீடு] \"இயல்புநிலை\" [/குறியீடு] க்கு மாற்றப்படும்."

#: docs/AudioServer.xml
msgid ""
"Scales the rate at which audio is played (i.e. setting it to [code]0.5[/"
"code] will make the audio be played twice as fast)."
msgstr ""
"ஆடியோ இயக்கப்படும் வீதத்தை அளவிடுகிறது (அதாவது அதை [குறியீடு] 0.5 [/குறியீடு] என "
"அமைப்பது ஆடியோவை இரண்டு மடங்கு வேகமாக இயக்கும்)."

#: docs/AudioServer.xml
msgid "Emitted when the [AudioBusLayout] changes."
msgstr "[ஆடியோபுச்லேஅவுட்] மாறும்போது உமிழப்படும்."

#: docs/AudioServer.xml
msgid "Two or fewer speakers were detected."
msgstr "இரண்டு அல்லது குறைவான பேச்சாளர்கள் கண்டறியப்பட்டனர்."

#: docs/AudioServer.xml
msgid "A 3.1 channel surround setup was detected."
msgstr "3.1 சேனல் சரவுண்ட் அமைப்பு கண்டறியப்பட்டது."

#: docs/AudioServer.xml
msgid "A 5.1 channel surround setup was detected."
msgstr "5.1 சேனல் சரவுண்ட் அமைப்பு கண்டறியப்பட்டது."

#: docs/AudioServer.xml
msgid "A 7.1 channel surround setup was detected."
msgstr "7.1 சேனல் சரவுண்ட் அமைப்பு கண்டறியப்பட்டது."

#: docs/AudioStream.xml
msgid "Base class for audio streams."
msgstr "ஆடியோ ச்ட்ரீம்களுக்கான அடிப்படை வகுப்பு."

#: docs/AudioStream.xml
msgid ""
"Base class for audio streams. Audio streams are used for sound effects and "
"music playback, and support WAV (via [AudioStreamSample]) and OGG (via "
"[AudioStreamOGGVorbis]) file formats."
msgstr ""
"ஆடியோ ச்ட்ரீம்களுக்கான அடிப்படை வகுப்பு. ஆடியோ ச்ட்ரீம்கள் ஒலி விளைவுகள் மற்றும் மியூசிக் "
"பிளேபேக்கிற்கு பயன்படுத்தப்படுகின்றன, மேலும் WAV ([ஆடியோச்ட்ரீம் மாதிரி] வழியாக) மற்றும் "
"OGG ([ஆடியோச்ட்ரீம் OGG VORBIS] வழியாக) கோப்பு வடிவங்களை ஆதரிக்கின்றன."

#: docs/AudioStream.xml docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/audio_streams.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/audio/audio_streams.html"

#: docs/AudioStream.xml
msgid "Returns the length of the audio stream in seconds."
msgstr "ஆடியோ ச்ட்ரீமின் நீளத்தை நொடிகளில் வழங்குகிறது."

#: docs/AudioStreamGenerator.xml
msgid "Audio stream that generates sounds procedurally."
msgstr "நடைமுறையில் ஒலிகளை உருவாக்கும் ஆடியோ ச்ட்ரீம்."

#: docs/AudioStreamGenerator.xml
msgid ""
"This audio stream does not play back sounds, but expects a script to "
"generate audio data for it instead. See also "
"[AudioStreamGeneratorPlayback].\n"
"See also [AudioEffectSpectrumAnalyzer] for performing real-time audio "
"spectrum analysis.\n"
"[b]Note:[/b] Due to performance constraints, this class is best used from C# "
"or from a compiled language via GDNative. If you still want to use this "
"class from GDScript, consider using a lower [member mix_rate] such as 11,025 "
"Hz or 22,050 Hz."
msgstr ""
"இந்த ஆடியோ ச்ட்ரீம் மீண்டும் ஒலிகளை இயக்காது, ஆனால் ஒரு ச்கிரிப்ட் அதற்கு பதிலாக ஆடியோ "
"தரவை உருவாக்கும் என்று எதிர்பார்க்கிறது. [ஆடியோச்ட்ரீம்செனரேட்டர் பிளேபேக்] ஐயும் காண்க.\n"
" நிகழ்நேர ஆடியோ ச்பெக்ட்ரம் பகுப்பாய்வைச் செய்வதற்கு [ஆடியோஎஃப்ட்ச்ச்பெக்ட்ரூமனலைசர்] மேலும் "
"காண்க.\n"
" . GDSCRIPT இலிருந்து இந்த வகுப்பை நீங்கள் இன்னும் பயன்படுத்த விரும்பினால், 11,025 எர்ட்ச் "
"அல்லது 22,050 எர்ட்ச் போன்ற குறைந்த [உறுப்பினர் மிக்ச்_ரேட்] ஐப் பயன்படுத்துவதைக் கவனியுங்கள்."

#: docs/AudioStreamGenerator.xml
msgid ""
"The length of the buffer to generate (in seconds). Lower values result in "
"less latency, but require the script to generate audio data faster, "
"resulting in increased CPU usage and more risk for audio cracking if the CPU "
"can't keep up."
msgstr ""
"உருவாக்க இடையகத்தின் நீளம் (நொடிகளில்). குறைந்த மதிப்புகள் குறைவான தாமதத்தை "
"விளைவிக்கின்றன, ஆனால் ச்கிரிப்ட் ஆடியோ தரவை வேகமாக உருவாக்க வேண்டும், இதன் விளைவாக "
"சிபியு பயன்பாடு அதிகரித்தது மற்றும் சிபியு ஐத் தொடர முடியாவிட்டால் ஆடியோ கிராக்கிங் "
"அதிக இடர் ஏற்படுகிறது."

#: docs/AudioStreamGenerator.xml
msgid ""
"The sample rate to use (in Hz). Higher values are more demanding for the CPU "
"to generate, but result in better quality.\n"
"In games, common sample rates in use are [code]11025[/code], [code]16000[/"
"code], [code]22050[/code], [code]32000[/code], [code]44100[/code], and "
"[code]48000[/code].\n"
"According to the [url=https://en.wikipedia.org/wiki/"
"Nyquist%E2%80%93Shannon_sampling_theorem]Nyquist-Shannon sampling theorem[/"
"url], there is no quality difference to human hearing when going past 40,000 "
"Hz (since most humans can only hear up to ~20,000 Hz, often less). If you "
"are generating lower-pitched sounds such as voices, lower sample rates such "
"as [code]32000[/code] or [code]22050[/code] may be usable with no loss in "
"quality."
msgstr ""
"பயன்படுத்த வேண்டிய மாதிரி வீதம் (HZ இல்). சிபியு ஐ உருவாக்க அதிக மதிப்புகள் அதிக "
"தேவை, ஆனால் சிறந்த தரத்தை ஏற்படுத்துகின்றன.\n"
" கேம்களில், பயன்பாட்டில் உள்ள பொதுவான மாதிரி விகிதங்கள் [குறியீடு] 11025 [/குறியீடு], "
"[குறியீடு] 16000 [/குறியீடு], [குறியீடு] 22050 [/குறியீடு], [குறியீடு] 32000 [/"
"குறியீடு], [குறியீடு] 44100 [/குறியீடு] மற்றும் [குறியீடு] 48000 [/குறியீடு].\n"
" . குரல்கள் போன்ற குறைந்த பிட்ச் ஒலிகளை நீங்கள் உருவாக்குகிறீர்கள் என்றால், [குறியீடு] 32000 "
"[/குறியீடு] அல்லது [குறியீடு] 22050 [/குறியீடு] போன்ற குறைந்த மாதிரி விகிதங்கள் "
"தரத்தில் எந்த இழப்பும் இல்லாமல் பயன்படுத்தக்கூடியதாக இருக்கலாம்."

#: docs/AudioStreamGeneratorPlayback.xml
msgid "Plays back audio generated using [AudioStreamGenerator]."
msgstr "[ஆடியோச்ட்ரீம்செனரேட்டர்] ஐப் பயன்படுத்தி உருவாக்கப்பட்ட ஆடியோவை மீண்டும் இயக்குகிறது."

#: docs/AudioStreamGeneratorPlayback.xml
msgid ""
"This class is meant to be used with [AudioStreamGenerator] to play back the "
"generated audio in real-time."
msgstr ""
"இந்த வகுப்பு உருவாக்கப்பட்ட ஆடியோவை நிகழ்நேரத்தில் மீண்டும் இயக்க [ஆடியோச்ட்ரீம்செனரேட்டர்] "
"உடன் பயன்படுத்தப்பட வேண்டும்."

#: docs/AudioStreamGeneratorPlayback.xml
msgid ""
"Returns [code]true[/code] if a buffer of the size [code]amount[/code] can be "
"pushed to the audio sample data buffer without overflowing it, [code]false[/"
"code] otherwise."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] ஐத் தருகிறது [குறியீடு] அளவு [/குறியீடு] ஆடியோ மாதிரி "
"தரவு இடையகத்தை நிரம்பி வழிகிறது, [குறியீடு] பொய் [/குறியீடு] இல்லையெனில்."

#: docs/AudioStreamGeneratorPlayback.xml
msgid "Clears the audio sample data buffer."
msgstr "ஆடியோ மாதிரி தரவு இடையகத்தை அழிக்கிறது."

#: docs/AudioStreamGeneratorPlayback.xml
msgid ""
"Returns the number of audio data frames left to play. If this returned "
"number reaches [code]0[/code], the audio will stop playing until frames are "
"added again. Therefore, make sure your script can always generate and push "
"new audio frames fast enough to avoid audio cracking."
msgstr ""
"விளையாட எஞ்சியிருக்கும் ஆடியோ தரவு பிரேம்களின் எண்ணிக்கையை வழங்குகிறது. இந்த திரும்பிய "
"எண் [குறியீடு] 0 [/குறியீட்டை] அடைந்தால், பிரேம்கள் மீண்டும் சேர்க்கப்படும் வரை ஆடியோ "
"விளையாடுவதை நிறுத்திவிடும். எனவே, உங்கள் ச்கிரிப்ட் எப்போதுமே ஆடியோ விரிசலைத் "
"தவிர்ப்பதற்கு புதிய ஆடியோ பிரேம்களை வேகமாக உருவாக்க முடியும் என்பதை உறுதிப்படுத்திக் "
"கொள்ளுங்கள்."

#: docs/AudioStreamGeneratorPlayback.xml
msgid ""
"Pushes several audio data frames to the buffer. This is usually more "
"efficient than [method push_frame] in C# and compiled languages via "
"GDNative, but [method push_buffer] may be [i]less[/i] efficient in GDScript."
msgstr ""
"பல ஆடியோ தரவு பிரேம்களை இடையகத்திற்கு தள்ளுகிறது. இது பொதுவாக சி# இல் [முறை "
"புச்_ஃப்ரேம்] மற்றும் சி.டி.என்.ஏடிவ் வழியாக தொகுக்கப்பட்ட மொழிகளை விட மிகவும் "
"திறமையானது, ஆனால் [முறை புச்_பஃபர்] சி.டி.எச்.ச்கிரிப்டில் திறமையாக [i] குறைவாக "
"இருக்கலாம்."

#: docs/AudioStreamGeneratorPlayback.xml
msgid ""
"Pushes a single audio data frame to the buffer. This is usually less "
"efficient than [method push_buffer] in C# and compiled languages via "
"GDNative, but [method push_frame] may be [i]more[/i] efficient in GDScript."
msgstr ""
"ஒற்றை ஆடியோ தரவு சட்டகத்தை இடையகத்திற்கு தள்ளுகிறது. இது பொதுவாக சி# இல் [முறை "
"புச்_பஃபர்] ஐ விட குறைவான செயல்திறன் கொண்டது மற்றும் சி.டி.என்.ஏடிவ் வழியாக "
"தொகுக்கப்பட்ட மொழிகள், ஆனால் [முறை புச்_ஃப்ரேம்] சி.டி.எச்ச்கிரிப்டில் திறமையாக இருக்கலாம்."

#: modules/minimp3/docs/AudioStreamMP3.xml
msgid "MP3 audio stream driver."
msgstr "எம்பி 3 ஆடியோ ச்ட்ரீம் டிரைவர்."

#: modules/minimp3/docs/AudioStreamMP3.xml
#: modules/stb_vorbis/docs/AudioStreamOGGVorbis.xml
msgid "Contains the audio data in bytes."
msgstr "பைட்டுகளில் ஆடியோ தரவைக் கொண்டுள்ளது."

#: modules/minimp3/docs/AudioStreamMP3.xml
#: modules/stb_vorbis/docs/AudioStreamOGGVorbis.xml
msgid ""
"If [code]true[/code], the stream will automatically loop when it reaches the "
"end."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், ச்ட்ரீம் தானாகவே அதை அடையும் போது அது சுழலும்."

#: modules/minimp3/docs/AudioStreamMP3.xml
#: modules/stb_vorbis/docs/AudioStreamOGGVorbis.xml
msgid "Time in seconds at which the stream starts after being looped."
msgstr "நீரோடை சுழற்றிய பின் தொடங்கும் வினாடிகளில் நேரம்."

#: modules/stb_vorbis/docs/AudioStreamOGGVorbis.xml
msgid "OGG Vorbis audio stream driver."
msgstr "OGG வோர்பிச் ஆடியோ ச்ட்ரீம் இயக்கி."

#: docs/AudioStreamPlayback.xml
msgid "Meta class for playing back audio."
msgstr "ஆடியோவை மீண்டும் இயக்க மேவு வகுப்பு."

#: docs/AudioStreamPlayback.xml
msgid ""
"Can play, loop, pause a scroll through audio. See [AudioStream] and "
"[AudioStreamOGGVorbis] for usage."
msgstr ""
"ஆடியோ மூலம் உருட்டலை இடைநிறுத்தலாம். பயன்பாட்டிற்கு [ஆடியோச்ட்ரீம்] மற்றும் "
"[ஆடியோச்ட்ரீமாக்ச்வார்பிச்] ஐப் பார்க்கவும்."

#: docs/AudioStreamPlayer.xml
msgid "Plays back audio non-positionally."
msgstr "பிளேபேக் ஆடியோ-நிலை இல்லை."

#: docs/AudioStreamPlayer.xml
msgid ""
"Plays an audio stream non-positionally.\n"
"To play audio positionally, use [AudioStreamPlayer2D] or "
"[AudioStreamPlayer3D] instead of [AudioStreamPlayer]."
msgstr ""
"ஆடியோ ச்ட்ரீமை நிலையற்ற முறையில் இயக்குகிறது.\n"
" [ஆடியோச்ட்ரீஆம்ப்ளேயர் 2 டி] அல்லது [ஆடியோச்ட்ரீஆக்லே பிளேயர் 3 டி] [ஆடியோச்ட்ரீஆம்ப்ளேயர்] "
"க்கு பதிலாக ஆடியோவை இயக்க ஆடியோவை இயக்கவும்."

#: docs/AudioStreamPlayer.xml
msgid "Returns the position in the [AudioStream] in seconds."
msgstr "[ஆடியோச்ட்ரீமில்] நொடிகளில் நிலையை வழங்குகிறது."

#: docs/AudioStreamPlayer.xml
msgid ""
"Returns the [AudioStreamPlayback] object associated with this "
"[AudioStreamPlayer]."
msgstr ""
"இந்த [ஆடியோச்ட்ரீஆம்ப்ளேயர்] உடன் தொடர்புடைய [ஆடியோச்ட்ரீஆம்ப்ளே பேக்] பொருளை வழங்குகிறது."

#: docs/AudioStreamPlayer.xml
msgid "Plays the audio from the given [code]from_position[/code], in seconds."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] இலிருந்து_போசிசன் [/குறியீடு] இலிருந்து ஆடியோவை நொடிகளில் "
"இயக்குகிறது."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid "Sets the position from which audio will be played, in seconds."
msgstr "ஆடியோ எந்த நொடிகளில் இயக்கப்படும் என்ற நிலையை அமைக்கிறது."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid "Stops the audio."
msgstr "ஆடியோவை நிறுத்துகிறது."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
msgid "If [code]true[/code], audio plays when added to scene tree."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், காட்சி மரத்தில் சேர்க்கும்போது ஆடியோ நாடகங்கள்."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
msgid "Bus on which this audio is playing."
msgstr "இந்த ஆடியோ இயங்கும் பச்."

#: docs/AudioStreamPlayer.xml
msgid ""
"If the audio configuration has more than two speakers, this sets the target "
"channels. See [enum MixTarget] constants."
msgstr ""
"ஆடியோ உள்ளமைவில் இரண்டு ச்பீக்கர்கள் இருந்தால், இது இலக்கு சேனல்களை அமைக்கிறது. [Enum "
"mixtarget] மாறிலிகளைக் காண்க."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid ""
"The pitch and the tempo of the audio, as a multiplier of the audio sample's "
"sample rate."
msgstr "ஆடியோ மாதிரியின் மாதிரி வீதத்தின் பெருக்கமாக ஆடியோவின் சுருதி மற்றும் டெம்போ."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid "If [code]true[/code], audio is playing."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், ஆடியோ இயங்குகிறது."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
msgid "The [AudioStream] object to be played."
msgstr "[ஆடியோச்ட்ரீம்] பொருள் விளையாட வேண்டும்."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
msgid ""
"If [code]true[/code], the playback is paused. You can resume it by setting "
"[code]stream_paused[/code] to [code]false[/code]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பின்னணி இடைநிறுத்தப்படுகிறது. [குறியீடு] [/"
"குறியீடு] [குறியீடு] தவறான [/குறியீடு] என அமைப்பதன் மூலம் அதை மீண்டும் தொடங்கலாம்."

#: docs/AudioStreamPlayer.xml
msgid "Volume of sound, in dB."
msgstr "ஒலியின் அளவு, டி.பியில்."

#: docs/AudioStreamPlayer.xml docs/AudioStreamPlayer2D.xml
#: docs/AudioStreamPlayer3D.xml
msgid "Emitted when the audio stops playing."
msgstr "ஆடியோ விளையாடுவதை நிறுத்தும்போது உமிழும்."

#: docs/AudioStreamPlayer.xml
msgid "The audio will be played only on the first channel."
msgstr "ஆடியோ முதல் சேனலில் மட்டுமே இயக்கப்படும்."

#: docs/AudioStreamPlayer.xml
msgid "The audio will be played on all surround channels."
msgstr "ஆடியோ அனைத்து சரவுண்ட் சேனல்களிலும் இயக்கப்படும்."

#: docs/AudioStreamPlayer.xml
msgid ""
"The audio will be played on the second channel, which is usually the center."
msgstr "இரண்டாவது சேனலில் ஆடியோ இயக்கப்படும், இது பொதுவாக மையமாக இருக்கும்."

#: docs/AudioStreamPlayer2D.xml
msgid "Plays positional sound in 2D space."
msgstr "2 டி இடத்தில் நிலை ஒலியை இயக்குகிறது."

#: docs/AudioStreamPlayer2D.xml
msgid ""
"Plays audio that dampens with distance from screen center.\n"
"See also [AudioStreamPlayer] to play a sound non-positionally.\n"
"[b]Note:[/b] Hiding an [AudioStreamPlayer2D] node does not disable its audio "
"output. To temporarily disable an [AudioStreamPlayer2D]'s audio output, set "
"[member volume_db] to a very low value like [code]-100[/code] (which isn't "
"audible to human hearing)."
msgstr ""
"திரை மையத்திலிருந்து தூரத்துடன் குறைக்கும் ஆடியோவை இயக்குகிறது.\n"
" ஒரு ஒலி அல்லாத முறையில் விளையாட [ஆடியோச்ட்ரீஆம்ப்ளேயர்] ஐயும் காண்க.\n"
" . [ஆடியோச்ட்ரீஆம்ப்ளேயர் 2 டி] இன் ஆடியோ வெளியீட்டை தற்காலிகமாக முடக்க, [குறியீடு] -100 "
"[/குறியீடு] போன்ற மிகக் குறைந்த மதிப்புக்கு [உறுப்பினர் தொகுதி_டிபி] அமைக்கவும் (இது "
"மனித விசாரணைக்கு கேட்கப்படவில்லை)."

#: docs/AudioStreamPlayer2D.xml docs/AudioStreamPlayer3D.xml
msgid "Returns the position in the [AudioStream]."
msgstr "[ஆடியோச்ட்ரீமில்] நிலையை வழங்குகிறது."

#: docs/AudioStreamPlayer2D.xml
msgid ""
"Returns the [AudioStreamPlayback] object associated with this "
"[AudioStreamPlayer2D]."
msgstr ""
"இதனுடன் தொடர்புடைய [ஆடியோச்ட்ரீஆம்ப்ளே பேக்] பொருளை வழங்குகிறது [ஆடியோச்ட்ரீஆம்ப்ளேயர் 2 "
"டி]."

#: docs/AudioStreamPlayer2D.xml docs/AudioStreamPlayer3D.xml
msgid ""
"Plays the audio from the given position [code]from_position[/code], in "
"seconds."
msgstr ""
"கொடுக்கப்பட்ட நிலையில் இருந்து [குறியீடு] ஆடியோவை_போசிசனில் இருந்து [/குறியீடு] "
"நொடிகளில் இயக்குகிறது."

#: docs/AudioStreamPlayer2D.xml
msgid ""
"Determines which [Area2D] layers affect the sound for reverb and audio bus "
"effects. Areas can be used to redirect [AudioStream]s so that they play in a "
"certain audio bus. An example of how you might use this is making a "
"\"water\" area so that sounds played in the water are redirected through an "
"audio bus to make them sound like they are being played underwater."
msgstr ""
"[AREA2D] அடுக்குகள் எதிரொலி மற்றும் ஆடியோ பச் விளைவுகளுக்கான ஒலியை பாதிக்கின்றன "
"என்பதை தீர்மானிக்கிறது. [ஆடியோச்ட்ரீம்] களை திருப்பிவிட பகுதிகள் பயன்படுத்தப்படலாம், இதனால் "
"அவை ஒரு குறிப்பிட்ட ஆடியோ பச்சில் விளையாடுகின்றன. இதை நீங்கள் எவ்வாறு பயன்படுத்தலாம் "
"என்பதற்கான எடுத்துக்காட்டு ஒரு \"நீர்\" பகுதியை உருவாக்குகிறது, இதனால் தண்ணீரில் "
"விளையாடும் ஒலிகள் ஆடியோ பச் மூலம் திருப்பி விடப்பட்டு அவை நீருக்கடியில் விளையாடுவதைப் "
"போல ஒலிக்கச் செய்கின்றன."

#: docs/AudioStreamPlayer2D.xml
msgid "Dampens audio over distance with this as an exponent."
msgstr "ஒரு அதிவேகமாக இதை தூரத்திற்கு மேல் ஆடியரைக் குறைக்கிறது."

#: docs/AudioStreamPlayer2D.xml
msgid "Maximum distance from which audio is still hearable."
msgstr "ஆடியோ இன்னும் கேட்கக்கூடிய அதிகபட்ச தூரம்."

#: docs/AudioStreamPlayer2D.xml
msgid "Base volume without dampening."
msgstr "ஈரமாதாமல் அடிப்படை அளவு."

#: docs/AudioStreamPlayer3D.xml
msgid "Plays positional sound in 3D space."
msgstr "3D இடத்தில் நிலை ஒலியை இயக்குகிறது."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Plays a sound effect with directed sound effects, dampens with distance if "
"needed, generates effect of hearable position in space. For greater realism, "
"a low-pass filter is automatically applied to distant sounds. This can be "
"disabled by setting [member attenuation_filter_cutoff_hz] to [code]20500[/"
"code].\n"
"By default, audio is heard from the camera position. This can be changed by "
"adding a [Listener] node to the scene and enabling it by calling [method "
"Listener.make_current] on it.\n"
"See also [AudioStreamPlayer] to play a sound non-positionally.\n"
"[b]Note:[/b] Hiding an [AudioStreamPlayer3D] node does not disable its audio "
"output. To temporarily disable an [AudioStreamPlayer3D]'s audio output, set "
"[member unit_db] to a very low value like [code]-100[/code] (which isn't "
"audible to human hearing)."
msgstr ""
"இயக்கப்பட்ட ஒலி விளைவுகளுடன் ஒலி விளைவை வகிக்கிறது, தேவைப்பட்டால் தூரத்துடன் "
"குறைகிறது, விண்வெளியில் கேட்கக்கூடிய நிலையின் விளைவை உருவாக்குகிறது. அதிக "
"யதார்த்தவாதத்திற்கு, குறைந்த-பாச் வடிகட்டி தானாகவே தொலைதூர ஒலிகளுக்கு "
"பயன்படுத்தப்படுகிறது. [குறியீடு] 20500 [/குறியீடு] என [உறுப்பினர் "
"attenuation_filter_cutoff_hz] ஐ அமைப்பதன் மூலம் இதை முடக்கலாம்.\n"
" இயல்பாக, கேமரா நிலையில் இருந்து ஆடியோ கேட்கப்படுகிறது. காட்சியில் ஒரு [கேட்பவர்] "
"முனையைச் சேர்ப்பதன் மூலமும், அதில் [முறை கேட்பவர்.மேக்_கரண்ட்] ஐ அழைப்பதன் மூலமும் அதை "
"இயக்குவதன் மூலம் இதை மாற்றலாம்.\n"
" ஒரு ஒலி அல்லாத முறையில் விளையாட [ஆடியோச்ட்ரீஆம்ப்ளேயர்] ஐயும் காண்க.\n"
" . [ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 டி] இன் ஆடியோ வெளியீட்டை தற்காலிகமாக முடக்க, [குறியீடு] -100 "
"[/குறியீடு] போன்ற மிகக் குறைந்த மதிப்புக்கு [உறுப்பினர் யூனிட்_டிபி] அமைக்கவும் (இது "
"மனித விசாரணைக்கு கேட்கப்படவில்லை)."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Returns the [AudioStreamPlayback] object associated with this "
"[AudioStreamPlayer3D]."
msgstr ""
"இதனுடன் தொடர்புடைய [ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 டி] [ஆடியோச்ட்ரீஆம்ப்ளே பேக்] பொருளை "
"வழங்குகிறது."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Determines which [Area] layers affect the sound for reverb and audio bus "
"effects. Areas can be used to redirect [AudioStream]s so that they play in a "
"certain audio bus. An example of how you might use this is making a "
"\"water\" area so that sounds played in the water are redirected through an "
"audio bus to make them sound like they are being played underwater."
msgstr ""
"எந்த [பகுதி] அடுக்குகள் எதிரொலி மற்றும் ஆடியோ பச் விளைவுகளுக்கான ஒலியை பாதிக்கின்றன "
"என்பதை தீர்மானிக்கிறது. [ஆடியோச்ட்ரீம்] களை திருப்பிவிட பகுதிகள் பயன்படுத்தப்படலாம், இதனால் "
"அவை ஒரு குறிப்பிட்ட ஆடியோ பச்சில் விளையாடுகின்றன. இதை நீங்கள் எவ்வாறு பயன்படுத்தலாம் "
"என்பதற்கான எடுத்துக்காட்டு ஒரு \"நீர்\" பகுதியை உருவாக்குகிறது, இதனால் தண்ணீரில் "
"விளையாடும் ஒலிகள் ஆடியோ பச் மூலம் திருப்பி விடப்பட்டு அவை நீருக்கடியில் விளையாடுவதைப் "
"போல ஒலிக்கச் செய்கின்றன."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Dampens audio using a low-pass filter above this frequency, in Hz. To "
"disable the dampening effect entirely, set this to [code]20500[/code] as "
"this frequency is above the human hearing limit."
msgstr ""
"HZ இல், இந்த அதிர்வெண்ணிற்கு மேலே குறைந்த-பாச் வடிப்பானைப் பயன்படுத்தி ஆடியோவை "
"நனைக்கிறது. அடர்த்தியான விளைவை முழுவதுமாக முடக்க, இந்த அதிர்வெண் மனித செவிப்புலன் "
"வரம்பை விட அதிகமாக இருப்பதால் இதை [குறியீடு] 20500 [/குறியீடு] என அமைக்கவும்."

#: docs/AudioStreamPlayer3D.xml
msgid "Amount how much the filter affects the loudness, in decibels."
msgstr "டெசிபல்களில், சத்தத்தை வடிகட்டி எவ்வளவு பாதிக்கிறது."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Decides if audio should get quieter with distance linearly, quadratically, "
"logarithmically, or not be affected by distance, effectively disabling "
"attenuation."
msgstr ""
"ஆடியோ தூரத்துடன் நேர்கோட்டு, இருபடி, மடக்கை ரீதியாக, அல்லது தூரத்தால் "
"பாதிக்கப்படக்கூடாது, திறம்பட விழிப்புணர்வை முடக்க வேண்டும் என்பதை தீர்மானிக்கிறது."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"If [code]true[/code], audio plays when the AudioStreamPlayer3D node is added "
"to scene tree."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், காட்சி மரத்தில் ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 டி முனை "
"சேர்க்கப்படும்போது ஆடியோ இயக்குகிறது."

#: docs/AudioStreamPlayer3D.xml
msgid "The bus on which this audio is playing."
msgstr "இந்த ஆடியோ இயங்கும் பச்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Decides in which step the [url=https://en.wikipedia.org/wiki/"
"Doppler_effect]Doppler effect[/url] should be calculated.\n"
"[b]Note:[/b] Only effective if the current [Camera]'s [member "
"Camera.doppler_tracking] property is set to a value other than [constant "
"Camera.DOPPLER_TRACKING_DISABLED]."
msgstr ""
"[Url = https: //en.wikipedia.org/wiki/doppler_effect] டாப்ளர் விளைவு [/url] "
"கணக்கிடப்பட வேண்டும் என்பதை தீர்மானிக்கிறது.\n"
" [பி] குறிப்பு: [/b] தற்போதைய [கேமரா] [உறுப்பினர் கேமரா."

#: docs/AudioStreamPlayer3D.xml
msgid "The angle in which the audio reaches cameras undampened."
msgstr "ஆடியோ கேமராக்களை அடையும் கோணம்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"If [code]true[/code], the audio should be dampened according to the "
"direction of the sound."
msgstr ""
"[குறியீடு] உண்மை [/code] என்றால், ஒலியின் திசைக்கு ஏற்ப ஆடியோ குறைக்கப்பட வேண்டும்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Dampens audio if camera is outside of [member emission_angle_degrees] and "
"[member emission_angle_enabled] is set by this factor, in decibels."
msgstr ""
"கேமரா [உறுப்பினர் உமிழ்வு_என்ஏஎல்_டெக்ரீச்] க்கு வெளியே இருந்தால் ஆடியோவை நனைக்கவும், "
"[உறுப்பினர் உமிழ்வு_என்ஏஎன்ஏஎன்_எனபிள்ட்] இந்த காரணியால், டெசிபல்களில் அமைக்கப்பட்டுள்ளது."

#: docs/AudioStreamPlayer3D.xml
msgid "Sets the absolute maximum of the soundlevel, in decibels."
msgstr "சவுண்ட்லெவலின் முழுமையான அதிகபட்சத்தை டெசிபல்களில் அமைக்கிறது."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Sets the distance from which the [member out_of_range_mode] takes effect. "
"Has no effect if set to 0."
msgstr ""
"[உறுப்பினர் out_of_range_mode] நடைமுறைக்கு வரும் தூரத்தை அமைக்கிறது. 0 என "
"அமைக்கப்பட்டால் எந்த விளைவும் இல்லை."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Decides if audio should pause when source is outside of [member "
"max_distance] range."
msgstr ""
"[உறுப்பினர் MAX_DISTANCE] வரம்பிற்கு வெளியே மூலமாக இருக்கும்போது ஆடியோ "
"இடைநிறுத்தப்பட வேண்டுமா என்பதை தீர்மானிக்கிறது."

#: docs/AudioStreamPlayer3D.xml
msgid "The [AudioStream] resource to be played."
msgstr "[ஆடியோச்ட்ரீம்] வளம்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"If [code]true[/code], the playback is paused. You can resume it by setting "
"[member stream_paused] to [code]false[/code]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பின்னணி இடைநிறுத்தப்படுகிறது. [குறியீடு] தவறான "
"[/குறியீடு] என [உறுப்பினர் ச்ட்ரீம்_பேட்ச்] அமைப்பதன் மூலம் அதை மீண்டும் தொடங்கலாம்."

#: docs/AudioStreamPlayer3D.xml
msgid "The base sound level unaffected by dampening, in decibels."
msgstr "டெசிபல்களில், ஈரப்படுத்துவதன் மூலம் பாதிக்கப்படாத அடிப்படை ஒலி நிலை."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"The factor for the attenuation effect. Higher values make the sound audible "
"over a larger distance."
msgstr ""
"விழிப்புணர்வு விளைவுக்கான காரணி. அதிக மதிப்புகள் ஒலியை பெரிய தூரத்தில் "
"கேட்கக்கூடியதாக ஆக்குகின்றன."

#: docs/AudioStreamPlayer3D.xml
msgid "Linear dampening of loudness according to distance."
msgstr "தூரத்திற்கு ஏற்ப சத்தத்தை நேரியல் ஈரமாக்குதல்."

#: docs/AudioStreamPlayer3D.xml
msgid "Squared dampening of loudness according to distance."
msgstr "தூரத்திற்கு ஏற்ப சத்தத்தை அடர்த்தியானது."

#: docs/AudioStreamPlayer3D.xml
msgid "Logarithmic dampening of loudness according to distance."
msgstr "தூரத்தின்படி சத்தத்தின் மடக்கை ஈரமாக்குதல்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"No dampening of loudness according to distance. The sound will still be "
"heard positionally, unlike an [AudioStreamPlayer]. [constant "
"ATTENUATION_DISABLED] can be combined with a [member max_distance] value "
"greater than [code]0.0[/code] to achieve linear attenuation clamped to a "
"sphere of a defined size."
msgstr ""
"தூரத்தின்படி சத்தத்தை குறைப்பதில்லை. [ஆடியோச்ட்ரீஆம்ப்ளேயர்] போலல்லாமல், ஒலி இன்னும் "
"நிலைநிறுத்தப்படும். [நிலையான அட்டென்சேசன்_டிசேபிள்] வரையறுக்கப்பட்ட அளவிலான ஒரு "
"கோளத்துடன் பிணைக்கப்பட்ட நேரியல் விழிப்புணர்வை அடைய [குறியீடு] 0.0 [/குறியீடு] ஐ விட "
"அதிகமான [உறுப்பினர் அதிகபட்சம்_டிச்டன்ச்] மதிப்புடன் இணைக்கப்படலாம்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Mix this audio in, even when it's out of range. This increases CPU usage, "
"but keeps the sound playing at the correct position if the camera leaves and "
"enters the [AudioStreamPlayer3D]'s [member max_distance] radius."
msgstr ""
"இந்த ஆடியோ வரம்பில்லாமல் இருக்கும்போது கூட கலக்கவும். இது சிபியு பயன்பாட்டை "
"அதிகரிக்கிறது, ஆனால் கேமரா [ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 டி] இன் [உறுப்பினர் MAX_DISTANCE] "
"ஆரம் மீது நுழைந்தால் ஒலி சரியான நிலையில் இருக்கும்."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Pause this audio when it gets out of range. This decreases CPU usage, but "
"will cause the sound to restart if the camera leaves and enters the "
"[AudioStreamPlayer3D]'s [member max_distance] radius."
msgstr ""
"இந்த ஆடியோ வரம்பிலிருந்து வெளியேறும்போது இடைநிறுத்தவும். இது சிபியு பயன்பாட்டைக் "
"குறைக்கிறது, ஆனால் கேமரா [ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 டி] இன் [உறுப்பினர் MAX_DISTANCE] ஆரம் "
"மீது நுழைந்தால் ஒலி மறுதொடக்கம் செய்யப்படும்."

#: docs/AudioStreamPlayer3D.xml
msgid "Disables doppler tracking."
msgstr "டாப்ளர் கண்காணிப்பை முடக்குகிறது."

#: docs/AudioStreamPlayer3D.xml
msgid "Executes doppler tracking in idle step (every rendered frame)."
msgstr "செயலற்ற படிநிலையில் டாப்ளர் கண்காணிப்பை இயக்குகிறது (ஒவ்வொரு வழங்குதல் சட்டகமும்)."

#: docs/AudioStreamPlayer3D.xml
msgid ""
"Executes doppler tracking in physics step (every simulated physics frame)."
msgstr ""
"இயற்பியல் படி (ஒவ்வொரு உருவகப்படுத்தப்பட்ட இயற்பியல் சட்டமும்) டாப்ளர் கண்காணிப்பை "
"செயல்படுத்துகிறது."

#: docs/AudioStreamRandomPitch.xml
msgid "Plays audio with random pitch shifting."
msgstr "சீரற்ற சுருதி மாற்றத்துடன் ஆடியோ வாசிக்கிறது."

#: docs/AudioStreamRandomPitch.xml
msgid "Randomly varies pitch on each start."
msgstr "ஒவ்வொரு தொடக்கத்திலும் தோராயமாக சுருதி மாறுபடும்."

#: docs/AudioStreamRandomPitch.xml
msgid "The current [AudioStream]."
msgstr "தற்போதைய [ஆடியோச்ட்ரீம்]."

#: docs/AudioStreamRandomPitch.xml
msgid "The intensity of random pitch variation."
msgstr "சீரற்ற சுருதி மாறுபாட்டின் தீவிரம்."

#: docs/AudioStreamSample.xml
msgid "Stores audio data loaded from WAV files."
msgstr "WAV கோப்புகளிலிருந்து ஏற்றப்பட்ட ஆடியோ தரவை சேமிக்கிறது."

#: docs/AudioStreamSample.xml
msgid ""
"AudioStreamSample stores sound samples loaded from WAV files. To play the "
"stored sound, use an [AudioStreamPlayer] (for non-positional audio) or "
"[AudioStreamPlayer2D]/[AudioStreamPlayer3D] (for positional audio). The "
"sound can be looped.\n"
"This class can also be used to store dynamically-generated PCM audio data. "
"See also [AudioStreamGenerator] for procedural audio generation."
msgstr ""
"ஆடியோச்ட்ரீம்சேல்பிள் வாவ் கோப்புகளிலிருந்து ஏற்றப்பட்ட ஒலி மாதிரிகளை சேமிக்கிறது. "
"சேமிக்கப்பட்ட ஒலியை இயக்க, [ஆடியோச்ட்ரீஆம்ப்ளேயர்] (நிலை அல்லாத ஆடியோவுக்கு) அல்லது "
"[ஆடியோச்ட்ரீஆம்ப்ளேயர் 2 டி]/[ஆடியோச்ட்ரீஎஃப் பிளேயர் 3 டி] (நிலை ஆடியோவுக்கு) "
"பயன்படுத்தவும். ஒலியை சுழற்றலாம்.\n"
" மாறும் வகையில் உருவாக்கிய பிசிஎம் ஆடியோ தரவை சேமிக்க இந்த வகுப்பைப் பயன்படுத்தலாம். "
"நடைமுறை ஆடியோ தலைமுறைக்கு [ஆடியோச்ட்ரீம்செனரேட்டர்] ஐயும் காண்க."

#: docs/AudioStreamSample.xml
msgid ""
"Saves the AudioStreamSample as a WAV file to [code]path[/code]. Samples with "
"IMA ADPCM format can't be saved.\n"
"[b]Note:[/b] A [code].wav[/code] extension is automatically appended to "
"[code]path[/code] if it is missing."
msgstr ""
"ஆடியோச்ட்ரீம்சேட்டை ஒரு WAV கோப்பாக [குறியீடு] பாதைக்கு சேமிக்கிறது [/குறியீடு]. IMA "
"ADPCM வடிவத்துடன் கூடிய மாதிரிகளை சேமிக்க முடியாது.\n"
" ."

#: docs/AudioStreamSample.xml
msgid ""
"Contains the audio data in bytes.\n"
"[b]Note:[/b] This property expects signed PCM8 data. To convert unsigned "
"PCM8 to signed PCM8, subtract 128 from each byte."
msgstr ""
"பைட்டுகளில் ஆடியோ தரவைக் கொண்டுள்ளது.\n"
" [b] குறிப்பு: [/b] இந்த சொத்து கையொப்பமிடப்பட்ட PCM8 தரவை எதிர்பார்க்கிறது. "
"கையொப்பமிடப்பட்ட பிசிஎம் 8 ஐ கையொப்பமிடப்பட்ட பிசிஎம் 8 ஆக மாற்ற, ஒவ்வொரு "
"பைட்டிலிருந்தும் 128 ஐக் கழிக்கவும்."

#: docs/AudioStreamSample.xml
msgid "Audio format. See [enum Format] constants for values."
msgstr "ஆடியோ வடிவம். மதிப்புகளுக்கான [ENUM FORMAT] மாறிலிகளைப் பார்க்கவும்."

#: docs/AudioStreamSample.xml
msgid ""
"The loop start point (in number of samples, relative to the beginning of the "
"sample). This information will be imported automatically from the WAV file "
"if present."
msgstr ""
"லூப் ச்டார்ட் பாயிண்ட் (மாதிரிகளின் எண்ணிக்கையில், மாதிரியின் தொடக்கத்துடன் தொடர்புடையது). "
"இந்த செய்தி இருந்தால் WAV கோப்பிலிருந்து தானாக இறக்குமதி செய்யப்படும்."

#: docs/AudioStreamSample.xml
msgid ""
"The loop end point (in number of samples, relative to the beginning of the "
"sample). This information will be imported automatically from the WAV file "
"if present."
msgstr ""
"லூப் எண்ட் பாயிண்ட் (மாதிரிகளின் எண்ணிக்கையில், மாதிரியின் தொடக்கத்துடன் ஒப்பிடும்போது). "
"இந்த செய்தி இருந்தால் WAV கோப்பிலிருந்து தானாக இறக்குமதி செய்யப்படும்."

#: docs/AudioStreamSample.xml
msgid ""
"The loop mode. This information will be imported automatically from the WAV "
"file if present. See [enum LoopMode] constants for values."
msgstr ""
"லூப் பயன்முறை. இந்த செய்தி இருந்தால் WAV கோப்பிலிருந்து தானாக இறக்குமதி செய்யப்படும். "
"மதிப்புகளுக்கான [ENUM LOOPMODE] மாறிலிகளைப் பார்க்கவும்."

#: docs/AudioStreamSample.xml
msgid ""
"The sample rate for mixing this audio. Higher values require more storage "
"space, but result in better quality.\n"
"In games, common sample rates in use are [code]11025[/code], [code]16000[/"
"code], [code]22050[/code], [code]32000[/code], [code]44100[/code], and "
"[code]48000[/code].\n"
"According to the [url=https://en.wikipedia.org/wiki/"
"Nyquist%E2%80%93Shannon_sampling_theorem]Nyquist-Shannon sampling theorem[/"
"url], there is no quality difference to human hearing when going past 40,000 "
"Hz (since most humans can only hear up to ~20,000 Hz, often less). If you "
"are using lower-pitched sounds such as voices, lower sample rates such as "
"[code]32000[/code] or [code]22050[/code] may be usable with no loss in "
"quality."
msgstr ""
"இந்த ஆடியோவைக் கலப்பதற்கான மாதிரி வீதம். அதிக மதிப்புகளுக்கு அதிக சேமிப்பு இடம் "
"தேவைப்படுகிறது, ஆனால் சிறந்த தரத்தை ஏற்படுத்துகிறது.\n"
" கேம்களில், பயன்பாட்டில் உள்ள பொதுவான மாதிரி விகிதங்கள் [குறியீடு] 11025 [/குறியீடு], "
"[குறியீடு] 16000 [/குறியீடு], [குறியீடு] 22050 [/குறியீடு], [குறியீடு] 32000 [/"
"குறியீடு], [குறியீடு] 44100 [/குறியீடு] மற்றும் [குறியீடு] 48000 [/குறியீடு].\n"
" . குரல்கள் போன்ற குறைந்த பிட்ச் ஒலிகளைப் பயன்படுத்துகிறீர்கள் என்றால், [குறியீடு] 32000 [/"
"குறியீடு] அல்லது [குறியீடு] 22050 [/குறியீடு] போன்ற குறைந்த மாதிரி விகிதங்கள் தரத்தில் "
"எந்த இழப்பும் இல்லாமல் பயன்படுத்தக்கூடியதாக இருக்கலாம்."

#: docs/AudioStreamSample.xml
msgid "If [code]true[/code], audio is stereo."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், ஆடியோ ச்டீரியோ."

#: docs/AudioStreamSample.xml
msgid "8-bit audio codec."
msgstr "8-பிட் ஆடியோ கோடெக்."

#: docs/AudioStreamSample.xml
msgid "16-bit audio codec."
msgstr "16-பிட் ஆடியோ கோடெக்."

#: docs/AudioStreamSample.xml
msgid "Audio is compressed using IMA ADPCM."
msgstr "IMA ADPCM ஐப் பயன்படுத்தி ஆடியோ சுருக்கப்படுகிறது."

#: docs/AudioStreamSample.xml
msgid "Audio does not loop."
msgstr "ஆடியோ வளையவில்லை."

#: docs/AudioStreamSample.xml
msgid ""
"Audio loops the data between [member loop_begin] and [member loop_end], "
"playing forward only."
msgstr ""
"[உறுப்பினர் லூப்_பெசின்] மற்றும் [உறுப்பினர் லூப்_எண்ட்] ஆகியவற்றுக்கு இடையேயான தரவை "
"ஆடியோ சுழல்கிறது, முன்னோக்கி மட்டுமே விளையாடுகிறது."

#: docs/AudioStreamSample.xml
msgid ""
"Audio loops the data between [member loop_begin] and [member loop_end], "
"playing back and forth."
msgstr ""
"[உறுப்பினர் லூப்_பெசின்] மற்றும் [உறுப்பினர் லூப்_எண்ட்] ஆகியவற்றுக்கு இடையேயான தரவை "
"ஆடியோ சுழல்கிறது, இது முன்னும் பின்னுமாக விளையாடுகிறது."

#: docs/AudioStreamSample.xml
msgid ""
"Audio loops the data between [member loop_begin] and [member loop_end], "
"playing backward only."
msgstr ""
"[உறுப்பினர் லூப்_பெசின்] மற்றும் [உறுப்பினர் லூப்_எண்ட்] ஆகியவற்றுக்கு இடையேயான தரவை "
"ஆடியோ சுழல்கிறது, பின்தங்கிய நிலையில் மட்டுமே விளையாடுகிறது."

#: docs/BackBufferCopy.xml
#, fuzzy
msgid ""
"Copies a region of the screen (or the whole screen) to a buffer so it can be "
"accessed in your shader scripts through the [code]texture(SCREEN_TEXTURE, …)"
"[/code] function."
msgstr ""
"திரையின் ஒரு பகுதியை (அல்லது முழு திரை) ஒரு இடையகத்திற்கு நகலெடுக்கிறது, எனவே இதை "
"உங்கள் சேடர் ச்கிரிப்ட்களில் [குறியீடு] அமைப்பு (ச்கிரீன்_ டெக்ச்டூர், ...) [/குறியீடு] "
"செயல்பாடு மூலம் அணுகலாம்."

#: docs/BackBufferCopy.xml
#, fuzzy
msgid ""
"Node for back-buffering the currently-displayed screen. The region defined "
"in the BackBufferCopy node is buffered with the content of the screen it "
"covers, or the entire screen according to the copy mode set. Use the "
"[code]texture(SCREEN_TEXTURE, …)[/code] function in your shader scripts to "
"access the buffer.\n"
"[b]Note:[/b] Since this node inherits from [Node2D] (and not [Control]), "
"anchors and margins won't apply to child [Control]-derived nodes. This can "
"be problematic when resizing the window. To avoid this, add [Control]-"
"derived nodes as [i]siblings[/i] to the BackBufferCopy node instead of "
"adding them as children."
msgstr ""
"தற்போது காண்பிக்கப்பட்ட திரையை பின்னுக்குத் தள்ளுவதற்கான முனை. பேக் பஃப்டெர்கோபி முனையில் "
"வரையறுக்கப்பட்ட பகுதி, அது உள்ளடக்கிய திரையின் உள்ளடக்கம் அல்லது நகல் பயன்முறை தொகுப்பின் "
"படி முழு திரை மூலம் இடையகப்படுத்தப்படுகிறது. இடையகத்தை அணுக உங்கள் சேடர் ச்கிரிப்ட்களில் "
"[குறியீடு] அமைப்பு (ச்கிரீன்_டெக்ச்டூர், ...) [/குறியீடு] செயல்பாட்டைப் பயன்படுத்தவும்.\n"
" . சாளரத்தை மறுஅளவிடும்போது இது சிக்கலாக இருக்கும். இதைத் தவிர்ப்பதற்கு, [i] "
"உடன்பிறப்புகள் [/i] என குழந்தைகளாகச் சேர்ப்பதற்கு பதிலாக முதுகுவலிக்பர்கோபி முனையில் "
"[கட்டுப்பாடு]-பெறப்பட்ட முனைகளைச் சேர்க்கவும்."

#: docs/BackBufferCopy.xml
msgid "Buffer mode. See [enum CopyMode] constants."
msgstr "இடையக முறை. [Enum copymode] மாறிலிகளைக் காண்க."

#: docs/BackBufferCopy.xml
msgid ""
"The area covered by the BackBufferCopy. Only used if [member copy_mode] is "
"[constant COPY_MODE_RECT]."
msgstr ""
"பேக் பஃப்டர்கோபியால் மூடப்பட்ட பகுதி. [உறுப்பினர் Copy_mode] [நிலையான "
"COPY_MODE_RECT] என்றால் மட்டுமே பயன்படுத்தப்படுகிறது."

#: docs/BackBufferCopy.xml
msgid ""
"Disables the buffering mode. This means the BackBufferCopy node will "
"directly use the portion of screen it covers."
msgstr ""
"இடையக பயன்முறையை முடக்குகிறது. இதன் பொருள், பேக் பஃப்டெர்கோபி முனை அது உள்ளடக்கிய "
"திரையின் பகுதியை நேரடியாகப் பயன்படுத்தும்."

#: docs/BackBufferCopy.xml
msgid "BackBufferCopy buffers a rectangular region."
msgstr "பேக் பஃப்டர்கோபி ஒரு செவ்வக பகுதியை இடையகப்படுத்துகிறது."

#: docs/BackBufferCopy.xml
msgid "BackBufferCopy buffers the entire screen."
msgstr "பேக் பஃப்டர்கோபி முழு திரையையும் இடையகப்படுத்துகிறது."

#: docs/BakedLightmap.xml
msgid "Prerendered indirect light map for a scene."
msgstr "ஒரு காட்சிக்கான மறைமுக ஒளி வரைபடம்."

#: docs/BakedLightmap.xml
msgid ""
"Baked lightmaps are an alternative workflow for adding indirect (or baked) "
"lighting to a scene. Unlike the [GIProbe] approach, baked lightmaps work "
"fine on low-end PCs and mobile devices as they consume almost no resources "
"in run-time.\n"
"[b]Procedural generation:[/b] Lightmap baking functionality is only "
"available in the editor. This means [BakedLightmap] is not suited to "
"procedurally generated or user-built levels. For procedurally generated or "
"user-built levels, use [GIProbe] instead.\n"
"[b]Note:[/b] Due to how lightmaps work, most properties only have a visible "
"effect once lightmaps are baked again."
msgstr ""
"வேகவைத்த லைட்மேப்ச் என்பது ஒரு காட்சியில் மறைமுக (அல்லது வேகவைத்த) விளக்குகளைச் "
"சேர்ப்பதற்கான மாற்று பணிப்பாய்வு ஆகும். [சிப்ரோப்] அணுகுமுறையைப் போலன்றி, வேகவைத்த "
"லைட்மாப்கள் குறைந்த-இறுதி பிசிக்கள் மற்றும் மொபைல் சாதனங்களில் நன்றாக வேலை செய்கின்றன, "
"ஏனெனில் அவை ரன்-நேரத்தில் கிட்டத்தட்ட எந்த ஆதாரங்களையும் உட்கொள்ளாது.\n"
" [b] நடைமுறை உருவாக்கம்: [/b] லைட்மேப் பேக்கிங் செயல்பாடு எடிட்டரில் மட்டுமே "
"கிடைக்கிறது. இதன் பொருள் [வேகவைத்த லைட்மேப்] நடைமுறை ரீதியாக உருவாக்கப்பட்ட அல்லது பயனர் "
"கட்டப்பட்ட நிலைகளுக்கு பொருந்தாது. நடைமுறையில் உருவாக்கப்பட்ட அல்லது பயனர் கட்டப்பட்ட "
"நிலைகளுக்கு, அதற்கு பதிலாக [GIPROBE] ஐப் பயன்படுத்தவும்.\n"
" ."

#: docs/BakedLightmap.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/baked_lightmaps.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/baked_lightmaps.html"

#: docs/BakedLightmap.xml
msgid ""
"Bakes the lightmap, scanning from the given [code]from_node[/code] root and "
"saves the resulting [BakedLightmapData] in [code]data_save_path[/code]. If "
"no root node is provided, parent of this node will be used as root instead. "
"If no save path is provided it will try to match the path from the current "
"[member light_data]."
msgstr ""
"லைட்மேப்பை சுட்டுக்கொள்ளுங்கள், கொடுக்கப்பட்ட [குறியீட்டிலிருந்து] from_node [/code] "
"மூலத்திலிருந்து ச்கேன் செய்து, இதன் விளைவாக [குறியீடு] தரவு_சேவ்_பாத் [/குறியீடு] இல் "
"[வேகவைத்த லைட்மாப்டேட்டா] ஐ சேமிக்கிறது. ரூட் முனை எதுவும் வழங்கப்படாவிட்டால், இந்த "
"முனையின் பெற்றோர் அதற்கு பதிலாக வேராகப் பயன்படுத்தப்படுவார்கள். சேமிக்கும் பாதை எதுவும் "
"வழங்கப்படாவிட்டால், அது தற்போதைய [உறுப்பினர் லைட்_டேட்டா] இலிருந்து பாதையை பொருத்த "
"முயற்சிக்கும்."

#: docs/BakedLightmap.xml
msgid ""
"When enabled, the lightmapper will merge the textures for all meshes into a "
"single large layered texture. Not supported in GLES2."
msgstr ""
"இயக்கப்பட்டால், லைட்மாப்பர் அனைத்து மெச்களுக்கான அமைப்புகளையும் ஒரு பெரிய அடுக்கு அமைப்பாக "
"ஒன்றிணைக்கும். GLES2 இல் ஆதரிக்கப்படவில்லை."

#: docs/BakedLightmap.xml
msgid ""
"Maximum size of each lightmap layer, only used when [member atlas_generate] "
"is enabled."
msgstr ""
"ஒவ்வொரு லைட்மேப் அடுக்கின் அதிகபட்ச அளவு, [உறுப்பினர் அட்லச்_செனரேட்] இயக்கப்பட்டால் மட்டுமே "
"பயன்படுத்தப்படுகிறது."

#: docs/BakedLightmap.xml
msgid ""
"Raycasting bias used during baking to avoid floating point precision issues."
msgstr ""
"மிதக்கும் புள்ளி துல்லியமான சிக்கல்களைத் தவிர்க்க பேக்கிங்கின் போது பயன்படுத்தப்படும் ரேச்டிங் "
"சார்பு."

#: docs/BakedLightmap.xml
msgid ""
"The energy multiplier for each bounce. Higher values will make indirect "
"lighting brighter. A value of [code]1.0[/code] represents physically "
"accurate behavior, but higher values can be used to make indirect lighting "
"propagate more visibly when using a low number of bounces. This can be used "
"to speed up bake times by lowering the number of [member bounces] then "
"increasing [member bounce_indirect_energy]. Unlike [member "
"BakedLightmapData.energy], this property does not affect direct lighting "
"emitted by light nodes, emissive materials and the environment.\n"
"[b]Note:[/b] [member bounce_indirect_energy] only has an effect if [member "
"bounces] is set to a value greater than or equal to [code]1[/code]."
msgstr ""
"ஒவ்வொரு துள்ளலுக்கும் ஆற்றல் பெருக்கி. அதிக மதிப்புகள் மறைமுக விளக்குகளை "
"பிரகாசமாக்கும். . [உறுப்பினர் பவுன்ச்] எண்ணிக்கையைக் குறைப்பதன் மூலம் சுட்டுக்கொள்ளும் "
"நேரங்களை விரைவுபடுத்த இதைப் பயன்படுத்தலாம் [உறுப்பினர் பவுன்ச்_இன்டிரைட்_இனெர்சி] "
"அதிகரிப்பதன் மூலம். [உறுப்பினர் backet lightmapdata.energy] போலல்லாமல், இந்த சொத்து "
"ஒளி முனைகள், உமிழும் பொருட்கள் மற்றும் சுற்றுச்சூழலால் வெளிப்படும் நேரடி விளக்குகளை "
"பாதிக்காது.\n"
" ."

#: docs/BakedLightmap.xml
msgid ""
"Number of light bounces that are taken into account during baking. See also "
"[member bounce_indirect_energy]."
msgstr ""
"பேக்கிங்கின் போது கணக்கில் எடுத்துக்கொள்ளப்படும் ஒளி பவுன்ச் எண்ணிக்கை. மேலும் காண்க "
"[உறுப்பினர்கள் மறைமுக ஆற்றலை பவுன்ச்]."

#: docs/BakedLightmap.xml
msgid "Grid size used for real-time capture information on dynamic objects."
msgstr "மாறும் பொருள்களின் நிகழ்நேர பிடிப்பு தகவல்களுக்கு பயன்படுத்தப்படும் கட்ட அளவு."

#: docs/BakedLightmap.xml
msgid ""
"When enabled, an octree containing the scene's lighting information will be "
"computed. This octree will then be used to light dynamic objects in the "
"scene."
msgstr ""
"இயக்கப்பட்டால், காட்சியின் லைட்டிங் தகவல்களைக் கொண்ட ஒரு ஆக்ட்ரீ கணக்கிடப்படும். இந்த ஆக்ட்ரீ "
"பின்னர் காட்சியில் மாறும் பொருள்களை ஒளிரச் செய்ய பயன்படுத்தப்படும்."

#: docs/BakedLightmap.xml
msgid ""
"Bias value to reduce the amount of light propagation in the captured octree."
msgstr "கைப்பற்றப்பட்ட ஆக்ட்ரீயில் ஒளி பரப்புதலின் அளவைக் குறைக்க சார்பு மதிப்பு."

#: docs/BakedLightmap.xml
msgid "Bake quality of the capture data."
msgstr "பிடிப்பு தரவின் சுட்டுக்கொள்ளும் தகுதி."

#: docs/BakedLightmap.xml
msgid ""
"If a baked mesh doesn't have a UV2 size hint, this value will be used to "
"roughly compute a suitable lightmap size."
msgstr ""
"வேகவைத்த கண்ணி ஒரு UV2 அளவு குறிப்பு இல்லையென்றால், இந்த மதிப்பு பொருத்தமான லைட்மேப் "
"அளவைக் கணக்கிட பயன்படுத்தப்படும்."

#: docs/BakedLightmap.xml
msgid ""
"The environment color when [member environment_mode] is set to [constant "
"ENVIRONMENT_MODE_CUSTOM_COLOR]."
msgstr ""
"[உறுப்பினர் சுற்றுச்சூழல்_மோட்] [நிலையான சுற்றுச்சூழல்_மோட்_கச்டம்_கோலர்] என அமைக்கப்படும் "
"போது சுற்றுச்சூழல் நிறம்."

#: docs/BakedLightmap.xml
msgid ""
"The energy scaling factor when when [member environment_mode] is set to "
"[constant ENVIRONMENT_MODE_CUSTOM_COLOR] or [constant "
"ENVIRONMENT_MODE_CUSTOM_SKY]."
msgstr ""
"[உறுப்பினர் சூழல்_மோட்] [நிலையான சூழல்_மோட்_கச்டம்_கோலர்] அல்லது [நிலையான "
"சூழல்_மோட்_கச்டம்_ச்கி] என அமைக்கப்பட்டால் ஆற்றல் அளவிடுதல் காரணி."

#: docs/BakedLightmap.xml
msgid ""
"The [Sky] resource to use when [member environment_mode] is set o [constant "
"ENVIRONMENT_MODE_CUSTOM_SKY]."
msgstr ""
"[உறுப்பினர் சுற்றுச்சூழல் பயன்முறை] [நிலையான சுற்றுச்சூழல் பயன்முறை_கச்டம்_ச்கி] என "
"அமைக்கப்படும்போது பயன்படுத்த வேண்டிய [ச்கை] சான்று."

#: docs/BakedLightmap.xml
msgid "The rotation of the baked custom sky."
msgstr "வேகவைத்த தனிப்பயன் வானத்தின் சுழற்சி."

#: docs/BakedLightmap.xml
msgid ""
"Minimum ambient light for all the lightmap texels. This doesn't take into "
"account any occlusion from the scene's geometry, it simply ensures a minimum "
"amount of light on all the lightmap texels. Can be used for artistic control "
"on shadow color."
msgstr ""
"அனைத்து லைட்மேப் டெக்சல்களுக்கும் குறைந்தபட்ச சுற்றுப்புற ஒளி. இது காட்சியின் "
"வடிவவியலிலிருந்து எந்தவொரு மறைவையும் கணக்கில் எடுத்துக்கொள்ளாது, இது அனைத்து லைட்மேப் "
"டெக்சல்களிலும் குறைந்தபட்ச அளவு ஒளியை உறுதி செய்கிறது. நிழல் நிறத்தில் கலைக் "
"கட்டுப்பாட்டுக்கு பயன்படுத்தலாம்."

#: docs/BakedLightmap.xml
msgid "Decides which environment to use during baking."
msgstr "பேக்கிங்கின் போது எந்த சூழலைப் பயன்படுத்த வேண்டும் என்பதை தீர்மானிக்கிறது."

#: docs/BakedLightmap.xml
msgid ""
"Size of the baked lightmap. Only meshes inside this region will be included "
"in the baked lightmap, also used as the bounds of the captured region for "
"dynamic lighting."
msgstr ""
"வேகவைத்த லைட்மேப்பின் அளவு. இந்த பிராந்தியத்திற்குள் உள்ள மெச்கள் மட்டுமே சுட்ட லைட்மேப்பில் "
"சேர்க்கப்படும், இது மாறும் லைட்டிங்கிற்காக கைப்பற்றப்பட்ட பகுதியின் எல்லைகளாகவும் "
"பயன்படுத்தப்படுகிறது."

#: docs/BakedLightmap.xml
msgid ""
"Deprecated, in previous versions it determined the location where lightmaps "
"were be saved."
msgstr "முந்தைய பதிப்புகளில், லைட்மாப்கள் சேமிக்கப்பட்ட இடத்தை இது தீர்மானித்தது."

#: docs/BakedLightmap.xml
msgid "The calculated light data."
msgstr "கணக்கிடப்பட்ட ஒளி தரவு."

#: docs/BakedLightmap.xml
msgid ""
"Determines the amount of samples per texel used in indirect light baking. "
"The amount of samples for each quality level can be configured in the "
"project settings."
msgstr ""
"மறைமுக ஒளி பேக்கிங்கில் பயன்படுத்தப்படும் ஒரு டெக்சலுக்கு மாதிரிகளின் அளவை "
"தீர்மானிக்கிறது. ஒவ்வொரு தர நிலைக்கும் மாதிரிகளின் அளவு திட்ட அமைப்புகளில் "
"கட்டமைக்கப்படலாம்."

#: docs/BakedLightmap.xml
msgid ""
"Store full color values in the lightmap textures. When disabled, lightmap "
"textures will store a single brightness channel. Can be disabled to reduce "
"disk usage if the scene contains only white lights or you don't mind losing "
"color information in indirect lighting."
msgstr ""
"லைட்மேப் அமைப்புகளில் முழு வண்ண மதிப்புகளை சேமிக்கவும். முடக்கப்பட்டால், லைட்மேப் அமைப்புகள் "
"ஒரு பிரகாசமான சேனலை சேமிக்கும். காட்சியில் வெள்ளை விளக்குகள் மட்டுமே இருந்தால் அல்லது "
"மறைமுக விளக்குகளில் வண்ண தகவல்களை இழப்பதை நீங்கள் பொருட்படுத்தவில்லை என்றால் வட்டு "
"பயன்பாட்டைக் குறைக்க முடக்கலாம்."

#: docs/BakedLightmap.xml
msgid ""
"When enabled, a lightmap denoiser will be used to reduce the noise inherent "
"to Monte Carlo based global illumination."
msgstr ""
"இயக்கப்பட்டால், மான்டே கார்லோவை தளமாகக் கொண்ட உலகளாவிய வெளிச்சத்திற்கு உள்ளார்ந்த சத்தத்தை "
"குறைக்க ஒரு லைட்மேப் டெனோசர் பயன்படுத்தப்படும்."

#: docs/BakedLightmap.xml
msgid ""
"If [code]true[/code], stores the lightmap textures in a high dynamic range "
"format (EXR). If [code]false[/code], stores the lightmap texture in a low "
"dynamic range PNG image. This can be set to [code]false[/code] to reduce "
"disk usage, but light values over 1.0 will be clamped and you may see "
"banding caused by the reduced precision.\n"
"[b]Note:[/b] Setting [member use_hdr] to [code]true[/code] will decrease "
"lightmap banding even when using the GLES2 backend or if [member "
"ProjectSettings.rendering/quality/depth/hdr] is [code]false[/code]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், லைட்மேப் அமைப்புகளை உயர் மாறும் வரம்பு வடிவத்தில் "
"(EXR) சேமிக்கிறது. [குறியீடு] பொய் [/குறியீடு] என்றால், லைட்மேப் அமைப்பை குறைந்த மாறும் "
"வரம்பு பி.என்.சி படத்தில் சேமிக்கிறது. வட்டு பயன்பாட்டைக் குறைக்க இதை [குறியீடு] தவறான "
"[/குறியீடு] என அமைக்கலாம், ஆனால் 1.0 க்கு மேல் ஒளி மதிப்புகள் பிணைக்கப்படும், மேலும் "
"குறைக்கப்பட்ட துல்லியத்தால் ஏற்படும் பேண்டிங் ஆகியவற்றைக் காணலாம்.\n"
" ."

#: docs/BakedLightmap.xml
msgid "The lowest bake quality mode. Fastest to calculate."
msgstr "மிகக் குறைந்த சுட்டுக்கொள்ள தரமான பயன்முறை. கணக்கிட வேகமாக."

#: docs/BakedLightmap.xml
msgid "The default bake quality mode."
msgstr "இயல்புநிலை சுட்டுக்கொள்ள தரமான பயன்முறை."

#: docs/BakedLightmap.xml
msgid "A higher bake quality mode. Takes longer to calculate."
msgstr "அதிக சுட்டுக்கொள்ள தரமான பயன்முறை. கணக்கிட அதிக நேரம் எடுக்கும்."

#: docs/BakedLightmap.xml
msgid "The highest bake quality mode. Takes the longest to calculate."
msgstr "மிக உயர்ந்த சுட்டுக்கொள்ள தரமான பயன்முறை. கணக்கிட நீண்ட நேரம் எடுக்கும்."

#: docs/BakedLightmap.xml
msgid "Baking was successful."
msgstr "பேக்கிங் வெற்றிகரமாக இருந்தது."

#: docs/BakedLightmap.xml
msgid ""
"Returns if no viable save path is found. This can happen where an [member "
"image_path] is not specified or when the save location is invalid."
msgstr ""
"சாத்தியமான சேமிப்பு பாதை காணப்படாவிட்டால் வருவாய். [உறுப்பினர் படம்_பாத்] "
"குறிப்பிடப்படாத இடத்தில் அல்லது சேமிக்கும் இடம் தவறானது போது இது நிகழலாம்."

#: docs/BakedLightmap.xml docs/SpatialMaterial.xml
msgid "Currently unused."
msgstr "தற்போது பயன்படுத்தப்படாதது."

#: docs/BakedLightmap.xml
msgid "Returns when the baker cannot save per-mesh textures to file."
msgstr "பேக்கர் ஒவ்வொரு கண்ணி அமைப்புகளையும் தாக்கல் செய்ய முடியாதபோது திரும்பும்."

#: docs/BakedLightmap.xml
msgid "The size of the generated lightmaps is too large."
msgstr "உருவாக்கப்பட்ட லைட்மாப்புகளின் அளவு மிகப் பெரியது."

#: docs/BakedLightmap.xml
msgid "Some mesh contains UV2 values outside the [code][0,1][/code] range."
msgstr ""
"சில கண்ணி [குறியீடு] [0,1] [/குறியீடு] வரம்பிற்கு வெளியே UV2 மதிப்புகளைக் கொண்டுள்ளது."

#: docs/BakedLightmap.xml
msgid "Returns if user cancels baking."
msgstr "பயனர் பேக்கிங்கை ரத்துசெய்தால் வருவார்."

#: docs/BakedLightmap.xml
msgid ""
"Returns if lightmapper can't be created. Unless you are using a custom "
"lightmapper, please report this as bug."
msgstr ""
"லைட்மாப்பரை உருவாக்க முடியாவிட்டால் திரும்பும். நீங்கள் தனிப்பயன் லைட்மாப்பரைப் "
"பயன்படுத்தாவிட்டால், இதை பிழையாகப் புகாரளிக்கவும்."

#: docs/BakedLightmap.xml
msgid ""
"There is no root node to start baking from. Either provide [code]from_node[/"
"code] argument or attach this node to a parent that should be used as root."
msgstr ""
"பேக்கிங் தொடங்க ரூட் முனை இல்லை. [குறியீடு] from_node [/code] வாதத்தை வழங்கவும் அல்லது "
"இந்த முனையை வேராகப் பயன்படுத்த வேண்டிய பெற்றோருடன் இணைக்கவும்."

#: docs/BakedLightmap.xml
msgid "No environment is used during baking."
msgstr "பேக்கிங்கின் போது எந்த சூழலும் பயன்படுத்தப்படவில்லை."

#: docs/BakedLightmap.xml
msgid "The baked environment is automatically picked from the current scene."
msgstr "வேகவைத்த சூழல் தற்போதைய காட்சியில் இருந்து தானாகவே தேர்ந்தெடுக்கப்படுகிறது."

#: docs/BakedLightmap.xml
msgid "A custom sky is used as environment during baking."
msgstr "தனிப்பயன் வானம் பேக்கிங்கின் போது சூழலாக பயன்படுத்தப்படுகிறது."

#: docs/BakedLightmap.xml
msgid "A custom solid color is used as environment during baking."
msgstr "தனிப்பயன் திட நிறம் பேக்கிங்கின் போது சூழலாக பயன்படுத்தப்படுகிறது."

#: docs/BakedLightmapData.xml
msgid ""
"Global energy multiplier for baked and dynamic capture objects. This can be "
"changed at run-time without having to bake lightmaps again.\n"
"To adjust only the energy of indirect lighting (without affecting direct "
"lighting or emissive materials), adjust [member "
"BakedLightmap.bounce_indirect_energy] and bake lightmaps again."
msgstr ""
"வேகவைத்த மற்றும் மாறும் பிடிப்பு பொருள்களுக்கான உலகளாவிய ஆற்றல் பெருக்கி. லைட்மேப்சை "
"மீண்டும் சுடாமல் இதை ரன்-டைமில் மாற்றலாம்.\n"
" மறைமுக விளக்குகளின் ஆற்றலை மட்டுமே சரிசெய்ய (நேரடி விளக்குகள் அல்லது உமிழும் "
"பொருட்களை பாதிக்காமல்), [உறுப்பினர் backet lightmap.bounce_indirect_energy] ஐ "
"சரிசெய்து மீண்டும் லைட்மாப்புகளை சுட்டுக்கொள்ளுங்கள்."

#: docs/BakedLightmapData.xml
msgid ""
"Controls whether dynamic capture objects receive environment lighting or not."
msgstr ""
"மாறும் பிடிப்பு பொருள்கள் சுற்றுச்சூழல் விளக்குகளைப் பெறுகின்றனவா இல்லையா என்பதைக் "
"கட்டுப்படுத்துகிறது."

#: docs/BaseButton.xml
msgid "Base class for different kinds of buttons."
msgstr "பல்வேறு வகையான பொத்தான்களுக்கான அடிப்படை வகுப்பு."

#: docs/BaseButton.xml
msgid ""
"BaseButton is the abstract base class for buttons, so it shouldn't be used "
"directly (it doesn't display anything). Other types of buttons inherit from "
"it."
msgstr ""
"பேச் பட்டன் என்பது பொத்தான்களுக்கான சுருக்க அடிப்படை வகுப்பு, எனவே இது நேரடியாகப் "
"பயன்படுத்தப்படக்கூடாது (இது எதையும் காட்டாது). பிற வகை பொத்தான்கள் அதிலிருந்து "
"பெறுகின்றன."

#: docs/BaseButton.xml
msgid ""
"Called when the button is pressed. If you need to know the button's pressed "
"state (and [member toggle_mode] is active), use [method _toggled] instead."
msgstr ""
"பொத்தானை அழுத்தும்போது அழைக்கப்படுகிறது. பொத்தானின் அழுத்தப்பட்ட நிலையை நீங்கள் அறிந்து "
"கொள்ள வேண்டும் என்றால் (மற்றும் [உறுப்பினர் மாற்று முறை] செயலில் உள்ளது), அதற்கு பதிலாக "
"[முறை மாற்றப்பட்ட முறை] பயன்படுத்தவும்."

#: docs/BaseButton.xml
msgid ""
"Called when the button is toggled (only if [member toggle_mode] is active)."
msgstr ""
"பொத்தானை மாற்றும்போது அழைக்கப்படுகிறது ([உறுப்பினர் மாற்று_மோட்] செயலில் இருந்தால் "
"மட்டுமே)."

#: docs/BaseButton.xml
msgid ""
"Returns the visual state used to draw the button. This is useful mainly when "
"implementing your own draw code by either overriding _draw() or connecting "
"to \"draw\" signal. The visual state of the button is defined by the [enum "
"DrawMode] enum."
msgstr ""
"பொத்தானை வரையப் பயன்படுத்தப்படும் காட்சி நிலையை வழங்குகிறது. _ டிரா () ஐ மீறுவதன் மூலம் "
"அல்லது \"டிரா\" சமிக்ஞையுடன் இணைப்பதன் மூலம் உங்கள் சொந்த டிரா குறியீட்டை "
"செயல்படுத்தும்போது இது முக்கியமாக பயனுள்ளதாக இருக்கும். பொத்தானின் காட்சி நிலை [enum "
"prowmode] enum ஆல் வரையறுக்கப்படுகிறது."

#: docs/BaseButton.xml
msgid ""
"Returns [code]true[/code] if the mouse has entered the button and has not "
"left it yet."
msgstr ""
"சுட்டி பொத்தானை உள்ளிட்டு இன்னும் விட்டுவிடவில்லை என்றால் [குறியீடு] உண்மை [/குறியீடு] "
"திரும்பும்."

#: docs/BaseButton.xml
msgid ""
"Changes the [member pressed] state of the button, without emitting [signal "
"toggled]. Use when you just want to change the state of the button without "
"sending the pressed event (e.g. when initializing scene). Only works if "
"[member toggle_mode] is [code]true[/code].\n"
"[b]Note:[/b] This method doesn't unpress other buttons in its button [member "
"group]."
msgstr ""
"[உறுப்பினர் அழுத்தப்பட்ட] பொத்தானின் நிலையை மாற்றாமல், [சமிக்ஞை மாற்றப்பட்டது]. அழுத்திய "
"நிகழ்வை அனுப்பாமல் பொத்தானின் நிலையை மாற்ற விரும்பும் போது பயன்படுத்தவும் (எ.கா. "
"காட்சியைத் தொடங்கும்போது). [உறுப்பினர் மாற்று_மோட்] [குறியீடு] உண்மை [/குறியீடு] என்றால் "
"மட்டுமே செயல்படும்.\n"
" [b] குறிப்பு: [/b] இந்த முறை அதன் பொத்தானை [உறுப்பினர் குழு] மற்ற பொத்தான்களை "
"அகற்றாது."

#: docs/BaseButton.xml
msgid ""
"Determines when the button is considered clicked, one of the [enum "
"ActionMode] constants."
msgstr ""
"பொத்தானைக் சொடுக்கு செய்யும்போது, [enum actionMode] மாறிலிகளில் ஒன்றாகும் என்பதை "
"தீர்மானிக்கிறது."

#: docs/BaseButton.xml
msgid ""
"Binary mask to choose which mouse buttons this button will respond to.\n"
"To allow both left-click and right-click, use [code]BUTTON_MASK_LEFT | "
"BUTTON_MASK_RIGHT[/code]."
msgstr ""
"இந்த பொத்தான் எந்த சுட்டி பொத்தான்களுக்கு பதிலளிக்கும் என்பதைத் தேர்வுசெய்ய பைனரி மாச்க்.\n"
" இடது சொடுக்கு மற்றும் வலது சொடுக்கு இரண்டையும் அனுமதிக்க, [குறியீடு] "
"பொத்தான்_மாச்க்_லெஃப்ட் | ஐப் பயன்படுத்தவும் பொத்தான்_மாச்க்_பிரைட் [/குறியீடு]."

#: docs/BaseButton.xml
msgid ""
"If [code]true[/code], the button is in disabled state and can't be clicked "
"or toggled."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பொத்தான் முடக்கப்பட்ட நிலையில் உள்ளது, மேலும் "
"சொடுக்கு செய்யவோ அல்லது மாற்றவோ முடியாது."

#: docs/BaseButton.xml
msgid ""
"[i]Deprecated.[/i] This property has been deprecated due to redundancy and "
"will be removed. Please use [member Control.focus_mode] instead."
msgstr ""
"[i] நீக்கப்பட்டது. [/i] பணிநீக்கம் காரணமாக இந்த சொத்து நீக்கப்பட்டு அகற்றப்படும். அதற்கு "
"பதிலாக [member control.focus_mode] ஐப் பயன்படுத்தவும்."

#: docs/BaseButton.xml
msgid "[ButtonGroup] associated to the button."
msgstr "[பட்ங்ரூப்] பொத்தானுடன் தொடர்புடையது."

#: docs/BaseButton.xml
msgid ""
"If [code]true[/code], the button stays pressed when moving the cursor "
"outside the button while pressing it.\n"
"[b]Note:[/b] This property only affects the button's visual appearance. "
"Signals will be emitted at the same moment regardless of this property's "
"value."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கர்சரை அழுத்தும் போது அதை அழுத்தும் போது பொத்தானை "
"அழுத்தும்.\n"
" [b] குறிப்பு: [/b] இந்த சொத்து பொத்தானின் காட்சி தோற்றத்தை மட்டுமே பாதிக்கிறது. இந்த "
"சொத்தின் மதிப்பைப் பொருட்படுத்தாமல் ஒரே நேரத்தில் சமிக்ஞைகள் வெளியேற்றப்படும்."

#: docs/BaseButton.xml
msgid ""
"If [code]true[/code], the button's state is pressed. Means the button is "
"pressed down or toggled (if [member toggle_mode] is active). Only works if "
"[member toggle_mode] is [code]true[/code].\n"
"[b]Note:[/b] Setting [member pressed] will result in [signal toggled] to be "
"emitted. If you want to change the pressed state without emitting that "
"signal, use [method set_pressed_no_signal]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பொத்தானின் நிலை அழுத்தப்படுகிறது. பொத்தானை "
"அழுத்தவும் அல்லது மாற்றியமைக்கவும் ([உறுப்பினர் மாற்று_மோட்] செயலில் இருந்தால்). "
"[உறுப்பினர் மாற்று_மோட்] [குறியீடு] உண்மை [/குறியீடு] என்றால் மட்டுமே செயல்படும்.\n"
" . அந்த சமிக்ஞையை வெளியிடாமல் அழுத்தும் நிலையை மாற்ற விரும்பினால், [முறை "
"set_pressed_no_signal] ஐப் பயன்படுத்தவும்."

#: docs/BaseButton.xml
msgid "[ShortCut] associated to the button."
msgstr "[குறுக்குவழி] பொத்தானுடன் தொடர்புடையது."

#: docs/BaseButton.xml
msgid ""
"If [code]true[/code], the button will add information about its shortcut in "
"the tooltip."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பொத்தானை அதன் குறுக்குவழி பற்றிய தகவல்களை "
"உதவிக்குறிப்பில் சேர்க்கும்."

#: docs/BaseButton.xml
msgid ""
"If [code]true[/code], the button is in toggle mode. Makes the button flip "
"state between pressed and unpressed each time its area is clicked."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பொத்தான் மாற்று பயன்முறையில் உள்ளது. ஒவ்வொரு "
"முறையும் அதன் பரப்பளவு சொடுக்கு செய்யப்படும் போது அழுத்தும் மற்றும் அழுத்தும் இடையே "
"பொத்தானை புரட்டுகிறது."

#: docs/BaseButton.xml
msgid "Emitted when the button starts being held down."
msgstr "பொத்தானை கீழே வைக்கத் தொடங்கும் போது உமிழப்படும்."

#: docs/BaseButton.xml
msgid "Emitted when the button stops being held down."
msgstr "பொத்தானை கீழே வைத்திருப்பதை நிறுத்தும்போது உமிழப்படும்."

#: docs/BaseButton.xml
msgid ""
"Emitted when the button is toggled or pressed. This is on [signal "
"button_down] if [member action_mode] is [constant ACTION_MODE_BUTTON_PRESS] "
"and on [signal button_up] otherwise.\n"
"If you need to know the button's pressed state (and [member toggle_mode] is "
"active), use [signal toggled] instead."
msgstr ""
"பொத்தானை மாற்றும்போது அல்லது அழுத்தும் போது உமிழப்படும். [Member action_mode] "
"[நிலையான Action_mode_button_press] மற்றும் [சிக்னல் பொத்தான்_அப்] இல்லையெனில் இது "
"[சிக்னல் பொத்தான்_ டவுன்] இல் உள்ளது.\n"
" பொத்தானின் அழுத்தப்பட்ட நிலையை நீங்கள் அறிந்து கொள்ள வேண்டும் என்றால் (மற்றும் [உறுப்பினர் "
"மாற்று_மோட்] செயலில் உள்ளது), அதற்கு பதிலாக [சமிக்ஞை மாற்றப்பட்ட] பயன்படுத்தவும்."

#: docs/BaseButton.xml
msgid ""
"Emitted when the button was just toggled between pressed and normal states "
"(only if [member toggle_mode] is active). The new state is contained in the "
"[code]button_pressed[/code] argument."
msgstr ""
"அழுத்தப்பட்ட மற்றும் சாதாரண நிலைகளுக்கு இடையில் பொத்தானை மாற்றும்போது உமிழப்படும் "
"([உறுப்பினர் மாற்று_மோட்] செயலில் இருந்தால் மட்டுமே). புதிய நிலை [குறியீடு] "
"பொத்தான்_பிரச் [/குறியீடு] வாதத்தில் உள்ளது."

#: docs/BaseButton.xml
msgid ""
"The normal state (i.e. not pressed, not hovered, not toggled and enabled) of "
"buttons."
msgstr ""
"பொத்தான்களின் இயல்பான நிலை (அதாவது அழுத்தவில்லை, இழுக்கப்படவில்லை, மாற்றப்படவில்லை)."

#: docs/BaseButton.xml
msgid "The state of buttons are pressed."
msgstr "பொத்தான்களின் நிலை அழுத்தப்படுகிறது."

#: docs/BaseButton.xml
msgid "The state of buttons are hovered."
msgstr "பொத்தான்களின் நிலை வட்டமிடப்பட்டுள்ளது."

#: docs/BaseButton.xml
msgid "The state of buttons are disabled."
msgstr "பொத்தான்களின் நிலை முடக்கப்பட்டுள்ளது."

#: docs/BaseButton.xml
msgid "The state of buttons are both hovered and pressed."
msgstr "பொத்தான்களின் நிலை வட்டமிட்டு அழுத்தப்படுகிறது."

#: docs/BaseButton.xml
msgid "Require just a press to consider the button clicked."
msgstr "பொத்தானைக் சொடுக்கு செய்ததைக் கருத்தில் கொள்ள ஒரு செய்தித் தாள் தேவை."

#: docs/BaseButton.xml
msgid ""
"Require a press and a subsequent release before considering the button "
"clicked."
msgstr ""
"பொத்தானைக் சொடுக்கு செய்வதைக் கருத்தில் கொள்வதற்கு முன் ஒரு செய்தித் தாள் மற்றும் அடுத்தடுத்த "
"வெளியீடு தேவை."

#: docs/Basis.xml
msgid "3×3 matrix datatype."
msgstr "3 × 3 மேட்ரிக்ச் டேட்டாடைப்."

#: docs/Basis.xml
msgid ""
"3×3 matrix used for 3D rotation and scale. Almost always used as an "
"orthogonal basis for a Transform.\n"
"Contains 3 vector fields X, Y and Z as its columns, which are typically "
"interpreted as the local basis vectors of a transformation. For such use, it "
"is composed of a scaling and a rotation matrix, in that order (M = R.S).\n"
"Can also be accessed as array of 3D vectors. These vectors are normally "
"orthogonal to each other, but are not necessarily normalized (due to "
"scaling).\n"
"For more information, read the \"Matrices and transforms\" documentation "
"article."
msgstr ""
"3 டி சுழற்சி மற்றும் அளவிற்கு பயன்படுத்தப்படும் 3 × 3 மேட்ரிக்ச். ஒரு உருமாற்றத்திற்கான "
"ஆர்த்தோகனல் அடிப்படையாக எப்போதும் பயன்படுத்தப்படுகிறது.\n"
" 3 திசையன் புலங்கள் ஃச், ஒய் மற்றும் சட் அதன் நெடுவரிசைகளாக உள்ளன, அவை பொதுவாக ஒரு "
"உருமாற்றத்தின் உள்ளக அடிப்படை திசையன்களாக விளக்கப்படுகின்றன. அத்தகைய பயன்பாட்டிற்கு, இது "
"ஒரு அளவிடுதல் மற்றும் சுழற்சி மேட்ரிக்சால் ஆனது, அந்த வரிசையில் (M = R.S).\n"
" 3D திசையன்களின் வரிசையாகவும் அணுகலாம். இந்த திசையன்கள் பொதுவாக ஒருவருக்கொருவர் "
"ஆர்த்தோகோனல் ஆகும், ஆனால் அவை இயல்பாக்கப்பட வேண்டிய அவசியமில்லை (அளவிடுதல் காரணமாக).\n"
" மேலும் தகவலுக்கு, \"மெட்ரிக்குகள் மற்றும் உருமாற்றங்கள்\" ஆவணக் கட்டுரையைப் படியுங்கள்."

#: docs/Basis.xml docs/Transform.xml docs/Transform2D.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/math/"
"matrices_and_transforms.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/math/"
"matrices_and_transforms.html"

#: docs/Basis.xml docs/Transform.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/using_transforms.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/3d/using_transforms.html"

#: docs/Basis.xml
msgid "Constructs a pure rotation basis matrix from the given quaternion."
msgstr ""
"கொடுக்கப்பட்ட குவாட்டர்னியனில் இருந்து தூய சுழற்சி அடிப்படை மேட்ரிக்சை உருவாக்குகிறது."

#: docs/Basis.xml
msgid ""
"Constructs a pure rotation basis matrix from the given Euler angles (in the "
"YXZ convention: when *composing*, first Y, then X, and Z last), given in the "
"vector format as (X angle, Y angle, Z angle).\n"
"Consider using the [Quat] constructor instead, which uses a quaternion "
"instead of Euler angles."
msgstr ""
"கொடுக்கப்பட்ட யூலர் கோணங்களிலிருந்து (YXZ மாநாட்டில்: *, முதல் ஒய், பின்னர் ஃச், மற்றும் சட் "
"கடைசி), திசையன் வடிவத்தில் (x கோணம், ஒய் கோணம், சட் கோணம்) கொடுக்கப்பட்டுள்ள ஒரு தூய "
"சுழற்சி அடிப்படை மேட்ரிக்சை உருவாக்குகிறது.\n"
" அதற்கு பதிலாக [குவாட்] கட்டமைப்பாளரைப் பயன்படுத்துவதைக் கவனியுங்கள், இது யூலர் "
"கோணங்களுக்கு பதிலாக ஒரு குவாட்டர்னியனைப் பயன்படுத்துகிறது."

#: docs/Basis.xml
msgid ""
"Constructs a pure rotation basis matrix, rotated around the given "
"[code]axis[/code] by [code]phi[/code], in radians. The axis must be a "
"normalized vector."
msgstr ""
"ரேடியன்களில் [குறியீடு] phi [/code] ஆல் கொடுக்கப்பட்ட [குறியீடு] அச்சைச் சுற்றி சுழலும் "
"தூய சுழற்சி அடிப்படை மேட்ரிக்சை உருவாக்குகிறது. அச்சு ஒரு இயல்பாக்கப்பட்ட திசையனாக "
"இருக்க வேண்டும்."

#: docs/Basis.xml
msgid "Constructs a basis matrix from 3 axis vectors (matrix columns)."
msgstr ""
"3 அச்சு திசையன்களிலிருந்து (மேட்ரிக்ச் நெடுவரிசைகள்) ஒரு அடிப்படை மேட்ரிக்சை "
"உருவாக்குகிறது."

#: docs/Basis.xml
msgid ""
"Returns the determinant of the basis matrix. If the basis is uniformly "
"scaled, its determinant is the square of the scale.\n"
"A negative determinant means the basis has a negative scale. A zero "
"determinant means the basis isn't invertible, and is usually considered "
"invalid."
msgstr ""
"அடிப்படை மேட்ரிக்சின் நிர்ணயிப்பாளரை வழங்குகிறது. அடிப்படை ஒரே மாதிரியாக "
"அளவிடப்பட்டால், அதன் தீர்மானிப்பவர் அளவின் சதுரம்.\n"
" எதிர்மறை தீர்மானிப்பவர் என்றால் அடிப்படை எதிர்மறை அளவைக் கொண்டுள்ளது. சுழிய தீர்மானிப்பவர் "
"என்றால் அடிப்படை தலைகீழ் அல்ல, பொதுவாக இது செல்லாது என்று கருதப்படுகிறது."

#: docs/Basis.xml
msgid ""
"Returns the basis's rotation in the form of Euler angles (in the YXZ "
"convention: when decomposing, first Z, then X, and Y last). The returned "
"vector contains the rotation angles in the format (X angle, Y angle, Z "
"angle).\n"
"Consider using the [method get_rotation_quat] method instead, which returns "
"a [Quat] quaternion instead of Euler angles."
msgstr ""
"அடிப்படையின் சுழற்சியை யூலர் கோணங்களின் வடிவத்தில் வழங்குகிறது (YXZ மாநாட்டில்: "
"சிதைந்தால், முதல் சட், பின்னர் ஃச், மற்றும் ஒய் கடைசியாக). திரும்பிய திசையன் வடிவத்தில் "
"சுழற்சி கோணங்களைக் கொண்டுள்ளது (x கோணம், ஒய் கோணம், சட் கோணம்).\n"
" அதற்கு பதிலாக [முறை get_rotation_quat] முறையைப் பயன்படுத்துவதைக் கவனியுங்கள், இது "
"யூலர் கோணங்களுக்கு பதிலாக [குவாட்] குவாட்டர்னியனைத் தருகிறது."

#: docs/Basis.xml
msgid ""
"This function considers a discretization of rotations into 24 points on unit "
"sphere, lying along the vectors (x,y,z) with each component being either -1, "
"0, or 1, and returns the index of the point best representing the "
"orientation of the object. It is mainly used by the [GridMap] editor. For "
"further details, refer to the Rebel Engine source code."
msgstr ""
"இந்த செயல்பாடு ஒவ்வொரு கூறுகளும் -1, 0, அல்லது 1 எனக் கொண்டு திசையன்களுடன் (x, ஒய், z) "
"படுத்துக் கொண்டு, யூனிட் கோளத்தில் 24 புள்ளிகளாக சுழற்சிகளை தனித்தனியாகக் கருதுகிறது, "
"மேலும் பொருளின் நோக்குநிலையை சிறப்பாகக் குறிக்கும் புள்ளியின் குறியீட்டை வழங்குகிறது. "
"இது முக்கியமாக [GRIDMAP] எடிட்டரால் பயன்படுத்தப்படுகிறது. மேலும் விவரங்களுக்கு, "
"கிளர்ச்சி இயந்திர மூலக் குறியீட்டைப் பார்க்கவும்."

#: docs/Basis.xml
msgid ""
"Returns the basis's rotation in the form of a quaternion. See [method "
"get_euler] if you need Euler angles, but keep in mind quaternions should "
"generally be preferred to Euler angles."
msgstr ""
"அடிப்படையின் சுழற்சியை ஒரு குவாட்டர்னியன் வடிவத்தில் வழங்குகிறது. உங்களுக்கு யூலர் "
"கோணங்கள் தேவைப்பட்டால் [முறை get_euler] ஐப் பார்க்கவும், ஆனால் மனதில் குவாட்டர்னியன்கள் "
"பொதுவாக யூலர் கோணங்களுக்கு விரும்பப்பட வேண்டும்."

#: docs/Basis.xml
msgid ""
"Assuming that the matrix is the combination of a rotation and scaling, "
"return the absolute value of scaling factors along each axis."
msgstr ""
"மேட்ரிக்ச் என்பது ஒரு சுழற்சி மற்றும் அளவிடுதல் ஆகியவற்றின் கலவையாகும் என்று கருதி, "
"ஒவ்வொரு அச்சிலும் அளவிடுதல் காரணிகளின் முழுமையான மதிப்பைத் தரும்."

#: docs/Basis.xml
msgid "Returns the inverse of the matrix."
msgstr "மேட்ரிக்சின் தலைகீழ் வழங்குகிறது."

#: docs/Basis.xml
msgid ""
"Returns [code]true[/code] if this basis and [code]b[/code] are approximately "
"equal, by calling [code]is_equal_approx[/code] on each component.\n"
"[b]Note:[/b] For complicated reasons, the epsilon argument is always "
"discarded. Don't use the epsilon argument, it does nothing."
msgstr ""
"ஒவ்வொரு கூறுகளிலும் [குறியீடு] IS_ECT_APPROX [/குறியீடு] ஐ அழைப்பதன் மூலம் இந்த "
"அடிப்படை மற்றும் [குறியீடு] B [/குறியீடு] தோராயமாக சமமாக இருந்தால் [குறியீடு] உண்மை [/"
"குறியீடு] திரும்பும்.\n"
" [b] குறிப்பு: [/b] சிக்கலான காரணங்களுக்காக, எப்சிலன் உரையாடல் எப்போதும் "
"நிராகரிக்கப்படுகிறது. எப்சிலன் வாதத்தைப் பயன்படுத்த வேண்டாம், அது எதுவும் செய்யாது."

#: docs/Basis.xml
msgid ""
"Returns the orthonormalized version of the matrix (useful to call from time "
"to time to avoid rounding error for orthogonal matrices). This performs a "
"Gram-Schmidt orthonormalization on the basis of the matrix."
msgstr ""
"மேட்ரிக்சின் ஆர்த்தோனார்மலைச் செய்யப்பட்ட பதிப்பை வழங்குகிறது (ஆர்த்தோகனல் மெட்ரிக்குகளுக்கான "
"வட்டமான பிழையைத் தவிர்க்க அவ்வப்போது அழைக்க பயனுள்ளதாக இருக்கும்). இது மேட்ரிக்சின் "
"அடிப்படையில் ஒரு கிராம்-ச்கிமிட் ஆர்த்தோனிசார்னலைசேசனை செய்கிறது."

#: docs/Basis.xml
msgid ""
"Introduce an additional rotation around the given axis by phi (radians). The "
"axis must be a normalized vector."
msgstr ""
"கொடுக்கப்பட்ட அச்சில் PHI (ரேடியன்கள்) மூலம் கூடுதல் சுழற்சியை அறிமுகப்படுத்துங்கள். அச்சு "
"ஒரு இயல்பாக்கப்பட்ட திசையனாக இருக்க வேண்டும்."

#: docs/Basis.xml
msgid ""
"Introduce an additional scaling specified by the given 3D scaling factor."
msgstr ""
"கொடுக்கப்பட்ட 3D அளவிடுதல் காரணியால் குறிப்பிடப்பட்ட கூடுதல் அளவை அறிமுகப்படுத்துங்கள்."

#: docs/Basis.xml
msgid ""
"Assuming that the matrix is a proper rotation matrix, slerp performs a "
"spherical-linear interpolation with another rotation matrix."
msgstr ""
"மேட்ரிக்ச் ஒரு சரியான சுழற்சி அணி என்று கருதி, SLERP மற்றொரு சுழற்சி மேட்ரிக்சுடன் ஒரு "
"கோள-நேரியல் இடைக்கணிப்பை செய்கிறது."

#: docs/Basis.xml
msgid "Transposed dot product with the X axis of the matrix."
msgstr "மேட்ரிக்சின் ஃச் அச்சுடன் இடமாற்றம் செய்யப்பட்ட புள்ளி தயாரிப்பு."

#: docs/Basis.xml
msgid "Transposed dot product with the Y axis of the matrix."
msgstr "மேட்ரிக்சின் ஒய் அச்சுடன் மாற்றப்பட்ட புள்ளி தயாரிப்பு."

#: docs/Basis.xml
msgid "Transposed dot product with the Z axis of the matrix."
msgstr "மேட்ரிக்சின் சட் அச்சுடன் இடமாற்றம் செய்யப்பட்ட புள்ளி தயாரிப்பு."

#: docs/Basis.xml
msgid "Returns the transposed version of the matrix."
msgstr "மேட்ரிக்சின் இடமாற்ற பதிப்பை வழங்குகிறது."

#: docs/Basis.xml
msgid "Returns a vector transformed (multiplied) by the matrix."
msgstr "மேட்ரிக்சால் மாற்றப்பட்ட ஒரு திசையன் (பெருக்கப்படுகிறது) தருகிறது."

#: docs/Basis.xml
msgid ""
"Returns a vector transformed (multiplied) by the transposed basis matrix.\n"
"[b]Note:[/b] This results in a multiplication by the inverse of the matrix "
"only if it represents a rotation-reflection."
msgstr ""
"மாற்றப்பட்ட அடிப்படை மேட்ரிக்சால் மாற்றப்பட்ட (பெருக்கப்படுகிறது) ஒரு திசையன் தருகிறது.\n"
" ."

#: docs/Basis.xml docs/Transform2D.xml
msgid ""
"The basis matrix's X vector (column 0). Equivalent to array index [code]0[/"
"code]."
msgstr ""
"அடிப்படை மேட்ரிக்சின் ஃச் திசையன் (நெடுவரிசை 0). வரிசை குறியீட்டுக்கு சமம் [குறியீடு] 0 "
"[/குறியீடு]."

#: docs/Basis.xml docs/Transform2D.xml
msgid ""
"The basis matrix's Y vector (column 1). Equivalent to array index [code]1[/"
"code]."
msgstr ""
"அடிப்படை மேட்ரிக்சின் ஒய் திசையன் (நெடுவரிசை 1). வரிசை குறியீட்டுக்கு சமம் [குறியீடு] 1 "
"[/குறியீடு]."

#: docs/Basis.xml
msgid ""
"The basis matrix's Z vector (column 2). Equivalent to array index [code]2[/"
"code]."
msgstr ""
"அடிப்படை மேட்ரிக்சின் சட் திசையன் (நெடுவரிசை 2). வரிசை குறியீட்டுக்கு சமம் [குறியீடு] 2 "
"[/குறியீடு]."

#: docs/Basis.xml
msgid ""
"The identity basis, with no rotation or scaling applied.\n"
"This is identical to calling [code]Basis()[/code] without any parameters. "
"This constant can be used to make your code clearer, and for consistency "
"with C#."
msgstr ""
"அடையாள அடிப்படை, சுழற்சி அல்லது அளவிடுதல் எதுவும் பயன்படுத்தப்படவில்லை.\n"
" இது எந்த அளவுருக்கள் இல்லாமல் [குறியீடு] அடிப்படை () [/குறியீடு] ஐ அழைப்பதற்கு "
"ஒத்ததாகும். உங்கள் குறியீட்டை தெளிவுபடுத்தவும், சி#உடன் ஒத்துப்போகவும் இந்த மாறிலி "
"பயன்படுத்தப்படலாம்."

#: docs/Basis.xml
msgid ""
"The basis that will flip something along the X axis when used in a "
"transformation."
msgstr "ஒரு மாற்றத்தில் பயன்படுத்தப்படும்போது ஃச் அச்சில் எதையாவது புரட்டும் அடிப்படை."

#: docs/Basis.xml
msgid ""
"The basis that will flip something along the Y axis when used in a "
"transformation."
msgstr "ஒரு மாற்றத்தில் பயன்படுத்தப்படும்போது ஒய் அச்சில் எதையாவது புரட்டும் அடிப்படை."

#: docs/Basis.xml
msgid ""
"The basis that will flip something along the Z axis when used in a "
"transformation."
msgstr "மாற்றத்தில் பயன்படுத்தப்படும்போது சட் அச்சில் எதையாவது புரட்டும் அடிப்படை."

#: docs/BitMap.xml
msgid "Boolean matrix."
msgstr "பூலியன் மேட்ரிக்ச்."

#: docs/BitMap.xml
msgid ""
"A two-dimensional array of boolean values, can be used to efficiently store "
"a binary matrix (every matrix element takes only one bit) and query the "
"values using natural cartesian coordinates."
msgstr ""
"பூலியன் மதிப்புகளின் இரு பரிமாண வரிசை, ஒரு பைனரி மேட்ரிக்சை திறம்பட சேமிக்க "
"பயன்படுத்தலாம் (ஒவ்வொரு மேட்ரிக்ச் உறுப்புகளும் ஒரு பிட் மட்டுமே எடுக்கும்) மற்றும் இயற்கை "
"கார்ட்டீசியன் ஆயங்களைப் பயன்படுத்தி மதிப்புகளை வினவலாம்."

#: docs/BitMap.xml
msgid ""
"Creates a bitmap with the specified size, filled with [code]false[/code]."
msgstr ""
"[குறியீடு] தவறான [/குறியீடு] நிரப்பப்பட்ட குறிப்பிட்ட அளவுடன் பிட்மேப்பை உருவாக்குகிறது."

#: docs/BitMap.xml
msgid ""
"Creates a bitmap that matches the given image dimensions, every element of "
"the bitmap is set to [code]false[/code] if the alpha value of the image at "
"that position is equal to [code]threshold[/code] or less, and [code]true[/"
"code] in other case."
msgstr ""
"கொடுக்கப்பட்ட பட பரிமாணங்களுடன் பொருந்தக்கூடிய பிட்மேப்பை உருவாக்குகிறது, பிட்மேப்பின் "
"ஒவ்வொரு உறுப்புகளும் அந்த நிலையில் உள்ள படத்தின் ஆல்பா மதிப்பு [குறியீடு] வாசல் [/"
"குறியீடு] அல்லது அதற்கும் குறைவான, மற்றும் [குறியீடு] உண்மையான [/குறியீடு] க்கு சமமாக "
"இருந்தால் [குறியீடு] தவறான [/குறியீடு] என அமைக்கப்படுகிறது."

#: docs/BitMap.xml
msgid "Returns bitmap's value at the specified position."
msgstr "குறிப்பிட்ட நிலையில் பிட்மேப்பின் மதிப்பை வழங்குகிறது."

#: docs/BitMap.xml
msgid "Returns bitmap's dimensions."
msgstr "பிட்மேப்பின் பரிமாணங்களைத் தருகிறது."

#: docs/BitMap.xml
msgid ""
"Returns the amount of bitmap elements that are set to [code]true[/code]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என அமைக்கப்பட்ட பிட்மேப் கூறுகளின் அளவை வழங்குகிறது."

#: docs/BitMap.xml
msgid ""
"Applies morphological dilation or erosion to the bitmap. If [code]pixels[/"
"code] is positive, dilation is applied to the bitmap. If [code]pixels[/code] "
"is negative, erosion is applied to the bitmap. [code]rect[/code] defines the "
"area where the morphological operation is applied. Pixels located outside "
"the [code]rect[/code] are unaffected by [method grow_mask]."
msgstr ""
"பிட்மேப்பிற்கு உருவவியல் விரிவாக்கம் அல்லது அரிப்பைப் பயன்படுத்துகிறது. [குறியீடு] "
"படப்புள்ளிகள் [/குறியீடு] நேர்மறையாக இருந்தால், பிட்மேப்பில் விரிவாக்கம் "
"பயன்படுத்தப்படுகிறது. [குறியீடு] படப்புள்ளிகள் [/குறியீடு] எதிர்மறையாக இருந்தால், "
"பிட்மேப்பில் அரிப்பு பயன்படுத்தப்படுகிறது. [குறியீடு] செவ்வகம் [/குறியீடு] உருவவியல் "
"செயல்பாடு பயன்படுத்தப்படும் பகுதியை வரையறுக்கிறது. [குறியீடு] செவ்வகத்திற்கு வெளியே "
"அமைந்துள்ள படப்புள்ளிகள் [/குறியீடு] [முறை COWER_MASK] ஆல் பாதிக்கப்படாது."

#: docs/BitMap.xml
msgid ""
"Sets the bitmap's element at the specified position, to the specified value."
msgstr "பிட்மேப்பின் உறுப்பை குறிப்பிட்ட நிலையில், குறிப்பிட்ட மதிப்புக்கு அமைக்கிறது."

#: docs/BitMap.xml
msgid "Sets a rectangular portion of the bitmap to the specified value."
msgstr "பிட்மேப்பின் செவ்வக பகுதியை குறிப்பிட்ட மதிப்புக்கு அமைக்கிறது."

#: docs/BitmapFont.xml
msgid ""
"Renders text using fonts under the [url=https://www.angelcode.com/products/"
"bmfont/]BMFont[/url] format.\n"
"Handles files with the [code].fnt[/code] extension."
msgstr ""
"[Url = https: //www.angelcode.com/products/bmfont/] bmfont [/url] வடிவமைப்பின் "
"கீழ் எழுத்துருக்களைப் பயன்படுத்தி உரையை வழங்குகிறது.\n"
" [குறியீடு] .fnt [/code] நீட்டிப்புடன் கோப்புகளை கையாளுகிறது."

#: docs/BitmapFont.xml
msgid ""
"Renders text using [code]*.fnt[/code] fonts containing texture atlases. "
"Supports distance fields. For using vector font files like TTF directly, see "
"[DynamicFont]."
msgstr ""
"[குறியீடு]*. Fnt [/code] எழுத்துருக்களைப் பயன்படுத்தி உரையை வழங்குகிறது. தொலைதூர "
"புலங்களை ஆதரிக்கிறது. TTF போன்ற திசையன் எழுத்துரு கோப்புகளை நேரடியாகப் பயன்படுத்த, "
"[டைனமிக்ஃபோன்ட்] ஐப் பார்க்கவும்."

#: docs/BitmapFont.xml
msgid ""
"Adds a character to the font, where [code]character[/code] is the Unicode "
"value, [code]texture[/code] is the texture index, [code]rect[/code] is the "
"region in the texture (in pixels!), [code]align[/code] is the (optional) "
"alignment for the character and [code]advance[/code] is the (optional) "
"advance."
msgstr ""
"எழுத்துருவில் ஒரு எழுத்தை சேர்க்கிறது, அங்கு [குறியீடு] எழுத்து [/குறியீடு] என்பது "
"யூனிகோட் மதிப்பு, [குறியீடு] அமைப்பு [/குறியீடு] என்பது அமைப்பு குறியீடாகும், "
"[குறியீடு] செவ்வகம் [/குறியீடு] என்பது அமைப்பில் (பிக்சல்களில்!), [குறியீடு] [/குறியீடு] "
"என்பது தன்மை மற்றும் [குறியீடு] அட்வான்ச் [/குறியீடு] அட்வான்ச் (விருப்பமான) சீரமைப்பு ஆகும்."

#: docs/BitmapFont.xml
msgid ""
"Adds a kerning pair to the [BitmapFont] as a difference. Kerning pairs are "
"special cases where a typeface advance is determined by the next character."
msgstr ""
"[பிட்மேப்ஃபோன்ட்] க்கு ஒரு கெர்னிங் சோடியை ஒரு வித்தியாசமாக சேர்க்கிறது. கெர்னிங் சோடிகள் "
"சிறப்பு நிகழ்வுகள், அங்கு ஒரு தட்டச்சு முன்கூட்டியே அடுத்த எழுத்துடன் தீர்மானிக்கப்படுகிறது."

#: docs/BitmapFont.xml
msgid "Adds a texture to the [BitmapFont]."
msgstr "[பிட்மாப்ஃபோன்ட்] க்கு ஒரு அமைப்பைச் சேர்க்கிறது."

#: docs/BitmapFont.xml
msgid "Clears all the font data and settings."
msgstr "அனைத்து எழுத்துரு தரவு மற்றும் அமைப்புகளையும் அழிக்கிறது."

#: docs/BitmapFont.xml
msgid ""
"Creates a BitmapFont from the [code]*.fnt[/code] file at [code]path[/code]."
msgstr ""
"[குறியீடு]*. Fnt [/code] கோப்பிலிருந்து [குறியீடு] பாதையில் [/குறியீடு] ஒரு "
"பிட்மேப்ஃபாண்டை உருவாக்குகிறது."

#: docs/BitmapFont.xml
msgid "Returns a kerning pair as a difference."
msgstr "கெர்னிங் சோடியை ஒரு வித்தியாசமாக வழங்குகிறது."

#: docs/BitmapFont.xml
msgid "Returns the font atlas texture at index [code]idx[/code]."
msgstr "குறியீட்டு [குறியீடு] IDX [/code] இல் எழுத்துரு அட்லச் அமைப்பை வழங்குகிறது."

#: docs/BitmapFont.xml
msgid "Returns the number of textures in the BitmapFont atlas."
msgstr "பிட்மாப்ஃபோன்ட் அட்லசில் உள்ள அமைப்புகளின் எண்ணிக்கையை வழங்குகிறது."

#: docs/BitmapFont.xml
msgid "Ascent (number of pixels above the baseline)."
msgstr "ஏற்றம் (அடிப்படைக்கு மேலே பிக்சல்களின் எண்ணிக்கை)."

#: docs/BitmapFont.xml
msgid "If [code]true[/code], distance field hint is enabled."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், தொலைதூர புல குறிப்பு இயக்கப்பட்டது."

#: docs/BitmapFont.xml
msgid "The fallback font."
msgstr "குறைவடையும் எழுத்துரு."

#: docs/BitmapFont.xml
msgid "Total font height (ascent plus descent) in pixels."
msgstr "பிக்சல்களில் மொத்த எழுத்துரு உயரம் (ஏற்றம் மற்றும் வம்சாவளி)."

#: docs/Bone2D.xml
msgid "Joint used with [Skeleton2D] to control and animate other nodes."
msgstr ""
"மற்ற முனைகளைக் கட்டுப்படுத்தவும் உயிரூட்டவும் [எலும்புக்கூடு 2 டி] உடன் கூட்டு "
"பயன்படுத்தப்படுகிறது."

#: docs/Bone2D.xml
msgid ""
"Use a hierarchy of [code]Bone2D[/code] bound to a [Skeleton2D] to control, "
"and animate other [Node2D] nodes.\n"
"You can use [code]Bone2D[/code] and [code]Skeleton2D[/code] nodes to animate "
"2D meshes created with the Polygon 2D UV editor.\n"
"Each bone has a [member rest] transform that you can reset to with [method "
"apply_rest]. These rest poses are relative to the bone's parent.\n"
"If in the editor, you can set the rest pose of an entire skeleton using a "
"menu option, from the code, you need to iterate over the bones to set their "
"individual rest poses."
msgstr ""
"[குறியீடு] எலும்பு 2 டி [/குறியீடு] ஐ [எலும்புக்கூடு 2 டி] உடன் கட்டுப்படுத்தவும், பிற "
"[Node2D] முனைகளை உயிரூட்டவும் பயன்படுத்தவும்.\n"
" பலகோணம் 2 டி யு.வி. எடிட்டருடன் உருவாக்கப்பட்ட 2 டி மெச்களை உயிரூட்டுவதற்கு நீங்கள் "
"[குறியீடு] எலும்பு 2 டி [/குறியீடு] மற்றும் [குறியீடு] எலும்புக்கூடு 2 டி [/குறியீடு] "
"முனைகளைப் பயன்படுத்தலாம்.\n"
" ஒவ்வொரு எலும்பிலும் [உறுப்பினர் ஓய்வு] உருமாற்றம் உள்ளது, நீங்கள் [முறை Apply_Rest] உடன் "
"மீட்டமைக்க முடியும். இந்த ஓய்வு போச்கள் எலும்பின் பெற்றோருடன் தொடர்புடையவை.\n"
" எடிட்டரில் இருந்தால், ஒரு பட்டியல் விருப்பத்தைப் பயன்படுத்தி ஒரு முழு எலும்புக்கூட்டின் "
"மீதமுள்ள போசை நீங்கள் அமைக்கலாம், குறியீட்டிலிருந்து, எலும்புகள் அவற்றின் தனிப்பட்ட ஓய்வு "
"போச்களை அமைக்க நீங்கள் மீண்டும் செய்ய வேண்டும்."

#: docs/Bone2D.xml
msgid "Stores the node's current transforms in [member rest]."
msgstr "முனையின் தற்போதைய மாற்றங்களை [உறுப்பினர் ஓய்வு] இல் சேமிக்கிறது."

#: docs/Bone2D.xml
msgid ""
"Returns the node's index as part of the entire skeleton. See [Skeleton2D]."
msgstr ""
"முழு எலும்புக்கூட்டின் ஒரு பகுதியாக முனையின் குறியீட்டை வழங்குகிறது. [எலும்புக்கூடு 2 "
"டி] ஐப் பார்க்கவும்."

#: docs/Bone2D.xml
msgid ""
"Returns the node's [member rest] [code]Transform2D[/code] if it doesn't have "
"a parent, or its rest pose relative to its parent."
msgstr ""
"முனையின் [உறுப்பினர் ஓய்வு] [குறியீடு] டிரான்ச்ஃபார்ம் 2 டி [/குறியீட்டை] பெற்றோர் "
"இல்லையென்றால், அல்லது அதன் ஓய்வு அதன் பெற்றோருடன் தொடர்புடையதாக இருந்தால்."

#: docs/Bone2D.xml
msgid ""
"Length of the bone's representation drawn in the editor's viewport in pixels."
msgstr ""
"எலும்பின் பிரதிநிதித்துவத்தின் நீளம் பிக்சல்களில் எடிட்டரின் காட்சியமைப்பில் வரையப்பட்டது."

#: docs/Bone2D.xml
msgid ""
"Rest transform of the bone. You can reset the node's transforms to this "
"value using [method apply_rest]."
msgstr ""
"எலும்பின் ஓய்வு மாற்றம். [முறை Appl_rest] ஐப் பயன்படுத்தி இந்த மதிப்புக்கு முனையின் "
"மாற்றங்களை மீட்டமைக்கலாம்."

#: docs/BoneAttachment.xml
msgid "A node that will attach to a bone."
msgstr "எலும்புடன் இணைக்கும் ஒரு முனை."

#: docs/BoneAttachment.xml
msgid ""
"This node must be the child of a [Skeleton] node. You can then select a bone "
"for this node to attach to. The BoneAttachment node will copy the transform "
"of the selected bone."
msgstr ""
"இந்த முனை ஒரு [எலும்புக்கூடு] முனையின் குழந்தையாக இருக்க வேண்டும். இணைக்க இந்த முனைக்கு "
"நீங்கள் ஒரு எலும்பைத் தேர்ந்தெடுக்கலாம். தேர்ந்தெடுக்கப்பட்ட எலும்பின் உருமாற்றத்தை போனீடாக்மென்ட் "
"முனை நகலெடுக்கும்."

#: docs/BoneAttachment.xml
msgid "The name of the attached bone."
msgstr "இணைக்கப்பட்ட எலும்பின் பெயர்."

#: docs/bool.xml
msgid "Boolean built-in type."
msgstr "பூலியன் உள்ளமைக்கப்பட்ட வகை."

#: docs/bool.xml
msgid ""
"Boolean is a built-in type. There are two boolean values: [code]true[/code] "
"and [code]false[/code]. You can think of it as a switch with on or off (1 or "
"0) setting. Booleans are used in programming for logic in condition "
"statements, like [code]if[/code] statements.\n"
"Booleans can be directly used in [code]if[/code] statements. The code below "
"demonstrates this on the [code]if can_shoot:[/code] line. You don't need to "
"use [code]== true[/code], you only need [code]if can_shoot:[/code]. "
"Similarly, use [code]if not can_shoot:[/code] rather than [code]== false[/"
"code].\n"
"[codeblock]\n"
"var can_shoot = true\n"
"\n"
"func shoot():\n"
"    if can_shoot:\n"
"        pass # Perform shooting actions here.\n"
"[/codeblock]\n"
"The following code will only create a bullet if both conditions are met: "
"action \"shoot\" is pressed and if [code]can_shoot[/code] is [code]true[/"
"code].\n"
"[b]Note:[/b] [code]Input.is_action_pressed(\"shoot\")[/code] is also a "
"boolean that is [code]true[/code] when \"shoot\" is pressed and [code]false[/"
"code] when \"shoot\" isn't pressed.\n"
"[codeblock]\n"
"var can_shoot = true\n"
"\n"
"func shoot():\n"
"    if can_shoot and Input.is_action_pressed(\"shoot\"):\n"
"        create_bullet()\n"
"[/codeblock]\n"
"The following code will set [code]can_shoot[/code] to [code]false[/code] and "
"start a timer. This will prevent player from shooting until the timer runs "
"out. Next [code]can_shoot[/code] will be set to [code]true[/code] again "
"allowing player to shoot once again.\n"
"[codeblock]\n"
"var can_shoot = true\n"
"onready var cool_down = $CoolDownTimer\n"
"\n"
"func shoot():\n"
"    if can_shoot and Input.is_action_pressed(\"shoot\"):\n"
"        create_bullet()\n"
"        can_shoot = false\n"
"        cool_down.start()\n"
"\n"
"func _on_CoolDownTimer_timeout():\n"
"    can_shoot = true\n"
"[/codeblock]"
msgstr ""
"பூலியன் ஒரு உள்ளமைக்கப்பட்ட வகை. இரண்டு பூலியன் மதிப்புகள் உள்ளன: [குறியீடு] உண்மை [/"
"குறியீடு] மற்றும் [குறியீடு] தவறான [/குறியீடு]. ஆன் அல்லது ஆஃப் (1 அல்லது 0) அமைப்புடன் "
"ஒரு சுவிட்சாக இதை நீங்கள் நினைக்கலாம். [/குறியீடு] அறிக்கைகள் என்றால், நிபந்தனை "
"அறிக்கைகளில் தர்க்கத்திற்கான நிரலாக்கத்தில் பூலியன்ச் பயன்படுத்தப்படுகிறது.\n"
" [/குறியீடு] அறிக்கைகள் என்றால் பூலியன்ச் நேரடியாக [குறியீடு] பயன்படுத்தப்படலாம். "
"கீழேயுள்ள குறியீடு இதை [குறியீடு] கேன்_சூட் என்றால் நிரூபிக்கிறது: [/குறியீடு] வரியில். "
"நீங்கள் [குறியீடு] == உண்மை [/குறியீடு] ஐப் பயன்படுத்தத் தேவையில்லை, கேன்_சூட் என்றால் "
"மட்டுமே உங்களுக்கு [குறியீடு] தேவை: [/குறியீடு]. இதேபோல், [குறியீடு] == தவறான [/"
"குறியீடு] ஐ விட [/குறியீடு] பயன்படுத்தவில்லை: [/குறியீடு].\n"
" [கோட் பிளாக்]\n"
" var can_shoot = உண்மை\n"
"\n"
" func shoft ():\n"
" can_shoot என்றால்:\n"
" பாச் # இங்கே படப்பிடிப்பு செயல்களைச் செய்யுங்கள்.\n"
" [/codeBlock]\n"
" இரண்டு நிபந்தனைகளும் நிறைவு செய்யப்பட்டால் மட்டுமே பின்வரும் குறியீடு ஒரு புல்லட்டை "
"உருவாக்கும்: செயல் \"படப்பிடிப்பு\" அழுத்தப்பட்டு, [குறியீடு] can_shoot [/code] "
"[குறியீடு] உண்மை [/குறியீடு] என்றால்.\n"
" .\n"
" [கோட் பிளாக்]\n"
" var can_shoot = உண்மை\n"
"\n"
" func shoft ():\n"
" can_shoot மற்றும் input.is_action_pressed (\"படப்பிடிப்பு\"):\n"
" create_bullet ()\n"
" [/codeBlock]\n"
" பின்வரும் குறியீடு [குறியீடு] Can_shoot [/code] ஐ [குறியீடு] தவறான [/குறியீடு] என "
"அமைத்து டைமரைத் தொடங்கும். இது நேரங்குறிகருவி வெளியேறும் வரை வீரர் படப்பிடிப்பைத் "
"தடுக்கும். அடுத்து [குறியீடு] Can_shoot [/code] [குறியீடு] உண்மை [/குறியீடு] என "
"மீண்டும் பிளேயரை மீண்டும் சுட அனுமதிக்கிறது.\n"
" [கோட் பிளாக்]\n"
" var can_shoot = உண்மை\n"
" onready var cool_down = $ cooldowntimer\n"
"\n"
" func தண்டுக் கிளை ():\n"
" can_shoot மற்றும் input.is_action_pressed (\"படப்பிடிப்பு\"):\n"
" create_bullet ()\n"
" can_shoot = பொய்\n"
" கூல்_ டவுன்.ச்டார்ட் ()\n"
"\n"
" func _on_cooldowntimer_timeout ():\n"
" can_shoot = உண்மை\n"
" [/codeBlock]"

#: docs/bool.xml
msgid ""
"Cast an [int] value to a boolean value, this method will return [code]false[/"
"code] if [code]0[/code] is passed in, and [code]true[/code] for all other "
"ints."
msgstr ""
"ஒரு பூலியன் மதிப்புக்கு ஒரு [INT] மதிப்பை செலுத்துங்கள், [குறியீடு] 0 [/குறியீடு] "
"அனுப்பப்பட்டால் [குறியீடு] தவறான [/குறியீடு], மற்றும் [குறியீடு] மற்ற எல்லா INT களுக்கும் "
"[குறியீடு] உண்மை [/குறியீடு] திரும்பும்."

#: docs/bool.xml
msgid ""
"Cast a [float] value to a boolean value, this method will return "
"[code]false[/code] if [code]0.0[/code] is passed in, and [code]true[/code] "
"for all other floats."
msgstr ""
"ஒரு பூலியன் மதிப்புக்கு ஒரு [மிதவை] மதிப்பை வாருங்கள், இந்த முறை [குறியீடு] 0.0 [/"
"குறியீடு] அனுப்பப்பட்டால் [குறியீடு] தவறான [/குறியீடு], மற்றும் மற்ற எல்லா மிதவைகளுக்கும் "
"[குறியீடு] உண்மை [/குறியீடு] திரும்பும்."

#: docs/bool.xml
msgid ""
"Cast a [String] value to a boolean value, this method will return "
"[code]false[/code] if [code]\"\"[/code] is passed in, and [code]true[/code] "
"for all non-empty strings.\n"
"Examples: [code]bool(\"False\")[/code] returns [code]true[/code], "
"[code]bool(\"\")[/code] returns [code]false[/code]."
msgstr ""
"ஒரு பூலியன் மதிப்புக்கு ஒரு [சரம்] மதிப்பை வாருங்கள், இந்த முறை [குறியீடு] \"\" [/"
"குறியீடு] அனுப்பப்பட்டால் [குறியீடு] தவறான [/குறியீடு], மற்றும் [குறியீடு] அனைத்து "
"வெற்று அல்லாத சரங்களுக்கும் திரும்பும்.\n"
" எடுத்துக்காட்டுகள்: [குறியீடு] பூல் (\"தவறான\") [/குறியீடு] [குறியீடு] உண்மை [/"
"குறியீடு], [குறியீடு] பூல் (\"\") [/குறியீடு] [குறியீடு] தவறான [/குறியீடு] ஐ "
"வழங்குகிறது."

#: docs/BoxContainer.xml
msgid "Base class for box containers."
msgstr "பெட்டி கொள்கலன்களுக்கான அடிப்படை வகுப்பு."

#: docs/BoxContainer.xml
msgid ""
"Arranges child controls vertically or horizontally, and rearranges the "
"controls automatically when their minimum size changes."
msgstr ""
"குழந்தை கட்டுப்பாடுகளை செங்குத்தாக அல்லது கிடைமட்டமாக ஏற்பாடு செய்கிறது, மேலும் அவற்றின் "
"குறைந்தபட்ச அளவு மாறும்போது கட்டுப்பாடுகளை தானாகவே மறுசீரமைக்கிறது."

#: docs/BoxContainer.xml
msgid ""
"Adds a control to the box as a spacer. If [code]true[/code], [code]begin[/"
"code] will insert the spacer control in front of other children."
msgstr ""
"ஒரு ச்பேசராக பெட்டியில் ஒரு கட்டுப்பாட்டை சேர்க்கிறது. [குறியீடு] உண்மை [/குறியீடு] "
"என்றால், [குறியீடு] தொடங்கு [/குறியீடு] மற்ற குழந்தைகளுக்கு முன்னால் ச்பேசர் கட்டுப்பாட்டை "
"செருகும்."

#: docs/BoxContainer.xml
msgid ""
"The alignment of the container's children (must be one of [constant "
"ALIGN_BEGIN], [constant ALIGN_CENTER] or [constant ALIGN_END])."
msgstr ""
"கொள்கலனின் குழந்தைகளின் சீரமைப்பு ([நிலையான சீரமைப்பு_பெசின்], [நிலையான சீரமைப்பு_ "
"சென்டர்] அல்லது [நிலையான சீரமைப்பு_என்ட்]) ஒன்றாக இருக்க வேண்டும்."

#: docs/BoxContainer.xml
msgid "Aligns children with the beginning of the container."
msgstr "கொள்கலனின் தொடக்கத்துடன் குழந்தைகளை சீரமைக்கிறது."

#: docs/BoxContainer.xml
msgid "Aligns children with the center of the container."
msgstr "கொள்கலனின் மையத்துடன் குழந்தைகளை சீரமைக்கிறது."

#: docs/BoxContainer.xml
msgid "Aligns children with the end of the container."
msgstr "கொள்கலனின் முடிவில் குழந்தைகளை சீரமைக்கிறது."

#: docs/BoxShape.xml
msgid "Box shape resource."
msgstr "பெட்டி வடிவ வள."

#: docs/BoxShape.xml
msgid "3D box shape that can be a child of a [PhysicsBody] or [Area]."
msgstr "[இயற்பியல் பாடி] அல்லது [பகுதி] குழந்தையாக இருக்கக்கூடிய 3 டி பெட்டி வடிவம்."

#: docs/BoxShape.xml
msgid ""
"The box's half extents. The width, height and depth of this shape is twice "
"the half extents."
msgstr ""
"பெட்டியின் அரை நீட்டிப்பு. இந்த வடிவத்தின் அகலம், உயரம் மற்றும் ஆழம் அரை நீட்டிப்புகளை விட "
"இரண்டு மடங்கு அதிகம்."

#: docs/Button.xml
msgid "Standard themed Button."
msgstr "நிலையான கருப்பொருள் பொத்தான்."

#: docs/Button.xml
msgid ""
"Button is the standard themed button. It can contain text and an icon, and "
"will display them according to the current [Theme].\n"
"[b]Example of creating a button and assigning an action when pressed by code:"
"[/b]\n"
"[codeblock]\n"
"func _ready():\n"
"    var button = Button.new()\n"
"    button.text = \"Click me\"\n"
"    button.connect(\"pressed\", self, \"_button_pressed\")\n"
"    add_child(button)\n"
"\n"
"func _button_pressed():\n"
"    print(\"Hello world!\")\n"
"[/codeblock]\n"
"Buttons (like all Control nodes) can also be created in the editor, but some "
"situations may require creating them from code.\n"
"See also [BaseButton] which contains common properties and methods "
"associated with this node.\n"
"[b]Note:[/b] Buttons do not interpret touch input and therefore don't "
"support multitouch, since mouse emulation can only press one button at a "
"given time. Use [TouchScreenButton] for buttons that trigger gameplay "
"movement or actions, as [TouchScreenButton] supports multitouch."
msgstr ""
"பொத்தான் நிலையான கருப்பொருள் பொத்தானாகும். இது உரை மற்றும் ஒரு ஐகானைக் கொண்டிருக்கலாம், "
"மேலும் தற்போதைய [தீம்] படி அவற்றைக் காண்பிக்கும்.\n"
" [b] ஒரு பொத்தானை உருவாக்குவதற்கும் குறியீட்டால் அழுத்தும் போது ஒரு செயலை "
"ஒதுக்குவதற்கும் எடுத்துக்காட்டு: [/b]\n"
" [கோட் பிளாக்]\n"
" func _ready ():\n"
" var பொத்தான் = பொத்தான்.நியூ ()\n"
" பொத்தான்.டெக்ச்ட் = \"என்னைக் சொடுக்கு செய்க\"\n"
" பொத்தான்.connect (\"அழுத்தியது\", தன்வய, \"_button_pressed\")\n"
" add_child (பொத்தான்)\n"
"\n"
" func _button_pressed ():\n"
" அச்சு (\"அலோ வேர்ல்ட்!\")\n"
" [/codeBlock]\n"
" பொத்தான்கள் (எல்லா கட்டுப்பாட்டு முனைகளையும் போன்றவை) எடிட்டரில் உருவாக்கப்படலாம், ஆனால் "
"சில சூழ்நிலைகளுக்கு அவற்றை குறியீட்டிலிருந்து உருவாக்க வேண்டியிருக்கலாம்.\n"
" இந்த முனையுடன் தொடர்புடைய பொதுவான பண்புகள் மற்றும் முறைகளைக் கொண்ட [பேச்பட்டன்] ஐயும் "
"காண்க.\n"
" . விளையாட்டு இயக்கம் அல்லது செயல்களைத் தூண்டும் பொத்தான்களுக்கு [தொடுதிரை பட்டூட்டன்] "
"பயன்படுத்தவும், [தொடுதிரை] மல்டிடூச்சை ஆதரிக்கிறது."

#: docs/Button.xml
msgid ""
"Text alignment policy for the button's text, use one of the [enum TextAlign] "
"constants."
msgstr ""
"உரை சீரமைப்பு கொள்கை பொத்தானின் உரைக்கு, [enum textalign] மாறிலிகளில் ஒன்றைப் "
"பயன்படுத்தவும்."

#: docs/Button.xml
msgid ""
"When this property is enabled, text that is too large to fit the button is "
"clipped, when disabled the Button will always be wide enough to hold the "
"text."
msgstr ""
"இந்த சொத்து இயக்கப்பட்டால், பொத்தானைப் பொருத்துவதற்கு மிகப் பெரிய உரை கிளிப் "
"செய்யப்படுகிறது, முடக்கப்பட்டால் பொத்தானை எப்போதும் உரையை வைத்திருக்கும் அளவுக்கு அகலமாக "
"இருக்கும்."

#: docs/Button.xml
msgid ""
"When enabled, the button's icon will expand/shrink to fit the button's size "
"while keeping its aspect."
msgstr ""
"இயக்கப்பட்டால், பொத்தானின் படவுரு அதன் அம்சத்தை வைத்திருக்கும் போது பொத்தானின் அளவிற்கு "
"ஏற்றவாறு விரிவடையும்/சுருக்கப்படும்."

#: docs/Button.xml
msgid "Flat buttons don't display decoration."
msgstr "தட்டையான பொத்தான்கள் அலங்காரத்தைக் காட்டாது."

#: docs/Button.xml
msgid ""
"Button's icon, if text is present the icon will be placed before the text.\n"
"To edit margin and spacing of the icon, use [code]hseparation[/code] theme "
"property of [Button] and [code]content_margin_*[/code] properties of the "
"used [StyleBox]es."
msgstr ""
"பொத்தானின் படவுரு, உரை இருந்தால் படவுரு உரைக்கு முன் வைக்கப்படும்.\n"
" ஐகானின் விளிம்பு மற்றும் இடைவெளியைத் திருத்த, [குறியீடு] [/குறியீடு] [பொத்தான்] மற்றும் "
"[குறியீடு] உள்ளடக்கம்_மார்சின் _*[/குறியீடு] பயன்படுத்தப்பட்ட [ச்டைல் பாக்ச்] ES இன் "
"கருப்பொருள் சொத்தின் சொத்து பயன்படுத்தவும்."

#: docs/Button.xml docs/LinkButton.xml
msgid "The button's text that will be displayed inside the button's area."
msgstr "பொத்தானின் உரை பொத்தானின் பகுதிக்குள் காண்பிக்கப்படும்."

#: docs/Button.xml
msgid "Align the text to the left."
msgstr "உரையை இடதுபுறமாக சீரமைக்கவும்."

#: docs/Button.xml
msgid "Align the text to the center."
msgstr "உரையை மையத்துடன் சீரமைக்கவும்."

#: docs/Button.xml
msgid "Align the text to the right."
msgstr "உரையை வலதுபுறமாக சீரமைக்கவும்."

#: docs/Button.xml
msgid "Default text [Color] of the [Button]."
msgstr "[பொத்தானின்] இயல்புநிலை உரை [வண்ணம்]."

#: docs/Button.xml
msgid "Text [Color] used when the [Button] is disabled."
msgstr "[பொத்தான்] முடக்கப்பட்டிருக்கும் போது உரை [வண்ணம்] பயன்படுத்தப்படுகிறது."

#: docs/Button.xml
msgid ""
"Text [Color] used when the [Button] is focused. Only replaces the normal "
"text color of the button. Disabled, hovered, and pressed states take "
"precedence over this color."
msgstr ""
"[பொத்தான்] கவனம் செலுத்தும்போது பயன்படுத்தப்படும் உரை [வண்ணம்]. பொத்தானின் சாதாரண உரை "
"நிறத்தை மட்டுமே மாற்றுகிறது. ஊனமுற்றோர், வட்டமிட்ட மற்றும் அழுத்தப்பட்ட மாநிலங்கள் இந்த "
"நிறத்தை விட முன்னுரிமை பெறுகின்றன."

#: docs/Button.xml
msgid "Text [Color] used when the [Button] is being hovered."
msgstr "[பொத்தான்] இழுக்கப்படும்போது பயன்படுத்தப்படும் உரை [வண்ணம்]."

#: docs/Button.xml
msgid "Text [Color] used when the [Button] is being pressed."
msgstr "[பொத்தான்] அழுத்தும் போது உரை [வண்ணம்] பயன்படுத்தப்படுகிறது."

#: docs/Button.xml
msgid "The horizontal space between [Button]'s icon and text."
msgstr "[பொத்தான்] இன் படவுரு மற்றும் உரைக்கு இடையில் கிடைமட்ட இடைவெளி."

#: docs/Button.xml
msgid "[Font] of the [Button]'s text."
msgstr "[பொத்தான்] உரையின் [எழுத்துரு]."

#: docs/Button.xml
msgid "[StyleBox] used when the [Button] is disabled."
msgstr "[ச்டைல் பாக்ச்] [பொத்தானை] முடக்கும்போது பயன்படுத்தப்படுகிறது."

#: docs/Button.xml
msgid ""
"[StyleBox] used when the [Button] is focused. It is displayed over the "
"current [StyleBox], so using [StyleBoxEmpty] will just disable the focus "
"visual effect."
msgstr ""
"[ச்டைல் பாக்ச்] [பொத்தான்] கவனம் செலுத்தும்போது பயன்படுத்தப்படுகிறது. இது தற்போதைய [ச்டைல் "
"பாக்ச்] இல் காட்டப்படும், எனவே [ச்டைல் பாக்ச்பெண்டி] பயன்படுத்துவது கவனம் காட்சி விளைவை "
"முடக்கும்."

#: docs/Button.xml
msgid "[StyleBox] used when the [Button] is being hovered."
msgstr "[ச்டைல் பாக்ச்] [பொத்தான்] இழுக்கப்படும்போது பயன்படுத்தப்படுகிறது."

#: docs/Button.xml
msgid "Default [StyleBox] for the [Button]."
msgstr "[பொத்தான்] க்கு இயல்புநிலை [ச்டைல் பாக்ச்]."

#: docs/Button.xml
msgid "[StyleBox] used when the [Button] is being pressed."
msgstr "[ச்டைல் பாக்ச்] [பொத்தான்] அழுத்தும் போது பயன்படுத்தப்படுகிறது."

#: docs/ButtonGroup.xml
msgid "Group of Buttons."
msgstr "பொத்தான்களின் குழு."

#: docs/ButtonGroup.xml
msgid ""
"Group of [Button]. All direct and indirect children buttons become radios. "
"Only one allows being pressed.\n"
"[member BaseButton.toggle_mode] should be [code]true[/code]."
msgstr ""
"[பொத்தான்] குழு. அனைத்து நேரடி மற்றும் மறைமுக குழந்தைகள் பொத்தான்கள் ரேடியோக்களாக "
"மாறும். ஒன்று மட்டுமே அழுத்த அனுமதிக்கிறது.\n"
" [உறுப்பினர் basebutton.toggle_mode] [குறியீடு] உண்மை [/குறியீடு] ஆக இருக்க வேண்டும்."

#: docs/ButtonGroup.xml
msgid ""
"Returns an [Array] of [Button]s who have this as their [ButtonGroup] (see "
"[member BaseButton.group])."
msgstr ""
"இதை [பொத்தானை] அவர்களின் [பட்ங்ரூப்] எனக் கொண்டுள்ளது ([உறுப்பினர் பேச்பட்டன்.குரூப்] ஐப் "
"பார்க்கவும்)."

#: docs/ButtonGroup.xml
msgid "Returns the current pressed button."
msgstr "தற்போதைய அழுத்தப்பட்ட பொத்தானை வழங்குகிறது."

#: docs/ButtonGroup.xml
msgid "Emitted when one of the buttons of the group is pressed."
msgstr "குழுவின் பொத்தான்களில் ஒன்று அழுத்தும் போது உமிழப்படும்."

#: docs/Camera.xml
msgid "Camera node, displays from a point of view."
msgstr "கேமரா முனை, ஒரு பார்வையில் இருந்து காண்பிக்கப்படுகிறது."

#: docs/Camera.xml
msgid ""
"Camera is a special node that displays what is visible from its current "
"location. Cameras register themselves in the nearest [Viewport] node (when "
"ascending the tree). Only one camera can be active per viewport. If no "
"viewport is available ascending the tree, the camera will register in the "
"global viewport. In other words, a camera just provides 3D display "
"capabilities to a [Viewport], and, without one, a scene registered in that "
"[Viewport] (or higher viewports) can't be displayed."
msgstr ""
"கேமரா என்பது ஒரு சிறப்பு முனை, அதன் தற்போதைய இருப்பிடத்திலிருந்து தெரியும் என்பதைக் "
"காட்டுகிறது. கேமராக்கள் தங்களை அருகிலுள்ள [வியூபோர்ட்] முனையில் பதிவு செய்கின்றன "
"(மரத்தை ஏறும் போது). ஒரு காட்சிக்கு ஒரு கேமரா மட்டுமே செயலில் இருக்க முடியும். "
"மரத்தில் ஏறும் காட்சிகள் எதுவும் கிடைக்கவில்லை என்றால், கேமரா உலகளாவிய காட்சியகத்தில் "
"பதிவு செய்யும். வேறு வார்த்தைகளில் கூறுவதானால், ஒரு கேமரா ஒரு [வியூபோர்ட்] க்கு 3D "
"காட்சி திறன்களை வழங்குகிறது, மேலும் ஒன்று இல்லாமல், அந்த [வியூபோர்ட்] (அல்லது அதிக "
"காட்சியகங்கள்) இல் பதிவு செய்யப்பட்ட ஒரு காட்சியைக் காட்ட முடியாது."

#: docs/Camera.xml
msgid ""
"If this is the current camera, remove it from being current. If "
"[code]enable_next[/code] is [code]true[/code], request to make the next "
"camera current, if any."
msgstr "இது தற்போதைய கேமரா என்றால், அதை மின்னோட்டத்திலிருந்து அகற்றவும். ."

#: docs/Camera.xml
msgid "Returns the camera's RID from the [VisualServer]."
msgstr "[VISIONSERVER] இலிருந்து கேமராவை வழங்குகிறது."

#: docs/Camera.xml
msgid ""
"Returns the transform of the camera plus the vertical ([member v_offset]) "
"and horizontal ([member h_offset]) offsets; and any other adjustments made "
"to the position and orientation of the camera by subclassed cameras such as "
"[ClippedCamera], [InterpolatedCamera] and [ARVRCamera]."
msgstr ""
"கேமராவின் உருமாற்றம் மற்றும் செங்குத்து ([உறுப்பினர் v_offset]) மற்றும் கிடைமட்ட "
"([உறுப்பினர் H_OFFSET]) ஆஃப்செட்டுகளை வழங்குகிறது; [கிளிப்ட் கேமெரா], [இன்டர்போலேட்டட் "
"கேமெரா] மற்றும் [அர்வ்ர்கமேரா] போன்ற துணைப்பிரிவு கேமராக்களால் கேமராவின் நிலை மற்றும் "
"நோக்குநிலைக்கு வேறு எந்த மாற்றங்களும் செய்யப்பட்டுள்ளன."

#: docs/Camera.xml
msgid ""
"Returns [code]true[/code] if the given [code]layer[/code] in the [member "
"cull_mask] is enabled, [code]false[/code] otherwise."
msgstr ""
"[குறியீடு] உண்மையான [/குறியீடு] [உறுப்பினர் Cull_mask] இல் கொடுக்கப்பட்ட [குறியீடு] "
"அடுக்கு [/குறியீடு] இயக்கப்பட்டிருந்தால், [குறியீடு] பொய் [/குறியீடு] இல்லையெனில்."

#: docs/Camera.xml
msgid ""
"Returns the camera's frustum planes in world space units as an array of "
"[Plane]s in the following order: near, far, left, top, right, bottom. Not to "
"be confused with [member frustum_offset]."
msgstr ""
"உலக விண்வெளி அலகுகளில் கேமராவின் விரைவான விமானங்களை பின்வரும் வரிசையில் [விமானம்] "
"களின் வரிசையாக வழங்குகிறது: அருகில், தூர, இடது, மேல், வலது, கீழ். [உறுப்பினர் "
"FRUSTUM_OFFSET] உடன் குழப்பமடையக்கூடாது."

#: docs/Camera.xml
msgid ""
"Returns [code]true[/code] if the given position is behind the camera.\n"
"[b]Note:[/b] A position which returns [code]false[/code] may still be "
"outside the camera's field of view."
msgstr ""
"கொடுக்கப்பட்ட நிலை கேமராவின் பின்னால் இருந்தால் [குறியீடு] உண்மை [/குறியீடு] திரும்பும்.\n"
" ."

#: docs/Camera.xml
msgid ""
"Makes this camera the current camera for the [Viewport] (see class "
"description). If the camera node is outside the scene tree, it will attempt "
"to become current once it's added."
msgstr ""
"இந்த கேமராவை [ViewPort] க்கான தற்போதைய கேமராவாக ஆக்குகிறது (வகுப்பு விளக்கத்தைப் "
"பார்க்கவும்). கேமரா முனை காட்சி மரத்திற்கு வெளியே இருந்தால், அது சேர்க்கப்பட்டவுடன் அது "
"தற்போதையதாக மாற முயற்சிக்கும்."

#: docs/Camera.xml
msgid ""
"Returns a normal vector from the screen point location directed along the "
"camera. Orthogonal cameras are normalized. Perspective cameras account for "
"perspective, screen width/height, etc."
msgstr ""
"கேமராவுடன் இயக்கப்பட்ட திரை பாயிண்ட் இருப்பிடத்திலிருந்து ஒரு சாதாரண திசையனை "
"வழங்குகிறது. ஆர்த்தோகனல் கேமராக்கள் இயல்பாக்கப்படுகின்றன. முன்னோக்கு கேமராக்கள் முன்னோக்கு, "
"திரை அகலம்/உயரம் போன்றவற்றுக்கான கணக்கு."

#: docs/Camera.xml
msgid ""
"Returns the 3D point in world space that maps to the given 2D coordinate in "
"the [Viewport] rectangle on a plane that is the given [code]z_depth[/code] "
"distance into the scene away from the camera."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] Z_Depth [/code] தூரத்தை கேமராவிலிருந்து விலகி காட்சிக்குள் "
"ஒரு விமானத்தில் [வியூபோர்ட்] செவ்வகத்தில் கொடுக்கப்பட்ட 2 டி ஒருங்கிணைப்புக்கு "
"வரைபடமாக்கும் உலக இடத்தின் 3D புள்ளியை வழங்குகிறது."

#: docs/Camera.xml
msgid ""
"Returns a normal vector in world space, that is the result of projecting a "
"point on the [Viewport] rectangle by the inverse camera projection. This is "
"useful for casting rays in the form of (origin, normal) for object "
"intersection or picking."
msgstr ""
"உலக இடைவெளியில் ஒரு சாதாரண திசையனைத் தருகிறது, இது தலைகீழ் கேமரா திட்டத்தால் "
"[வியூபோர்ட்] செவ்வகத்தில் ஒரு புள்ளியைக் காண்பிப்பதன் விளைவாகும். பொருள் குறுக்குவெட்டு "
"அல்லது எடுப்பதற்கான (தோற்றம், இயல்பான) வடிவத்தில் கதிர்களை வார்ப்பதற்கு இது பயனுள்ளதாக "
"இருக்கும்."

#: docs/Camera.xml
msgid ""
"Returns a 3D position in world space, that is the result of projecting a "
"point on the [Viewport] rectangle by the inverse camera projection. This is "
"useful for casting rays in the form of (origin, normal) for object "
"intersection or picking."
msgstr ""
"உலக இடைவெளியில் ஒரு 3D நிலையை வழங்குகிறது, இது தலைகீழ் கேமரா திட்டத்தால் [ViewPort] "
"செவ்வகத்தில் ஒரு புள்ளியைக் காண்பிப்பதன் விளைவாகும். பொருள் குறுக்குவெட்டு அல்லது "
"எடுப்பதற்கான (தோற்றம், இயல்பான) வடிவத்தில் கதிர்களை வார்ப்பதற்கு இது பயனுள்ளதாக இருக்கும்."

#: docs/Camera.xml
msgid ""
"Enables or disables the given [code]layer[/code] in the [member cull_mask]."
msgstr ""
"[உறுப்பினர் CULL_MASK] இல் கொடுக்கப்பட்ட [குறியீடு] அடுக்கு [/குறியீடு] ஐ இயக்குகிறது "
"அல்லது முடக்குகிறது."

#: docs/Camera.xml
msgid ""
"Sets the camera projection to frustum mode (see [constant "
"PROJECTION_FRUSTUM]), by specifying a [code]size[/code], an [code]offset[/"
"code], and the [code]z_near[/code] and [code]z_far[/code] clip planes in "
"world space units."
msgstr ""
"உலக விண்வெளி அலகுகளில் உள்ள விமானங்கள் விமானங்கள் விமானங்களை [குறியீடு] அளவு [/"
"குறியீடு], [குறியீடு] ஆஃப்செட் [/குறியீடு] மற்றும் [குறியீடு] Z_Near [/code] மற்றும் "
"[குறியீடு] Z_NEAR [/code] மற்றும் கிளிப் விமானங்களைக் குறிப்பிடுவதன் மூலம் கேமரா "
"திட்டத்தை ஃப்ச்டம் பயன்முறையில் அமைக்கிறது ([நிலையான ப்ரொசெக்சன்_ஃப்ரச்டம்])."

#: docs/Camera.xml
msgid ""
"Sets the camera projection to orthogonal mode (see [constant "
"PROJECTION_ORTHOGONAL]), by specifying a [code]size[/code], and the "
"[code]z_near[/code] and [code]z_far[/code] clip planes in world space units. "
"(As a hint, 2D games often use this projection, with values specified in "
"pixels.)"
msgstr ""
"கேமரா திட்டத்தை ஆர்த்தோகனல் பயன்முறைக்கு அமைக்கிறது ([CONTRANT "
"Provection_orthogonal]), ஒரு [குறியீடு] அளவு [/குறியீடு], மற்றும் [குறியீடு] "
"Z_NEAR [/குறியீடு] மற்றும் [குறியீடு] Z_FAR [/குறியீடு] கிளிப் விமானங்களை உலக "
"விண்வெளி அலகுகளில் குறிப்பிடுவதன் மூலம். (ஒரு குறிப்பாக, 2 டி கேம்கள் பெரும்பாலும் இந்த "
"திட்டத்தைப் பயன்படுத்துகின்றன, மதிப்புகள் பிக்சல்களில் குறிப்பிடப்பட்டுள்ளன.)"

#: docs/Camera.xml
msgid ""
"Sets the camera projection to perspective mode (see [constant "
"PROJECTION_PERSPECTIVE]), by specifying a [code]fov[/code] (field of view) "
"angle in degrees, and the [code]z_near[/code] and [code]z_far[/code] clip "
"planes in world space units."
msgstr ""
"கேமரா திட்டத்தை முன்னோக்கு பயன்முறைக்கு அமைக்கிறது ([நிலையான ப்ரொசெக்சன்_பெச்பெக்டிவ்] ஐப் "
"பார்க்கவும்), ஒரு [குறியீடு] FOV [/குறியீடு] (பார்வை புலம்) கோணத்தில் டிகிரிகளில் "
"குறிப்பிடுவதன் மூலம், மற்றும் [குறியீடு] Z_NEER [/code] மற்றும் [குறியீடு] Z_FAR [/"
"குறியீடு] கிளிப் விமானங்கள்."

#: docs/Camera.xml
msgid ""
"Returns the 2D coordinate in the [Viewport] rectangle that maps to the given "
"3D point in world space.\n"
"[b]Note:[/b] When using this to position GUI elements over a 3D viewport, "
"use [method is_position_behind] to prevent them from appearing if the 3D "
"point is behind the camera:\n"
"[codeblock]\n"
"# This code block is part of a script that inherits from Spatial.\n"
"# `control` is a reference to a node inheriting from Control.\n"
"control.visible = not "
"get_viewport().get_camera().is_position_behind(global_transform.origin)\n"
"control.rect_position = "
"get_viewport().get_camera().unproject_position(global_transform.origin)\n"
"[/codeblock]"
msgstr ""
"உலக இடைவெளியில் கொடுக்கப்பட்ட 3D புள்ளிக்கு வரைபடமாக்கும் [ViewPort] செவ்வகத்தில் 2 டி "
"ஒருங்கிணைப்பை வழங்குகிறது.\n"
" .\n"
" [கோட் பிளாக்]\n"
" # இந்த குறியீடு தொகுதி இடஞ்சார்ந்த ஒரு ச்கிரிப்ட்டின் ஒரு பகுதியாகும்.\n"
" # `கட்டுப்பாடு` என்பது கட்டுப்பாட்டிலிருந்து மரபுரிமையாகும் ஒரு முனையின் குறிப்பு.\n"
" control.visible = get_viewport (). get_camera (). is_position_behind "
"(global_transform.origin)\n"
" control.rect_position = get_viewport (). get_camera ().\n"
" [/codeBlock]"

#: docs/Camera.xml
msgid ""
"The culling mask that describes which 3D render layers are rendered by this "
"camera."
msgstr ""
"இந்த கேமராவால் எந்த 3D வழங்குதல் அடுக்குகள் வழங்கப்படுகின்றன என்பதை விவரிக்கும் குல்லிங் "
"முகமூடி."

#: docs/Camera.xml
msgid ""
"If [code]true[/code], the ancestor [Viewport] is currently using this camera."
msgstr ""
"[குறியீடு] உண்மை [/code] என்றால், மூதாதையர் [ViewPort] தற்போது இந்த கேமராவைப் "
"பயன்படுத்துகிறார்."

#: docs/Camera.xml
msgid ""
"If not [constant DOPPLER_TRACKING_DISABLED], this camera will simulate the "
"[url=https://en.wikipedia.org/wiki/Doppler_effect]Doppler effect[/url] for "
"objects changed in particular [code]_process[/code] methods. The Doppler "
"effect is only simulated for [AudioStreamPlayer3D] nodes that have [member "
"AudioStreamPlayer3D.doppler_tracking] set to a value other than [constant "
"AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED].\n"
"[b]Note:[/b] To toggle the Doppler effect preview in the editor, use the "
"Perspective menu in the top-left corner of the 3D viewport and toggle "
"[b]Enable Doppler[/b]."
msgstr ""
"[நிலையான doppler_tracking_disabled] இல்லையென்றால், இந்த கேமரா [url = https: //"
"en.wikipedia.org/wiki/doppler_effect] டாப்ளர் விளைவு [/url] குறிப்பாக [குறியீடு] "
"_ -processessess [/code] முறைகளில் மாற்றப்படும். டாப்ளர் விளைவு [ஆடியோச்ட்ரீஆம்ப்ளேயர் 3 "
"டி] முனைகளுக்கு மட்டுமே உருவகப்படுத்தப்படுகிறது, அவை [உறுப்பினர் ஆடியோச்ட்ரீஆக்லேயர் 3 "
"டி.\n"
" ."

#: docs/Camera.xml
msgid "The [Environment] to use for this camera."
msgstr "இந்த கேமராவுக்கு பயன்படுத்த [சூழல்]."

#: docs/Camera.xml
msgid ""
"The distance to the far culling boundary for this camera relative to its "
"local Z axis."
msgstr ""
"இந்த கேமராவிற்கு அதன் உள்ளக சட் அச்சுடன் ஒப்பிடும்போது தூரக் குறைக்கும் எல்லைக்கான தூரம்."

#: docs/Camera.xml
msgid ""
"The camera's field of view angle (in degrees). Only applicable in "
"perspective mode. Since [member keep_aspect] locks one axis, [code]fov[/"
"code] sets the other axis' field of view angle.\n"
"For reference, the default vertical field of view value ([code]70.0[/code]) "
"is equivalent to a horizontal FOV of:\n"
"- ~86.07 degrees in a 4:3 viewport\n"
"- ~96.50 degrees in a 16:10 viewport\n"
"- ~102.45 degrees in a 16:9 viewport\n"
"- ~117.06 degrees in a 21:9 viewport"
msgstr ""
"கேமராவின் பார்வை கோணம் (டிகிரிகளில்). முன்னோக்கு பயன்முறையில் மட்டுமே பொருந்தும். "
"[உறுப்பினர் கீப்_எச்பெக்ட்] ஒரு அச்சைப் பூட்டுவதால், [குறியீடு] FOV [/code] மற்ற அச்சின் "
"பார்வை கோணத்தை அமைக்கிறது.\n"
" குறிப்புக்கு, பார்வை மதிப்பின் இயல்புநிலை செங்குத்து புலம் ([குறியீடு] 70.0 [/"
"குறியீடு]) கிடைமட்ட FOV க்கு சமம்:\n"
" - 4: 3 பார்வையில் ~ 86.07 டிகிரி\n"
" - 16:10 பார்வையில் ~ 96.50 டிகிரி\n"
" - 16: 9 பார்வையில் 2 102.45 டிகிரி\n"
" - 21: 9 பார்வையில் 7 117.06 டிகிரி"

#: docs/Camera.xml
msgid ""
"The camera's frustum offset. This can be changed from the default to create "
"\"tilted frustum\" effects such as [url=https://zdoom.org/wiki/Y-shearing]Y-"
"shearing[/url]."
msgstr ""
"கேமராவின் விரைவான ஆஃப்செட். [Url = https: //zdoom.org/wiki/y-shearing] y- "
"சியரிங் [/url] போன்ற \"சாய்ந்த ஃப்ரச்டம்\" விளைவுகளை உருவாக்க இதை இயல்புநிலையிலிருந்து "
"மாற்றலாம்."

#: docs/Camera.xml
msgid "The horizontal (X) offset of the camera viewport."
msgstr "கேமரா வியாபோர்ட்டின் கிடைமட்ட (எக்ச்) ஆஃப்செட்."

#: docs/Camera.xml
msgid ""
"The axis to lock during [member fov]/[member size] adjustments. Can be "
"either [constant KEEP_WIDTH] or [constant KEEP_HEIGHT]."
msgstr ""
"[உறுப்பினர் FOV]/[உறுப்பினர் அளவு] மாற்றங்களின் போது பூட்ட வேண்டிய அச்சு. [நிலையான "
"கீப்_விட்] அல்லது [நிலையான கீப்_ஐட்] ஆக இருக்கலாம்."

#: docs/Camera.xml
msgid ""
"The distance to the near culling boundary for this camera relative to its "
"local Z axis."
msgstr ""
"இந்த கேமராவுக்கு அதன் உள்ளக சட் அச்சுடன் ஒப்பிடும்போது அருகிலுள்ள கலிங் எல்லைக்கான தூரம்."

#: docs/Camera.xml
msgid ""
"The camera's projection mode. In [constant PROJECTION_PERSPECTIVE] mode, "
"objects' Z distance from the camera's local space scales their perceived "
"size."
msgstr ""
"கேமரா ப்ரொசெக்சன் பயன்முறை. [நிலையான திட்ட முன்னோக்கு] பயன்முறையில், கேமராவின் உள்ளக "
"இடத்திலிருந்து பொருள் தூரம் அவற்றின் உணரப்பட்ட அளவை அளவிடுகிறது."

#: docs/Camera.xml
msgid ""
"The camera's size measured as 1/2 the width or height. Only applicable in "
"orthogonal mode. Since [member keep_aspect] locks on axis, [code]size[/code] "
"sets the other axis' size length."
msgstr ""
"கேமராவின் அளவு 1/2 அகலம் அல்லது உயரமாக அளவிடப்படுகிறது. ஆர்த்தோகனல் பயன்முறையில் "
"மட்டுமே பொருந்தும். [உறுப்பினர் கீப்_எச்பெக்ட்] அச்சில் பூட்டப்படுவதால், [குறியீடு] அளவு [/"
"குறியீடு] மற்ற அச்சின் அளவு நீளத்தை அமைக்கிறது."

#: docs/Camera.xml
msgid "The vertical (Y) offset of the camera viewport."
msgstr "கேமரா வியாபோர்ட்டின் செங்குத்து (y) ஆஃப்செட்."

#: docs/Camera.xml
msgid ""
"Perspective projection. Objects on the screen becomes smaller when they are "
"far away."
msgstr ""
"முன்னோக்கு திட்டம். திரையில் உள்ள பொருள்கள் வெகு தொலைவில் இருக்கும்போது சிறியதாகிவிடும்."

#: docs/Camera.xml
msgid ""
"Orthogonal projection, also known as orthographic projection. Objects remain "
"the same size on the screen no matter how far away they are."
msgstr ""
"ஆர்த்தோகனல் ப்ரொசெக்சன், ஆர்த்தோகிராஃபிக் ப்ரொசெக்சன் என்றும் அழைக்கப்படுகிறது. பொருள்கள் "
"எவ்வளவு தொலைவில் இருந்தாலும் திரையில் ஒரே அளவாக இருக்கும்."

#: docs/Camera.xml
msgid ""
"Frustum projection. This mode allows adjusting [member frustum_offset] to "
"create \"tilted frustum\" effects."
msgstr ""
"துண்டின் திட்டம். இந்த பயன்முறை \"சாய்ந்த துண்டு\" விளைவுகளை உருவாக்க [உறுப்பினர் "
"FRUSUM_OFFSET] ஐ சரிசெய்ய அனுமதிக்கிறது."

#: docs/Camera.xml
msgid ""
"Preserves the horizontal aspect ratio; also known as Vert- scaling. This is "
"usually the best option for projects running in portrait mode, as taller "
"aspect ratios will benefit from a wider vertical FOV."
msgstr ""
"கிடைமட்ட விகித விகிதத்தை பாதுகாக்கிறது; வெர்ட்-அளவிடுதல் என்றும் அழைக்கப்படுகிறது. "
"உருவப்படம் பயன்முறையில் இயங்கும் திட்டங்களுக்கு இது பொதுவாக சிறந்த வழி, ஏனெனில் உயரமான "
"அம்ச விகிதங்கள் பரந்த செங்குத்து FOV இலிருந்து பயனடைகின்றன."

#: docs/Camera.xml
msgid ""
"Preserves the vertical aspect ratio; also known as Hor+ scaling. This is "
"usually the best option for projects running in landscape mode, as wider "
"aspect ratios will automatically benefit from a wider horizontal FOV."
msgstr ""
"செங்குத்து விகித விகிதத்தை பாதுகாக்கிறது; HOR+ அளவிடுதல் என்றும் அழைக்கப்படுகிறது. "
"நிலப்பரப்பு பயன்முறையில் இயங்கும் திட்டங்களுக்கு இது பொதுவாக சிறந்த வழி, ஏனெனில் பரந்த "
"அம்ச விகிதங்கள் தானாகவே பரந்த கிடைமட்ட FOV இலிருந்து பயனடைகின்றன."

#: docs/Camera.xml
msgid ""
"Disables [url=https://en.wikipedia.org/wiki/Doppler_effect]Doppler effect[/"
"url] simulation (default)."
msgstr ""
"[Url = https: //en.wikipedia.org/wiki/doppler_effect] டாப்ளர் விளைவு [/url] "
"உருவகப்படுத்துதல் (இயல்புநிலை) முடக்குகிறது."

#: docs/Camera.xml
msgid ""
"Simulate [url=https://en.wikipedia.org/wiki/Doppler_effect]Doppler effect[/"
"url] by tracking positions of objects that are changed in [code]_process[/"
"code]. Changes in the relative velocity of this camera compared to those "
"objects affect how Audio is perceived (changing the Audio's [code]pitch "
"shift[/code])."
msgstr ""
". அந்த பொருள்களுடன் ஒப்பிடும்போது இந்த கேமராவின் ஒப்பீட்டு வேகத்தில் ஏற்படும் மாற்றங்கள் "
"ஆடியோ எவ்வாறு உணரப்படுகின்றன என்பதை பாதிக்கிறது (ஆடியோவின் [குறியீடு] சுருதி "
"மாற்றத்தை மாற்றுதல் [/குறியீடு])."

#: docs/Camera.xml
msgid ""
"Simulate [url=https://en.wikipedia.org/wiki/Doppler_effect]Doppler effect[/"
"url] by tracking positions of objects that are changed in "
"[code]_physics_process[/code]. Changes in the relative velocity of this "
"camera compared to those objects affect how Audio is perceived (changing the "
"Audio's [code]pitch shift[/code])."
msgstr ""
"[Url = https: //en.wikipedia.org/wiki/doppler_effect] டாப்ளர் விளைவு [/url] ஐ "
"உருவகப்படுத்துங்கள் [குறியீடு] _physics_process [/code] இல் மாற்றப்பட்ட பொருள்களின் "
"நிலைகளைக் கண்காணிப்பதன் மூலம். அந்த பொருள்களுடன் ஒப்பிடும்போது இந்த கேமராவின் ஒப்பீட்டு "
"வேகத்தில் ஏற்படும் மாற்றங்கள் ஆடியோ எவ்வாறு உணரப்படுகின்றன என்பதை பாதிக்கிறது (ஆடியோவின் "
"[குறியீடு] சுருதி மாற்றத்தை மாற்றுதல் [/குறியீடு])."

#: docs/Camera2D.xml
msgid "Camera node for 2D scenes."
msgstr "2 டி காட்சிகளுக்கு கேமரா முனை."

#: docs/Camera2D.xml
msgid ""
"Camera node for 2D scenes. It forces the screen (current layer) to scroll "
"following this node. This makes it easier (and faster) to program scrollable "
"scenes than manually changing the position of [CanvasItem]-based nodes.\n"
"This node is intended to be a simple helper to get things going quickly, but "
"more functionality may be desired to change how the camera works. To make "
"your own custom camera node, inherit it from [Node2D] and change the "
"transform of the canvas by setting [member Viewport.canvas_transform] in "
"[Viewport] (you can obtain the current [Viewport] by using [method "
"Node.get_viewport]).\n"
"Note that the [Camera2D] node's [code]position[/code] doesn't represent the "
"actual position of the screen, which may differ due to applied smoothing or "
"limits. You can use [method get_camera_screen_center] to get the real "
"position."
msgstr ""
"2 டி காட்சிகளுக்கு கேமரா முனை. இந்த முனையைத் தொடர்ந்து உருட்ட திரையை (தற்போதைய "
"அடுக்கு) கட்டாயப்படுத்துகிறது. [கேன்வாசிட்டெம்] அடிப்படையிலான முனைகளின் நிலையை "
"கைமுறையாக மாற்றுவதை விட இது உருட்டக்கூடிய காட்சிகளை நிரல் செய்வதை எளிதாக்குகிறது "
"(மற்றும் வேகமானது).\n"
" இந்த முனை விசயங்களை விரைவாகப் பெறுவதற்கு ஒரு எளிய உதவியாளராக இருக்க வேண்டும், ஆனால் "
"கேமரா எவ்வாறு செயல்படுகிறது என்பதை மாற்ற அதிக செயல்பாடு விரும்பப்படலாம். உங்கள் சொந்த "
"தனிப்பயன் கேமரா முனையை உருவாக்க, [Node2D] இலிருந்து பெறவும், "
"[ViewPort.canvas_transform] இல் [ViewPort] ([ViewPort] ஐ [முறை "
"node.get_viewport]) பயன்படுத்துவதன் மூலம்) கேன்வாசின் உருமாற்றத்தை மாற்றவும்.\n"
" [கேமரா 2 டி] முனையின் [குறியீடு] நிலை [/குறியீடு] திரையின் உண்மையான நிலையைக் "
"குறிக்காது என்பதை நினைவில் கொள்க, இது பயன்படுத்தப்பட்ட மென்மையான அல்லது வரம்புகள் "
"காரணமாக வேறுபடலாம். உண்மையான நிலையைப் பெற நீங்கள் [முறை get_camera_creen_center] "
"ஐப் பயன்படுத்தலாம்."

#: docs/Camera2D.xml
msgid "Aligns the camera to the tracked node."
msgstr "கண்காணிக்கப்பட்ட முனைக்கு கேமராவை ஒருங்கிணைக்கிறது."

#: docs/Camera2D.xml
msgid ""
"Removes any [Camera2D] from the ancestor [Viewport]'s internal currently-"
"assigned camera."
msgstr ""
"மூதாதையர் [ViewPort] இன் உள் தற்போது ஒதுக்கப்பட்ட கேமராவிலிருந்து எந்த [கேமரா 2 டி] ஐ "
"நீக்குகிறது."

#: docs/Camera2D.xml
msgid "Forces the camera to update scroll immediately."
msgstr "உருட்டலை உடனடியாக புதுப்பிக்க கேமராவை கட்டாயப்படுத்துகிறது."

#: docs/Camera2D.xml
msgid "Returns the camera position."
msgstr "கேமரா நிலையை வழங்குகிறது."

#: docs/Camera2D.xml
msgid ""
"Returns the location of the [Camera2D]'s screen-center, relative to the "
"origin."
msgstr ""
"[கேமரா 2 டி] இன் திரை மையத்தின் இருப்பிடத்தை வழங்குகிறது, இது தோற்றத்துடன் "
"தொடர்புடையது."

#: docs/Camera2D.xml
msgid ""
"Returns the specified margin. See also [member drag_margin_bottom], [member "
"drag_margin_top], [member drag_margin_left], and [member drag_margin_right]."
msgstr ""
"குறிப்பிட்ட விளிம்பை வழங்குகிறது. [உறுப்பினர் drack_margin_bottom], [உறுப்பினர் "
"இழுவை_மார்சின்_டோப்], [உறுப்பினர் இழுவை_மார்சின்_லெஃப்ட்], மற்றும் [உறுப்பினர் "
"இழுவை_மார்சின்_ரைட்] ஆகியவற்றைக் காண்க."

#: docs/Camera2D.xml
msgid ""
"Returns the specified camera limit. See also [member limit_bottom], [member "
"limit_top], [member limit_left], and [member limit_right]."
msgstr ""
"குறிப்பிட்ட கேமரா வரம்பை வழங்குகிறது. [உறுப்பினர் வரம்பு_பொட்டோம்], [உறுப்பினர் "
"வரம்பு_டாப்], [உறுப்பினர் வரம்பு_எல்ஃப்ட்] மற்றும் [உறுப்பினர் வரம்பு_பிரைட்] ஆகியோரையும் "
"காண்க."

#: docs/Camera2D.xml
msgid ""
"Make this the current 2D camera for the scene (viewport and layer), in case "
"there are many cameras in the scene."
msgstr ""
"காட்சியில் பல கேமராக்கள் இருந்தால், காட்சிக்கான தற்போதைய 2 டி கேமராவாக மாற்றவும் "
"(வியூபோர்ட் மற்றும் லேயர்)."

#: docs/Camera2D.xml
msgid ""
"Sets the camera's position immediately to its current smoothing "
"destination.\n"
"This has no effect if smoothing is disabled."
msgstr ""
"கேமராவின் நிலையை அதன் தற்போதைய மென்மையான இடத்திற்கு உடனடியாக அமைக்கிறது.\n"
" மென்மையாக்குதல் முடக்கப்பட்டால் இது எந்த விளைவையும் ஏற்படுத்தாது."

#: docs/Camera2D.xml
msgid ""
"Sets the specified margin. See also [member drag_margin_bottom], [member "
"drag_margin_top], [member drag_margin_left], and [member drag_margin_right]."
msgstr ""
"குறிப்பிட்ட விளிம்பை அமைக்கிறது. [உறுப்பினர் drack_margin_bottom], [உறுப்பினர் "
"இழுவை_மார்சின்_டோப்], [உறுப்பினர் இழுவை_மார்சின்_லெஃப்ட்], மற்றும் [உறுப்பினர் "
"இழுவை_மார்சின்_ரைட்] ஆகியவற்றைக் காண்க."

#: docs/Camera2D.xml
msgid ""
"Sets the specified camera limit. See also [member limit_bottom], [member "
"limit_top], [member limit_left], and [member limit_right]."
msgstr ""
"குறிப்பிட்ட கேமரா வரம்பை அமைக்கிறது. [உறுப்பினர் வரம்பு_பொட்டோம்], [உறுப்பினர் "
"வரம்பு_டாப்], [உறுப்பினர் வரம்பு_எல்ஃப்ட்] மற்றும் [உறுப்பினர் வரம்பு_பிரைட்] ஆகியோரையும் "
"காண்க."

#: docs/Camera2D.xml
msgid "The Camera2D's anchor point. See [enum AnchorMode] constants."
msgstr "கேமரா 2 டி இன் நங்கூர புள்ளி. [Enum ankormode] மாறிலிகளைக் காண்க."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], the camera is the active camera for the current scene. "
"Only one camera can be current, so setting a different camera [code]current[/"
"code] will disable this one."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமரா என்பது தற்போதைய காட்சிக்கான செயலில் உள்ள "
"கேமரா. ஒரு கேமரா மட்டுமே தற்போதையதாக இருக்க முடியும், எனவே வேறு கேமரா [குறியீடு] "
"மின்னோட்டத்தை அமைப்பது [/குறியீடு] இதை முடக்கும்."

#: docs/Camera2D.xml
msgid ""
"The custom [Viewport] node attached to the [Camera2D]. If [code]null[/code] "
"or not a [Viewport], uses the default viewport instead."
msgstr "[கேமரா 2 டி] உடன் இணைக்கப்பட்ட தனிப்பயன் [VIEWPORT] முனை. ."

#: docs/Camera2D.xml
msgid ""
"Bottom margin needed to drag the camera. A value of [code]1[/code] makes the "
"camera move only when reaching the edge of the screen."
msgstr ""
"கேமராவை இழுக்க கீழே விளிம்பு தேவை. [குறியீடு] 1 [/குறியீடு] இன் மதிப்பு திரையின் "
"விளிம்பை அடையும்போது மட்டுமே கேமராவை நகர்த்தும்."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], the camera only moves when reaching the horizontal "
"drag margins. If [code]false[/code], the camera moves horizontally "
"regardless of margins."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கிடைமட்ட இழுவை விளிம்புகளை அடையும்போது மட்டுமே "
"கேமரா நகரும். [குறியீடு] பொய் [/குறியீடு] என்றால், ஓரங்கள் பொருட்படுத்தாமல் கேமரா "
"கிடைமட்டமாக நகரும்."

#: docs/Camera2D.xml
msgid ""
"Left margin needed to drag the camera. A value of [code]1[/code] makes the "
"camera move only when reaching the edge of the screen."
msgstr ""
"கேமராவை இழுக்க இடது விளிம்பு தேவை. [குறியீடு] 1 [/குறியீடு] இன் மதிப்பு திரையின் "
"விளிம்பை அடையும்போது மட்டுமே கேமராவை நகர்த்தும்."

#: docs/Camera2D.xml
msgid ""
"Right margin needed to drag the camera. A value of [code]1[/code] makes the "
"camera move only when reaching the edge of the screen."
msgstr ""
"கேமராவை இழுக்க வலது விளிம்பு தேவை. [குறியீடு] 1 [/குறியீடு] இன் மதிப்பு திரையின் "
"விளிம்பை அடையும்போது மட்டுமே கேமராவை நகர்த்தும்."

#: docs/Camera2D.xml
msgid ""
"Top margin needed to drag the camera. A value of [code]1[/code] makes the "
"camera move only when reaching the edge of the screen."
msgstr ""
"கேமராவை இழுக்க மேல் விளிம்பு தேவை. [குறியீடு] 1 [/குறியீடு] இன் மதிப்பு திரையின் "
"விளிம்பை அடையும்போது மட்டுமே கேமராவை நகர்த்தும்."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], the camera only moves when reaching the vertical drag "
"margins. If [code]false[/code], the camera moves vertically regardless of "
"margins."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், செங்குத்து இழுவை விளிம்புகளை அடையும்போது மட்டுமே "
"கேமரா நகரும். [குறியீடு] பொய் [/குறியீடு] என்றால், கேமரா விளிம்புகளைப் பொருட்படுத்தாமல் "
"செங்குத்தாக நகரும்."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], draws the camera's drag margin rectangle in the editor."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமராவின் இழுவை விளிம்பு செவ்வகத்தை எடிட்டரில் "
"ஈர்க்கிறது."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], draws the camera's limits rectangle in the editor."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமராவின் வரம்புகள் செவ்வகத்தை எடிட்டரில் ஈர்க்கிறது."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], draws the camera's screen rectangle in the editor."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமராவின் திரை செவ்வகத்தை எடிட்டரில் ஈர்க்கிறது."

#: docs/Camera2D.xml
msgid ""
"Bottom scroll limit in pixels. The camera stops moving when reaching this "
"value."
msgstr ""
"பிக்சல்களில் கீழே உருள் வரம்பு. இந்த மதிப்பை எட்டும்போது கேமரா நகர்வதை நிறுத்துகிறது."

#: docs/Camera2D.xml
msgid ""
"Left scroll limit in pixels. The camera stops moving when reaching this "
"value."
msgstr ""
"இடது scroll limit in படப்புள்ளிகள். இந்த மதிப்பை எட்டும்போது கேமரா நகர்வதை "
"நிறுத்துகிறது."

#: docs/Camera2D.xml
msgid ""
"Right scroll limit in pixels. The camera stops moving when reaching this "
"value."
msgstr ""
"பிக்சல்களில் வலது உருள் வரம்பு. இந்த மதிப்பை எட்டும்போது கேமரா நகர்வதை நிறுத்துகிறது."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], the camera smoothly stops when reaches its limits.\n"
"This has no effect if smoothing is disabled.\n"
"[b]Note:[/b] To immediately update the camera's position to be within limits "
"without smoothing, even with this setting enabled, invoke [method "
"reset_smoothing]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமரா அதன் வரம்புகளை அடையும் போது சீராக "
"நிறுத்தப்படும்.\n"
" மென்மையாக்குதல் முடக்கப்பட்டால் இது எந்த விளைவையும் ஏற்படுத்தாது.\n"
" ."

#: docs/Camera2D.xml
msgid ""
"Top scroll limit in pixels. The camera stops moving when reaching this value."
msgstr ""
"பிக்சல்களில் மேல் உருள் வரம்பு. இந்த மதிப்பை எட்டும்போது கேமரா நகர்வதை நிறுத்துகிறது."

#: docs/Camera2D.xml
msgid ""
"The camera's offset, useful for looking around or camera shake animations."
msgstr ""
"கேமராவின் ஆஃப்செட், சுற்றிப் பார்க்க பயனுள்ளதாக அல்லது கேமரா அனிமேசன்களை அசைக்க "
"பயனுள்ளதாக இருக்கும்."

#: docs/Camera2D.xml
msgid ""
"The horizontal offset of the camera, relative to the drag margins.\n"
"[b]Note:[/b] Offset H is used only to force offset relative to margins. It's "
"not updated in any way if drag margins are enabled and can be used to set "
"initial offset."
msgstr ""
"இழுவை விளிம்புகளுடன் தொடர்புடைய கேமராவின் கிடைமட்ட ஆஃப்செட்.\n"
" [b] குறிப்பு: [/b] ஓரங்களுடன் ஒப்பிடும்போது ஆஃப்செட்டை கட்டாயப்படுத்த மட்டுமே ஆஃப்செட் H "
"பயன்படுத்தப்படுகிறது. இழுவை விளிம்புகள் இயக்கப்பட்டால் அது எந்த வகையிலும் "
"புதுப்பிக்கப்படாது மற்றும் ஆரம்ப ஆஃப்செட்டை அமைக்க பயன்படுத்தலாம்."

#: docs/Camera2D.xml
msgid ""
"The vertical offset of the camera, relative to the drag margins.\n"
"[b]Note:[/b] Used the same as [member offset_h]."
msgstr ""
"இழுவை விளிம்புகளுடன் தொடர்புடைய கேமராவின் செங்குத்து ஆஃப்செட்.\n"
" [b] குறிப்பு: [/b] [உறுப்பினர் ஆஃப்செட்_எச்] போலவே பயன்படுத்தப்பட்டது."

#: docs/Camera2D.xml
msgid "The camera's process callback. See [enum Camera2DProcessMode]."
msgstr "கேமராவின் செயல்முறை கால்பேக். [Enum camea2dprocessmode] ஐப் பார்க்கவும்."

#: docs/Camera2D.xml
msgid "If [code]true[/code], the camera rotates with the target."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமரா இலக்குடன் சுழல்கிறது."

#: docs/Camera2D.xml
msgid ""
"If [code]true[/code], the camera smoothly moves towards the target at "
"[member smoothing_speed]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமரா [உறுப்பினர் மென்மையான_ச்பீட்] இல் இலக்கை "
"நோக்கி சீராக நகர்கிறது."

#: docs/Camera2D.xml
msgid ""
"Speed in pixels per second of the camera's smoothing effect when [member "
"smoothing_enabled] is [code]true[/code]."
msgstr ""
"[உறுப்பினர் மென்மையாக்கல்_இனபிள்] [குறியீடு] உண்மை [/குறியீடு] ஆக இருக்கும்போது "
"கேமராவின் மென்மையான விளைவின் நொடிக்கு பிக்சல்களில் விரைவு."

#: docs/Camera2D.xml
msgid ""
"The camera's zoom relative to the viewport. Values larger than "
"[code]Vector2(1, 1)[/code] zoom out and smaller values zoom in. For an "
"example, use [code]Vector2(0.5, 0.5)[/code] for a 2× zoom-in, and "
"[code]Vector2(4, 4)[/code] for a 4× zoom-out."
msgstr ""
"காட்சியமைப்புடன் தொடர்புடைய கேமராவின் பெரிதாக்கு. [குறியீடு] திசையன் 2 (1, 1) [/"
"குறியீடு] பெரிதாக்கவும், சிறிய மதிப்புகள் பெரிதாக்கவும். ஒரு எடுத்துக்காட்டுக்கு, 2 × "
"சூம்-இன், மற்றும் [குறியீடு] திசையன் 2 (4, 4) [/குறியீடு] 4 × சூம்-அவுட்டுக்கு "
"[குறியீடு] திசையன் 2 (0.5, 0.5) [/குறியீடு] ஐப் பயன்படுத்தவும்."

#: docs/Camera2D.xml
msgid ""
"The camera's position is fixed so that the top-left corner is always at the "
"origin."
msgstr ""
"கேமராவின் நிலை சரி செய்யப்பட்டது, இதனால் மேல்-இடது மூலையில் எப்போதும் தோற்றத்தில் "
"இருக்கும்."

#: docs/Camera2D.xml
msgid ""
"The camera's position takes into account vertical/horizontal offsets and the "
"screen size."
msgstr ""
"கேமராவின் நிலை செங்குத்து/கிடைமட்ட ஆஃப்செட்டுகள் மற்றும் திரை அளவைக் கணக்கில் "
"எடுத்துக்கொள்கிறது."

#: docs/Camera2D.xml docs/ClippedCamera.xml
msgid "The camera updates with the [code]_physics_process[/code] callback."
msgstr ""
"[குறியீடு] _PHYSICS_PROCESS [/குறியீடு] திரும்பப்பெறுதலுடன் கேமரா புதுப்பிக்கிறது."

#: docs/Camera2D.xml docs/ClippedCamera.xml
msgid "The camera updates with the [code]_process[/code] callback."
msgstr "[குறியீடு] _ செயல்முறை [/குறியீடு] திரும்பப்பெறுதலுடன் கேமரா புதுப்பிக்கிறது."

#: docs/CameraFeed.xml
msgid ""
"A camera feed gives you access to a single physical camera attached to your "
"device."
msgstr ""
"கேமரா ஊட்டம் உங்கள் சாதனத்துடன் இணைக்கப்பட்ட ஒற்றை உடல் கேமராவுக்கான அணுகலை வழங்குகிறது."

#: docs/CameraFeed.xml
msgid ""
"A camera feed gives you access to a single physical camera attached to your "
"device. When enabled, Rebel Engine will start capturing frames from the "
"camera which can then be used. See also [CameraServer].\n"
"[b]Note:[/b] Many cameras will return YCbCr images which are split into two "
"textures and need to be combined in a shader. Rebel Engine does this "
"automatically for you if you set the environment to show the camera image in "
"the background."
msgstr ""
"கேமரா ஊட்டம் உங்கள் சாதனத்துடன் இணைக்கப்பட்ட ஒற்றை உடல் கேமராவுக்கான அணுகலை வழங்குகிறது. "
"இயக்கப்பட்டால், கிளர்ச்சி இயந்திரம் கேமராவிலிருந்து பிரேம்களைப் பிடிக்கத் தொடங்கும். "
"[கேமரேசர்] ஐயும் காண்க.\n"
" [b] குறிப்பு: [/b] பல கேமராக்கள் YCBCR படங்களை இரண்டு அமைப்புகளாகப் பிரித்து ஒரு "
"சேடரில் இணைக்க வேண்டும். கேமரா படத்தை பின்னணியில் காண்பிக்க சூழலை அமைத்தால், கிளர்ச்சி "
"இயந்திரம் தானாகவே உங்களுக்காக இதைச் செய்கிறது."

#: docs/CameraFeed.xml
msgid "Returns the unique ID for this feed."
msgstr "இந்த ஊட்டத்திற்கான தனித்துவமான ஐடியை வழங்குகிறது."

#: docs/CameraFeed.xml
msgid "Returns the camera's name."
msgstr "கேமராவின் பெயரை வழங்குகிறது."

#: docs/CameraFeed.xml
msgid "Returns the position of camera on the device."
msgstr "சாதனத்தில் கேமராவின் நிலையை வழங்குகிறது."

#: docs/CameraFeed.xml
msgid "If [code]true[/code], the feed is active."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், ஊட்டம் செயலில் உள்ளது."

#: docs/CameraFeed.xml
msgid "The transform applied to the camera's image."
msgstr "கேமராவின் படத்திற்கு மாற்றம் பயன்படுத்தப்படுகிறது."

#: docs/CameraFeed.xml
msgid "No image set for the feed."
msgstr "ஊட்டத்திற்கு எந்த படமும் அமைக்கப்படவில்லை."

#: docs/CameraFeed.xml
msgid "Feed supplies RGB images."
msgstr "ஊட்டங்கள் RGB படங்களை வழங்குகின்றன."

#: docs/CameraFeed.xml
msgid "Feed supplies YCbCr images that need to be converted to RGB."
msgstr "Ycbcr படங்களை YCBCR படங்களை RGB ஆக மாற்ற வேண்டும்."

#: docs/CameraFeed.xml
msgid ""
"Feed supplies separate Y and CbCr images that need to be combined and "
"converted to RGB."
msgstr ""
"ஃபீட் சப்ளை தனித்தனி ஒய் மற்றும் சிபிசிஆர் படங்களை இணைக்க வேண்டும், அவை ஒன்றிணைந்து "
"ஆர்சிபிக்கு மாற்றப்பட வேண்டும்."

#: docs/CameraFeed.xml
msgid "Unspecified position."
msgstr "குறிப்பிடப்படாத நிலை."

#: docs/CameraFeed.xml
msgid "Camera is mounted at the front of the device."
msgstr "சாதனத்தின் முன்புறத்தில் கேமரா பொருத்தப்பட்டுள்ளது."

#: docs/CameraFeed.xml
msgid "Camera is mounted at the back of the device."
msgstr "சாதனத்தின் பின்புறத்தில் கேமரா பொருத்தப்பட்டுள்ளது."

#: docs/CameraServer.xml
msgid "Server keeping track of different cameras accessible in Rebel Engine."
msgstr "கிளர்ச்சி இயந்திரத்தில் அணுகக்கூடிய வெவ்வேறு கேமராக்களைக் கண்காணிக்கும் சேவையகம்."

#: docs/CameraServer.xml
msgid ""
"The [CameraServer] keeps track of different cameras accessible in Rebel "
"Engine. These are external cameras such as webcams or the cameras on your "
"phone.\n"
"It is notably used to provide AR modules with a video feed from the camera.\n"
"[b]Note:[/b] This class is currently only implemented on macOS and iOS. On "
"other platforms, no [CameraFeed]s will be available."
msgstr ""
"[கேமரேசர்] கிளர்ச்சி இயந்திரத்தில் வெவ்வேறு கேமராக்களை அணுகக்கூடியதாக வைத்திருக்கிறது. "
"இவை வெப்கேம்கள் அல்லது உங்கள் தொலைபேசியில் உள்ள கேமராக்கள் போன்ற வெளிப்புற கேமராக்கள்.\n"
" கேமராவிலிருந்து வீடியோ ஊட்டத்துடன் AR தொகுதிகள் வழங்க இது குறிப்பாகப் பயன்படுகிறது.\n"
" [b] குறிப்பு: [/b] இந்த வகுப்பு தற்போது MACOS மற்றும் ஐஇமு இல் மட்டுமே "
"செயல்படுத்தப்படுகிறது. மற்ற தளங்களில், இல்லை [கேமராஃபீட்] கள் கிடைக்காது."

#: docs/CameraServer.xml
msgid "Adds the camera [code]feed[/code] to the camera server."
msgstr "கேமரா சேவையகத்தில் கேமரா [குறியீடு] ஊட்டத்தை [/குறியீடு] சேர்க்கிறது."

#: docs/CameraServer.xml
msgid "Returns an array of [CameraFeed]s."
msgstr "[கேமராஃபீட்] கள் வரிசையை வழங்குகிறது."

#: docs/CameraServer.xml
msgid ""
"Returns the [CameraFeed] corresponding to the camera with the given "
"[code]index[/code]."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] குறியீட்டுடன் [/குறியீடு] கேமராவுடன் தொடர்புடைய [கேமராஃபீட்] ஐ "
"வழங்குகிறது."

#: docs/CameraServer.xml
msgid "Returns the number of [CameraFeed]s registered."
msgstr "பதிவுசெய்யப்பட்ட [கேமராஃபீட்] எண்ணிக்கையின் எண்ணிக்கையை வழங்குகிறது."

#: docs/CameraServer.xml
msgid "Removes the specified camera [code]feed[/code]."
msgstr "குறிப்பிட்ட கேமரா [குறியீடு] ஊட்டத்தை [/குறியீடு] நீக்குகிறது."

#: docs/CameraServer.xml
msgid "Emitted when a [CameraFeed] is added (e.g. a webcam is plugged in)."
msgstr "[கேமராஃபீட்] சேர்க்கப்படும்போது உமிழப்படும் (எ.கா. ஒரு வெப்கேம் செருகப்படுகிறது)."

#: docs/CameraServer.xml
msgid "Emitted when a [CameraFeed] is removed (e.g. a webcam is unplugged)."
msgstr ""
"ஒரு [கேமராஃபீட்] அகற்றப்படும் போது உமிழப்படும் (எ.கா. ஒரு வெப்கேம் அவிழ்க்கப்படுகிறது)."

#: docs/CameraServer.xml
msgid "The RGBA camera image."
msgstr "RGBA கேமரா படம்."

#: docs/CameraServer.xml
msgid "The [url=https://en.wikipedia.org/wiki/YCbCr]YCbCr[/url] camera image."
msgstr "[Url = https: //en.wikipedia.org/wiki/ycbcr] ycbcr [/url] கேமரா படம்."

#: docs/CameraServer.xml
msgid "The Y component camera image."
msgstr "ஒய் கூறு கேமரா படம்."

#: docs/CameraServer.xml
msgid "The CbCr component camera image."
msgstr "சிபிசிஆர் கூறு கேமரா படம்."

#: docs/CameraTexture.xml
msgid "Texture provided by a [CameraFeed]."
msgstr "[கேமராஃபீட்] வழங்கிய அமைப்பு."

#: docs/CameraTexture.xml
msgid ""
"This texture gives access to the camera texture provided by a [CameraFeed].\n"
"[b]Note:[/b] Many cameras supply YCbCr images which need to be converted in "
"a shader."
msgstr ""
"இந்த அமைப்பு [கேமராஃபீட்] வழங்கிய கேமரா அமைப்புக்கு அணுகலை வழங்குகிறது.\n"
" [b] குறிப்பு: [/b] பல கேமராக்கள் YCBCR படங்களை வழங்குகின்றன, அவை சேடரில் மாற்றப்பட "
"வேண்டும்."

#: docs/CameraTexture.xml
msgid "The ID of the [CameraFeed] for which we want to display the image."
msgstr "படத்தைக் காட்ட விரும்பும் [கேமராஃபீட்] இன் ஐடி."

#: docs/CameraTexture.xml
msgid ""
"Convenience property that gives access to the active property of the "
"[CameraFeed]."
msgstr "[கேமராஃபீட்] செயலில் உள்ள சொத்துக்கான அணுகலை வழங்கும் வசதியான சொத்து."

#: docs/CameraTexture.xml
msgid ""
"Which image within the [CameraFeed] we want access to, important if the "
"camera image is split in a Y and CbCr component."
msgstr ""
"[கேமராஃபீட்] க்குள் எந்தப் படம் அணுகலை விரும்புகிறோம், கேமரா படம் ஒரு ஒய் மற்றும் CBCR "
"கூறுகளில் பிரிக்கப்பட்டால் முக்கியமானது."

#: docs/CanvasItem.xml
msgid "Base class of anything 2D."
msgstr "எதையும் அடிப்படை வகுப்பு 2 டி."

#: docs/CanvasItem.xml
msgid ""
"Base class of anything 2D. Canvas items are laid out in a tree; children "
"inherit and extend their parent's transform. [CanvasItem] is extended by "
"[Control] for anything GUI-related, and by [Node2D] for anything related to "
"the 2D engine.\n"
"Any [CanvasItem] can draw. For this, [method update] must be called, then "
"[constant NOTIFICATION_DRAW] will be received on idle time to request "
"redraw. Because of this, canvas items don't need to be redrawn on every "
"frame, improving the performance significantly. Several functions for "
"drawing on the [CanvasItem] are provided (see [code]draw_*[/code] "
"functions). However, they can only be used inside the [method "
"Object._notification], signal or [method _draw] virtual functions.\n"
"Canvas items are drawn in tree order. By default, children are on top of "
"their parents so a root [CanvasItem] will be drawn behind everything. This "
"behavior can be changed on a per-item basis.\n"
"A [CanvasItem] can also be hidden, which will also hide its children. It "
"provides many ways to change parameters such as modulation (for itself and "
"its children) and self modulation (only for itself), as well as its blend "
"mode.\n"
"Ultimately, a transform notification can be requested, which will notify the "
"node that its global position changed in case the parent tree changed.\n"
"[b]Note:[/b] Unless otherwise specified, all methods that have angle "
"parameters must have angles specified as [i]radians[/i]. To convert degrees "
"to radians, use [method @GDScript.deg2rad]."
msgstr ""
"எதையும் அடிப்படை வகுப்பு 2 டி. கேன்வாச் உருப்படிகள் ஒரு மரத்தில் அமைக்கப்பட்டுள்ளன; "
"குழந்தைகள் தங்கள் பெற்றோரின் உருமாற்றத்தை வாரிசாகப் பெறுகிறார்கள். [கேன்வாசிடெம்] GUI "
"தொடர்பான எதற்கும் [கட்டுப்பாட்டால்], மற்றும் [Node2D] 2 டி எஞ்சின் தொடர்பான எதற்கும் "
"நீட்டிக்கப்படுகிறது.\n"
" எந்தவொரு [கேன்வாசிட்டெம்] வரையலாம். இதற்காக, [முறை புதுப்பிப்பு] அழைக்கப்பட வேண்டும், "
"பின்னர் [நிலையான அறிவிப்பு_ டிரா] செயலற்ற நேரத்தில் மறுவடிவமைப்பு கோரப்படுவார். இதன் "
"காரணமாக, கேன்வாச் உருப்படிகள் ஒவ்வொரு சட்டகத்திலும் மீண்டும் வரையப்பட வேண்டிய அவசியமில்லை, "
"செயல்திறனை கணிசமாக மேம்படுத்துகிறது. [கேன்வாசிடெம்] இல் வரைவதற்கான பல செயல்பாடுகள் "
"வழங்கப்படுகின்றன ([குறியீடு] டிரா _*[/குறியீடு] செயல்பாடுகளைப் பார்க்கவும்). "
"இருப்பினும், [முறை பொருள் ._நொட்டிஃபிகேசன்], சமிக்ஞை அல்லது [முறை _ டிரா] மெய்நிகர் "
"செயல்பாடுகளுக்குள் மட்டுமே அவற்றைப் பயன்படுத்த முடியும்.\n"
" கேன்வாச் உருப்படிகள் மர வரிசையில் வரையப்படுகின்றன. இயல்பாக, குழந்தைகள் பெற்றோரின் மேல் "
"இருக்கிறார்கள், எனவே எல்லாவற்றிற்கும் பின்னால் ஒரு வேர் [கேன்வாசிட்டெம்] வரையப்படும். இந்த "
"நடத்தை ஒரு உருப்படி அடிப்படையில் மாற்றப்படலாம்.\n"
" ஒரு [கேன்வாசிட்டெம்] மறைக்கப்படலாம், இது அதன் குழந்தைகளையும் மறைக்கும். மாடுலேசன் "
"(தனக்கும் அதன் குழந்தைகளுக்கும்) மற்றும் தன்வய பண்பேற்றம் (தனக்குத்தானே மட்டுமே), அத்துடன் "
"அதன் கலவை முறை போன்ற அளவுருக்களை மாற்ற இது பல வழிகளை வழங்குகிறது.\n"
" இறுதியில், ஒரு உருமாற்ற அறிவிப்பைக் கோரலாம், இது பெற்றோர் மரம் மாறினால் அதன் உலகளாவிய "
"நிலை மாறியது என்று முனைக்கு அறிவிக்கும்.\n"
" . டிகிரிகளை ரேடியன்களாக மாற்ற, [முறை @gdscript.deg2rad] ஐப் பயன்படுத்தவும்."

#: docs/CanvasItem.xml docs/CanvasLayer.xml docs/InputEvent.xml
#: docs/Viewport.xml
msgid "https://docs.rebeltoolbox.com/en/latest/tutorials/2d/2d_transforms.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/2d/2d_transforms.html"

#: docs/CanvasItem.xml docs/Control.xml docs/Node2D.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/2d/"
"custom_drawing_in_2d.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/2d/"
"custom_drawing_in_2d.html"

#: docs/CanvasItem.xml
msgid ""
"Overridable function called by the engine (if defined) to draw the canvas "
"item."
msgstr ""
"கேன்வாச் உருப்படியை வரைய இயந்திரத்தால் (வரையறுக்கப்பட்டால்) அழைக்கப்படும் மிகைப்படுத்தப்பட்ட "
"செயல்பாடு."

#: docs/CanvasItem.xml
msgid ""
"Draws a unfilled arc between the given angles. The larger the value of "
"[code]point_count[/code], the smoother the curve. See also [method "
"draw_circle].\n"
"[b]Note:[/b] Line drawing is not accelerated by batching if "
"[code]antialiased[/code] is [code]true[/code].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent lines and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedRegularPolygon2D node. That node relies on a texture with custom "
"mipmaps to perform antialiasing. 2D batching is also still supported with "
"those antialiased lines."
msgstr ""
"கொடுக்கப்பட்ட கோணங்களுக்கு இடையில் நிரப்பப்படாத வளைவை ஈர்க்கிறது. [குறியீடு] "
"பாயிண்ட்_கவுண்ட் [/குறியீடு] இன் பெரிய மதிப்பு, வளைவு மென்மையாகும். [முறை டிரா_சர்கிள்] "
"ஐயும் காண்க.\n"
" .\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] ஆன்டியாலியாச் லைன் 2 டி [/url] கூடுதல் ஐ உருவாக்கி ஒரு "
"ஆன்டிலியச்செட் ரெடிசுலர் பேலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் "
"செய்ய தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது. 2 டி பேட்சிங் இன்னும் அந்த "
"ஆன்டிலியாச் கோடுகளுடன் ஆதரிக்கப்படுகிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws a string character using a custom font. Returns the advance, depending "
"on the character width and kerning with an optional next character."
msgstr ""
"தனிப்பயன் எழுத்துருவைப் பயன்படுத்தி ஒரு சரம் எழுத்தை ஈர்க்கிறது. எழுத்துக்குறி அகலத்தைப் "
"பொறுத்து மற்றும் விருப்பமான அடுத்த எழுத்துடன் கெர்னிங் செய்வதை முன்கூட்டியே வழங்குகிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws a colored, filled circle. See also [method draw_arc], [method "
"draw_polyline] and [method draw_polygon].\n"
"[b]Note:[/b] Built-in antialiasing is not provided for [method draw_circle]. "
"As a workaround, install the [url=https://github.com/godot-extended-"
"libraries/godot-antialiased-line2d]Antialiased Line2D[/url] add-on then "
"create an AntialiasedRegularPolygon2D node. That node relies on a texture "
"with custom mipmaps to perform antialiasing."
msgstr ""
"வண்ண, நிரப்பப்பட்ட வட்டத்தை ஈர்க்கிறது. [முறை டிரா_ஆர்க்], [முறை டிரா_போலைலைன்] மற்றும் "
"[முறை டிரா_போலிகான்] ஆகியவற்றைக் காண்க.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] ஆன்டியாலியாச் லைன் 2 டி [/url] கூடுதல் ஐ உருவாக்கி ஒரு "
"ஆன்டிலியச்செட் ரெடிசுலர் பேலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் "
"செய்ய தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Draws a colored polygon of any amount of points, convex or concave. Unlike "
"[method draw_polygon], a single color must be specified for the whole "
"polygon.\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent polygons and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedPolygon2D node. That node relies on a texture with custom mipmaps "
"to perform antialiasing."
msgstr ""
"குவிந்த அல்லது குழிவான எந்த அளவிலான புள்ளிகளின் வண்ண பலகோணத்தை ஈர்க்கிறது. [முறை "
"டிரா_போலிகான்] போலல்லாமல், முழு பலகோணத்திற்கும் ஒற்றை வண்ணம் குறிப்பிடப்பட வேண்டும்.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியச்செட்போலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Draws a line from a 2D point to another, with a given color and width. It "
"can be optionally antialiased. See also [method draw_multiline] and [method "
"draw_polyline].\n"
"[b]Note:[/b] Line drawing is not accelerated by batching if "
"[code]antialiased[/code] is [code]true[/code].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent lines and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedLine2D node. That node relies on a texture with custom mipmaps to "
"perform antialiasing. 2D batching is also still supported with those "
"antialiased lines."
msgstr ""
"கொடுக்கப்பட்ட வண்ணம் மற்றும் அகலத்துடன் 2 டி புள்ளியிலிருந்து இன்னொரு இடத்திற்கு ஒரு கோட்டை "
"வரைகிறது. இது விருப்பமாக ஆன்டியாலியாச் செய்யப்படலாம். [முறை Draw_multiline] மற்றும் "
"[முறை Draw_polyline] ஐயும் காண்க.\n"
" .\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியாசெட்லைன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது. 2 டி பேட்சிங் இன்னும் அந்த ஆன்டிலியாச் "
"கோடுகளுடன் ஆதரிக்கப்படுகிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws a [Mesh] in 2D, using the provided texture. See [MeshInstance2D] for "
"related documentation."
msgstr ""
"வழங்கப்பட்ட அமைப்பைப் பயன்படுத்தி 2D இல் ஒரு [கண்ணி] ஐ ஈர்க்கிறது. தொடர்புடைய ஆவணங்களுக்கு "
"[meshinstance2d] ஐப் பார்க்கவும்."

#: docs/CanvasItem.xml
msgid ""
"Draws multiple disconnected lines with a uniform [code]color[/code]. When "
"drawing large amounts of lines, this is faster than using individual [method "
"draw_line] calls. To draw interconnected lines, use [method draw_polyline] "
"instead.\n"
"[b]Note:[/b] [code]width[/code] and [code]antialiased[/code] are currently "
"not implemented and have no effect. As a workaround, install the "
"[url=https://github.com/godot-extended-libraries/godot-antialiased-"
"line2d]Antialiased Line2D[/url] add-on then create an AntialiasedLine2D "
"node. That node relies on a texture with custom mipmaps to perform "
"antialiasing. 2D batching is also still supported with those antialiased "
"lines."
msgstr ""
"சீருடை [குறியீடு] வண்ணத்துடன் [/குறியீடு] பல துண்டிக்கப்பட்ட வரிகளை ஈர்க்கிறது. அதிக "
"அளவு கோடுகளை வரையும்போது, இது தனிப்பட்ட [முறை டிரா_்லைன்] அழைப்புகளைப் பயன்படுத்துவதை "
"விட வேகமாக இருக்கும். ஒன்றோடொன்று இணைக்கப்பட்ட கோடுகளை வரைய, அதற்கு பதிலாக [முறை "
"டிரா_போலைலைன்] ஐப் பயன்படுத்தவும்.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியாசெட்லைன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது. 2 டி பேட்சிங் இன்னும் அந்த ஆன்டிலியாச் "
"கோடுகளுடன் ஆதரிக்கப்படுகிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws multiple disconnected lines with a uniform [code]width[/code] and "
"segment-by-segment coloring. Colors assigned to line segments match by index "
"between [code]points[/code] and [code]colors[/code]. When drawing large "
"amounts of lines, this is faster than using individual [method draw_line] "
"calls. To draw interconnected lines, use [method draw_polyline_colors] "
"instead.\n"
"[b]Note:[/b] [code]width[/code] and [code]antialiased[/code] are currently "
"not implemented and have no effect. As a workaround, install the "
"[url=https://github.com/godot-extended-libraries/godot-antialiased-"
"line2d]Antialiased Line2D[/url] add-on then create an AntialiasedLine2D "
"node. That node relies on a texture with custom mipmaps to perform "
"antialiasing. 2D batching is also still supported with those antialiased "
"lines."
msgstr ""
"சீருடை [குறியீடு] அகலம் [/குறியீடு] மற்றும் பிரிவு மூலம் பிரிவு வண்ணத்துடன் பல "
"துண்டிக்கப்பட்ட வரிகளை ஈர்க்கிறது. வரி பிரிவுகளுக்கு ஒதுக்கப்பட்ட வண்ணங்கள் [குறியீடு] "
"புள்ளிகள் [/குறியீடு] மற்றும் [குறியீடு] வண்ணங்கள் [/குறியீடு] இடையே குறியீட்டால் "
"பொருந்துகின்றன. அதிக அளவு கோடுகளை வரையும்போது, இது தனிப்பட்ட [முறை டிரா_்லைன்] "
"அழைப்புகளைப் பயன்படுத்துவதை விட வேகமாக இருக்கும். ஒன்றோடொன்று இணைக்கப்பட்ட வரிகளை வரைய, "
"அதற்கு பதிலாக [முறை Draw_polyline_colors] ஐப் பயன்படுத்தவும்.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி ஒரு "
"ஆன்டிலியாசெட்லைன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய தனிப்பயன் "
"MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது. 2 டி பேட்சிங் இன்னும் அந்த ஆன்டிலியாச் கோடுகளுடன் "
"ஆதரிக்கப்படுகிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws a [MultiMesh] in 2D with the provided texture. See "
"[MultiMeshInstance2D] for related documentation."
msgstr ""
"வழங்கப்பட்ட அமைப்புடன் 2D இல் ஒரு [மல்டிமெச்] ஐ ஈர்க்கிறது. தொடர்புடைய ஆவணங்களுக்கு "
"[மல்டிமெசின்ச்டன்ச் 2 டி] ஐப் பார்க்கவும்."

#: docs/CanvasItem.xml
msgid ""
"Draws a solid polygon of any amount of points, convex or concave. Unlike "
"[method draw_colored_polygon], each point's color can be changed "
"individually. See also [method draw_polyline] and [method "
"draw_polyline_colors].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent polygons and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedPolygon2D node. That node relies on a texture with custom mipmaps "
"to perform antialiasing."
msgstr ""
"குவிந்த அல்லது குழிவான எந்த அளவிலான புள்ளிகளின் திடமான பலகோணத்தை ஈர்க்கிறது. [முறை "
"Draw_colored_polygon] போலல்லாமல், ஒவ்வொரு புள்ளியின் வண்ணத்தையும் தனித்தனியாக "
"மாற்றலாம். [முறை Draw_polyline] மற்றும் [முறை Draw_polyline_colors] ஐயும் காண்க.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியச்செட்போலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Draws interconnected line segments with a uniform [code]color[/code] and "
"[code]width[/code] and optional antialiasing. When drawing large amounts of "
"lines, this is faster than using individual [method draw_line] calls. To "
"draw disconnected lines, use [method draw_multiline] instead. See also "
"[method draw_polygon].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent polygons and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedPolygon2D node. That node relies on a texture with custom mipmaps "
"to perform antialiasing."
msgstr ""
"சீரான [குறியீடு] வண்ணம் [/குறியீடு] மற்றும் [குறியீடு] அகலம் [/குறியீடு] மற்றும் "
"விருப்பமான ஆன்டிலியாசிங் ஆகியவற்றுடன் ஒன்றோடொன்று இணைக்கப்பட்ட வரி பிரிவுகளை ஈர்க்கிறது. "
"அதிக அளவு கோடுகளை வரையும்போது, இது தனிப்பட்ட [முறை டிரா_்லைன்] அழைப்புகளைப் "
"பயன்படுத்துவதை விட வேகமாக இருக்கும். துண்டிக்கப்பட்ட வரிகளை வரைய, அதற்கு பதிலாக [முறை "
"டிரா_முல்டைன்] ஐப் பயன்படுத்தவும். [முறை டிரா_போலிகன்] ஐயும் காண்க.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியச்செட்போலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Draws interconnected line segments with a uniform [code]width[/code] and "
"segment-by-segment coloring, and optional antialiasing. Colors assigned to "
"line segments match by index between [code]points[/code] and [code]colors[/"
"code]. When drawing large amounts of lines, this is faster than using "
"individual [method draw_line] calls. To draw disconnected lines, use [method "
"draw_multiline_colors] instead. See also [method draw_polygon].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent polygons and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedPolygon2D node. That node relies on a texture with custom mipmaps "
"to perform antialiasing."
msgstr ""
"சீருடை [குறியீடு] அகலம் [/குறியீடு] மற்றும் பிரிவு மூலம்-பிரிவு வண்ணமயமாக்கல் மற்றும் "
"விருப்பமான ஆன்டிலியாசிங் ஆகியவற்றுடன் ஒன்றோடொன்று இணைக்கப்பட்ட வரி பிரிவுகளை ஈர்க்கிறது. "
"வரி பிரிவுகளுக்கு ஒதுக்கப்பட்ட வண்ணங்கள் [குறியீடு] புள்ளிகள் [/குறியீடு] மற்றும் "
"[குறியீடு] வண்ணங்கள் [/குறியீடு] இடையே குறியீட்டால் பொருந்துகின்றன. அதிக அளவு கோடுகளை "
"வரையும்போது, இது தனிப்பட்ட [முறை டிரா_்லைன்] அழைப்புகளைப் பயன்படுத்துவதை விட வேகமாக "
"இருக்கும். துண்டிக்கப்பட்ட வரிகளை வரைய, அதற்கு பதிலாக [முறை Draw_multiline_colors] "
"ஐப் பயன்படுத்தவும். [முறை டிரா_போலிகன்] ஐயும் காண்க.\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியச்செட்போலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Draws a custom primitive. 1 point for a point, 2 points for a line, 3 points "
"for a triangle, and 4 points for a quad. If 0 points or more than 4 points "
"are specified, nothing will be drawn and an error message will be printed. "
"See also [method draw_line], [method draw_polyline], [method draw_polygon], "
"and [method draw_rect]."
msgstr ""
"தனிப்பயன் பழமையானதை ஈர்க்கிறது. ஒரு புள்ளிக்கு 1 புள்ளி, ஒரு வரிக்கு 2 புள்ளிகள், ஒரு "
"முக்கோணத்திற்கு 3 புள்ளிகள், ஒரு குவாட் 4 புள்ளிகள். 0 புள்ளிகள் அல்லது 4 புள்ளிகளுக்கு "
"மேல் குறிப்பிடப்பட்டால், எதுவும் வரையப்படாது மற்றும் பிழை செய்தி அச்சிடப்படும். [முறை "
"டிரா_்லைன்], [முறை டிரா_போலைலைன்], [முறை டிரா_போலிகோன்] மற்றும் [முறை டிரா_ரெக்ட்] "
"ஆகியவற்றைக் காண்க."

#: docs/CanvasItem.xml
msgid ""
"Draws a rectangle. If [code]filled[/code] is [code]true[/code], the "
"rectangle will be filled with the [code]color[/code] specified. If "
"[code]filled[/code] is [code]false[/code], the rectangle will be drawn as a "
"stroke with the [code]color[/code] and [code]width[/code] specified. If "
"[code]antialiased[/code] is [code]true[/code], the lines will attempt to "
"perform antialiasing using OpenGL line smoothing.\n"
"[b]Note:[/b] [code]width[/code] and [code]antialiased[/code] are only "
"effective if [code]filled[/code] is [code]false[/code].\n"
"[b]Note:[/b] Due to how it works, built-in antialiasing will not look "
"correct for translucent polygons and may not work on certain platforms. As a "
"workaround, install the [url=https://github.com/godot-extended-libraries/"
"godot-antialiased-line2d]Antialiased Line2D[/url] add-on then create an "
"AntialiasedPolygon2D node. That node relies on a texture with custom mipmaps "
"to perform antialiasing."
msgstr ""
"ஒரு செவ்வகத்தை ஈர்க்கிறது. [குறியீடு] நிரப்பப்பட்ட [/குறியீடு] [குறியீடு] உண்மை [/"
"குறியீடு] என்றால், செவ்வகம் குறிப்பிடப்பட்ட [குறியீடு] வண்ணம் [/குறியீடு] உடன் "
"நிரப்பப்படும். . .\n"
" .\n"
" . ஒரு பணித்தொகுப்பாக, [url = https: //github.com/godot-extended-libraries/"
"godot-antialiased-line2d] antialiased line2d [/url] கூடுதல் ஐ நிறுவி பின்னர் "
"ஒரு ஆன்டிலியச்செட்போலிகோன் 2 டி முனையை உருவாக்கவும். அந்த முனை ஆன்டிலியாசிங்கைச் செய்ய "
"தனிப்பயன் MIPMAPS உடன் ஒரு அமைப்பை நம்பியுள்ளது."

#: docs/CanvasItem.xml
msgid ""
"Sets a custom transform for drawing via components. Anything drawn "
"afterwards will be transformed by this."
msgstr ""
"கூறுகள் வழியாக வரைவதற்கு தனிப்பயன் உருமாற்றத்தை அமைக்கிறது. பின்னர் வரையப்பட்ட எதுவும் "
"இதன் மூலம் மாற்றப்படும்."

#: docs/CanvasItem.xml
msgid ""
"Sets a custom transform for drawing via matrix. Anything drawn afterwards "
"will be transformed by this."
msgstr ""
"மேட்ரிக்ச் வழியாக வரைவதற்கு தனிப்பயன் உருமாற்றத்தை அமைக்கிறது. பின்னர் வரையப்பட்ட எதுவும் "
"இதன் மூலம் மாற்றப்படும்."

#: docs/CanvasItem.xml
msgid ""
"Draws [code]text[/code] using the specified [code]font[/code] at the "
"[code]position[/code] (bottom-left corner using the baseline of the font). "
"The text will have its color multiplied by [code]modulate[/code]. If "
"[code]clip_w[/code] is greater than or equal to 0, the text will be clipped "
"if it exceeds the specified width.\n"
"[b]Example using the default project font:[/b]\n"
"[codeblock]\n"
"# If using this method in a script that redraws constantly, move the\n"
"# `default_font` declaration to a member variable assigned in `_ready()`\n"
"# so the Control is only created once.\n"
"var default_font = Control.new().get_font(\"font\")\n"
"draw_string(default_font, Vector2(64, 64), \"Hello world\")\n"
"[/codeblock]\n"
"See also [method Font.draw]."
msgstr ""
"[குறியீடு] நிலை [/குறியீடு] [/குறியீடு] [/குறியீடு] [/குறியீடு] நிலையில் [/"
"குறியீடு] (எழுத்துருவின் அடிப்படையைப் பயன்படுத்தி கீழ்-இடது மூலையில்) ஈர்க்கிறது. உரையில் "
"அதன் வண்ணம் [குறியீடு] மாடுலேட் [/குறியீடு] ஆல் பெருக்கப்படும். [குறியீடு] கிளிப்_டபிள்யூ "
"[/குறியீடு] 0 ஐ விட அதிகமாகவோ அல்லது சமமாகவோ இருந்தால், குறிப்பிட்ட அகலத்தை மீறினால் "
"உரை கிளிப் செய்யப்படும்.\n"
" [b] இயல்புநிலை திட்ட எழுத்துருவைப் பயன்படுத்தி எடுத்துக்காட்டு: [/b]\n"
" [கோட் பிளாக்]\n"
" # இந்த முறையை ஒரு ச்கிரிப்டில் தொடர்ந்து மீண்டும் மறுக்கிறார் என்றால், நகர்த்தவும்\n"
" `_ready ()` இல் ஒதுக்கப்பட்ட உறுப்பினர் மாறிக்கு # `இயல்புநிலை_பொன்ட்` அறிவித்தல்\n"
" # எனவே கட்டுப்பாடு ஒரு முறை மட்டுமே உருவாக்கப்படுகிறது.\n"
" var default_font = control.new (). get_font (\"எழுத்துரு\")\n"
" draw_string (இயல்புநிலை_பொன்ட், வெக்டர் 2 (64, 64), \"அலோ வேர்ல்ட்\")\n"
" [/codeBlock]\n"
" [முறை font.draw] ஐயும் காண்க."

#: docs/CanvasItem.xml
msgid "Draws a styled rectangle."
msgstr "ஒரு பாணியிலான செவ்வகத்தை ஈர்க்கிறது."

#: docs/CanvasItem.xml
msgid "Draws a texture at a given position."
msgstr "ஒரு குறிப்பிட்ட நிலையில் ஒரு அமைப்பை ஈர்க்கிறது."

#: docs/CanvasItem.xml
msgid ""
"Draws a textured rectangle at a given position, optionally modulated by a "
"color. If [code]transpose[/code] is [code]true[/code], the texture will have "
"its X and Y coordinates swapped."
msgstr ""
"கொடுக்கப்பட்ட நிலையில் ஒரு கடினமான செவ்வகத்தை ஈர்க்கிறது, விருப்பமாக ஒரு வண்ணத்தால் "
"மாற்றியமைக்கப்படுகிறது. ."

#: docs/CanvasItem.xml
msgid ""
"Draws a textured rectangle region at a given position, optionally modulated "
"by a color. If [code]transpose[/code] is [code]true[/code], the texture will "
"have its X and Y coordinates swapped."
msgstr ""
"ஒரு குறிப்பிட்ட நிலையில் ஒரு கடினமான செவ்வகப் பகுதியை ஈர்க்கிறது, விருப்பமாக ஒரு "
"வண்ணத்தால் மாற்றியமைக்கப்படுகிறது. ."

#: docs/CanvasItem.xml docs/Spatial.xml
msgid ""
"Forces the transform to update. Transform changes in physics are not instant "
"for performance reasons. Transforms are accumulated and then set. Use this "
"if you need an up-to-date transform when doing physics operations."
msgstr ""
"மாற்றத்தை புதுப்பிக்க கட்டாயப்படுத்துகிறது. இயற்பியலில் மாற்றங்கள் செயல்திறன் காரணங்களுக்காக "
"உடனடி அல்ல. உருமாற்றங்கள் திரட்டப்பட்டு பின்னர் அமைக்கப்படுகின்றன. இயற்பியல் செயல்பாடுகளைச் "
"செய்யும்போது உங்களுக்கு புதுப்பித்த மாற்றம் தேவைப்பட்டால் இதைப் பயன்படுத்தவும்."

#: docs/CanvasItem.xml
msgid "Returns the [RID] of the [World2D] canvas where this item is in."
msgstr "இந்த உருப்படி இருக்கும் [world2d] கேன்வாசின் [RID] ஐ வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the canvas item RID used by [VisualServer] for this item."
msgstr ""
"இந்த உருப்படிக்கு [விசுவர்சர்வர்] பயன்படுத்தும் கேன்வாச் உருப்படி அகற்றலை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the transform matrix of this item's canvas."
msgstr "இந்த உருப்படியின் கேன்வாசின் உருமாற்ற மேட்ரிக்சை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the global position of the mouse."
msgstr "சுட்டியின் உலகளாவிய நிலையை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the global transform matrix of this item."
msgstr "இந்த உருப்படியின் உலகளாவிய உருமாற்ற மேட்ரிக்சை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid ""
"Returns the global transform matrix of this item in relation to the canvas."
msgstr "கேன்வாச் தொடர்பாக இந்த உருப்படியின் உலகளாவிய உருமாற்ற மேட்ரிக்சை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the mouse position relative to this item's position."
msgstr "இந்த உருப்படியின் நிலையுடன் தொடர்புடைய சுட்டி நிலையை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the transform matrix of this item."
msgstr "இந்த உருப்படியின் உருமாற்ற மேட்ரிக்சை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the viewport's boundaries as a [Rect2]."
msgstr "வியூபோர்ட்டின் எல்லைகளை [rect2] என வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns this item's transform in relation to the viewport."
msgstr "காட்சியகம் தொடர்பாக இந்த உருப்படியின் உருமாற்றத்தை வழங்குகிறது."

#: docs/CanvasItem.xml
msgid "Returns the [World2D] where this item is in."
msgstr "இந்த உருப்படி இருக்கும் [world2d] ஐ வழங்குகிறது."

#: docs/CanvasItem.xml
msgid ""
"Hide the [CanvasItem] if it's currently visible. This is equivalent to "
"setting [member visible] to [code]false[/code]."
msgstr ""
"தற்போது காணப்பட்டால் [கேன்வாசிட்டெம்] மறைக்கவும். இது [குறியீடு] தவறான [/குறியீடு] என "
"[உறுப்பினர் தெரியும்] அமைப்பதற்கு சமம்."

#: docs/CanvasItem.xml
msgid ""
"Returns [code]true[/code] if local transform notifications are communicated "
"to children."
msgstr ""
"உள்ளக உருமாற்ற அறிவிப்புகள் குழந்தைகளுக்கு தெரிவிக்கப்பட்டால் [குறியீடு] உண்மை [/"
"குறியீடு] திரும்பும்."

#: docs/CanvasItem.xml
msgid ""
"Returns [code]true[/code] if the node is set as top-level. See [method "
"set_as_toplevel]."
msgstr ""
"முனை மேல் மட்டமாக அமைக்கப்பட்டால் [குறியீடு] உண்மை [/குறியீடு] ஐ வழங்குகிறது. [முறை "
"set_as_toplevel] ஐப் பார்க்கவும்."

#: docs/CanvasItem.xml
msgid ""
"Returns [code]true[/code] if global transform notifications are communicated "
"to children."
msgstr ""
"உலகளாவிய உருமாற்ற அறிவிப்புகள் குழந்தைகளுக்குத் தெரிவிக்கப்பட்டால் [குறியீடு] உண்மை [/"
"குறியீடு]."

#: docs/CanvasItem.xml docs/Spatial.xml
msgid ""
"Returns [code]true[/code] if the node is present in the [SceneTree], its "
"[member visible] property is [code]true[/code] and all its antecedents are "
"also visible. If any antecedent is hidden, this node will not be visible in "
"the scene tree."
msgstr ""
"[CODE] உண்மை [/குறியீடு] வருமானம் [SCESETREE] இல் முனை இருந்தால், அதன் [உறுப்பினர் "
"தெரியும்] சொத்து [குறியீடு] உண்மை [/குறியீடு] மற்றும் அதன் அனைத்து முன்னோடிகளும் "
"தெரியும். ஏதேனும் முன்னோடி மறைக்கப்பட்டால், இந்த முனை காட்சி மரத்தில் தெரியாது."

#: docs/CanvasItem.xml
msgid "Assigns [code]screen_point[/code] as this node's new local transform."
msgstr ""
"இந்த முனையின் புதிய உள்ளக உருமாற்றமாக [குறியீடு] ச்கிரீன்_ பாயிண்ட் [/குறியீடு] ஐ "
"ஒதுக்குகிறது."

#: docs/CanvasItem.xml
msgid ""
"Transformations issued by [code]event[/code]'s inputs are applied in local "
"space instead of global space."
msgstr ""
"[குறியீடு] நிகழ்வு [/குறியீடு] இன் உள்ளீடுகளால் வழங்கப்பட்ட மாற்றங்கள் உலகளாவிய இடத்திற்கு "
"பதிலாக உள்ளக இடத்தில் பயன்படுத்தப்படுகின்றன."

#: docs/CanvasItem.xml
msgid ""
"If [code]enable[/code] is [code]true[/code], this [CanvasItem] will [i]not[/"
"i] inherit its transform from parent [CanvasItem]s. Its draw order will also "
"be changed to make it draw on top of other [CanvasItem]s that are not set as "
"top-level. The [CanvasItem] will effectively act as if it was placed as a "
"child of a bare [Node]. See also [method is_set_as_toplevel]."
msgstr ""
". அதன் டிரா ஆர்டர் மாற்றப்படும், இது மற்ற [கேன்வாசிட்டெம்] கள் மேல்-நிலை என "
"அமைக்கப்படாதது. [கேன்வாசிட்டெம்] இது ஒரு வெற்று [முனை] குழந்தையாக வைக்கப்பட்டதைப் போல "
"திறம்பட செயல்படும். [முறை IS_SET_AS_TOPLEVEL] ஐயும் காண்க."

#: docs/CanvasItem.xml
msgid ""
"If [code]enable[/code] is [code]true[/code], children will be updated with "
"local transform data."
msgstr ""
"[குறியீடு] [/குறியீடு] [குறியீடு] உண்மை [/குறியீடு] என்றால், குழந்தைகள் உள்ளக உருமாற்ற "
"தரவுகளுடன் புதுப்பிக்கப்படும்."

#: docs/CanvasItem.xml
msgid ""
"If [code]enable[/code] is [code]true[/code], children will be updated with "
"global transform data."
msgstr ""
"[குறியீடு] [/குறியீடு] [குறியீடு] உண்மை [/குறியீடு] என்றால், குழந்தைகள் உலகளாவிய "
"உருமாற்ற தரவுகளுடன் புதுப்பிக்கப்படும்."

#: docs/CanvasItem.xml
msgid ""
"Show the [CanvasItem] if it's currently hidden. This is equivalent to "
"setting [member visible] to [code]true[/code]. For controls that inherit "
"[Popup], the correct way to make them visible is to call one of the multiple "
"[code]popup*()[/code] functions instead."
msgstr ""
"தற்போது மறைக்கப்பட்டிருந்தால் [கேன்வாசிட்டெம்] காட்டுங்கள். இது [குறியீடு] உண்மை [/"
"குறியீடு] என [உறுப்பினர் தெரியும்] அமைப்பதற்கு சமம். [பாப்அப்] மரபுரிமையாகும் "
"கட்டுப்பாடுகளுக்கு, அவற்றைக் காண சரியான வழி, அதற்கு பதிலாக பல [குறியீடு] பாப்அப்*() [/"
"குறியீடு] செயல்பாடுகளில் ஒன்றை அழைப்பது."

#: docs/CanvasItem.xml
msgid ""
"Queue the [CanvasItem] for update. [constant NOTIFICATION_DRAW] will be "
"called on idle time to request redraw."
msgstr ""
"புதுப்பிப்புக்கு [கேன்வாசிட்டெம்] வரிசையில் நிற்கவும். [நிலையான அறிவிப்பு_ டிரா] "
"மறுவடிவமைப்பு கோர செயலற்ற நேரத்தில் அழைக்கப்படும்."

#: docs/CanvasItem.xml
msgid ""
"The rendering layers in which this [CanvasItem] responds to [Light2D] nodes."
msgstr "இந்த [கேன்வாசிட்டெம்] [லைட் 2 டி] முனைகளுக்கு பதிலளிக்கும் வழங்குதல் அடுக்குகள்."

#: docs/CanvasItem.xml
msgid "The material applied to textures on this [CanvasItem]."
msgstr "இந்த [கேன்வாசிட்டெம்] இல் உள்ள அமைப்புகளுக்குப் பயன்படுத்தப்படும் பொருள்."

#: docs/CanvasItem.xml
msgid "The color applied to textures on this [CanvasItem]."
msgstr "இந்த [கேன்வாசிட்டெம்] இல் உள்ள அமைப்புகளுக்கு பயன்படுத்தப்படும் நிறம்."

#: docs/CanvasItem.xml
msgid ""
"The color applied to textures on this [CanvasItem]. This is not inherited by "
"children [CanvasItem]s."
msgstr ""
"இந்த [கேன்வாசிட்டெம்] இல் உள்ள அமைப்புகளுக்கு பயன்படுத்தப்படும் நிறம். இது குழந்தைகளால் "
"பெறப்படவில்லை [கேன்வாசிட்டெம்] கள்."

#: docs/CanvasItem.xml
msgid "If [code]true[/code], the object draws behind its parent."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், பொருள் அதன் பெற்றோரின் பின்னால் ஈர்க்கிறது."

#: docs/CanvasItem.xml
msgid "If [code]true[/code], the object draws on top of its parent."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், பொருள் அதன் பெற்றோரின் மேல் ஈர்க்கிறது."

#: docs/CanvasItem.xml
msgid ""
"If [code]true[/code], the parent [CanvasItem]'s [member material] property "
"is used as this one's material."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், பெற்றோர் [கேன்வாசிட்டெம்] இன் [உறுப்பினர் பொருள்] "
"சொத்து இந்த பொருளாக பயன்படுத்தப்படுகிறது."

#: docs/CanvasItem.xml
msgid ""
"If [code]true[/code], this [CanvasItem] is drawn. The node is only visible "
"if all of its antecedents are visible as well (in other words, [method "
"is_visible_in_tree] must return [code]true[/code]).\n"
"[b]Note:[/b] For controls that inherit [Popup], the correct way to make them "
"visible is to call one of the multiple [code]popup*()[/code] functions "
"instead."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், இந்த [கேன்வாசிடெம்] வரையப்படுகிறது. முனை அதன் "
"முன்னோடிகள் அனைத்தும் தெரிந்தால் மட்டுமே தெரியும் (வேறுவிதமாகக் கூறினால், [முறை "
"IS_VISIBLE_IN_TREE] [குறியீடு] உண்மை [/குறியீடு] திரும்ப வேண்டும்).\n"
" ."

#: docs/CanvasItem.xml
msgid ""
"Emitted when the [CanvasItem] must redraw. This can only be connected "
"realtime, as deferred will not allow drawing."
msgstr ""
"[கேன்வாசிட்டெம்] மீண்டும் வர வேண்டும். இது நிகழ்நேரத்தை மட்டுமே இணைக்க முடியும், ஏனெனில் "
"ஒத்திவைக்கப்பட்டது வரைபடத்தை அனுமதிக்காது."

#: docs/CanvasItem.xml
msgid "Emitted when becoming hidden."
msgstr "மறைக்கும்போது உமிழும்."

#: docs/CanvasItem.xml
msgid ""
"Emitted when the item's [Rect2] boundaries (position or size) have changed, "
"or when an action is taking place that may have impacted these boundaries "
"(e.g. changing [member Sprite.texture])."
msgstr ""
"உருப்படியின் [rect2] எல்லைகள் (நிலை அல்லது அளவு) மாறிவிட்டால், அல்லது இந்த எல்லைகளை "
"பாதித்திருக்கக்கூடிய ஒரு நடவடிக்கை நடைபெறும் போது (எ.கா."

#: docs/CanvasItem.xml
msgid "Emitted when the visibility (hidden/visible) changes."
msgstr "தெரிவுநிலை (மறைக்கப்பட்ட/புலப்படும்) மாறும்போது உமிழப்படும்."

#: docs/CanvasItem.xml docs/CanvasItemMaterial.xml
msgid ""
"Mix blending mode. Colors are assumed to be independent of the alpha "
"(opacity) value."
msgstr ""
"கலப்பு பயன்முறையை கலக்கவும். வண்ணங்கள் ஆல்பா (ஒளிபுகாநிலை) மதிப்பிலிருந்து சுயாதீனமாக "
"இருப்பதாக கருதப்படுகிறது."

#: docs/CanvasItem.xml docs/CanvasItemMaterial.xml
msgid "Additive blending mode."
msgstr "சேர்க்கை கலப்பு முறை."

#: docs/CanvasItem.xml docs/CanvasItemMaterial.xml
msgid "Subtractive blending mode."
msgstr "கழித்தல் கலப்பு முறை."

#: docs/CanvasItem.xml docs/CanvasItemMaterial.xml
msgid "Multiplicative blending mode."
msgstr "பெருக்கல் கலப்பு முறை."

#: docs/CanvasItem.xml docs/CanvasItemMaterial.xml
msgid ""
"Mix blending mode. Colors are assumed to be premultiplied by the alpha "
"(opacity) value."
msgstr ""
"கலப்பு பயன்முறையை கலக்கவும். வண்ணங்கள் ஆல்பா (ஒளிபுகாநிலை) மதிப்பால் முன்கூட்டியே "
"கருதப்படுகின்றன."

#: docs/CanvasItem.xml
msgid ""
"Disables blending mode. Colors including alpha are written as-is. Only "
"applicable for render targets with a transparent background. No lighting "
"will be applied."
msgstr ""
"கலப்பு பயன்முறையை முடக்குகிறது. ஆல்பா உள்ளிட்ட வண்ணங்கள் எழுதப்பட்டவை. வெளிப்படையான "
"பின்னணியுடன் இலக்குகளை வழங்குவதற்கு மட்டுமே பொருந்தும். எந்த விளக்குகளும் "
"பயன்படுத்தப்படாது."

#: docs/CanvasItem.xml
msgid ""
"The [CanvasItem]'s transform has changed. This notification is only received "
"if enabled by [method set_notify_transform] or [method "
"set_notify_local_transform]."
msgstr ""
"[கேன்வாசிட்டெம்] இன் மாற்றம் மாறிவிட்டது. [முறை set_notify_transform] அல்லது [முறை "
"set_notify_local_transform] ஆல் இயக்கப்பட்டால் மட்டுமே இந்த அறிவிப்பு பெறப்படுகிறது."

#: docs/CanvasItem.xml
msgid "The [CanvasItem] is requested to draw."
msgstr "[கேன்வாசிட்டெம்] வரையுமாறு கேட்டுக்கொள்ளப்படுகிறது."

#: docs/CanvasItem.xml
msgid "The [CanvasItem]'s visibility has changed."
msgstr "[கேன்வாசிட்டெம்] இன் தெரிவுநிலை மாறிவிட்டது."

#: docs/CanvasItem.xml
msgid "The [CanvasItem] has entered the canvas."
msgstr "[கேன்வாசிட்டெம்] கேன்வாசில் நுழைந்தது."

#: docs/CanvasItem.xml
msgid "The [CanvasItem] has exited the canvas."
msgstr "[கேன்வாசிட்டெம்] கேன்வாசிலிருந்து வெளியேறிவிட்டது."

#: docs/CanvasItemMaterial.xml
msgid "A material for [CanvasItem]s."
msgstr "[கேன்வாசிட்டெம்] கள்."

#: docs/CanvasItemMaterial.xml
msgid ""
"[CanvasItemMaterial]s provide a means of modifying the textures associated "
"with a CanvasItem. They specialize in describing blend and lighting "
"behaviors for textures. Use a [ShaderMaterial] to more fully customize a "
"material's interactions with a [CanvasItem]."
msgstr ""
"[கேன்வாசிடெமேட்டரியல்] கள் கேன்வாசிட்டெமுடன் தொடர்புடைய அமைப்புகளை மாற்றுவதற்கான "
"வழிமுறையை வழங்குகின்றன. அமைப்புகளுக்கான கலவை மற்றும் லைட்டிங் நடத்தைகளை விவரிப்பதில் "
"அவர்கள் நிபுணத்துவம் பெற்றவர்கள். [கேன்வாசிட்டெம்] உடன் பொருளின் தொடர்புகளை இன்னும் "
"முழுமையாகத் தனிப்பயனாக்க [நிழல் நிலப்பரப்பைப் பயன்படுத்தவும்."

#: docs/CanvasItemMaterial.xml
msgid ""
"The manner in which a material's rendering is applied to underlying textures."
msgstr "ஒரு பொருளின் வழங்குதல் அடிப்படை அமைப்புகளுக்கு பயன்படுத்தப்படும் விதம்."

#: docs/CanvasItemMaterial.xml
msgid "The manner in which material reacts to lighting."
msgstr "பொருள் விளக்குகளுக்கு வினைபுரியும் விதம்."

#: docs/CanvasItemMaterial.xml
msgid ""
"The number of columns in the spritesheet assigned as [Texture] for a "
"[Particles2D] or [CPUParticles2D].\n"
"[b]Note:[/b] This property is only used and visible in the editor if [member "
"particles_animation] is [code]true[/code]."
msgstr ""
"[துகள்கள் 2 டி] அல்லது [cpuparticles2d] க்கு [அமைப்பு] என ஒதுக்கப்பட்ட ச்பிரிட்சீட்டில் "
"உள்ள நெடுவரிசைகளின் எண்ணிக்கை.\n"
" ."

#: docs/CanvasItemMaterial.xml
msgid ""
"If [code]true[/code], the particles animation will loop.\n"
"[b]Note:[/b] This property is only used and visible in the editor if [member "
"particles_animation] is [code]true[/code]."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், துகள்கள் அனிமேசன் சுழலும்.\n"
" ."

#: docs/CanvasItemMaterial.xml
msgid ""
"The number of rows in the spritesheet assigned as [Texture] for a "
"[Particles2D] or [CPUParticles2D].\n"
"[b]Note:[/b] This property is only used and visible in the editor if [member "
"particles_animation] is [code]true[/code]."
msgstr ""
"[துகள்கள் 2 டி] அல்லது [cpuparticles2d] க்கு [அமைப்பு] என ஒதுக்கப்பட்ட ச்பிரிட்சீட்டில் "
"உள்ள வரிசைகளின் எண்ணிக்கை.\n"
" ."

#: docs/CanvasItemMaterial.xml
msgid ""
"If [code]true[/code], enable spritesheet-based animation features when "
"assigned to [Particles2D] and [CPUParticles2D] nodes. The [member "
"ParticlesMaterial.anim_speed] or [member CPUParticles2D.anim_speed] should "
"also be set to a positive value for the animation to play.\n"
"This property (and other [code]particles_anim_*[/code] properties that "
"depend on it) has no effect on other types of nodes."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், [துகள் 2 டி] மற்றும் [cpuparticles2d] "
"முனைகளுக்கு ஒதுக்கப்படும்போது ச்பிரிட்சீட் அடிப்படையிலான அனிமேசன் அம்சங்களை இயக்கவும். "
"[உறுப்பினர் துகள்கள்மேட்டர். அனிம்_ச்பீட்] அல்லது [உறுப்பினர் cpuparticles2d.anim_speed] "
"அனிமேசன் விளையாடுவதற்கு நேர்மறையான மதிப்புக்கு அமைக்கப்பட வேண்டும்.\n"
" இந்த சொத்து (மற்றும் பிற [குறியீடு] துகள்கள்_அனிம் _*[/குறியீடு] அதைச் சார்ந்து இருக்கும் "
"பண்புகள்) மற்ற வகை முனைகளில் எந்த விளைவையும் ஏற்படுத்தாது."

#: docs/CanvasItemMaterial.xml
msgid ""
"Render the material using both light and non-light sensitive material "
"properties."
msgstr "ஒளி மற்றும் ஒளி அல்லாத உணர்திறன் பொருள் பண்புகளைப் பயன்படுத்தி பொருளை வழங்கவும்."

#: docs/CanvasItemMaterial.xml
msgid "Render the material as if there were no light."
msgstr "ஒளி இல்லாதது போல் பொருளை வழங்கவும்."

#: docs/CanvasItemMaterial.xml
msgid "Render the material as if there were only light."
msgstr "ஒளி மட்டுமே இருப்பதைப் போல பொருளை வழங்கவும்."

#: docs/CanvasLayer.xml
msgid "Canvas drawing layer."
msgstr "கேன்வாச் வரைதல் அடுக்கு."

#: docs/CanvasLayer.xml
msgid ""
"Canvas drawing layer. [CanvasItem] nodes that are direct or indirect "
"children of a [CanvasLayer] will be drawn in that layer. The layer is a "
"numeric index that defines the draw order. The default 2D scene renders with "
"index 0, so a [CanvasLayer] with index -1 will be drawn below, and one with "
"index 1 will be drawn above. This is very useful for HUDs (in layer 1+ or "
"above), or backgrounds (in layer -1 or below)."
msgstr ""
"கேன்வாச் வரைதல் அடுக்கு. [கேன்வாசிடெம்] [கேன்வாச்லேயர்] இன் நேரடி அல்லது மறைமுக "
"குழந்தைகளாக இருக்கும் முனைகள் அந்த அடுக்கில் வரையப்படும். அடுக்கு என்பது ஒரு எண் "
"குறியீடாகும், இது டிரா வரிசையை வரையறுக்கிறது. இயல்புநிலை 2 டி காட்சி குறியீட்டு 0 "
"உடன் வழங்குகிறது, எனவே குறியீட்டு -1 உடன் [கேன்வாச்லேயர்] கீழே வரையப்படும், மேலும் "
"குறியீட்டு 1 உடன் ஒன்று மேலே வரையப்படும். இது HUD களுக்கு (1+ அல்லது அதற்கு மேற்பட்ட "
"அடுக்கு), அல்லது பின்னணிக்கு (அடுக்கு -1 அல்லது அதற்குக் கீழே) மிகவும் பயனுள்ளதாக "
"இருக்கும்."

#: docs/CanvasLayer.xml
msgid "https://docs.rebeltoolbox.com/en/latest/tutorials/2d/canvas_layers.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/2d/canvas_layers.html"

#: docs/CanvasLayer.xml
msgid "Returns the RID of the canvas used by this layer."
msgstr "இந்த அடுக்கு பயன்படுத்தும் கேன்வாசிலிருந்து விடுபடுகிறது."

#: docs/CanvasLayer.xml
msgid ""
"The custom [Viewport] node assigned to the [CanvasLayer]. If [code]null[/"
"code], uses the default viewport instead."
msgstr ""
"[கேன்வாச்லேயர்] க்கு ஒதுக்கப்பட்ட தனிப்பயன் [வியூபோர்ட்] முனை. [குறியீடு] NULL [/code] "
"என்றால், அதற்கு பதிலாக இயல்புநிலை காட்சியமைப்பைப் பயன்படுத்துகிறது."

#: docs/CanvasLayer.xml
msgid ""
"Sets the layer to follow the viewport in order to simulate a pseudo 3D "
"effect."
msgstr ""
"ஒரு போலி 3D விளைவை உருவகப்படுத்துவதற்காக காட்சியகத்தைப் பின்பற்ற அடுக்கை அமைக்கிறது."

#: docs/CanvasLayer.xml
msgid ""
"Scales the layer when using [member follow_viewport_enable]. Layers moving "
"into the foreground should have increasing scales, while layers moving into "
"the background should have decreasing scales."
msgstr ""
"[உறுப்பினர் Follow_viewport_enable] ஐப் பயன்படுத்தும் போது அடுக்கை அளவிடுகிறது. "
"முன்புறத்தில் நகரும் அடுக்குகள் அதிகரிக்கும் அளவீடுகளைக் கொண்டிருக்க வேண்டும், அதே நேரத்தில் "
"பின்னணியில் நகரும் அடுக்குகள் குறைக்கும் அளவீடுகளைக் கொண்டிருக்க வேண்டும்."

#: docs/CanvasLayer.xml
msgid "Layer index for draw order. Lower values are drawn first."
msgstr "டிரா ஆர்டருக்கான அடுக்கு குறியீடு. குறைந்த மதிப்புகள் முதலில் வரையப்படுகின்றன."

#: docs/CanvasLayer.xml
msgid "The layer's base offset."
msgstr "அடுக்கின் அடிப்படை ஆஃப்செட்."

#: docs/CanvasLayer.xml
msgid "The layer's rotation in radians."
msgstr "ரேடியன்களில் அடுக்கின் சுழற்சி."

#: docs/CanvasLayer.xml
msgid "The layer's rotation in degrees."
msgstr "டிகிரிகளில் அடுக்கின் சுழற்சி."

#: docs/CanvasLayer.xml
msgid "The layer's scale."
msgstr "அடுக்கின் அளவு."

#: docs/CanvasLayer.xml
msgid "The layer's transform."
msgstr "அடுக்கின் உருமாற்றம்."

#: docs/CanvasModulate.xml
msgid "Tint the entire canvas."
msgstr "முழு கேன்வாசையும் சாய்த்துக் கொள்ளுங்கள்."

#: docs/CanvasModulate.xml
msgid ""
"[CanvasModulate] tints the canvas elements using its assigned [member color]."
msgstr ""
"[கேன்வாச்மோடுலேட்] கேன்வாச் கூறுகளை அதன் ஒதுக்கப்பட்ட [உறுப்பினர் வண்ணம்] பயன்படுத்தி "
"நிற்கிறது."

#: docs/CanvasModulate.xml
msgid "The tint color to apply."
msgstr "விண்ணப்பிக்க வண்ணம்."

#: docs/CapsuleMesh.xml
msgid "Class representing a capsule-shaped [PrimitiveMesh]."
msgstr "காப்ச்யூல் வடிவ [ப்ரிமிடிவேமேச்] ஐ குறிக்கும் வகுப்பு."

#: docs/CapsuleMesh.xml
msgid ""
"Height of the middle cylindrical part of the capsule (without the "
"hemispherical ends).\n"
"[b]Note:[/b] The capsule's total height is equal to [member mid_height] + 2 "
"* [member radius]."
msgstr ""
"காப்ச்யூலின் நடுத்தர உருளை பகுதியின் உயரம் (அரைக்கோள முனைகள் இல்லாமல்).\n"
" [b] குறிப்பு: [/b] காப்ச்யூலின் மொத்த உயரம் [உறுப்பினர் மிட்_ஐட்] + 2 * [உறுப்பினர் "
"ஆரம்] க்கு சமம்."

#: docs/CapsuleMesh.xml
msgid "Number of radial segments on the capsule mesh."
msgstr "காப்ச்யூல் கண்ணி மீது ரேடியல் பிரிவுகளின் எண்ணிக்கை."

#: docs/CapsuleMesh.xml
msgid "Radius of the capsule mesh."
msgstr "காப்ச்யூல் கண்ணி ஆரம்."

#: docs/CapsuleMesh.xml
msgid "Number of rings along the height of the capsule."
msgstr "காப்ச்யூலின் உயரத்தில் மோதிரங்களின் எண்ணிக்கை."

#: docs/CapsuleShape.xml
msgid "Capsule shape for collisions."
msgstr "மோதல்களுக்கான காப்ச்யூல் வடிவம்."

#: docs/CapsuleShape.xml docs/CapsuleShape2D.xml
msgid "The capsule's height."
msgstr "காப்ச்யூலின் உயரம்."

#: docs/CapsuleShape.xml docs/CapsuleShape2D.xml
msgid "The capsule's radius."
msgstr "காப்ச்யூலின் ஆரம்."

#: docs/CapsuleShape2D.xml
msgid "Capsule shape for 2D collisions."
msgstr "2 டி மோதல்களுக்கான காப்ச்யூல் வடிவம்."

#: docs/CenterContainer.xml
msgid "Keeps children controls centered."
msgstr "குழந்தைகள் கட்டுப்பாடுகளை மையமாகக் கொண்டுள்ளது."

#: docs/CenterContainer.xml
msgid ""
"CenterContainer keeps children controls centered. This container keeps all "
"children to their minimum size, in the center."
msgstr ""
"சென்டர் கான்டைனர் குழந்தைகளை மையமாக வைத்திருக்கிறது. இந்த கொள்கலன் அனைத்து குழந்தைகளையும் "
"மையத்தில், அவர்களின் குறைந்தபட்ச அளவிற்கு வைத்திருக்கிறது."

#: docs/CenterContainer.xml
msgid ""
"If [code]true[/code], centers children relative to the [CenterContainer]'s "
"top left corner."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், [சென்டர் கான்டெய்னர்] இன் மேல் இடது மூலையுடன் "
"தொடர்புடைய குழந்தைகளை மையமாகக் கொண்டுள்ளது."

#: docs/CharFXTransform.xml
msgid ""
"Controls how an individual character will be displayed in a [RichTextEffect]."
msgstr ""
"[ரிச் டெக்ச்டெஃபெக்ட்] இல் ஒரு தனிப்பட்ட எழுத்து எவ்வாறு காண்பிக்கப்படும் என்பதைக் "
"கட்டுப்படுத்துகிறது."

#: docs/CharFXTransform.xml
msgid ""
"By setting various properties on this object, you can control how individual "
"characters will be displayed in a [RichTextEffect]."
msgstr ""
"இந்த பொருளில் பல்வேறு பண்புகளை அமைப்பதன் மூலம், தனிப்பட்ட எழுத்துக்கள் [பணக்கார உரை "
"விளைவு] இல் எவ்வாறு காண்பிக்கப்படும் என்பதை நீங்கள் கட்டுப்படுத்தலாம்."

#: docs/CharFXTransform.xml docs/RichTextEffect.xml docs/RichTextLabel.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/ui/"
"bbcode_in_richtextlabel.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/ui/"
"bbcode_in_richtextlabel.html"

#: docs/CharFXTransform.xml
msgid ""
"The index of the current character (starting from 0) for the "
"[RichTextLabel]'s BBCode text. Setting this property won't affect drawing."
msgstr ""
"[ரிச் டெக்ச்ட்லேபிள்] இன் பிபிகோட் உரைக்கு தற்போதைய எழுத்தின் குறியீடு (0 இலிருந்து "
"தொடங்குகிறது). இந்த சொத்தை அமைப்பது வரைபடத்தை பாதிக்காது."

#: docs/CharFXTransform.xml
msgid ""
"The Unicode codepoint the character will use. This only affects non-"
"whitespace characters. [method @GDScript.ord] can be useful here. For "
"example, the following will replace all characters with asterisks:\n"
"[codeblock]\n"
"# `char_fx` is the CharFXTransform parameter from `_process_custom_fx()`.\n"
"# See the RichTextEffect documentation for details.\n"
"char_fx.character = ord(\"*\")\n"
"[/codeblock]"
msgstr ""
"எழுத்துக்குறி பயன்படுத்தும் யூனிகோட் குறியீடு. இது வெண்மையாக்காத எழுத்துக்களை மட்டுமே "
"பாதிக்கிறது. [முறை @gdscript.ord] இங்கே பயனுள்ளதாக இருக்கும். எடுத்துக்காட்டாக, "
"பின்வருபவை அனைத்து எழுத்துக்களையும் நட்சத்திரங்களுடன் மாற்றும்:\n"
" [கோட் பிளாக்]\n"
" # `char_fx` என்பது` _ process_custom_fx () இருந்து இலிருந்து charfxtransform "
"அளவுருவாகும்.\n"
" # விவரங்களுக்கு ரிச் டெக்ச்டெஃபெக்ட் ஆவணங்களைக் காண்க.\n"
" char_fx.charter = ord (\"*\")\n"
" [/codeBlock]"

#: docs/CharFXTransform.xml
msgid "The color the character will be drawn with."
msgstr "எழுத்து வண்ணம் வரையப்படும்."

#: docs/CharFXTransform.xml
msgid ""
"The time elapsed since the [RichTextLabel] was added to the scene tree (in "
"seconds). Time stops when the [RichTextLabel] is paused (see [member "
"Node.pause_mode]). Resets when the text in the [RichTextLabel] is changed.\n"
"[b]Note:[/b] Time still passes while the [RichTextLabel] is hidden."
msgstr ""
"[ரிச் டெக்ச்ட்லேபிள்] காட்சி மரத்தில் (நொடிகளில்) சேர்க்கப்பட்டதிலிருந்து நேரம் "
"கடந்துவிட்டது. [ரிச்ச்டெக்ச்ட்லேபிள்] இடைநிறுத்தப்படும்போது நேரம் நிறுத்தப்படும் (பார்க்க "
"[உறுப்பினர் node.pause_mode]). [ரிச் டெக்ச்ட்லேபிள்] இல் உள்ள உரை மாற்றப்படும்போது "
"மீட்டமைக்கிறது.\n"
" ."

#: docs/CharFXTransform.xml
msgid ""
"Contains the arguments passed in the opening BBCode tag. By default, "
"arguments are strings; if their contents match a type such as [bool], [int] "
"or [float], they will be converted automatically. Color codes in the form "
"[code]#rrggbb[/code] or [code]#rgb[/code] will be converted to an opaque "
"[Color]. String arguments may not contain spaces, even if they're quoted. If "
"present, quotes will also be present in the final string.\n"
"For example, the opening BBCode tag [code][example foo=hello bar=true baz=42 "
"color=#ffffff][/code] will map to the following [Dictionary]:\n"
"[codeblock]\n"
"{\"foo\": \"hello\", \"bar\": true, \"baz\": 42, \"color\": Color(1, 1, 1, "
"1)}\n"
"[/codeblock]"
msgstr ""
"தொடக்க பிபிகோட் குறிச்சொல்லில் அனுப்பப்பட்ட வாதங்கள் உள்ளன. இயல்பாக, வாதங்கள் சரங்கள்; "
"அவற்றின் உள்ளடக்கங்கள் [பூல்], [இன்ட்] அல்லது [மிதவை] போன்ற ஒரு வகையுடன் பொருந்தினால், அவை "
"தானாக மாற்றப்படும். படிவத்தில் உள்ள வண்ணக் குறியீடுகள் [குறியீடு] #RRGGBB [/குறியீடு] "
"அல்லது [குறியீடு] #RGB [/குறியீடு] ஒரு ஒளிபுகா [வண்ணம்] ஆக மாற்றப்படும். சரம் வாதங்கள் "
"மேற்கோள் காட்டப்பட்டாலும் கூட இடைவெளிகளைக் கொண்டிருக்காது. இருந்தால், மேற்கோள்கள் இறுதி "
"சரத்தில் இருக்கும்.\n"
" எடுத்துக்காட்டாக, திறக்கும் பிபிகோட் குறிச்சொல் [குறியீடு] [எடுத்துக்காட்டு foo = அலோ "
"பார் = உண்மையான பாச் = 42 வண்ணம் =#ffffff] [/குறியீடு] பின்வரும் [அகராதி] க்கு "
"வரைபடமாக்கும்:\n"
" [கோட் பிளாக்]\n"
" {\"foo\": \"அலோ\", \"பார்\": உண்மை, \"பாச்\": 42, \"வண்ணம்\": நிறம் (1, 1, 1, "
"1)}\n"
" [/codeBlock]"

#: docs/CharFXTransform.xml
msgid "The position offset the character will be drawn with (in pixels)."
msgstr "(பிக்சல்களில்) பாத்திரத்தை ஈடுசெய்யும் நிலை வரையப்படும்."

#: docs/CharFXTransform.xml
msgid ""
"The index of the current character (starting from 0) for this "
"[RichTextEffect] custom block. Setting this property won't affect drawing."
msgstr ""
"இந்த [ரிச்ச்டெக்ச்டெஃபெக்ட்] தனிப்பயன் தொகுதிக்கு தற்போதைய எழுத்தின் குறியீடு (0 இலிருந்து "
"தொடங்குகிறது). இந்த சொத்தை அமைப்பது வரைபடத்தை பாதிக்காது."

#: docs/CharFXTransform.xml
msgid ""
"If [code]true[/code], the character will be drawn. If [code]false[/code], "
"the character will be hidden. Characters around hidden characters will "
"reflow to take the space of hidden characters. If this is not desired, set "
"their [member color] to [code]Color(1, 1, 1, 0)[/code] instead."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், எழுத்து வரையப்படும். [குறியீடு] பொய் [/குறியீடு] "
"என்றால், எழுத்து மறைக்கப்படும். மறைக்கப்பட்ட எழுத்துக்களைச் சுற்றியுள்ள எழுத்துக்கள் "
"மறைக்கப்பட்ட எழுத்துக்களின் இடத்தை எடுக்க பிரதிபலிக்கும். இது விரும்பவில்லை என்றால், "
"அவற்றின் [உறுப்பினர் வண்ணத்தை] [குறியீடு] வண்ணமாக (1, 1, 1, 0) [/குறியீடு] என "
"அமைக்கவும்."

#: docs/CheckBox.xml
msgid "Binary choice user interface widget. See also [CheckButton]."
msgstr "பைனரி தேர்வு பயனர் இடைமுக விட்செட். [செக் பட்டன்] ஐயும் காண்க."

#: docs/CheckBox.xml
msgid ""
"A checkbox allows the user to make a binary choice (choosing only one of two "
"possible options). It's similar to [CheckButton] in functionality, but it "
"has a different appearance. To follow established UX patterns, it's "
"recommended to use CheckBox when toggling it has [b]no[/b] immediate effect "
"on something. For instance, it should be used when toggling it will only do "
"something once a confirmation button is pressed.\n"
"See also [BaseButton] which contains common properties and methods "
"associated with this node."
msgstr ""
"ஒரு தேர்வுப்பெட்டி பயனரை பைனரி தேர்வு செய்ய அனுமதிக்கிறது (இரண்டு சாத்தியமான "
"விருப்பங்களில் ஒன்றை மட்டுமே தேர்வுசெய்கிறது). இது செயல்பாட்டில் [செக் பட்டடனுக்கு] "
"ஒத்ததாக இருக்கிறது, ஆனால் இது வேறுபட்ட தோற்றத்தைக் கொண்டுள்ளது. நிறுவப்பட்ட யுஎக்ச் "
"வடிவங்களைப் பின்பற்ற, தேர்வுப்பெட்டியை மாற்றும்போது அதைப் பயன்படுத்த பரிந்துரைக்கப்படுகிறது "
"[b] [/b] எதையாவது உடனடி விளைவு இல்லை. உதாரணமாக, உறுதிப்படுத்தும் பொத்தானை "
"அழுத்தியவுடன் மட்டுமே அது ஏதாவது செய்யும்.\n"
" இந்த முனையுடன் தொடர்புடைய பொதுவான பண்புகள் மற்றும் முறைகளைக் கொண்ட [பேச்பட்டன்] ஐயும் "
"காண்க."

#: docs/CheckBox.xml
msgid "The [CheckBox] text's font color."
msgstr "[தேர்வுப்பெட்டி] உரையின் எழுத்துரு நிறம்."

#: docs/CheckBox.xml
msgid "The [CheckBox] text's font color when it's disabled."
msgstr "[தேர்வுப்பெட்டி] உரையின் எழுத்துரு முடக்கப்படும்போது."

#: docs/CheckBox.xml
msgid ""
"The [CheckBox] text's font color when it's focused. Only replaces the normal "
"text color of the checkbox. Disabled, hovered, and pressed states take "
"precedence over this color."
msgstr ""
"[தேர்வுப்பெட்டி] உரையின் எழுத்துரு கவனம் செலுத்தும்போது. தேர்வுப்பெட்டியின் சாதாரண உரை "
"நிறத்தை மட்டுமே மாற்றுகிறது. ஊனமுற்றோர், வட்டமிட்ட மற்றும் அழுத்தப்பட்ட மாநிலங்கள் இந்த "
"நிறத்தை விட முன்னுரிமை பெறுகின்றன."

#: docs/CheckBox.xml
msgid "The [CheckBox] text's font color when it's hovered."
msgstr "[தேர்வுப்பெட்டி] உரையின் எழுத்துரு வண்ணம்."

#: docs/CheckBox.xml
msgid "The [CheckBox] text's font color when it's hovered and pressed."
msgstr "[செக்பாக்ச்] உரையின் எழுத்துரு வண்ணம் அதை அழுத்தி அழுத்தும் போது."

#: docs/CheckBox.xml
msgid "The [CheckBox] text's font color when it's pressed."
msgstr "[தேர்வுப்பெட்டி] உரையின் எழுத்துரு அழுத்தும் போது."

#: docs/CheckBox.xml
msgid "The vertical offset used when rendering the check icons (in pixels)."
msgstr "காசோலை ஐகான்களை (பிக்சல்களில்) வழங்கும்போது பயன்படுத்தப்படும் செங்குத்து ஆஃப்செட்."

#: docs/CheckBox.xml
msgid "The separation between the check icon and the text (in pixels)."
msgstr "காசோலை ஐகானுக்கும் உரைக்கும் இடையிலான பிரிப்பு (பிக்சல்களில்)."

#: docs/CheckBox.xml
msgid "The [Font] to use for the [CheckBox] text."
msgstr "[செக்பாக்ச்] உரைக்கு பயன்படுத்த [எழுத்துரு]."

#: docs/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is checked."
msgstr "[தேர்வுப்பெட்டி] சரிபார்க்கப்படும்போது காண்பிக்க காசோலை படவுரு."

#: docs/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is checked and disabled."
msgstr "[தேர்வுப்பெட்டி] சரிபார்க்கப்பட்டு முடக்கப்படும் போது காண்பிக்க காசோலை படவுரு."

#: docs/CheckBox.xml
msgid ""
"If the [CheckBox] is configured as a radio button, the icon to display when "
"the [CheckBox] is checked."
msgstr ""
"[தேர்வுப்பெட்டி] ஒரு ரேடியோ பொத்தானாக கட்டமைக்கப்பட்டிருந்தால், [தேர்வுப்பெட்டி] "
"சரிபார்க்கப்படும்போது காண்பிக்கப்படும் படவுரு."

#: docs/CheckBox.xml
msgid ""
"If the [CheckBox] is configured as a radio button, the icon to display when "
"the [CheckBox] is unchecked."
msgstr ""
"[தேர்வுப்பெட்டி] ரேடியோ பொத்தானாக கட்டமைக்கப்பட்டிருந்தால், [தேர்வுப்பெட்டி] தேர்வு "
"செய்யப்படும்போது காண்பிக்க படவுரு."

#: docs/CheckBox.xml
msgid "The check icon to display when the [CheckBox] is unchecked."
msgstr "[தேர்வுப்பெட்டி] தேர்வு செய்யப்படும்போது காண்பிக்க காசோலை படவுரு."

#: docs/CheckBox.xml
msgid ""
"The check icon to display when the [CheckBox] is unchecked and disabled."
msgstr "[தேர்வுப்பெட்டி] தேர்வு செய்யப்படாத மற்றும் முடக்கப்பட்டால் காண்பிக்க காசோலை படவுரு."

#: docs/CheckBox.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckBox] is disabled."
msgstr "[தேர்வுப்பெட்டி] முடக்கப்பட்டிருக்கும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckBox.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckBox] is focused."
msgstr "[தேர்வுப்பெட்டி] கவனம் செலுத்தும்போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckBox.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckBox] is hovered."
msgstr "[தேர்வுப்பெட்டி] இழுக்கப்படும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckBox.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckBox] is hovered and "
"pressed."
msgstr "[தேர்வுப்பெட்டி] இழுத்து அழுத்தும்போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckBox.xml docs/CheckButton.xml
msgid "The [StyleBox] to display as a background."
msgstr "பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckBox.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckBox] is pressed."
msgstr "[தேர்வுப்பெட்டி] அழுத்தும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckButton.xml
msgid "Checkable button. See also [CheckBox]."
msgstr "சரிபார்க்கக்கூடிய பொத்தான். [தேர்வுப்பெட்டி] ஐயும் காண்க."

#: docs/CheckButton.xml
msgid ""
"CheckButton is a toggle button displayed as a check field. It's similar to "
"[CheckBox] in functionality, but it has a different appearance. To follow "
"established UX patterns, it's recommended to use CheckButton when toggling "
"it has an [b]immediate[/b] effect on something. For instance, it should be "
"used if toggling it enables/disables a setting without requiring the user to "
"press a confirmation button.\n"
"See also [BaseButton] which contains common properties and methods "
"associated with this node."
msgstr ""
"செக் பட்டன் என்பது ஒரு மாற்று பொத்தானாகும். இது செயல்பாட்டில் [தேர்வுப்பெட்டி] ஒத்ததாக "
"இருக்கிறது, ஆனால் இது வேறுபட்ட தோற்றத்தைக் கொண்டுள்ளது. நிறுவப்பட்ட யுஎக்ச் வடிவங்களைப் "
"பின்பற்ற, சரிபார்ப்பு பட்டனைப் பயன்படுத்த பரிந்துரைக்கப்படுகிறது. உதாரணமாக, "
"உறுதிப்படுத்தல் பொத்தானை அழுத்துவதற்கு பயனரை தேவையில்லாமல் ஒரு அமைப்பை இயக்குகிறது/"
"முடக்குகிறது என்றால் அதைப் பயன்படுத்த வேண்டும்.\n"
" இந்த முனையுடன் தொடர்புடைய பொதுவான பண்புகள் மற்றும் முறைகளைக் கொண்ட [பேச்பட்டன்] ஐயும் "
"காண்க."

#: docs/CheckButton.xml
msgid "The [CheckButton] text's font color."
msgstr "[செக் பட்டன்] உரையின் எழுத்துரு நிறம்."

#: docs/CheckButton.xml
msgid "The [CheckButton] text's font color when it's disabled."
msgstr "[செக் பட்டடன்] உரையின் எழுத்துரு முடக்கப்பட்டிருக்கும் போது."

#: docs/CheckButton.xml
msgid ""
"The [CheckButton] text's font color when it's focused. Only replaces the "
"normal text color of the button. Disabled, hovered, and pressed states take "
"precedence over this color."
msgstr ""
"[செக் பட்டன்] உரையின் எழுத்துரு வண்ணம் கவனம் செலுத்தும்போது. பொத்தானின் சாதாரண உரை "
"நிறத்தை மட்டுமே மாற்றுகிறது. ஊனமுற்றோர், வட்டமிட்ட மற்றும் அழுத்தப்பட்ட மாநிலங்கள் இந்த "
"நிறத்தை விட முன்னுரிமை பெறுகின்றன."

#: docs/CheckButton.xml
msgid "The [CheckButton] text's font color when it's hovered."
msgstr "[செக் பட்டன்] உரையின் எழுத்துரு வண்ணம் அது செல்லும்போது."

#: docs/CheckButton.xml
msgid "The [CheckButton] text's font color when it's hovered and pressed."
msgstr "[செக் பட்டன்] உரையின் எழுத்துரு வண்ணம் அது இழுத்து அழுத்தும் போது."

#: docs/CheckButton.xml
msgid "The [CheckButton] text's font color when it's pressed."
msgstr "[செக் பட்டன்] உரையின் எழுத்துரு வண்ணம் அழுத்தும் போது."

#: docs/CheckButton.xml
msgid "The vertical offset used when rendering the toggle icons (in pixels)."
msgstr "மாற்று ஐகான்களை (பிக்சல்களில்) வழங்கும்போது பயன்படுத்தப்படும் செங்குத்து ஆஃப்செட்."

#: docs/CheckButton.xml
msgid "The separation between the toggle icon and the text (in pixels)."
msgstr "மாற்று ஐகானுக்கும் உரைக்கும் இடையிலான பிரிப்பு (பிக்சல்களில்)."

#: docs/CheckButton.xml
msgid "The [Font] to use for the [CheckButton] text."
msgstr "[செக் பட்டன்] உரைக்கு பயன்படுத்த [எழுத்துரு]."

#: docs/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked."
msgstr "[செக் பட்டன்] தேர்வு செய்யப்படாதபோது காண்பிக்க வேண்டிய படவுரு."

#: docs/CheckButton.xml
msgid "The icon to display when the [CheckButton] is unchecked and disabled."
msgstr "[செக் பட்டன்] தேர்வு செய்யப்படாத மற்றும் முடக்கப்பட்டால் காண்பிக்க வேண்டிய படவுரு."

#: docs/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked."
msgstr "[செக் பட்டன்] சரிபார்க்கப்படும்போது காண்பிக்க வேண்டிய படவுரு."

#: docs/CheckButton.xml
msgid "The icon to display when the [CheckButton] is checked and disabled."
msgstr "[செக் பட்டன்] சரிபார்க்கப்பட்டு முடக்கப்படும் போது காண்பிக்க வேண்டிய படவுரு."

#: docs/CheckButton.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckButton] is disabled."
msgstr "[செக் பட்டன்] முடக்கப்பட்டிருக்கும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckButton.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckButton] is focused."
msgstr "[செக் பட்டன்] கவனம் செலுத்தும்போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckButton.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckButton] is hovered."
msgstr "[செக் பட்டன்] இழுக்கப்படும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckButton.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckButton] is hovered "
"and pressed."
msgstr "[செக் பட்டன்] வட்டமிட்டு அழுத்தும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CheckButton.xml
msgid ""
"The [StyleBox] to display as a background when the [CheckButton] is pressed."
msgstr "[செக் பட்டன்] அழுத்தும் போது பின்னணியாகக் காண்பிக்க [ச்டைல் பாக்ச்]."

#: docs/CircleShape2D.xml
msgid "Circular shape for 2D collisions."
msgstr "2 டி மோதல்களுக்கான வட்ட வடிவம்."

#: docs/CircleShape2D.xml
msgid ""
"Circular shape for 2D collisions. This shape is useful for modeling balls or "
"small characters and its collision detection with everything else is very "
"fast."
msgstr ""
"2 டி மோதல்களுக்கான வட்ட வடிவம். இந்த வடிவம் பந்துகள் அல்லது சிறிய எழுத்துக்களை மாடலிங் "
"செய்வதற்கு பயனுள்ளதாக இருக்கும், மேலும் எல்லாவற்றையும் கொண்டு அதன் மோதல் கண்டறிதல் மிக "
"வேகமாக உள்ளது."

#: docs/CircleShape2D.xml
msgid "The circle's radius."
msgstr "வட்டத்தின் ஆரம்."

#: docs/ClassDB.xml
msgid "Class information repository."
msgstr "வகுப்பு செய்தி களஞ்சியம்."

#: docs/ClassDB.xml
msgid "Provides access to metadata stored for every available class."
msgstr ""
"கிடைக்கக்கூடிய ஒவ்வொரு வகுப்பிற்கும் சேமிக்கப்பட்ட மெட்டாடேட்டாவிற்கான அணுகலை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns [code]true[/code] if you can instance objects from the specified "
"[code]class[/code], [code]false[/code] in other case."
msgstr ""
"[குறியீடு] உண்மையான [/குறியீடு] ஐத் தருகிறது, மற்ற விசயத்தில் குறிப்பிட்ட [குறியீடு] "
"வகுப்பு [/குறியீடு], [குறியீடு] தவறான [/குறியீடு] இலிருந்து பொருள்களை நீங்கள் நிகழ்த்த "
"முடிந்தால்."

#: docs/ClassDB.xml
msgid "Returns whether the specified [code]class[/code] is available or not."
msgstr ""
"குறிப்பிட்ட [குறியீடு] வகுப்பு [/குறியீடு] கிடைக்குமா இல்லையா என்பதை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns a category associated with the class for use in documentation and "
"the Asset Library. Debug mode required."
msgstr ""
"ஆவணங்கள் மற்றும் சொத்து நூலகத்தில் பயன்படுத்த வகுப்போடு தொடர்புடைய ஒரு வகையை "
"வழங்குகிறது. பிழைத்திருத்த முறை தேவை."

#: docs/ClassDB.xml
msgid ""
"Returns an array with all the keys in [code]enum[/code] of [code]class[/"
"code] or its ancestry."
msgstr ""
"[குறியீடு] வகுப்பின் [/குறியீடு] அல்லது அதன் வம்சாவளியின் [குறியீடு] enum [/code] இல் "
"உள்ள அனைத்து விசைகளுடனும் ஒரு வரிசையை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns an array with all the enums of [code]class[/code] or its ancestry."
msgstr ""
"[குறியீடு] வகுப்பு [/குறியீடு] அல்லது அதன் வம்சாவளியின் அனைத்து கணக்குகளுடனும் ஒரு "
"வரிசையை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns the value of the integer constant [code]name[/code] of [code]class[/"
"code] or its ancestry. Always returns 0 when the constant could not be found."
msgstr ""
"[குறியீடு] வகுப்பின் [/குறியீடு] அல்லது அதன் வம்சாவளியின் முழு எண் மாறிலி [குறியீடு] "
"பெயர் [/குறியீடு] மதிப்பை வழங்குகிறது. மாறிலியைக் கண்டுபிடிக்க முடியாதபோது எப்போதும் "
"0 ஐத் தருகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns which enum the integer constant [code]name[/code] of [code]class[/"
"code] or its ancestry belongs to."
msgstr ""
"[குறியீடு] வகுப்பின் [/குறியீடு] அல்லது அதன் வம்சாவளி சொந்தமானது என்ற முழு எண் மாறிலி "
"[குறியீடு] பெயர் [/குறியீடு] ஐக் கணக்கிடுகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns an array with the names all the integer constants of [code]class[/"
"code] or its ancestry."
msgstr ""
"[குறியீடு] வகுப்பின் [/குறியீடு] அல்லது அதன் வம்சாவளியின் அனைத்து முழு எண் மாறிலிகள் "
"பெயர்களுடன் ஒரு வரிசையை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns an array with all the methods of [code]class[/code] or its ancestry "
"if [code]no_inheritance[/code] is [code]false[/code]. Every element of the "
"array is a [Dictionary] with the following keys: [code]args[/code], "
"[code]default_args[/code], [code]flags[/code], [code]id[/code], [code]name[/"
"code], [code]return: (class_name, hint, hint_string, name, type, usage)[/"
"code].\n"
"[b]Note:[/b] In exported release builds the debug info is not available, so "
"the returned dictionaries will contain only method names."
msgstr ""
". வரிசையின் ஒவ்வொரு உறுப்புகளும் பின்வரும் விசைகளுடன் [அகராதி] ஆகும்: [குறியீடு] ஆர்க்ச் "
"[/குறியீடு], [குறியீடு] இயல்புநிலை_ஆர்க்ச் [/குறியீடு], [குறியீடு] கொடிகள் [/"
"குறியீடு], [குறியீடு], [குறியீடு] பெயர் [/குறியீடு], [குறியீடு] திரும்ப: "
"(வகுப்பு_நேம், இன்ட், இன்ட்_ச்ட்ரிங், பெயர், வகை, பயன்பாடு, வகை, பயன்பாடு].\n"
" [b] குறிப்பு: [/b] ஏற்றுமதி செய்யப்பட்ட வெளியீட்டில் பிழைத்திருத்த செய்தி கிடைக்கவில்லை, "
"எனவே திரும்பிய அகராதிகளில் முறை பெயர்கள் மட்டுமே இருக்கும்."

#: docs/ClassDB.xml
msgid ""
"Returns the value of [code]property[/code] of [code]class[/code] or its "
"ancestry."
msgstr ""
"[குறியீடு] வகுப்பின் [/குறியீடு] அல்லது அதன் வம்சாவளியின் [குறியீடு] சொத்தின் [/"
"குறியீடு] மதிப்பை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns an array with all the properties of [code]class[/code] or its "
"ancestry if [code]no_inheritance[/code] is [code]false[/code]."
msgstr ""
"Returns an array with அனைத்தும் the பண்புகள் of [code]class[/code] or its "
"ancestry if [code]no_inheritance[/code] is [code]false[/code]."

#: docs/ClassDB.xml
msgid ""
"Returns the [code]signal[/code] data of [code]class[/code] or its ancestry. "
"The returned value is a [Dictionary] with the following keys: [code]args[/"
"code], [code]default_args[/code], [code]flags[/code], [code]id[/code], "
"[code]name[/code], [code]return: (class_name, hint, hint_string, name, type, "
"usage)[/code]."
msgstr ""
"[குறியீடு] சமிக்ஞை [/குறியீடு] தரவை [குறியீடு] வகுப்பு [/குறியீடு] அல்லது அதன் "
"வம்சாவளியை வழங்குகிறது. திரும்பிய மதிப்பு பின்வரும் விசைகளுடன் ஒரு [அகராதி] ஆகும்: "
"[குறியீடு] ஆர்க்ச் [/குறியீடு], [குறியீடு] இயல்புநிலை_ஆர்க்ச் [/குறியீடு], [குறியீடு] "
"கொடிகள் [/குறியீடு], [குறியீடு], [குறியீடு] பெயர் [/குறியீடு], [குறியீடு] திரும்ப: "
"(வகுப்பு_நாம், இன்ட், இன்ட்_ச்ட்ரிங், பெயர், பயன்பாடு, பயன்பாடு, வகை, பயன்பாடு]."

#: docs/ClassDB.xml
msgid ""
"Returns an array with all the signals of [code]class[/code] or its ancestry "
"if [code]no_inheritance[/code] is [code]false[/code]. Every element of the "
"array is a [Dictionary] as described in [method class_get_signal]."
msgstr ""
". [முறை class_get_signal] இல் விவரிக்கப்பட்டுள்ளபடி வரிசையின் ஒவ்வொரு உறுப்பு "
"[அகராதி] ஆகும்."

#: docs/ClassDB.xml
msgid ""
"Returns whether [code]class[/code] or its ancestry has an enum called "
"[code]name[/code] or not."
msgstr ""
"[குறியீடு] வகுப்பு [/குறியீடு] அல்லது அதன் வம்சாவளியில் [குறியீடு] பெயர் [/குறியீடு] "
"எனப்படும் ஒரு enum இருக்கிறதா இல்லையா என்பதை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns whether [code]class[/code] or its ancestry has an integer constant "
"called [code]name[/code] or not."
msgstr ""
"[குறியீடு] வகுப்பு [/குறியீடு] அல்லது அதன் வம்சாவளியில் [குறியீடு] பெயர் [/குறியீடு] "
"எனப்படும் முழு எண் மாறிலி உள்ளதா இல்லையா என்பதை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns whether [code]class[/code] (or its ancestry if [code]no_inheritance[/"
"code] is [code]false[/code]) has a method called [code]method[/code] or not."
msgstr ""
"Returns whether [code]class[/code] (or its ancestry if [code]no_inheritance[/"
"code] is [code]false[/code]) has a method called [code]method[/code] or not."

#: docs/ClassDB.xml
msgid ""
"Returns whether [code]class[/code] or its ancestry has a signal called "
"[code]signal[/code] or not."
msgstr ""
"[குறியீடு] வகுப்பு [/குறியீடு] அல்லது அதன் வம்சாவளியில் [குறியீடு] சமிக்ஞை [/குறியீடு] "
"எனப்படும் சமிக்ஞை உள்ளதா இல்லையா என்பதை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Sets [code]property[/code] value of [code]class[/code] to [code]value[/code]."
msgstr ""
"[குறியீடு] சொத்து [/குறியீடு] [குறியீடு] வகுப்பின் [/குறியீடு] மதிப்பை [குறியீடு] "
"மதிப்பு [/குறியீடு] என அமைக்கிறது."

#: docs/ClassDB.xml
msgid "Returns the names of all the classes available."
msgstr "கிடைக்கக்கூடிய அனைத்து வகுப்புகளின் பெயர்களையும் வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns the names of all the classes that directly or indirectly inherit "
"from [code]class[/code]."
msgstr ""
"[குறியீடு] வகுப்பிலிருந்து நேரடியாகவோ அல்லது மறைமுகமாகவோ பெறும் அனைத்து வகுப்புகளின் "
"பெயர்களையும் வழங்குகிறது [/குறியீடு]."

#: docs/ClassDB.xml
msgid "Returns the parent class of [code]class[/code]."
msgstr "[குறியீடு] வகுப்பின் பெற்றோர் வகுப்பை வழங்குகிறது [/குறியீடு]."

#: docs/ClassDB.xml
msgid "Creates an instance of [code]class[/code]."
msgstr "[குறியீடு] வகுப்பின் [/குறியீடு] ஒரு உதாரணத்தை உருவாக்குகிறது."

#: docs/ClassDB.xml
msgid "Returns whether this [code]class[/code] is enabled or not."
msgstr "இந்த [குறியீடு] வகுப்பு [/குறியீடு] இயக்கப்பட்டதா இல்லையா என்பதை வழங்குகிறது."

#: docs/ClassDB.xml
msgid ""
"Returns whether [code]inherits[/code] is an ancestor of [code]class[/code] "
"or not."
msgstr ""
"[குறியீடு] மரபு [/குறியீடு] [குறியீடு] வகுப்பின் [/குறியீடு] மூதாதையர் இல்லையா என்பதை "
"வழங்குகிறது."

#: docs/ClippedCamera.xml
msgid "A [Camera] that includes collision."
msgstr "மோதலை உள்ளடக்கிய ஒரு [கேமரா]."

#: docs/ClippedCamera.xml
msgid ""
"This node extends [Camera] to add collisions with [Area] and/or "
"[PhysicsBody] nodes. The camera cannot move through colliding objects."
msgstr ""
"[பகுதி] மற்றும்/அல்லது [இயற்பியல் பாடி] முனைகளுடன் மோதல்களைச் சேர்க்க இந்த முனை [கேமரா] "
"நீட்டிக்கிறது. மோதும் பொருள்களை வழியாக கேமராவால் நகர்த்த முடியாது."

#: docs/ClippedCamera.xml
msgid ""
"Adds a collision exception so the camera does not collide with the specified "
"node."
msgstr "மோதல் விதிவிலக்கைச் சேர்க்கிறது, எனவே கேமரா குறிப்பிட்ட முனையுடன் மோதாது."

#: docs/ClippedCamera.xml
msgid ""
"Adds a collision exception so the camera does not collide with the specified "
"[RID]."
msgstr "மோதல் விதிவிலக்கைச் சேர்க்கிறது, எனவே கேமரா குறிப்பிட்ட [RID] உடன் மோதாது."

#: docs/ClippedCamera.xml
msgid "Removes all collision exceptions."
msgstr "அனைத்து மோதல் விதிவிலக்குகளையும் நீக்குகிறது."

#: docs/ClippedCamera.xml
msgid "Returns the distance the camera has been offset due to a collision."
msgstr "மோதல் காரணமாக கேமரா ஈடுசெய்யப்பட்ட தூரத்தை வழங்குகிறது."

#: docs/ClippedCamera.xml
msgid ""
"Returns [code]true[/code] if the specified bit index is on.\n"
"[b]Note:[/b] Bit indices range from 0-19."
msgstr ""
"குறிப்பிட்ட பிட் குறியீடு இயக்கப்பட்டிருந்தால் [குறியீடு] உண்மை [/குறியீடு] ஐ "
"வழங்குகிறது.\n"
" [b] குறிப்பு: [/b] பிட் குறியீடுகள் 0-19 முதல்."

#: docs/ClippedCamera.xml
msgid "Removes a collision exception with the specified node."
msgstr "குறிப்பிட்ட முனையுடன் மோதல் விதிவிலக்கை நீக்குகிறது."

#: docs/ClippedCamera.xml
msgid "Removes a collision exception with the specified [RID]."
msgstr "குறிப்பிட்ட [RID] உடன் மோதல் விதிவிலக்கை நீக்குகிறது."

#: docs/ClippedCamera.xml
msgid ""
"Sets the specified bit index to the [code]value[/code].\n"
"[b]Note:[/b] Bit indices range from 0-19."
msgstr ""
"குறிப்பிட்ட பிட் குறியீட்டை [குறியீடு] மதிப்புக்கு [/குறியீடு] அமைக்கிறது.\n"
" [b] குறிப்பு: [/b] பிட் குறியீடுகள் 0-19 முதல்."

#: docs/ClippedCamera.xml
msgid "If [code]true[/code], the camera stops on contact with [Area]s."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், கேமரா [பகுதி] உடன் தொடர்பில் நிற்கிறது."

#: docs/ClippedCamera.xml
msgid "If [code]true[/code], the camera stops on contact with [PhysicsBody]s."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், [இயற்பியல் பாடி] கள் தொடர்பில் கேமரா நிறுத்தப்படும்."

#: docs/ClippedCamera.xml
msgid ""
"The camera's collision mask. Only objects in at least one collision layer "
"matching the mask will be detected. See [url=https://docs.rebeltoolbox.com/"
"en/latest/tutorials/physics/physics_introduction.html#collision-layers-and-"
"masks]Collision layers and masks[/url] in the documentation for more "
"information."
msgstr ""
"கேமராவின் மோதல் முகமூடி. முகமூடியுடன் பொருந்தக்கூடிய குறைந்தது ஒரு மோதல் அடுக்கில் "
"உள்ள பொருள்கள் மட்டுமே கண்டறியப்படும். [Url = https: //docs.rebeltoolbox.com/en/"
"latest/tutorials/physics/physics_introduction.html#collision-layers-and-"
"mass] மோதல் அடுக்குகள் மற்றும் முகமூடிகள் [/url] ஐக் காண்க."

#: docs/ClippedCamera.xml
msgid ""
"The camera's collision margin. The camera can't get closer than this "
"distance to a colliding object."
msgstr ""
"கேமராவின் மோதல் விளிம்பு. மோதும் பொருளுக்கு இந்த தூரத்தை விட கேமரா நெருங்க முடியாது."

#: docs/ClippedCamera.xml
msgid "The camera's process callback. See [enum ProcessMode]."
msgstr "கேமராவின் செயல்முறை கால்பேக். [Enum processmode] ஐப் பார்க்கவும்."

#: docs/CollisionObject.xml
msgid "Base node for collision objects."
msgstr "மோதல் பொருள்களுக்கான அடிப்படை முனை."

#: docs/CollisionObject.xml
msgid ""
"CollisionObject is the base class for physics objects. It can hold any "
"number of collision [Shape]s. Each shape must be assigned to a [i]shape "
"owner[/i]. The CollisionObject can have any number of shape owners. Shape "
"owners are not nodes and do not appear in the editor, but are accessible "
"through code using the [code]shape_owner_*[/code] methods."
msgstr ""
"COLISIONOBJECT என்பது இயற்பியல் பொருள்களுக்கான அடிப்படை வகுப்பு. இது எந்தவொரு "
"மோதலையும் [வடிவம்] வைத்திருக்க முடியும். ஒவ்வொரு வடிவமும் ஒரு [i] வடிவ "
"உரிமையாளருக்கு ஒதுக்கப்பட வேண்டும் [/i]. மோதல் எந்தவொரு வடிவ உரிமையாளர்களையும் "
"கொண்டிருக்கலாம். வடிவ உரிமையாளர்கள் முனைகள் அல்ல, அவை எடிட்டரில் தோன்றாது, ஆனால் "
"[குறியீடு] வடிவம்_ உரிமையாளர் _*[/குறியீடு] முறைகளைப் பயன்படுத்தி குறியீடு மூலம் "
"அணுகக்கூடியவை."

#: docs/CollisionObject.xml
msgid ""
"Receives unhandled [InputEvent]s. [code]position[/code] is the location in "
"world space of the mouse pointer on the surface of the shape with index "
"[code]shape_idx[/code] and [code]normal[/code] is the normal vector of the "
"surface at that point. Connect to the [signal input_event] signal to easily "
"pick up these events."
msgstr ""
"தடையற்ற [உள்நோக்கி] கள் பெறுகின்றன. . இந்த நிகழ்வுகளை எளிதாக எடுக்க [சிக்னல் "
"உள்ளீடு_வென்ட்] சமிக்ஞையுடன் இணைக்கவும்."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"Creates a new shape owner for the given object. Returns [code]owner_id[/"
"code] of the new owner for future reference."
msgstr ""
"கொடுக்கப்பட்ட பொருளுக்கு புதிய வடிவ உரிமையாளரை உருவாக்குகிறது. எதிர்கால "
"குறிப்புக்காக புதிய உரிமையாளரின் [குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] ஐ "
"வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"Returns whether or not the specified [code]bit[/code] of the [member "
"collision_layer] is set."
msgstr ""
"[உறுப்பினர் மோதல்_லேயர்] இன் குறிப்பிட்ட [குறியீடு] பிட் [/குறியீடு] அமைக்கப்பட்டதா "
"இல்லையா என்பதை வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"Returns whether or not the specified [code]bit[/code] of the [member "
"collision_mask] is set."
msgstr ""
"[உறுப்பினர் மோதல்_மாச்க்] இன் குறிப்பிட்ட [குறியீடு] பிட் [/குறியீடு] அமைக்கப்பட்டதா "
"இல்லையா என்பதை வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Returns the object's [RID]."
msgstr "பொருளின் [RID] ஐ வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"Returns an [Array] of [code]owner_id[/code] identifiers. You can use these "
"ids in other methods that take [code]owner_id[/code] as an argument."
msgstr ""
"[குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] அடையாளங்காட்டிகளின் [வரிசை] ஐ வழங்குகிறது. "
"[குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] ஐ ஒரு வாதமாக எடுத்துக் கொள்ளும் பிற முறைகளில் "
"இந்த ஐடிகளை நீங்கள் பயன்படுத்தலாம்."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "If [code]true[/code], the shape owner and its shapes are disabled."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், வடிவ உரிமையாளரும் அதன் வடிவங்களும் "
"முடக்கப்பட்டுள்ளன."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Removes the given shape owner."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரை நீக்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"If [code]value[/code] is [code]true[/code], sets the specified [code]bit[/"
"code] in the the [member collision_layer].\n"
"If [code]value[/code] is [code]false[/code], clears the specified [code]bit[/"
"code] in the the [member collision_layer]."
msgstr ""
"[குறியீடு] மதிப்பு [/குறியீடு] [குறியீடு] உண்மை [/குறியீடு] என்றால், [உறுப்பினர் "
"மோதல்_லேயர்] இல் குறிப்பிட்ட [குறியீடு] பிட் [/குறியீடு] ஐ அமைக்கிறது.\n"
" [குறியீடு] மதிப்பு [/குறியீடு] [குறியீடு] தவறானது [/குறியீடு] என்றால், [உறுப்பினர் "
"மோதல்_லேயர்] இல் குறிப்பிட்ட [குறியீடு] பிட் [/குறியீடு] ஐ அழிக்கிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"If [code]value[/code] is [code]true[/code], sets the specified [code]bit[/"
"code] in the the [member collision_mask].\n"
"If [code]value[/code] is [code]false[/code], clears the specified [code]bit[/"
"code] in the the [member collision_mask]."
msgstr ""
".\n"
" ."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Returns the [code]owner_id[/code] of the given shape."
msgstr "கொடுக்கப்பட்ட வடிவத்தின் [குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] ஐ வழங்குகிறது."

#: docs/CollisionObject.xml
msgid "Adds a [Shape] to the shape owner."
msgstr "வடிவ உரிமையாளருக்கு [வடிவம்] சேர்க்கிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Removes all shapes from the shape owner."
msgstr "வடிவ உரிமையாளரிடமிருந்து அனைத்து வடிவங்களையும் நீக்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Returns the parent object of the given shape owner."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரின் பெற்றோர் பொருளை வழங்குகிறது."

#: docs/CollisionObject.xml
msgid "Returns the [Shape] with the given id from the given shape owner."
msgstr ""
"கொடுக்கப்பட்ட வடிவ உரிமையாளரிடமிருந்து கொடுக்கப்பட்ட ஐடியுடன் [வடிவத்தை] வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Returns the number of shapes the given shape owner contains."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரைக் கொண்ட வடிவங்களின் எண்ணிக்கையை வழங்குகிறது."

#: docs/CollisionObject.xml
msgid ""
"Returns the child index of the [Shape] with the given id from the given "
"shape owner."
msgstr ""
"கொடுக்கப்பட்ட வடிவ உரிமையாளரிடமிருந்து கொடுக்கப்பட்ட ஐடியுடன் [வடிவத்தின்] குழந்தை "
"குறியீட்டை வழங்குகிறது."

#: docs/CollisionObject.xml
msgid "Returns the shape owner's [Transform]."
msgstr "வடிவ உரிமையாளரின் [உருமாற்றம்] ஐ வழங்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "Removes a shape from the given shape owner."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரிடமிருந்து ஒரு வடிவத்தை நீக்குகிறது."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid "If [code]true[/code], disables the given shape owner."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், கொடுக்கப்பட்ட வடிவ உரிமையாளரை முடக்குகிறது."

#: docs/CollisionObject.xml
msgid "Sets the [Transform] of the given shape owner."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரின் [உருமாற்றத்தை] அமைக்கிறது."

#: docs/CollisionObject.xml
msgid ""
"The physics layers this CollisionObject3D is in. Collision objects can exist "
"in one or more of 32 different layers. See also [member collision_mask].\n"
"[b]Note:[/b] A contact is detected if object A is in any of the layers that "
"object B scans, or object B is in any layers that object A scans. See "
"[url=https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] in the documentation for more information."
msgstr ""
"இந்த மோதல் ஆப்செக்ட் 3 டி இயற்பியல் அடுக்குகள். மோதல் பொருள்கள் ஒன்று அல்லது அதற்கு மேற்பட்ட "
"32 வெவ்வேறு அடுக்குகளில் இருக்கலாம். [உறுப்பினர் மோதல்_மாச்க்] ஐயும் காண்க.\n"
" . [Url = https: //docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-mass] மோதல் அடுக்குகள் மற்றும் "
"முகமூடிகள் [/url] ஐக் காண்க."

#: docs/CollisionObject.xml
msgid ""
"The physics layers this CollisionObject3D scans. Collision objects can scan "
"one or more of 32 different layers. See also [member collision_layer].\n"
"[b]Note:[/b] A contact is detected if object A is in any of the layers that "
"object B scans, or object B is in any layers that object A scans. See "
"[url=https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] in the documentation for more information."
msgstr ""
"இயற்பியல் இந்த மோதல் ஆப்செக்ட் 3 டி ச்கேன்களை அடுக்குகிறது. மோதல் பொருள்கள் 32 வெவ்வேறு "
"அடுக்குகளில் ஒன்று அல்லது அதற்கு மேற்பட்டவற்றை ச்கேன் செய்யலாம். [உறுப்பினர் மோதல்_லேயர்] "
"ஐயும் காண்க.\n"
" . [Url = https: //docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-mass] மோதல் அடுக்குகள் மற்றும் "
"முகமூடிகள் [/url] ஐக் காண்க."

#: docs/CollisionObject.xml
msgid ""
"If [code]true[/code], the [CollisionObject] will continue to receive input "
"events as the mouse is dragged across its shapes."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், சுட்டி அதன் வடிவங்களில் இழுக்கப்படுவதால் "
"[COLLISIONOBJECT] உள்ளீட்டு நிகழ்வுகளை தொடர்ந்து பெறும்."

#: docs/CollisionObject.xml docs/CollisionObject2D.xml
msgid ""
"If [code]true[/code], this object is pickable. A pickable object can detect "
"the mouse pointer entering/leaving, and if the mouse is inside it, report "
"input events. Requires at least one [member collision_layer] bit to be set."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், இந்த பொருள் எடுக்கக்கூடியது. தேர்ந்தெடுக்கக்கூடிய "
"பொருள் சுட்டி சுட்டிக்காட்டி நுழைவதை/வெளியேறுவதைக் கண்டறிய முடியும், மேலும் சுட்டி "
"அதற்குள் இருந்தால், உள்ளீட்டு நிகழ்வுகளைப் புகாரளிக்கவும். குறைந்தது ஒரு [உறுப்பினர் "
"மோதல்_லேயர்] பிட் அமைக்கப்பட வேண்டும்."

#: docs/CollisionObject.xml
msgid ""
"Emitted when the object receives an unhandled [InputEvent]. [code]position[/"
"code] is the location in world space of the mouse pointer on the surface of "
"the shape with index [code]shape_idx[/code] and [code]normal[/code] is the "
"normal vector of the surface at that point."
msgstr "பொருள் ஒரு தடையற்ற [உள்ளுணர்வு] பெறும்போது உமிழப்படும். ."

#: docs/CollisionObject.xml
msgid "Emitted when the mouse pointer enters any of this object's shapes."
msgstr "சுட்டி சுட்டிக்காட்டி இந்த பொருளின் வடிவங்களில் ஏதேனும் நுழையும் போது உமிழப்படும்."

#: docs/CollisionObject.xml
msgid "Emitted when the mouse pointer exits all this object's shapes."
msgstr "சுட்டி சுட்டிக்காட்டி இந்த பொருளின் வடிவங்கள் அனைத்தையும் வெளியேறும்போது உமிழும்."

#: docs/CollisionObject2D.xml
msgid "Base node for 2D collision objects."
msgstr "2 டி மோதல் பொருள்களுக்கான அடிப்படை முனை."

#: docs/CollisionObject2D.xml
msgid ""
"CollisionObject2D is the base class for 2D physics objects. It can hold any "
"number of 2D collision [Shape2D]s. Each shape must be assigned to a [i]shape "
"owner[/i]. The CollisionObject2D can have any number of shape owners. Shape "
"owners are not nodes and do not appear in the editor, but are accessible "
"through code using the [code]shape_owner_*[/code] methods.\n"
"[b]Note:[/b] Only collisions between objects within the same canvas "
"([Viewport] canvas or [CanvasLayer]) are supported. The behavior of "
"collisions between objects in different canvases is undefined."
msgstr ""
"CollisionObject2d என்பது 2D இயற்பியல் பொருள்களுக்கான அடிப்படை வகுப்பாகும். இது 2 டி "
"மோதல் [Shape2d] களை வைத்திருக்க முடியும். ஒவ்வொரு வடிவமும் ஒரு [i] வடிவ "
"உரிமையாளருக்கு ஒதுக்கப்பட வேண்டும் [/i]. CollisionObject2d எந்தவொரு வடிவ "
"உரிமையாளர்களையும் கொண்டிருக்கலாம். வடிவ உரிமையாளர்கள் முனைகள் அல்ல, அவை எடிட்டரில் "
"தோன்றாது, ஆனால் [குறியீடு] வடிவம்_ உரிமையாளர் _*[/குறியீடு] முறைகளைப் பயன்படுத்தி "
"குறியீடு மூலம் அணுகக்கூடியவை.\n"
" . வெவ்வேறு கேன்வாச்களில் உள்ள பொருட்களுக்கு இடையிலான மோதல்களின் நடத்தை "
"வரையறுக்கப்படவில்லை."

#: docs/CollisionObject2D.xml
msgid ""
"Accepts unhandled [InputEvent]s. Requires [member input_pickable] to be "
"[code]true[/code]. [code]shape_idx[/code] is the child index of the clicked "
"[Shape2D]. Connect to the [code]input_event[/code] signal to easily pick up "
"these events."
msgstr ""
"[Inputevent] களை ஏற்றுக்கொள்கிறது. [குறியீடு] உண்மை [/குறியீடு] ஆக [உறுப்பினர் "
"உள்ளீடு_பிக்கபிள்] தேவைப்படுகிறது. . இந்த நிகழ்வுகளை எளிதாக எடுக்க [குறியீடு] "
"input_event [/code] சமிக்ஞையுடன் இணைக்கவும்."

#: docs/CollisionObject2D.xml
msgid ""
"Returns the [code]one_way_collision_margin[/code] of the shape owner "
"identified by given [code]owner_id[/code]."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] மூலம் அடையாளம் காணப்பட்ட வடிவ "
"உரிமையாளரின் [குறியீடு] ONE_WAY_COLLISION_MARGIN [/குறியீடு] ஐ வழங்குகிறது."

#: docs/CollisionObject2D.xml
msgid ""
"Returns [code]true[/code] if collisions for the shape owner originating from "
"this [CollisionObject2D] will not be reported to collided with "
"[CollisionObject2D]s."
msgstr ""
"இந்த [collisionObject2d] இலிருந்து தோன்றும் வடிவ உரிமையாளருக்கான மோதல்கள் "
"[CollisionObject2d] s உடன் மோதியதாக தெரிவிக்கப்படாவிட்டால் [குறியீடு] உண்மை [/"
"குறியீடு] வருமானம்."

#: docs/CollisionObject2D.xml
msgid "Adds a [Shape2D] to the shape owner."
msgstr "வடிவ உரிமையாளருக்கு [Shape2D] ஐ சேர்க்கிறது."

#: docs/CollisionObject2D.xml
msgid "Returns the [Shape2D] with the given id from the given shape owner."
msgstr ""
"கொடுக்கப்பட்ட வடிவ உரிமையாளரிடமிருந்து கொடுக்கப்பட்ட ஐடியுடன் [சேப் 2 டி] ஐ "
"வழங்குகிறது."

#: docs/CollisionObject2D.xml
msgid ""
"Returns the child index of the [Shape2D] with the given id from the given "
"shape owner."
msgstr ""
"கொடுக்கப்பட்ட வடிவ உரிமையாளரிடமிருந்து கொடுக்கப்பட்ட ஐடியுடன் [சேப் 2 டி] இன் குழந்தை "
"குறியீட்டை வழங்குகிறது."

#: docs/CollisionObject2D.xml
msgid "Returns the shape owner's [Transform2D]."
msgstr "வடிவ உரிமையாளரின் [உருமாற்றம் 2 டி] ஐ வழங்குகிறது."

#: docs/CollisionObject2D.xml
msgid ""
"If [code]enable[/code] is [code]true[/code], collisions for the shape owner "
"originating from this [CollisionObject2D] will not be reported to collided "
"with [CollisionObject2D]s."
msgstr ""
"If [code]enable[/code] is [code]true[/code], collisions க்கு the வடிவம் "
"உரிமையாளர் originating இருந்து this [CollisionObject2D] will not be reported "
"பெறுநர் collided with [CollisionObject2D]s."

#: docs/CollisionObject2D.xml
msgid ""
"Sets the [code]one_way_collision_margin[/code] of the shape owner identified "
"by given [code]owner_id[/code] to [code]margin[/code] pixels."
msgstr ""
"கொடுக்கப்பட்ட [குறியீடு] உரிமையாளர்_ஐடி [/குறியீடு] மூலம் [குறியீடு] விளிம்பு [/"
"குறியீடு] பிக்சல்களுக்கு அடையாளம் காணப்பட்ட வடிவ உரிமையாளரின் [குறியீடு] "
"ONE_WAY_COLLISION_MARGIN [/குறியீடு] ஐ அமைக்கிறது."

#: docs/CollisionObject2D.xml
msgid "Sets the [Transform2D] of the given shape owner."
msgstr "கொடுக்கப்பட்ட வடிவ உரிமையாளரின் [உருமாற்றம் 2 டி] ஐ அமைக்கிறது."

#: docs/CollisionObject2D.xml
msgid ""
"The physics layers this CollisionObject2D is in. Collision objects can exist "
"in one or more of 32 different layers. See also [member collision_mask].\n"
"[b]Note:[/b] A contact is detected if object A is in any of the layers that "
"object B scans, or object B is in any layers that object A scans. See "
"[url=https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] in the documentation for more information."
msgstr ""
"இந்த மோதல் பதிப்பு 2 டி இயற்பியல் அடுக்குகள். மோதல் பொருள்கள் ஒன்று அல்லது அதற்கு மேற்பட்ட "
"32 வெவ்வேறு அடுக்குகளில் இருக்கலாம். [உறுப்பினர் மோதல்_மாச்க்] ஐயும் காண்க.\n"
" . [Url = https: //docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-mass] மோதல் அடுக்குகள் மற்றும் "
"முகமூடிகள் [/url] ஐக் காண்க."

#: docs/CollisionObject2D.xml
msgid ""
"The physics layers this CollisionObject2D scans. Collision objects can scan "
"one or more of 32 different layers. See also [member collision_layer].\n"
"[b]Note:[/b] A contact is detected if object A is in any of the layers that "
"object B scans, or object B is in any layers that object A scans. See "
"[url=https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] in the documentation for more information."
msgstr ""
"இயற்பியல் அடுக்குகள் இந்த மோதல் பதிப்பு 2 டி ச்கேன். மோதல் பொருள்கள் 32 வெவ்வேறு "
"அடுக்குகளில் ஒன்று அல்லது அதற்கு மேற்பட்டவற்றை ச்கேன் செய்யலாம். [உறுப்பினர் மோதல்_லேயர்] "
"ஐயும் காண்க.\n"
" . [Url = https: //docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html#collision-layers-and-mass] மோதல் அடுக்குகள் மற்றும் "
"முகமூடிகள் [/url] ஐக் காண்க."

#: docs/CollisionObject2D.xml
msgid ""
"Emitted when an input event occurs. Requires [member input_pickable] to be "
"[code]true[/code] and at least one [code]collision_layer[/code] bit to be "
"set. See [method _input_event] for details."
msgstr ""
"உள்ளீட்டு நிகழ்வு நிகழும்போது உமிழும். [குறியீடு] உண்மை [/குறியீடு] மற்றும் குறைந்தது "
"ஒரு [குறியீடு] மோதல்_லேயர் [/குறியீடு] பிட் அமைக்கப்பட வேண்டும். விவரங்களுக்கு [முறை "
"_input_event] ஐப் பார்க்கவும்."

#: docs/CollisionObject2D.xml
msgid ""
"Emitted when the mouse pointer enters any of this object's shapes. Requires "
"[member input_pickable] to be [code]true[/code] and at least one "
"[code]collision_layer[/code] bit to be set."
msgstr ""
"சுட்டி சுட்டிக்காட்டி இந்த பொருளின் வடிவங்களில் ஏதேனும் நுழையும் போது உமிழப்படும். "
"[குறியீடு] உண்மை [/குறியீடு] மற்றும் குறைந்தது ஒரு [குறியீடு] மோதல்_லேயர் [/குறியீடு] "
"பிட் அமைக்கப்பட வேண்டும்."

#: docs/CollisionObject2D.xml
msgid ""
"Emitted when the mouse pointer exits all this object's shapes. Requires "
"[member input_pickable] to be [code]true[/code] and at least one "
"[code]collision_layer[/code] bit to be set."
msgstr ""
"சுட்டி சுட்டிக்காட்டி இந்த பொருளின் வடிவங்கள் அனைத்தையும் வெளியேறும்போது உமிழும். "
"[குறியீடு] உண்மை [/குறியீடு] மற்றும் குறைந்தது ஒரு [குறியீடு] மோதல்_லேயர் [/குறியீடு] "
"பிட் அமைக்கப்பட வேண்டும்."

#: docs/CollisionPolygon.xml
msgid "Editor-only class for defining a collision polygon in 3D space."
msgstr "3 டி இடத்தில் மோதல் பலகோணத்தை வரையறுப்பதற்கான ஆசிரியர் மட்டும் வகுப்பு."

#: docs/CollisionPolygon.xml
msgid ""
"Allows editing a collision polygon's vertices on a selected plane. Can also "
"set a depth perpendicular to that plane. This class is only available in the "
"editor. It will not appear in the scene tree at run-time. Creates a [Shape] "
"for gameplay. Properties modified during gameplay will have no effect."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட விமானத்தில் மோதல் பலகோணத்தின் செங்குத்துகளைத் திருத்த அனுமதிக்கிறது. "
"அந்த விமானத்திற்கு செங்குத்தாக ஒரு ஆழத்தையும் அமைக்கலாம். இந்த வகுப்பு எடிட்டரில் மட்டுமே "
"கிடைக்கிறது. இது ரன்-நேரத்தில் காட்சி மரத்தில் தோன்றாது. விளையாட்டுக்கு ஒரு [வடிவத்தை] "
"உருவாக்குகிறது. விளையாட்டின் போது மாற்றியமைக்கப்பட்ட பண்புகள் எந்த விளைவையும் "
"ஏற்படுத்தாது."

#: docs/CollisionPolygon.xml
msgid ""
"Length that the resulting collision extends in either direction "
"perpendicular to its polygon."
msgstr "இதன் விளைவாக மோதல் அதன் பலகோணத்திற்கு செங்குத்தாக இரு திசையிலும் நீண்டுள்ளது."

#: docs/CollisionPolygon.xml
msgid "If [code]true[/code], no collision will be produced."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், மோதல் எதுவும் தயாரிக்கப்படாது."

#: docs/CollisionPolygon.xml
msgid ""
"The collision margin for the generated [Shape]. See [member Shape.margin] "
"for more details."
msgstr ""
"உருவாக்கப்பட்ட [வடிவம்] மோதல் விளிம்பு. மேலும் விவரங்களுக்கு [உறுப்பினர் வடிவம்.மார்சின்] "
"ஐப் பார்க்கவும்."

#: docs/CollisionPolygon.xml
msgid ""
"Array of vertices which define the polygon.\n"
"[b]Note:[/b] The returned value is a copy of the original. Methods which "
"mutate the size or properties of the return value will not impact the "
"original polygon. To change properties of the polygon, assign it to a "
"temporary variable and make changes before reassigning the [code]polygon[/"
"code] member."
msgstr ""
"பலகோணத்தை வரையறுக்கும் செங்குத்துகளின் வரிசை.\n"
" [b] குறிப்பு: [/b] திரும்பிய மதிப்பு என்பது அசலின் நகலாகும். வருவாய் மதிப்பின் அளவு "
"அல்லது பண்புகளை மாற்றும் முறைகள் அசல் பலகோணத்தை பாதிக்காது. பலகோணத்தின் பண்புகளை மாற்ற, "
"அதை ஒரு தற்காலிக மாறிக்கு ஒதுக்கி, [குறியீடு] பலகோண [/குறியீடு] உறுப்பினரை "
"மறுசீரமைப்பதற்கு முன் மாற்றங்களைச் செய்யுங்கள்."

#: docs/CollisionPolygon2D.xml
msgid "Defines a 2D collision polygon."
msgstr "2 டி மோதல் பலகோணத்தை வரையறுக்கிறது."

#: docs/CollisionPolygon2D.xml
msgid ""
"Provides a 2D collision polygon to a [CollisionObject2D] parent. Polygons "
"can be drawn in the editor or specified by a list of vertices."
msgstr ""
"[CollisionObject2d] பெற்றோருக்கு 2 டி மோதல் பலகோணத்தை வழங்குகிறது. பலகோணங்களை "
"எடிட்டரில் வரையலாம் அல்லது செங்குத்துகளின் பட்டியலால் குறிப்பிடலாம்."

#: docs/CollisionPolygon2D.xml
msgid "Collision build mode. Use one of the [enum BuildMode] constants."
msgstr "மோதல் உருவாக்க முறை. [Enum buildmode] மாறிலிகளில் ஒன்றைப் பயன்படுத்தவும்."

#: docs/CollisionPolygon2D.xml
msgid "If [code]true[/code], no collisions will be detected."
msgstr "[குறியீடு] உண்மை [/குறியீடு] என்றால், மோதல்கள் எதுவும் கண்டறியப்படாது."

#: docs/CollisionPolygon2D.xml
msgid ""
"If [code]true[/code], only edges that face up, relative to "
"[CollisionPolygon2D]'s rotation, will collide with other objects."
msgstr ""
"[குறியீடு] உண்மை [/குறியீடு] என்றால், [COLINSPOLYGON2D] இன் சுழற்சியுடன் "
"ஒப்பிடும்போது, எதிர்கொள்ளும் விளிம்புகள் மட்டுமே மற்ற பொருள்களுடன் மோதுகின்றன."

#: docs/CollisionPolygon2D.xml
msgid ""
"The margin used for one-way collision (in pixels). Higher values will make "
"the shape thicker, and work better for colliders that enter the polygon at a "
"high velocity."
msgstr ""
"ஒரு வழி மோதலுக்கு (பிக்சல்களில்) பயன்படுத்தப்படும் விளிம்பு. அதிக மதிப்புகள் வடிவத்தை "
"தடிமனாக மாற்றும், மேலும் பலகோணத்திற்குள் அதிக வேகத்தில் நுழையும் கோலிடர்களுக்கு சிறப்பாக "
"செயல்படும்."

#: docs/CollisionPolygon2D.xml
msgid ""
"The polygon's list of vertices. The final point will be connected to the "
"first. The returned value is a clone of the [PoolVector2Array], not a "
"reference."
msgstr ""
"பலகோணத்தின் செங்குத்துகளின் பட்டியல். இறுதி புள்ளி முதல் உடன் இணைக்கப்படும். திரும்பிய "
"மதிப்பு [பூல் வெக்டர் 2 வரிசை] இன் நகலி, ஒரு குறிப்பு அல்ல."

#: docs/CollisionPolygon2D.xml
msgid "Collisions will include the polygon and its contained area."
msgstr "மோதல்களில் பலகோணம் மற்றும் அதில் உள்ள பகுதி ஆகியவை அடங்கும்."

#: docs/CollisionPolygon2D.xml
msgid "Collisions will only include the polygon edges."
msgstr "மோதல்களில் பலகோண விளிம்புகள் மட்டுமே இருக்கும்."

#: docs/CollisionShape.xml
msgid "Node that represents collision shape data in 3D space."
msgstr "3D இடத்தில் மோதல் வடிவ தரவைக் குறிக்கும் முனை."

#: docs/CollisionShape.xml
msgid ""
"Editor facility for creating and editing collision shapes in 3D space. You "
"can use this node to represent all sorts of collision shapes, for example, "
"add this to an [Area] to give it a detection shape, or add it to a "
"[PhysicsBody] to create a solid object. [b]IMPORTANT[/b]: this is an Editor-"
"only helper to create shapes, use [method "
"CollisionObject.shape_owner_get_shape] to get the actual shape."
msgstr ""
"3 டி இடத்தில் மோதல் வடிவங்களை உருவாக்குவதற்கும் திருத்துவதற்கும் ஆசிரியர் வசதி. அனைத்து "
"வகையான மோதல் வடிவங்களையும் குறிக்க இந்த முனையைப் பயன்படுத்தலாம், எடுத்துக்காட்டாக, இதை "
"ஒரு கண்டறிதல் வடிவத்தைக் கொடுக்க ஒரு [பகுதியில்] இதைச் சேர்க்கவும் அல்லது ஒரு திடமான "
"பொருளை உருவாக்க [இயற்பியல் பாடி] இல் சேர்க்கவும். ."

#: docs/CollisionShape.xml docs/CollisionShape2D.xml
#: docs/Physics2DDirectBodyState.xml docs/Physics2DDirectSpaceState.xml
#: docs/PhysicsBody.xml docs/PhysicsBody2D.xml docs/PhysicsDirectBodyState.xml
#: docs/PhysicsDirectSpaceState.xml docs/RigidBody.xml docs/Shape.xml
#: docs/Shape2D.xml
msgid ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html"
msgstr ""
"https://docs.rebeltoolbox.com/en/latest/tutorials/physics/"
"physics_introduction.html"

#: docs/CollisionShape.xml
msgid ""
"Sets the collision shape's shape to the addition of all its convexed "
"[MeshInstance] siblings geometry."
msgstr ""
"மோதல் வடிவத்தின் வடிவத்தை அதன் குவிந்த [மெசின்ச்டன்ச்] உடன்பிறப்புகளின் வடிவவியலைச் "
"சேர்ப்பதற்கு அமைக்கிறது."

#: docs/CollisionShape.xml
msgid ""
"If this method exists within a script it will be called whenever the shape "
"resource has been modified."
msgstr ""
"இந்த முறை ஒரு ச்கிரிப்ட்டுக்குள் இருந்தால், வடிவ வளம் மாற்றியமைக்கப்படும்போதெல்லாம் அது "
"அழைக்கப்படும்."

#: docs/CollisionShape.xml
msgid "A disabled collision shape has no effect in the world."
msgstr "ஊனமுற்ற மோதல் வடிவம் உலகில் எந்த விளைவையும் ஏற்படுத்தாது."

#: docs/CollisionShape.xml docs/CollisionShape2D.xml
msgid "The actual shape owned by this collision shape."
msgstr "இந்த மோதல் வடிவத்திற்கு சொந்தமான உண்மையான வடிவம்."

#: docs/CollisionShape2D.xml
msgid "Node that represents collision shape data in 2D space."
msgstr "2 டி இடத்தில் மோதல் வடிவ தரவைக் குறிக்கும் முனை."

#: docs/CollisionShape2D.xml
msgid ""
"Editor facility for creating and editing collision shapes in 2D space. You "
"can use this node to represent all sorts of collision shapes, for example, "
"add this to an [Area2D] to give it a detection shape, or add it to a "
"[PhysicsBody2D] to create a solid object. [b]IMPORTANT[/b]: this is an "
"Editor-only helper to create shapes, use [method "
"CollisionObject2D.shape_owner_get_shape] to get the actual shape."
msgstr ""
"2 டி இடத்தில் மோதல் வடிவங்களை உருவாக்குவதற்கும் திருத்துவதற்கும் ஆசிரியர் வசதி. அனைத்து "
"வகையான மோதல் வடிவங்களையும் குறிக்க இந்த முனையைப் பயன்படுத்தலாம், எடுத்துக்காட்டாக, இதை "
"ஒரு கண்டறிதல் வடிவத்தைக் கொடுக்க [ஏரியா 2 டி] இல் சேர்க்கவும் அல்லது ஒரு திடமான பொருளை "
"உருவாக்க [இயற்பியல் பாடி 2 டி] இல் சேர்க்கவும். ."

#: docs/CollisionShape2D.xml
msgid ""
"A disabled collision shape has no effect in the world. This property should "
"be changed with [method Object.set_deferred]."
msgstr ""
"ஊனமுற்ற மோதல் வடிவம் உலகில் எந்த விளைவையும் ஏற்படுத்தாது. இந்த சொத்தை [முறை "
"பொருள்.செட்_டெஃபெர்டு] மூலம் மாற்ற வேண்டும்."

#: docs/CollisionShape2D.xml
msgid ""
"Sets whether this collision shape should only detect collision on one side "
"(top or bottom)."
msgstr ""
"இந்த மோதல் வடிவம் ஒரு பக்கத்தில் (மேல் அல்லது கீழ்) மோதலை மட்டுமே கண்டறிய வேண்டுமா என்பதை "
"அமைக்கிறது."

#: docs/CollisionShape2D.xml
msgid ""
"The margin used for one-way collision (in pixels). Higher values will make "
"the shape thicker, and work better for colliders that enter the shape at a "
"high velocity."
msgstr ""
"ஒரு வழி மோதலுக்கு (பிக்சல்களில்) பயன்படுத்தப்படும் விளிம்பு. அதிக மதிப்புகள் வடிவத்தை "
"தடிமனாக மாற்றும், மேலும் அதிக வேகத்தில் வடிவத்தை உள்ளிடும் கோலிடர்களுக்கு சிறப்பாக "
"செயல்படும்."

#: docs/Color.xml
msgid "Color in RGBA format using floats on the range of 0 to 1."
msgstr "0 முதல் 1 வரம்பில் மிதவைகளைப் பயன்படுத்தி RGBA வடிவத்தில் வண்ணம்."

#: docs/Color.xml
msgid ""
"A color represented by red, green, blue, and alpha (RGBA) components. The "
"alpha component is often used for opacity. Values are in floating-point and "
"usually range from 0 to 1. Some properties (such as CanvasItem.modulate) may "
"accept values greater than 1 (overbright or HDR colors).\n"
"You can also create a color from standardized color names by using [method "
"@GDScript.ColorN] or directly using the color constants defined here. The "
"standardized color set is based on the [url=https://en.wikipedia.org/wiki/"
"X11_color_names]X11 color names[/url].\n"
"If you want to supply values in a range of 0 to 255, you should use [method "
"@GDScript.Color8].\n"
"[b]Note:[/b] In a boolean context, a Color will evaluate to [code]false[/"
"code] if it's equal to [code]Color(0, 0, 0, 1)[/code] (opaque black). "
"Otherwise, a Color will always evaluate to [code]true[/code].\n"
"[img caption=\"Color constants cheatsheet\"]/img/color_constants.png[/img]"
msgstr ""
"சிவப்பு, பச்சை, நீலம் மற்றும் ஆல்பா (RGBA) கூறுகளால் குறிப்பிடப்படும் வண்ணம். ஆல்பா கூறு "
"பெரும்பாலும் ஒளிபுகாநிலைக்கு பயன்படுத்தப்படுகிறது. மதிப்புகள் மிதக்கும் புள்ளியில் உள்ளன, "
"பொதுவாக 0 முதல் 1 வரை இருக்கும். சில பண்புகள் (canvasitem.modulate போன்றவை) 1 ஐ "
"விட அதிகமான மதிப்புகளை ஏற்றுக்கொள்ளலாம் (ஓவர் பிரைட் அல்லது எச்டிஆர் வண்ணங்கள்).\n"
" [முறை @gdscript.colorn] ஐப் பயன்படுத்தி அல்லது இங்கே வரையறுக்கப்பட்ட வண்ண மாறிலிகளை "
"நேரடியாகப் பயன்படுத்துவதன் மூலம் தரப்படுத்தப்பட்ட வண்ண பெயர்களிலிருந்து ஒரு வண்ணத்தை "
"உருவாக்கலாம். தரப்படுத்தப்பட்ட வண்ண தொகுப்பு [url = https: //en.wikipedia.org/wiki/"
"x11_color_names] x11 வண்ண பெயர்கள் [/url] ஐ அடிப்படையாகக் கொண்டது.\n"
" நீங்கள் 0 முதல் 255 வரை மதிப்புகளை வழங்க விரும்பினால், நீங்கள் [முறை @gdscript.color8] "
"ஐப் பயன்படுத்த வேண்டும்.\n"
" . இல்லையெனில், ஒரு வண்ணம் எப்போதும் [குறியீடு] உண்மை [/குறியீடு] க்கு மதிப்பீடு "
"செய்யும்.\n"
" ."

#: docs/Color.xml
msgid ""
"Constructs a color from an HTML hexadecimal color string in ARGB or RGB "
"format. See also [method @GDScript.ColorN].\n"
"[codeblock]\n"
"# Each of the following creates the same color RGBA(178, 217, 10, 255).\n"
"var c1 = Color(\"#ffb2d90a\") # ARGB format with \"#\".\n"
"var c2 = Color(\"ffb2d90a\") # ARGB format.\n"
"var c3 = Color(\"#b2d90a\") # RGB format with \"#\".\n"
"var c4 = Color(\"b2d90a\") # RGB format.\n"
"[/codeblock]"
msgstr ""
"ARGB அல்லது RGB வடிவத்தில் உஉகுமொ எக்சாடெசிமல் வண்ண சரத்திலிருந்து ஒரு வண்ணத்தை "
"உருவாக்குகிறது. [முறை @gdscript.colorn] ஐயும் காண்க.\n"
" [கோட் பிளாக்]\n"
" # பின்வருவனவற்றில் ஒவ்வொன்றும் ஒரே வண்ண RGBA ஐ உருவாக்குகின்றன (178, 217, 10, 255).\n"
" var c1 = color (\"#ffb2d90a\")#ARGB வடிவம் \"#\" உடன்.\n"
" var c2 = color (\"ffb2d90a\") # argb வடிவம்.\n"
" var c3 = வண்ணம் (\"#B2D90A\")#RGB வடிவமைப்பு \"#\" உடன்.\n"
" var c4 = வண்ணம் (\"B2D90A\") # RGB வடிவம்.\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Constructs a color from a 32-bit integer in RGBA format (each byte "
"represents a color channel).\n"
"[codeblock]\n"
"var c = Color(274) # Similar to Color(0.0, 0.0, 0.004, 0.07)\n"
"[/codeblock]"
msgstr ""
"RGBA வடிவத்தில் 32-பிட் முழு எண்ணிலிருந்து ஒரு வண்ணத்தை உருவாக்குகிறது (ஒவ்வொரு பைட் "
"ஒரு வண்ண சேனலையும் குறிக்கிறது).\n"
" [கோட் பிளாக்]\n"
" var c = வண்ணம் (274) # வண்ணத்திற்கு ஒத்த (0.0, 0.0, 0.004, 0.07)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Constructs a color from RGB values, typically between 0 and 1. Alpha will be "
"1.\n"
"[codeblock]\n"
"var color = Color(0.2, 1.0, 0.7) # Similar to Color8(51, 255, 178, 255)\n"
"[/codeblock]"
msgstr ""
"RGB மதிப்புகளிலிருந்து ஒரு வண்ணத்தை உருவாக்குகிறது, பொதுவாக 0 மற்றும் 1 க்கு இடையில். "
"ஆல்பா 1 ஆக இருக்கும்.\n"
" [கோட் பிளாக்]\n"
" var color = நிறம் (0.2, 1.0, 0.7) # கலர் 8 க்கு ஒத்த (51, 255, 178, 255)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Constructs a color from RGBA values, typically between 0 and 1.\n"
"[codeblock]\n"
"var color = Color(0.2, 1.0, 0.7, 0.8) # Similar to Color8(51, 255, 178, "
"204)\n"
"[/codeblock]"
msgstr ""
"பொதுவாக 0 மற்றும் 1 க்கு இடையில் RGBA மதிப்புகளிலிருந்து ஒரு வண்ணத்தை "
"உருவாக்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var color = நிறம் (0.2, 1.0, 0.7, 0.8) # கலர் 8 க்கு ஒத்த (51, 255, 178, 204)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns a new color resulting from blending this color over another. If the "
"color is opaque, the result is also opaque. The second color may have a "
"range of alpha values.\n"
"[codeblock]\n"
"var bg = Color(0.0, 1.0, 0.0, 0.5) # Green with alpha of 50%\n"
"var fg = Color(1.0, 0.0, 0.0, 0.5) # Red with alpha of 50%\n"
"var blended_color = bg.blend(fg) # Brown with alpha of 75%\n"
"[/codeblock]"
msgstr ""
"இந்த நிறத்தை மற்றொன்றுக்கு மேல் கலப்பதன் விளைவாக ஒரு புதிய வண்ணத்தை வழங்குகிறது. வண்ணம் "
"ஒளிபுகாதாக இருந்தால், இதன் விளைவாக ஒளிபுகா. இரண்டாவது நிறத்தில் ஆல்பா மதிப்புகள் "
"இருக்கலாம்.\n"
" [கோட் பிளாக்]\n"
" var bg = நிறம் (0.0, 1.0, 0.0, 0.5) # 50% ஆல்பாவுடன் பச்சை\n"
" var fg = வண்ணம் (1.0, 0.0, 0.0, 0.5) # 50% ஆல்பாவுடன் சிவப்பு\n"
" var claned_color = bg.blend (fg) # 75% ஆல்பாவுடன் பழுப்பு\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the most contrasting color.\n"
"[codeblock]\n"
"var c = Color(0.3, 0.4, 0.9)\n"
"var contrasted_color = c.contrasted() # Equivalent to RGBA(204, 229, 102, "
"255)\n"
"[/codeblock]"
msgstr ""
"மிகவும் மாறுபட்ட வண்ணத்தை வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var c = நிறம் (0.3, 0.4, 0.9)\n"
" var wonthed_color = c.contrasted () # RGBA க்கு சமம் (204, 229, 102, 255)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns a new color resulting from making this color darker by the specified "
"percentage (ratio from 0 to 1).\n"
"[codeblock]\n"
"var green = Color(0.0, 1.0, 0.0)\n"
"var darkgreen = green.darkened(0.2) # 20% darker than regular green\n"
"[/codeblock]"
msgstr ""
"குறிப்பிட்ட சதவீதத்தால் இந்த வண்ணத்தை இருண்டதாக மாற்றுவதன் விளைவாக ஒரு புதிய வண்ணத்தை "
"வழங்குகிறது (விகிதம் 0 முதல் 1 வரை).\n"
" [கோட் பிளாக்]\n"
" var பச்சை = நிறம் (0.0, 1.0, 0.0)\n"
" var கரும்பச்சை = green.Darkened (0.2) # 20% வழக்கமான பச்சை நிறத்தை விட இருண்டது\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Constructs a color from an HSV profile. [code]h[/code], [code]s[/code], and "
"[code]v[/code] are values between 0 and 1.\n"
"[codeblock]\n"
"var c = Color.from_hsv(0.58, 0.5, 0.79, 0.8) # Equivalent to HSV(210, 50, "
"79, 0.8) or Color8(100, 151, 201, 0.8)\n"
"[/codeblock]"
msgstr ""
"HSV சுயவிவரத்திலிருந்து ஒரு வண்ணத்தை உருவாக்குகிறது. .\n"
" [கோட் பிளாக்]\n"
" var c = color.from_hsv (0.58, 0.5, 0.79, 0.8) # HSV க்கு சமம் (210, 50, 79, "
"0.8) அல்லது வண்ணம் 8 (100, 151, 201, 0.8)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color's grayscale representation.\n"
"The gray value is calculated as [code](r + g + b) / 3[/code].\n"
"[codeblock]\n"
"var c = Color(0.2, 0.45, 0.82)\n"
"var gray = c.gray() # A value of 0.466667\n"
"[/codeblock]"
msgstr ""
"வண்ணத்தின் கிரேச்கேல் பிரதிநிதித்துவத்தை வழங்குகிறது.\n"
" சாம்பல் மதிப்பு [குறியீடு] (R + G + B) / 3 [ / குறியீடு] என கணக்கிடப்படுகிறது.\n"
" [கோட் பிளாக்]\n"
" var c = நிறம் (0.2, 0.45, 0.82)\n"
" var grey = c.gray () # 0.466667 இன் மதிப்பு\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the inverted color [code](1 - r, 1 - g, 1 - b, a)[/code].\n"
"[codeblock]\n"
"var color = Color(0.3, 0.4, 0.9)\n"
"var inverted_color = color.inverted() # Equivalent to Color(0.7, 0.6, 0.1)\n"
"[/codeblock]"
msgstr ""
"தலைகீழ் வண்ணத்தை [குறியீடு] (1 - r, 1 - g, 1 - b, a) [/code] ஐ வழங்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (0.3, 0.4, 0.9)\n"
" var தலைகீழ்_கோலர் = வண்ணம்.\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns [code]true[/code] if this color and [code]color[/code] are "
"approximately equal, by running [method @GDScript.is_equal_approx] on each "
"component."
msgstr ""
"ஒவ்வொரு கூறுகளிலும் [முறை @gdscript.is_equal_approx] ஐ இயக்குவதன் மூலம் இந்த வண்ணம் "
"மற்றும் [குறியீடு] நிறம் [/குறியீடு] தோராயமாக சமமாக இருந்தால் [குறியீடு] உண்மை [/"
"குறியீடு] வழங்குகிறது."

#: docs/Color.xml
msgid ""
"Returns a new color resulting from making this color lighter by the "
"specified percentage (ratio from 0 to 1).\n"
"[codeblock]\n"
"var green = Color(0.0, 1.0, 0.0)\n"
"var lightgreen = green.lightened(0.2) # 20% lighter than regular green\n"
"[/codeblock]"
msgstr ""
"குறிப்பிட்ட சதவீதத்தால் இந்த வண்ணத்தை இலகுவாக மாற்றுவதன் விளைவாக ஒரு புதிய வண்ணத்தை "
"வழங்குகிறது (விகிதம் 0 முதல் 1 வரை).\n"
" [கோட் பிளாக்]\n"
" var பச்சை = நிறம் (0.0, 1.0, 0.0)\n"
" var மெல்லியபச்சை = பச்சை. விளக்கு (0.2) # 20% வழக்கமான பச்சை நிறத்தை விட "
"இலகுவானது\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the linear interpolation with another color. The interpolation "
"factor [code]weight[/code] is between 0 and 1.\n"
"[codeblock]\n"
"var c1 = Color(1.0, 0.0, 0.0)\n"
"var c2 = Color(0.0, 1.0, 0.0)\n"
"var li_c = c1.linear_interpolate(c2, 0.5) # Equivalent to Color(0.5, 0.5, "
"0.0)\n"
"[/codeblock]"
msgstr ""
"மற்றொரு வண்ணத்துடன் நேரியல் இடைக்கணிப்பை வழங்குகிறது. இடைக்கணிப்பு காரணி [குறியீடு] எடை "
"[/குறியீடு] 0 மற்றும் 1 க்கு இடையில் உள்ளது.\n"
" [கோட் பிளாக்]\n"
" var c1 = வண்ணம் (1.0, 0.0, 0.0)\n"
" var c2 = வண்ணம் (0.0, 1.0, 0.0)\n"
" var li_c = c1.linear_interpolate (c2, 0.5) # வண்ணத்திற்கு சமம் (0.5, 0.5, 0.0)\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 32-bit integer in ABGR format (each byte "
"represents a color channel). ABGR is the reversed version of the default "
"format.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_abgr32()) # Prints 4281565439\n"
"[/codeblock]"
msgstr ""
"ஏபிசிஆர் வடிவத்தில் 32-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு பைட் "
"ஒரு வண்ண சேனலையும் குறிக்கிறது). ABGR என்பது இயல்புநிலை வடிவமைப்பின் தலைகீழ் "
"பதிப்பாகும்.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_abgr32 ()) # அச்சிடுகிறது 4281565439\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 64-bit integer in ABGR format (each word "
"represents a color channel). ABGR is the reversed version of the default "
"format.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_abgr64()) # Prints -225178692812801\n"
"[/codeblock]"
msgstr ""
"ஏபிசிஆர் வடிவத்தில் 64-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு "
"வார்த்தையும் ஒரு வண்ண சேனலைக் குறிக்கிறது). ABGR என்பது இயல்புநிலை வடிவமைப்பின் தலைகீழ் "
"பதிப்பாகும்.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_abgr64 ()) # அச்சிட்டு -225178692812801\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 32-bit integer in ARGB format (each byte "
"represents a color channel). ARGB is more compatible with DirectX.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_argb32()) # Prints 4294934323\n"
"[/codeblock]"
msgstr ""
"ARGB வடிவத்தில் 32-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு பைட் ஒரு "
"வண்ண சேனலையும் குறிக்கிறது). ARGB டைரக்ட்எக்ச் உடன் மிகவும் இணக்கமானது.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_argb32 ()) # அச்சிடுகிறது 4294934323\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 64-bit integer in ARGB format (each word "
"represents a color channel). ARGB is more compatible with DirectX.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_argb64()) # Prints -2147470541\n"
"[/codeblock]"
msgstr ""
"ARGB வடிவத்தில் 64-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு வார்த்தையும் "
"ஒரு வண்ண சேனலைக் குறிக்கிறது). ARGB டைரக்ட்எக்ச் உடன் மிகவும் இணக்கமானது.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_argb64 ()) # அச்சிட்டு -2147470541\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color's HTML hexadecimal color string in ARGB format (ex: "
"[code]ff34f822[/code]).\n"
"Setting [code]with_alpha[/code] to [code]false[/code] excludes alpha from "
"the hexadecimal string.\n"
"[codeblock]\n"
"var c = Color(1, 1, 1, 0.5)\n"
"var s1 = c.to_html() # Returns \"7fffffff\"\n"
"var s2 = c.to_html(false) # Returns \"ffffff\"\n"
"[/codeblock]"
msgstr ""
"வண்ணத்தின் உஉகுமொ எக்சாடெசிமல் வண்ண சரத்தை ARGB வடிவத்தில் (எ.கா.: [குறியீடு] FF34F822 "
"[/குறியீடு]) வழங்குகிறது.\n"
" [குறியீடு] வித்_ஆல்பா [/குறியீடு] ஐ [குறியீடு] தவறான [/குறியீடு] என அமைப்பது "
"எக்சாடெசிமல் சரத்திலிருந்து ஆல்பாவை விலக்குகிறது.\n"
" [கோட் பிளாக்]\n"
" var c = நிறம் (1, 1, 1, 0.5)\n"
" var s1 = c.to_html () # \"7fffffff\" ஐ வழங்குகிறது\n"
" var s2 = c.to_html (பொய்) # \"ffffff\" ஐ வழங்குகிறது\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 32-bit integer in RGBA format (each byte "
"represents a color channel). RGBA is Rebel Engine's default format.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_rgba32()) # Prints 4286526463\n"
"[/codeblock]"
msgstr ""
"RGBA வடிவத்தில் 32-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு பைட் ஒரு "
"வண்ண சேனலையும் குறிக்கிறது). RGBA என்பது கிளர்ச்சி இயந்திரத்தின் இயல்புநிலை வடிவம்.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_rgba32 ()) # அச்சிடுகிறது 4286526463\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"Returns the color converted to a 64-bit integer in RGBA format (each word "
"represents a color channel). RGBA is Rebel Engine's default format.\n"
"[codeblock]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_rgba64()) # Prints -140736629309441\n"
"[/codeblock]"
msgstr ""
"RGBA வடிவத்தில் 64-பிட் முழு எண்ணாக மாற்றப்பட்ட வண்ணத்தை வழங்குகிறது (ஒவ்வொரு வார்த்தையும் "
"ஒரு வண்ண சேனலைக் குறிக்கிறது). RGBA என்பது கிளர்ச்சி இயந்திரத்தின் இயல்புநிலை வடிவம்.\n"
" [கோட் பிளாக்]\n"
" var நிறம் = நிறம் (1, 0.5, 0.2)\n"
" அச்சு (color.to_rgba64 ()) # அச்சிட்டு -140736629309441\n"
" [/codeBlock]"

#: docs/Color.xml
msgid ""
"The color's alpha component, typically on the range of 0 to 1. A value of 0 "
"means that the color is fully transparent. A value of 1 means that the color "
"is fully opaque."
msgstr ""
"வண்ணத்தின் ஆல்பா கூறு, பொதுவாக 0 முதல் 1 வரம்பில். 0 இன் மதிப்பு என்பது நிறம் முழுமையாக "
"வெளிப்படையானது என்பதாகும். 1 இன் மதிப்பு என்பது நிறம் முழுமையாக ஒளிபுகாதாக "
"இருக்கிறது என்பதாகும்."

#: docs/Color.xml
