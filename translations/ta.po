#: modules/upnp/docs/UPNP.xml
msgid "Inconsistent parameters."
msgstr "சீரற்ற அளவுருக்கள்."

#: modules/upnp/docs/UPNP.xml
msgid ""
"No such entry in array. May be returned if a given port, protocol "
